diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
index 0631685e9..8c0e44011 100644
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -22,6 +22,60 @@ public:
 
 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
+/*
+ * poplar (MSM8998): the shim arms the APSS watchdog (qcom,wdt@17817000, ~30 s
+ * bite) and sets the PON/IMEM restart reason to bootloader, so a kernel that
+ * hangs or panics resets the phone into fastboot. Pet it while threads run.
+ * poplarwdt=0 turns it off; polarreboot=N stops petting after about N seconds,
+ * which bounds an unattended test run.
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define POPLAR_WDT_PA    0x17817000
+#define POPLAR_WDT_RST   0x04
+#define POPLAR_WDT_EN    0x08
+#define POPLAR_WDT_PET_S 5
+
+static void
+poplar_wdt_thread(void *arg)
+{
+	volatile uint32_t *wdt = (volatile uint32_t *)arg;
+	int reboot_s = 0;
+	PE_parse_boot_argn("poplarreboot", &reboot_s, sizeof(reboot_s));
+	for (int t = 0; reboot_s <= 0 || t < reboot_s; t += POPLAR_WDT_PET_S) {
+		wdt[POPLAR_WDT_RST / 4] = 1;
+		IOSleep(POPLAR_WDT_PET_S * 1000);
+	}
+	IOLog("POPLAR WDT: polarreboot=%d reached, no more pets: reset follows\n", reboot_s);
+	for (;;) {
+		IOSleep(1000000);
+	}
+}
+
+static void
+poplar_wdt_start(void)
+{
+	int enabled = 1;
+	PE_parse_boot_argn("poplarwdt", &enabled, sizeof(enabled));
+	volatile uint32_t *wdt = (volatile uint32_t *)ml_io_map(POPLAR_WDT_PA, 0x1000);
+	if (wdt == NULL) {
+		IOLog("POPLAR WDT: mapping failed\n");
+		return;
+	}
+	if (!(wdt[POPLAR_WDT_EN / 4] & 1)) {
+		IOLog("POPLAR WDT: not armed by the shim\n");
+		return;
+	}
+	wdt[POPLAR_WDT_RST / 4] = 1;
+	if (!enabled) {
+		wdt[POPLAR_WDT_EN / 4] = 0;
+		IOLog("POPLAR WDT: disabled (poplarwdt=0)\n");
+		return;
+	}
+	IOCreateThread(poplar_wdt_thread, (void *)wdt);
+	IOLog("POPLAR WDT: petting every %d s\n", POPLAR_WDT_PET_S);
+}
+
