 {
@@ -29,6 +83,7 @@ SweetPlatformExpert::start(IOService *provider)
 	if (!IODTPlatformExpert::start(provider)) {
 		return false;
 	}
+	poplar_wdt_start();
 	registerService();
 	IOLog("SWEET: platform expert registered\n");
 	return true;
