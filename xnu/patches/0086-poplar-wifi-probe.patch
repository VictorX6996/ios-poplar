+static bool
+s5b_wlfw_download_bdf(uint32_t board_id)
+{
+	char bdf_name[24];
+	const char *hex = "0123456789abcdef";
+	uint32_t bclus = 0u, bsize = 0u;
+	bool found = false;
+
+	if (board_id >= 0x100u && board_id <= 0xfffu) {
+		memcpy(bdf_name, "bdwlan.", 7);
+		bdf_name[7]  = hex[(board_id >> 8) & 0xfu];
+		bdf_name[8]  = hex[(board_id >> 4) & 0xfu];
+		bdf_name[9]  = hex[board_id & 0xfu];
+		bdf_name[10] = '\0';
+		found = sweet_modem_fat16_lookup_filename(bdf_name, &bclus, &bsize);
+	} else if (board_id > 0u && board_id < 0xffu) {
+		memcpy(bdf_name, "bdwlan.b", 8);
+		bdf_name[8]  = hex[(board_id >> 4) & 0xfu];
+		bdf_name[9]  = hex[board_id & 0xfu];
+		bdf_name[10] = '\0';
+		found = sweet_modem_fat16_lookup_filename(bdf_name, &bclus, &bsize);
+	}
+	if (!found) {
+		memcpy(bdf_name, "bdwlan.bin", 11);
+		found = sweet_modem_fat16_lookup_filename(bdf_name, &bclus, &bsize);
+	}
+	if (!found || bsize == 0u || bsize > sizeof(s_5b_bdf_buf)) {
+		printf("WIFI PROBE: [5B.4] ERROR: BDF '%s' missing or oversized (%u B)\n", bdf_name, bsize);
+		return false;
+	}
+	if (sweet_modem_fat16_read_slice(bclus, bsize, 0u, bsize, s_5b_bdf_buf) != 0) {
+		printf("WIFI PROBE: [5B.4] ERROR: failed reading BDF '%s'\n", bdf_name);
+		return false;
+	}
+
+	printf("WIFI PROBE: [5B.4] Streaming BDF '%s' (%u B) via QMI_WLFW_BDF_DOWNLOAD_REQ...\n",
+	    bdf_name, bsize);
+
+	uint32_t seg_id = 0u;
+	uint32_t off = 0u;
+	while (off < bsize) {
+		uint32_t chunk = bsize - off;
+		if (chunk > 1024u) {
+			chunk = 1024u;
+		}
+		bool is_end = (off + chunk >= bsize);
+		uint8_t sdu[1120];
+		uint32_t sl = 0u;
+		uint8_t one = 1u, end_b = is_end ? 1u : 0u;
+		uint8_t u32v[4];
+
+		sl = s5b_qmi_put_tlv(sdu, sl, 0x01u, 1u, &one);
+		s5b_wr_le32(u32v, 0u);     sl = s5b_qmi_put_tlv(sdu, sl, 0x10u, 4u, u32v);
+		s5b_wr_le32(u32v, bsize);  sl = s5b_qmi_put_tlv(sdu, sl, 0x11u, 4u, u32v);
+		s5b_wr_le32(u32v, seg_id); sl = s5b_qmi_put_tlv(sdu, sl, 0x12u, 4u, u32v);
+		/* Variable byte array TLV 0x13: u16 count + chunk bytes */
+		sdu[sl + 0] = 0x13u;
+		s5b_wr_le16(sdu + sl + 1, (uint16_t)(2u + chunk));
+		s5b_wr_le16(sdu + sl + 3, (uint16_t)chunk);
+		memcpy(sdu + sl + 5, s_5b_bdf_buf + off, chunk);
+		sl += 5u + chunk;
+		sl = s5b_qmi_put_tlv(sdu, sl, 0x14u, 1u, &end_b);
+
+		uint16_t res = 0u, err = 0u;
+		bool seg_ok = s5b_wlfw_qmi_sync(WLFW_BDF_DOWNLOAD_REQ, sdu, (uint16_t)sl, &res, &err);
+		if (!seg_ok && !(is_end && err == 1u)) {
+			printf("WIFI PROBE: [5B.4] ERROR: BDF seg=%u rejected res=%u err=%u\n", seg_id, res, err);
+			return false;
+		}
+		if (!seg_ok && is_end && err == 1u) {
+			printf("WIFI PROBE: [5B.4] BDF final seg=%u CRC warning res=%u err=%u (non-fatal)\n", seg_id, res, err);
+		}
+		off += chunk;
+		seg_id++;
+	}
+	printf("WIFI PROBE: [5B.4] BDF '%s' uploaded in %u segments OK.\n", bdf_name, seg_id);
+	return true;
+}
+
+static void
+probe_stage5b_wlfw_bringup(void)
+{
+	int wlan_stage5b_wlfw = 0;
+	(void)PE_parse_boot_argn("wlan_stage5b_wlfw", &wlan_stage5b_wlfw, sizeof(wlan_stage5b_wlfw));
+
+	printf("WIFI PROBE: [5B] === STAGE 5B: SMMU, RAILS, GLINK/IPCRTR, PD/TFTP/RMTFS & WLFW QMI ===\n");
+
+	if (wlan_stage5b_wlfw <= 0) {
+		printf("WIFI PROBE: [5B] Gate: wlan_stage5b_wlfw=0 (dormant default).\n");
+		printf("WIFI PROBE: [5B] Stage 5B skipped. To activate, set wlan_stage5b_wlfw=1.\n\n");
+		return;
+	}
+
+	if (!s_mpss_boot_ok || !s_fat16_valid || !s_fw_wlanmdsp.found ||
+	    s_smem_p07_pa == 0u || s_smem_p07_sz == 0u || s_mba_va == 0u) {
+		printf("WIFI PROBE: [5B] ABORT: Preconditions unmet (mpss=%d fat16=%d wlanmdsp=%d p07=0x%x).\n\n",
+		    s_mpss_boot_ok ? 1 : 0, s_fat16_valid ? 1 : 0,
+		    s_fw_wlanmdsp.found ? 1 : 0, s_smem_p07_pa);
+		return;
+	}
+
+	memset(&s5b, 0, sizeof(s5b));
+	printf("WIFI PROBE: [5B] Gate: wlan_stage5b_wlfw=1 ACTIVE (wlanmdsp=%u B, /IMAGE/ entries=%u) [Experiment D8-E].\n",
+	    s_fw_wlanmdsp.size, s_img_dir_cnt);
+
+	/* 5B.0: IMEM baseline read (0x146bf000) */
+	vm_offset_t imem_base_va = s5b_get_imem_va();
+	if (imem_base_va) {
+		uint32_t b_rst = probe_rd32(imem_base_va, POPLAR_IMEM_RESTART_REASON);
+		uint32_t b_dld = probe_rd32(imem_base_va, POPLAR_IMEM_DLOAD_TYPE_OFF);
+		uint32_t b_pil = probe_rd32(imem_base_va, POPLAR_IMEM_PIL_INFO_OFF);
+		printf("WIFI PROBE: [5B.0] IMEM baseline @ 0x%08llx: restart_reason=0x%08x dload_type=0x%08x pil_info=0x%08x\n",
+		    (unsigned long long)POPLAR_IMEM_BASE_PA, b_rst, b_dld, b_pil);
+	}
+
+	/* 5B.1: ANOC2 SMMU S1-Bypass + PM8998 WLAN Rails + clk_rf_clk2_pin + RMTFS/MSA prep */
+	s5b_anoc2_smmu_bypass();
+
+	bool ok_l5  = poplar_rpm_ldoa(5, 800000u);
+	bool ok_l7  = poplar_rpm_ldoa(7, 1800000u);
+	bool ok_l17 = poplar_rpm_ldoa(17, 1304000u);
+	bool ok_l25 = poplar_rpm_ldoa(25, 3312000u);
+	bool ok_clk = poplar_rpm_clka(5, 1u);
+	delay(5000);
+	printf("WIFI PROBE: [5B.1] PM8998 WLAN Rails: L5=%d L7=%d L17=%d L25=%d RF_CLK2=%d\n",
+	    ok_l5 ? 1 : 0, ok_l7 ? 1 : 0, ok_l17 ? 1 : 0, ok_l25 ? 1 : 0, ok_clk ? 1 : 0);
+
+	if (!s_rmtfs_va) {
+		s_rmtfs_va = ml_io_map_unmappable(POPLAR_RMTFS_CARVEOUT_PA,
+		    POPLAR_RMTFS_CARVEOUT_SIZE, SWEET_VM_WIMG_WCOMB);
+	}
+	if (s_rmtfs_va) {
+		sweet_io_zero((void *)s_rmtfs_va, (size_t)POPLAR_RMTFS_CARVEOUT_SIZE);
+		sweet_dcache_clean_poc(s_rmtfs_va, (size_t)POPLAR_RMTFS_CARVEOUT_SIZE);
+		uint32_t rsrc[1] = { QCOM_SCM_VMID_HLOS };
+		uint32_t rdst[2] = { QCOM_SCM_VMID_HLOS, QCOM_SCM_VMID_MSS_MSA };
+		uint32_t rprm[2] = { QCOM_SCM_PERM_RW,  QCOM_SCM_PERM_RW };
+		(void)sweet_scm_assign_mem_multi(POPLAR_RMTFS_CARVEOUT_PA,
+		    POPLAR_RMTFS_CARVEOUT_SIZE, rsrc, 1u, rdst, rprm, 2u);
+	}
+	sweet_io_zero((void *)s_mba_va, (size_t)PIL_MBA_DP_SIZE);
+	sweet_dcache_clean_poc(s_mba_va, (size_t)PIL_MBA_DP_SIZE);
+
+	/* 5B.2 & 5B.3: SMEM GLINK 'mpss' + IPCRTR + PD-Mapper/RMTFS/TFTP servers */
+	if (!s5b_setup_smem_glink()) {
+		printf("WIFI PROBE: [5B] ABORT: SMEM GLINK setup failed.\n\n");
+		return;
+	}
+
+	/* Pump IPCRTR up to 25 seconds for PD/TFTP/RMTFS traffic & WLFW (0x45) server arrival */
+	printf("WIFI PROBE: [5B.3] Pumping IPCRTR up to 25000 ms for MPSS services & wlan_pd...\n");
+	for (unsigned ms = 0u; ms < 25000u; ms++) {
+		s5b.current_ms = ms;
+		s5b_pump_all();
+		if (s5b.wlfw_up) {
+			break;
+		}
+		if ((ms % 2000u) == 0u && ms > 0u) {
+			uint32_t t_rel = (s5b.last_rmtfs_ms > 0u && ms >= s5b.last_rmtfs_ms) ?
+			    (ms - s5b.last_rmtfs_ms) : 0u;
+			printf("WIFI PROBE: [5B.3] Heartbeat (%u ms, t_rel_efs=+%u ms): hello=%d notif=%d wlan_pd=%d (st=0x%x) wlfw=%d rmtfs_reads=%u tftp_reqs=%u\n",
+			    ms, t_rel, s5b.hello_recvd ? 1 : 0, s5b.servreg_notif_up ? 1 : 0,
+			    s5b.wlan_pd_started ? 1 : 0, s5b.wlan_pd_state, s5b.wlfw_up ? 1 : 0,
+			    s5b.rmtfs_read_count, s5b.tftp_req_count);
+			printf("WIFI PROBE: [5B.3]   SSM(open=%d adv_int=%u rx_int=%u pkts=%u bytes=%u) SSR(open=%d adv_int=%u rx_int=%u pkts=%u bytes=%u) SSCTL(up=%d sent=%d ack=%d wcnss=%d/%d)\n",
+			    (s5b.ssm_open_acked && s5b.ssm_rem_open) ? 1 : 0,
+			    s5b.ssm_rx_intents_advertised, s5b.ssm_tx_intents_received,
+			    s5b.ssm_rx_packets, s5b.ssm_rx_bytes,
+			    (s5b.ssr_open_acked && s5b.ssr_rem_open) ? 1 : 0,
+			    s5b.ssr_rx_intents_advertised, s5b.ssr_tx_intents_received,
+			    s5b.ssr_rx_packets, s5b.ssr_rx_bytes,
+			    s5b.ssctl_up ? 1 : 0, s5b.ssctl_event_sent ? 1 : 0, s5b.ssctl_event_acked ? 1 : 0,
+			    s5b.ssctl_wcnss_sent ? 1 : 0, s5b.ssctl_wcnss_acked ? 1 : 0);
+			printf("WIFI PROBE: [5B.3]   QRTR(ctrl_rx=%u ctrl_tx=%u hello=%u lookup=%u [tftp_lkup=%u other=%u] srv_rx=%u del_clnt=%u)\n",
+			    s5b.qrtr_ctrl_rx_count, s5b.qrtr_ctrl_tx_count, s5b.qrtr_hello_count,
+			    s5b.qrtr_lookup_count, s5b.qrtr_lookup_tftp_count, s5b.qrtr_lookup_other_count,
+			    s5b.qrtr_new_server_rx_count, s5b.qrtr_del_client_count);
+			/* Experiment D8-E: Suppress repetitive pre-fatal SSCTL failure queries during normal operation.
+			 * Hexagon is healthy; polling failure reasons treats healthy state as anomalous.
+			 * Failure reason will only be audited in post-fatal diagnostics if ERR-FATAL occurs.
+			 */
+#if 0
+			if (s5b.ssctl_up && !s5b.mpss_err_fatal_dumped &&
+			    (ms == 2000u || ms == 6000u || ms == 10000u || ms == 14000u)) {
+				s5b_ssctl_query_failure_reason("pre-fatal");
+			}
+#endif
+			/* Experiment D8-C: Re-advertise TFTP & core servers during early boot (2s, 4s) */
+			if (s5b.hello_recvd && (ms == 2000u || ms == 4000u)) {
+				s5b_advertise_apps_servers(s5b.mpss_node_id);
+			}
+		}
+		delay(1000);
+	}
+
+	if (!s5b.wlfw_up) {
+		printf("WIFI PROBE: [5B.4] NOTICE: WLFW (0x45) did not arrive within 25000 ms (hello=%d notif=%d wlan_pd=%d st=0x%x).\n\n",
+		    s5b.hello_recvd ? 1 : 0, s5b.servreg_notif_up ? 1 : 0, s5b.wlan_pd_started ? 1 : 0, s5b.wlan_pd_state);
+		return;
+	}
+
+	printf("WIFI PROBE: [5B.4] *** WLFW QMI (0x45) CONNECTED @ node=%u port=%u ***\n",
+	    s5b.wlfw_node, s5b.wlfw_port);
+
+	/* 5B.4 Step 1: WLFW_IND_REGISTER_REQ (0x0020) */
+	{
+		uint8_t sdu[48], one = 1u, cid[4];
+		uint32_t sl = 0u;
+		sl = s5b_qmi_put_tlv(sdu, sl, 0x10u, 1u, &one);
+		sl = s5b_qmi_put_tlv(sdu, sl, 0x13u, 1u, &one);
+		sl = s5b_qmi_put_tlv(sdu, sl, 0x14u, 1u, &one);
+		s5b_wr_le32(cid, WLFW_CLIENT_ID_KNEL);
+		sl = s5b_qmi_put_tlv(sdu, sl, 0x15u, 4u, cid);
+		uint16_t res = 0u, err = 0u;
+		bool ok = s5b_wlfw_qmi_sync(WLFW_IND_REGISTER_REQ, sdu, (uint16_t)sl, &res, &err);
+		uint16_t fw_st_len = 0u;
+		const uint8_t *fw_st_v = s5b_qmi_find_tlv(s_5b_qmi_resp_buf, s5b.qmi_resp_len, 0x10u, &fw_st_len);
+		uint64_t fw_status = (fw_st_v && fw_st_len >= 8u) ? s5b_rd_le64(fw_st_v) : 0ULL;
+		if ((fw_status & 2ULL) != 0ULL) {
+			s5b.wlfw_fw_ready = true;
+		}
+		printf("WIFI PROBE: [5B.4] 1. IND_REGISTER (0x0020): ok=%d res=%u err=%u fw_status=0x%llx\n",
+		    ok ? 1 : 0, res, err, (unsigned long long)fw_status);
+		if (!ok) return;
+	}
+
+	/* 5B.4 Step 2 & 3: WLFW_MSA_INFO_REQ (0x002d), Multi-VMID MP_ASSIGN & WLFW_MSA_READY_REQ (0x002e) */
+	if (!s5b.wlfw_fw_ready) {
+		uint8_t sdu[32], pa8[8], sz4[4];
+		uint32_t sl = 0u;
+		s5b_wr_le64(pa8, PIL_MBA_PHYS_BASE);
+		s5b_wr_le32(sz4, (uint32_t)PIL_MBA_DP_SIZE);
+		sl = s5b_qmi_put_tlv(sdu, sl, 0x01u, 8u, pa8);
+		sl = s5b_qmi_put_tlv(sdu, sl, 0x02u, 4u, sz4);
+		uint16_t res = 0u, err = 0u;
+		bool ok = s5b_wlfw_qmi_sync(WLFW_MSA_INFO_REQ, sdu, (uint16_t)sl, &res, &err);
+		printf("WIFI PROBE: [5B.4] 2. MSA_INFO (0x002d): ok=%d res=%u err=%u\n", ok ? 1 : 0, res, err);
+		if (!ok) return;
+
+		uint16_t rlen = 0u;
+		const uint8_t *rv = s5b_qmi_find_tlv(s_5b_qmi_resp_buf, s5b.qmi_resp_len, 0x03u, &rlen);
+		if (!rv) {
+			rv = s5b_qmi_find_tlv(s_5b_qmi_resp_buf, s5b.qmi_resp_len, 0x10u, &rlen);
+		}
+		if (rv && rlen >= 1u) {
+			uint8_t nr = rv[0];
+			if (nr > 2u) nr = 2u;
+			for (uint8_t i = 0u; i < nr && (uint32_t)(1u + (i + 1u) * 13u) <= rlen; i++) {
+				const uint8_t *re = rv + 1u + (uint32_t)i * 13u;
+				uint64_t raddr = s5b_rd_le64(re + 0);
+				uint32_t rsize = s5b_rd_le32(re + 8);
+				uint8_t  rsec  = re[12];
+				printf("WIFI PROBE: [5B.4]    MSA region[%u]: addr=0x%llx size=0x%x secure=%u\n",
+				    i, (unsigned long long)raddr, rsize, rsec);
+				uint32_t asize = (rsize + 0xfffu) & ~0xfffu;
+				if (raddr >= PIL_MBA_PHYS_BASE &&
+				    raddr < PIL_MBA_PHYS_BASE + PIL_MBA_DP_SIZE &&
+				    rsize > 0u && asize > 0u &&
+				    (uint64_t)asize <= PIL_MBA_PHYS_BASE + PIL_MBA_DP_SIZE - raddr &&
+				    (raddr & 0xfffULL) == 0u) {
+					delay(20000); /* quiesce before TZ XPU update after MSA_INFO reply */
+					uint32_t src_v[1] = { QCOM_SCM_VMID_HLOS };
+					uint32_t dst_s[2] = { QCOM_SCM_VMID_MSS_MSA, QCOM_SCM_VMID_WLAN };
+					uint32_t prm_s[2] = { QCOM_SCM_PERM_RW, QCOM_SCM_PERM_RW };
+					uint32_t dst_u[3] = { QCOM_SCM_VMID_MSS_MSA, QCOM_SCM_VMID_WLAN, QCOM_SCM_VMID_WLAN_CE };
+					uint32_t prm_u[3] = { QCOM_SCM_PERM_RW, QCOM_SCM_PERM_RW, QCOM_SCM_PERM_RW };
+					(void)sweet_scm_assign_mem_multi(raddr, asize, src_v, 1u,
+					    rsec ? dst_s : dst_u, rsec ? prm_s : prm_u, rsec ? 2u : 3u);
+				}
+			}
+		}
+
+		res = 0u; err = 0u;
+		ok = s5b_wlfw_qmi_sync(WLFW_MSA_READY_REQ, NULL, 0u, &res, &err);
+		printf("WIFI PROBE: [5B.4] 3. MSA_READY (0x002e): ok=%d res=%u err=%u\n", ok ? 1 : 0, res, err);
+		if (!ok) return;
+	}
+
+	/* 5B.4 Step 4: WLFW_CAP_REQ (0x0024) */
+	uint32_t board_id = 0xffu;
+	{
+		uint16_t res = 0u, err = 0u;
+		bool ok = s5b_wlfw_qmi_sync(WLFW_CAP_REQ, NULL, 0u, &res, &err);
+		printf("WIFI PROBE: [5B.4] 4. CAP_REQ (0x0024): ok=%d res=%u err=%u\n", ok ? 1 : 0, res, err);
+		if (!ok) return;
+
+		uint16_t l10 = 0u, l11 = 0u, l12 = 0u, l13 = 0u, l14 = 0u;
+		const uint8_t *v10 = s5b_qmi_find_tlv(s_5b_qmi_resp_buf, s5b.qmi_resp_len, 0x10u, &l10);
+		const uint8_t *v11 = s5b_qmi_find_tlv(s_5b_qmi_resp_buf, s5b.qmi_resp_len, 0x11u, &l11);
+		const uint8_t *v12 = s5b_qmi_find_tlv(s_5b_qmi_resp_buf, s5b.qmi_resp_len, 0x12u, &l12);
+		const uint8_t *v13 = s5b_qmi_find_tlv(s_5b_qmi_resp_buf, s5b.qmi_resp_len, 0x13u, &l13);
+		const uint8_t *v14 = s5b_qmi_find_tlv(s_5b_qmi_resp_buf, s5b.qmi_resp_len, 0x14u, &l14);
+		uint32_t chip_id = (v10 && l10 >= 4u) ? s5b_rd_le32(v10) : 0u;
+		uint32_t chip_fm = (v10 && l10 >= 8u) ? s5b_rd_le32(v10 + 4) : 0u;
+		if (v11 && l11 >= 4u) board_id = s5b_rd_le32(v11);
+		uint32_t soc_id  = (v12 && l12 >= 4u) ? s5b_rd_le32(v12) : 0u;
+		uint32_t fw_ver  = (v13 && l13 >= 4u) ? s5b_rd_le32(v13) : 0u;
+		char build_id[64];
+		memset(build_id, 0, sizeof(build_id));
+		if (v14 && l14 > 0u) {
+			uint32_t cn = (l14 < sizeof(build_id) - 1u) ? l14 : (uint32_t)(sizeof(build_id) - 1u);
+			memcpy(build_id, v14, cn);
+		}
+		printf("WIFI PROBE: [5B.4]    CAP: chip=0x%x fam=0x%x board_id=0x%x soc=0x%x fw_ver=0x%x build='%s'\n",
+		    chip_id, chip_fm, board_id, soc_id, fw_ver, build_id);
+	}
+
+	/* 5B.4 Step 5: Wait for MSA_READY_IND, then BDF_DOWNLOAD, MAC_ADDR (0x0033), & CAL_REPORT */
+	for (unsigned ms = 0u; ms < 5000u && !s5b.wlfw_msa_ready_ind && !s5b.wlfw_fw_ready; ms++) {
+		s5b_pump_all();
+		delay(1000);
+	}
+	if (!s5b.wlfw_fw_ready) {
+		if (s5b_wlfw_download_bdf(board_id)) {
+			uint8_t mac[6] = { 0x02u, 0x50u, 0x4fu, 0x50u, 0x4cu, 0x30u };
+			DTEntry chosen = NULL;
+			void const *mprop = NULL;
+			unsigned int mlen = 0;
+			if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+			    SecureDTGetProperty(chosen, "mac-address-wifi0", &mprop, &mlen) == kSuccess &&
+			    mlen == 6u) {
+				memcpy(mac, mprop, 6u);
+			}
+			uint8_t mac_sdu[12];
+			uint32_t msl = s5b_qmi_put_tlv(mac_sdu, 0u, 0x10u, 6u, mac);
+			uint16_t mres = 0u, merr = 0u;
+			bool mok = s5b_wlfw_qmi_sync(WLFW_MAC_ADDR_REQ, mac_sdu, (uint16_t)msl, &mres, &merr);
+			printf("WIFI PROBE: [5B.4] 5a. MAC_ADDR (0x0033) %02x:%02x:%02x:%02x:%02x:%02x: ok=%d res=%u err=%u\n",
+			    mac[0], mac[1], mac[2], mac[3], mac[4], mac[5], mok ? 1 : 0, mres, merr);
+
+			uint8_t cal_sdu[8];
+			uint8_t meta_cnt = 0u;
+			uint32_t csl = s5b_qmi_put_tlv(cal_sdu, 0u, 0x01u, 1u, &meta_cnt);
+			uint16_t res = 0u, err = 0u;
+			bool ok = s5b_wlfw_qmi_sync(WLFW_CAL_REPORT_REQ, cal_sdu, (uint16_t)csl, &res, &err);
+			printf("WIFI PROBE: [5B.4] 5b. CAL_REPORT (0x0026): ok=%d res=%u err=%u\n", ok ? 1 : 0, res, err);
+		}
+	}
+
+	/* 5B.4 Step 6: Wait up to 10000 ms for QMI_WLFW_FW_READY_IND_V01 (0x0021) */
+	for (unsigned ms = 0u; ms < 10000u && !s5b.wlfw_fw_ready; ms++) {
+		s5b_pump_all();
+		delay(1000);
+	}
+
+	printf("WIFI PROBE: [5B] Stage 5B complete (wlfw_fw_ready=%d).\n\n", s5b.wlfw_fw_ready ? 1 : 0);
+}
+
+void
+sweet_poplar_wifi_probe(void)
+{
+	int probe = 0;
+	(void)PE_parse_boot_argn("wifiprobe", &probe, sizeof(probe));
+
+	/* Default: completely dormant */
+	if (probe <= 0) {
+		return;
+	}
+
+	if (probe != 1) {
+		printf("WIFI PROBE: wifiprobe=%d unsupported; defaulting to Level 1 read-only diagnostic\n", probe);
+	}
+
+	printf("\n=======================================================\n");
+	printf("=== SWEET POPLAR WI-FI DIAGNOSTIC PROBE (LEVEL 1)   ===\n");
+	printf("=======================================================\n");
+
+	/* Level 1 Probes: 100% Non-invasive, safe, always-clocked buses */
+	probe_smem();
+	probe_smmu();
+	probe_pm8998_gpio3();
+	probe_rpm_msgram();
+	probe_wlan_device_tree();
+	probe_stage4_passive_audit();
+	probe_stage4_2a_passive_audit();
+	probe_stage4_3_passive_audit();
+	probe_stage4_4_passive_audit();
+	probe_stage4_5_active_mba_load();
+	probe_stage5a_mpss_boot();
+	probe_stage5b_wlfw_bringup();
+
+	printf("=======================================================\n");
+	printf("=== SWEET POPLAR WI-FI DIAGNOSTIC PROBE COMPLETE    ===\n");
+	printf("=======================================================\n\n");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
