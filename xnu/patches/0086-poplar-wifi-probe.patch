+/*
+ * sweet_poplar_wifi_probe.c - Step 8 Stage 1B Poplar Wi-Fi Read-Only Diagnostic Probe
+ *
+ * Controlled by boot-args:
+ *   wifiprobe=0 (default): Completely dormant; normal boot path untouched.
+ *   wifiprobe=1: Level 1 non-invasive read-only diagnostic probe of:
+ *                1. SMEM TOC (0x861ff000)
+ *                2. SMMU ANOC2 capabilities, fault status, and full SMR/S2CR dump (0x016c0000)
+ *                3. SPMI v3 Arbiter APID mapping and ownership (0x0800f000 / 0x0800a000)
+ *                4. RPM GLINK Message RAM TOC (0x00778000)
+ *                5. Device-Tree: live Apple Device Tree inspection + MSM8998 stock DT reference
+ *
+ * Safety Boundaries (100% Passive):
+ *   - Zero writes to SMMU registers, context banks, or translation tables.
+ *   - Zero writes to PMIC peripheral registers (no power rail / GPIO changes).
+ *   - Zero active SPMI command transactions (all active observer writes removed).
+ *   - Zero access to unclocked MMIO (WCSS 0x18800000 and MSS/RMB 0x04180000
+ *     are strictly excluded).
+ */
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <mach/vm_types.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void delay(int usec);
+extern int printf(const char *format, ...) __printflike(1, 2);
+
+void sweet_poplar_wifi_probe(void);
+extern bool poplar_rpm_ldoa(unsigned ldo, uint32_t uv);
+extern bool poplar_rpm_clka(unsigned clk_id, uint32_t enable);
+
+/*
+ * Verified Base Addresses from Poplar Device Tree (dtb/live.dtb)
+ */
+#define POPLAR_SMEM_TOC_PA      0x861ff000u   /* Last 4KB of 2MB SMEM region */
+#define POPLAR_SMMU_ANOC2_PA    0x016c0000u   /* /soc/arm,smmu-anoc2@16c0000 */
+#define POPLAR_SMMU_ANOC2_SIZE  0x4000u       /* 16KB GR0 mapping window */
+#define POPLAR_SPMI_CORE_PA     0x0800f000u   /* /soc/qcom,spmi@800f000 'core' */
+#define POPLAR_SPMI_CNFG_PA     0x0800a000u   /* /soc/qcom,spmi@800f000 'cnfg' */
+#define POPLAR_RPM_MSGRAM_PA    0x00778000u   /* /soc/qcom,glink-rpm 'aux-mem1' (28KB) */
+#define POPLAR_WCSS_PA              0x18800000u   /* /soc/qcom,icnss@18800000 'membase' */
+#define POPLAR_WCSS_CE0_PAGE_PA     0x18857000u   /* Copy Engine 0 page-aligned base (0x18800000 + 0x57000) */
+#define POPLAR_WCSS_CE0_PAGE_OFF    0x00000400u   /* Offset of CE0 base register within 4KB page (0x57400 - 0x57000) */
+#define POPLAR_WCSS_PAGE_SZ         0x00001000u   /* 4KB targeted page mapping (prevents io_submap exhaustion) */
+
+/*
+ * ARM SMMUv2 Architecture Register Offsets (ARM IHI 0062D)
+ */
+#define ARM_SMMU_GR0_sCR0       0x0000u
+#define ARM_SMMU_GR0_IDR0       0x0020u
+#define ARM_SMMU_GR0_IDR1       0x0024u
+#define ARM_SMMU_GR0_IDR2       0x0028u
+#define ARM_SMMU_GR0_sGFSR      0x0048u
+#define ARM_SMMU_GR0_sGFSYNR0   0x0050u
+#define ARM_SMMU_GR0_sGFSYNR1   0x0054u
+#define ARM_SMMU_GR0_sGFSYNR2   0x0058u
+#define ARM_SMMU_GR0_SMR_BASE   0x0800u
+#define ARM_SMMU_GR0_S2CR_BASE  0x0c00u
+
+/* SMMUv2 IDR0 Bitfields */
+#define SMMU_IDR0_NUMSMRG_MASK  0x000000ffu   /* bits [7:0]: Num SMR groups */
+#define SMMU_IDR0_NUMSIDB_SHIFT 9
+#define SMMU_IDR0_NUMSIDB_MASK  0x0000000fu   /* bits [12:9]: Num StreamID bits */
+#define SMMU_IDR0_BTM           (1u << 13)    /* bit 13: Broadcast TLB maint */
+#define SMMU_IDR0_CTTW          (1u << 14)    /* bit 14: Coherent walk */
+#define SMMU_IDR0_NUMIRPT_SHIFT 16
+#define SMMU_IDR0_NUMIRPT_MASK  0x000000ffu   /* bits [23:16]: Num interrupt lines */
+#define SMMU_IDR0_SMS           (1u << 27)    /* bit 27: Stream Match Support */
+#define SMMU_IDR0_NTS           (1u << 28)    /* bit 28: Nested translation */
+#define SMMU_IDR0_S2TS          (1u << 29)    /* bit 29: Stage 2 translation */
+#define SMMU_IDR0_S1TS          (1u << 30)    /* bit 30: Stage 1 translation */
+
+/* SMMUv2 IDR1 Bitfields */
+#define SMMU_IDR1_NUMCB_MASK    0x000000ffu   /* bits [7:0]: Total Context Banks */
+#define SMMU_IDR1_SMCD          (1u << 15)    /* bit 15: Stream Match Disable */
+#define SMMU_IDR1_NUMS2CB_SHIFT 16
+#define SMMU_IDR1_NUMS2CB_MASK  0x000000ffu   /* bits [23:16]: Num Stage 2-only CBs */
+#define SMMU_IDR1_PAGESIZE      (1u << 31)    /* bit 31: 0=4KB, 1=64KB */
+
+/* SMMUv2 SMR Bitfields */
+#define SMMU_SMR_VALID          (1u << 31)    /* bit 31: Entry valid */
+#define SMMU_SMR_MASK_SHIFT     16
+#define SMMU_SMR_MASK_MASK      0x00007fffu   /* bits [30:16]: 15-bit StreamID mask */
+#define SMMU_SMR_ID_MASK        0x00007fffu   /* bits [14:0]: 15-bit StreamID */
+
+/* SMMUv2 S2CR Bitfields */
+#define SMMU_S2CR_CBNDX_MASK    0x000000ffu   /* bits [7:0]: Context Bank index */
+#define SMMU_S2CR_TYPE_SHIFT    16
+#define SMMU_S2CR_TYPE_MASK     0x00000003u   /* bits [17:16]: 0=trans, 1=bypass, 2=fault */
+
+/* Target WLAN StreamIDs for investigation (from MSM8998 DTB) */
+#define WLAN_STREAM_ID_PRIMARY   0x1900u      /* Copy Engine data path */
+#define WLAN_STREAM_ID_SECONDARY 0x1901u      /* Firmware / MSA path */
+
+/* Qualcomm SPMI Arbiter v3 Offsets (MSM8998) */
+#define SPMI_V3_MAP_BASE        0x0800u       /* In CORE region */
+#define SPMI_V3_OWNER_BASE      0x0700u       /* In CNFG region */
+#define PM8998_GPIO3_PPID       0x00c2u       /* SID 0, Peripheral 0xc2 */
+
+/* RPM GLINK Message RAM Constants */
+#define RPM_TOC_OFFSET          (0x7000u - 256u)
+#define RPM_TOC_MAGIC           0x67727430u   /* "grt0" */
+
+/* APCS IPC Doorbell (MSM8998) */
+#define POPLAR_APCS_IPC_PA      0x17911008u   /* APCS IPC register base for RPM */
+#define APCS_IPC_RPM_MASK       0x00000001u   /* Bit 0 kicks RPM interrupt */
+
+/* Qualcomm GLINK Command Constants */
+#define GLINK_CMD_VERSION           0u
+#define GLINK_CMD_VERSION_ACK       1u
+#define GLINK_CMD_OPEN              2u
+#define GLINK_CMD_CLOSE             3u
+#define GLINK_CMD_OPEN_ACK          4u
+#define GLINK_CMD_INTENT            5u
+#define GLINK_CMD_RX_DONE           6u
+#define GLINK_CMD_RX_INTENT_REQ     7u
+#define GLINK_CMD_RX_INTENT_REQ_ACK 8u
+#define GLINK_CMD_TX_DATA           9u
+#define GLINK_CMD_CLOSE_ACK         11u
+#define GLINK_CMD_TX_DATA_CONT      12u
+#define GLINK_CMD_READ_NOTIF        13u
+#define GLINK_CMD_RX_DONE_W_REUSE   14u
+#define GLINK_CMD_SIGNALS           15u
+
+/* Qualcomm SMD RPM Resource & Key Constants */
+#define QCOM_SMD_RPM_LDOA           0x616f646cu   /* "ldoa" in little-endian */
+#define QCOM_SMD_RPM_CLK_BUF_A      0x616b6c63u   /* "clka" in little-endian */
+#define RPM_KEY_SWEN                0x6e657773u   /* "swen" in little-endian */
+#define RPM_KEY_UV                  0x00007675u   /* "uv"   in little-endian */
+#define RPM_KEY_MA                  0x0000616du   /* "ma"   in little-endian */
+#define RPM_KEY_RATE                0x007a686bu   /* "khz"  in little-endian */
+
+static inline uint32_t
+probe_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+probe_wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb sy; isb" ::: "memory");
+}
+
+/*
+ * --- 1. SMEM Partition Table Probe ---
+ * Safely reads the Qualcomm SMEM TOC at 0x861ff000.
+ * Layout per Qualcomm Linux drivers/soc/qcom/smem.c:
+ *   Header (32 bytes):
+ *     u32 magic ("$TOC" = 0x434f5424)
+ *     u32 version (= 1)
+ *     u32 num_entries
+ *     u32 max_entries
+ *     u32 reserved[4]
+ *   Entry (48 bytes):
+ *     u32 offset (byte offset from 2MB SMEM base)
+ *     u32 size   (byte size of partition)
+ *     u32 flags
+ *     u16 host0  (subsystem host 0, e.g. APPS=1)
+ *     u16 host1  (subsystem host 1, e.g. Modem=2)
+ *     u32 size_cacheline
+ *     u32 reserved[7]
+ *
+ * Restricts logging to partition headers; never reads partition payloads.
+ */
+static void
+probe_smem(void)
+{
+	vm_offset_t toc;
+	uint32_t magic, ver, num_entries, max_entries, max_safe_entries;
+	uint32_t i;
+
+	printf("WIFI PROBE: [SMEM] mapping TOC @ 0x%08x (4KB)\n", POPLAR_SMEM_TOC_PA);
+	toc = ml_io_map(POPLAR_SMEM_TOC_PA, 0x1000);
+	if (!toc) {
+		printf("WIFI PROBE: [SMEM] FAILED: ml_io_map returned NULL\n");
+		return;
+	}
+
+	magic = probe_rd32(toc, 0);
+	ver = probe_rd32(toc, 4);
+	num_entries = probe_rd32(toc, 8);
+	max_entries = probe_rd32(toc, 12);
+
+	if (magic != 0x434f5424) { /* "$TOC" */
+		printf("WIFI PROBE: [SMEM] invalid magic 0x%08x (expected '$TOC')\n", magic);
+		return;
+	}
+
+	printf("WIFI PROBE: [SMEM] valid $TOC ver=%u entries=%u max=%u\n", ver, num_entries, max_entries);
+
+	/* Bound scan by mapped 4KB page: 32 bytes header + 48 bytes per entry */
+	max_safe_entries = (0x1000u - 32u) / 48u; /* 84 entries max */
+	if (max_entries > 0 && num_entries > max_entries) {
+		num_entries = max_entries;
+	}
+	if (num_entries > max_safe_entries) {
+		num_entries = max_safe_entries;
+	}
+
+	for (i = 0; i < num_entries; i++) {
+		uint32_t e_off = 32u + i * 48u;
+		uint32_t off = probe_rd32(toc, e_off);
+		uint32_t size = probe_rd32(toc, e_off + 4);
+		uint32_t flags = probe_rd32(toc, e_off + 8);
+		uint32_t hosts = probe_rd32(toc, e_off + 12);
+		uint16_t h0 = (uint16_t)hosts;
+		uint16_t h1 = (uint16_t)(hosts >> 16);
+		bool in_bounds, is_global, is_apps;
+
+		/* Explicitly classify empty vs malformed vs valid entries */
+		if (off == 0 && size == 0) {
+			printf("WIFI PROBE: [SMEM] p[%02u] [EMPTY] off=0x00000 sz=0KB (unallocated entry)\n", i);
+			continue;
+		}
+		if (size == 0) {
+			printf("WIFI PROBE: [SMEM] p[%02u] [MALFORMED-ZERO-SIZE] off=0x%05x sz=0KB fl=0x%x\n",
+			    i, off, flags);
+			continue;
+		}
+
+		/* Overflow-safe range check within 2MB SMEM region */
+		in_bounds = (size <= 0x200000u && off <= 0x200000u - size);
+		if (!in_bounds) {
+			printf("WIFI PROBE: [SMEM] p[%02u] [OUT-OF-BOUNDS] off=0x%08x sz=%u fl=0x%x\n",
+			    i, off, size, flags);
+			continue;
+		}
+
+		/*
+		 * Qualcomm SMEM Host IDs: Global = 0, APPS = 1, Modem = 2, ADSP = 3.
+		 * Partitions not including APPS (h0!=1 && h1!=1 && not global) are
+		 * access-protected by the XPU MPU. Reading their payloads causes a bus hang.
+		 */
+		is_global = (h0 == 0 && h1 == 0);
+		is_apps = (h0 == 1 || h1 == 1);
+		printf("WIFI PROBE: [SMEM] p[%02u] off=0x%05x sz=%uKB fl=0x%x h=%u:%u %s\n",
+			i, off, size / 1024u, flags, h0, h1,
+			(is_global || is_apps) ? "APPS-accessible" : "XPU-restricted");
+	}
+}
+
+/*
+ * --- 2. SMMU ANOC2 Probe ---
+ * Reads ARM SMMUv2 capability registers (IDR0, IDR1, IDR2, sCR0).
+ * Decodes all control bits (CLIENTPD, USFCFG, SMCFCFG, GFRE, GFIE, GCFGFRE).
+ * Reads SMMU Global Fault Status and Syndrome registers (sGFSR, sGFSYNR0..2).
+ * Dumps all implemented SMR and S2CR entries bounded by hardware and mapping.
+ */
+static void
+probe_smmu(void)
+{
+	vm_offset_t smmu;
+	uint32_t scr0, idr0, idr1, idr2;
+	uint32_t gfsr, gfsynr0, gfsynr1, gfsynr2;
+	uint32_t num_smr, num_cb, num_s2cb, num_sidb, max_smr_mapped;
+	bool s1ts, s2ts, nts, sms, smcd;
+	bool clientpd, gfre, gfie, gcfgfre, smcfcfg, usfcfg;
+	uint32_t matched_1900, matched_1901, i;
+
+	printf("WIFI PROBE: [SMMU] mapping ANOC2 @ 0x%08x (16KB window)\n", POPLAR_SMMU_ANOC2_PA);
+	smmu = ml_io_map(POPLAR_SMMU_ANOC2_PA, POPLAR_SMMU_ANOC2_SIZE);
+	if (!smmu) {
+		printf("WIFI PROBE: [SMMU] FAILED: ml_io_map returned NULL\n");
+		return;
+	}
+
+	scr0 = probe_rd32(smmu, ARM_SMMU_GR0_sCR0);
+	idr0 = probe_rd32(smmu, ARM_SMMU_GR0_IDR0);
+	idr1 = probe_rd32(smmu, ARM_SMMU_GR0_IDR1);
+	idr2 = probe_rd32(smmu, ARM_SMMU_GR0_IDR2);
+
+	gfsr = probe_rd32(smmu, ARM_SMMU_GR0_sGFSR);
+	gfsynr0 = probe_rd32(smmu, ARM_SMMU_GR0_sGFSYNR0);
+	gfsynr1 = probe_rd32(smmu, ARM_SMMU_GR0_sGFSYNR1);
+	gfsynr2 = probe_rd32(smmu, ARM_SMMU_GR0_sGFSYNR2);
+
+	clientpd = (scr0 & (1u << 0)) != 0;
+	gfre     = (scr0 & (1u << 1)) != 0;
+	gfie     = (scr0 & (1u << 2)) != 0;
+	gcfgfre  = (scr0 & (1u << 5)) != 0;
+	smcfcfg  = (scr0 & (1u << 9)) != 0;
+	usfcfg   = (scr0 & (1u << 10)) != 0;
+
+	sms = (idr0 & SMMU_IDR0_SMS) != 0;
+	num_smr = idr0 & SMMU_IDR0_NUMSMRG_MASK;
+	num_sidb = (idr0 >> SMMU_IDR0_NUMSIDB_SHIFT) & SMMU_IDR0_NUMSIDB_MASK;
+	s1ts = (idr0 & SMMU_IDR0_S1TS) != 0;
+	s2ts = (idr0 & SMMU_IDR0_S2TS) != 0;
+	nts = (idr0 & SMMU_IDR0_NTS) != 0;
+
+	num_cb = idr1 & SMMU_IDR1_NUMCB_MASK;
+	smcd = (idr1 & SMMU_IDR1_SMCD) != 0;
+	num_s2cb = (idr1 >> SMMU_IDR1_NUMS2CB_SHIFT) & SMMU_IDR1_NUMS2CB_MASK;
+
+	printf("WIFI PROBE: [SMMU] sCR0=0x%08x -> CLIENTPD=%u GFRE=%u GFIE=%u GCFGFRE=%u SMCFCFG=%u USFCFG=%u\n",
+	    scr0, clientpd, gfre, gfie, gcfgfre, smcfcfg, usfcfg);
+	printf("WIFI PROBE: [SMMU] IDR0=0x%08x -> NUMSMRG=%u SIDB=%u SMS=%u S1TS=%u S2TS=%u NTS=%u BTM=%u CTTW=%u\n",
+	    idr0, num_smr, num_sidb, sms, s1ts, s2ts, nts, (idr0 >> 13) & 1u, (idr0 >> 14) & 1u);
+	printf("WIFI PROBE: [SMMU] IDR1=0x%08x -> NUMCB=%u SMCD=%u NUMS2CB=%u (raw=0x%02x, %s) NUMPAGENDXB=%u PAGESIZE=%s\n",
+	    idr1, num_cb, smcd, num_s2cb, (idr1 >> 16) & 0xffu, s2ts ? "active" : "N/A (S2TS=0)",
+	    (idr1 >> 28) & 7u, (idr1 & (1u << 31)) ? "64KB" : "4KB");
+	printf("WIFI PROBE: [SMMU] IDR2=0x%08x -> IAS=%u OAS=%u\n",
+	    idr2, idr2 & 0xfu, (idr2 >> 4) & 0xfu);
+	printf("WIFI PROBE: [SMMU] sampled sGFSR=0x%08x (USF=%u SMCF=%u MULTI=%u) sGFSYNR0=0x%08x sGFSYNR1=0x%08x (fault_SID=0x%04x) sGFSYNR2=0x%08x\n",
+	    gfsr, (gfsr >> 1) & 1u, (gfsr >> 2) & 1u, (gfsr >> 31) & 1u,
+	    gfsynr0, gfsynr1, gfsynr1 & 0x7fffu, gfsynr2);
+
+	if (!sms) {
+		printf("WIFI PROBE: [SMMU] SMS=0: SMMU operates in Stream Indexing mode (linear S2CR table)\n");
+		return;
+	}
+
+	/* Double-bound scan by hardware limit and mapped 16KB window */
+	if (num_smr > 128u) {
+		num_smr = 128u;
+	}
+	max_smr_mapped = (POPLAR_SMMU_ANOC2_SIZE > ARM_SMMU_GR0_S2CR_BASE) ?
+	    (POPLAR_SMMU_ANOC2_SIZE - ARM_SMMU_GR0_S2CR_BASE) / 4u : 0u;
+	if (num_smr > max_smr_mapped) {
+		num_smr = max_smr_mapped;
+	}
+
+	printf("WIFI PROBE: [SMMU] dumping all %u SMR / S2CR register pairs:\n", num_smr);
+	matched_1900 = 0;
+	matched_1901 = 0;
+	for (i = 0; i < num_smr; i++) {
+		uint32_t smr_off = ARM_SMMU_GR0_SMR_BASE + i * 4u;
+		uint32_t s2cr_off = ARM_SMMU_GR0_S2CR_BASE + i * 4u;
+		uint32_t smr, s2cr, mask, sid, type, cbndx;
+		bool valid, match_1900, match_1901;
+		const char *type_str;
+
+		/* Explicit per-entry bounds check against mapped window */
+		if (smr_off + 4u > POPLAR_SMMU_ANOC2_SIZE || s2cr_off + 4u > POPLAR_SMMU_ANOC2_SIZE) {
+			printf("WIFI PROBE: [SMMU] SMR[%02u] offset exceeds mapped window, stopping dump\n", i);
+			break;
+		}
+
+		smr = probe_rd32(smmu, smr_off);
+		s2cr = probe_rd32(smmu, s2cr_off);
+		valid = (smr & SMMU_SMR_VALID) != 0;
+		mask = (smr >> SMMU_SMR_MASK_SHIFT) & SMMU_SMR_MASK_MASK;
+		sid = smr & SMMU_SMR_ID_MASK;
+		type = (s2cr >> SMMU_S2CR_TYPE_SHIFT) & SMMU_S2CR_TYPE_MASK;
+		cbndx = s2cr & SMMU_S2CR_CBNDX_MASK;
+		type_str = (type == 1) ? "BYPASS" : (type == 0) ? "TRANS" : (type == 2) ? "FAULT" : "RSVD";
+
+		/* ARM SMMUv2 stream matching rule: ((StreamID ^ sid) & ~mask) == 0 */
+		match_1900 = valid && (((WLAN_STREAM_ID_PRIMARY ^ sid) & ~mask) == 0);
+		match_1901 = valid && (((WLAN_STREAM_ID_SECONDARY ^ sid) & ~mask) == 0);
+
+		printf("WIFI PROBE: [SMMU] SMR[%02u]: valid=%u ID=0x%04x mask=0x%04x -> S2CR: %s (type=%u cb=%u)%s%s\n",
+		    i, valid, sid, mask, type_str, type, cbndx,
+		    match_1900 ? " [MATCH 0x1900]" : "",
+		    match_1901 ? " [MATCH 0x1901]" : "");
+
+		if (match_1900) {
+			matched_1900++;
+		}
+		if (match_1901) {
+			matched_1901++;
+		}
+	}
+
+	printf("WIFI PROBE: [SMMU] RESULT: StreamID 0x1900 (primary): %u match(es), StreamID 0x1901 (secondary): %u match(es)\n",
+	    matched_1900, matched_1901);
+	if (matched_1900 == 0 && matched_1901 == 0) {
+		printf("WIFI PROBE: [SMMU] RESULT: Neither WLAN StreamID has an SMR route. Under USFCFG=1, transactions will raise USF aborts.\n");
+	}
+
+	/* Stage 3D Sub-Phase 3D.2: SMMU Stream Routing Preparation (WCSS Held in Reset) */
+	int sweetwifi = 0;
+	(void)PE_parse_boot_argn("sweetwifi", &sweetwifi, sizeof(sweetwifi));
+	if (sweetwifi >= 1) {
+		int slot_ce = -1, slot_msa = -1;
+		uint32_t smr_ce, s2cr_ce, smr_msa, s2cr_msa;
+		uint32_t post_gfsr;
+		int rollback_test = 0;
+
+		printf("\nWIFI PROBE: [3D.2] === SUB-PHASE 3D.2: SMMU STREAM ROUTING PREPARATION ===\n");
+		printf("WIFI PROBE: [3D.2] Gate: sweetwifi=%d authorized for SMMU preparation (WCSS held in reset).\n", sweetwifi);
+		printf("WIFI PROBE: [3D.2] Safety constraint: WCSS unpowered and held in reset; zero rail/clock/MMIO changes.\n");
+
+		/* Find 2 candidate invalid SMR slots */
+		for (i = 0; i < num_smr; i++) {
+			uint32_t smr_off = ARM_SMMU_GR0_SMR_BASE + i * 4u;
+			uint32_t smr_val = probe_rd32(smmu, smr_off);
+			if ((smr_val & SMMU_SMR_VALID) == 0) {
+				if (slot_ce < 0) {
+					slot_ce = (int)i;
+				} else if (slot_msa < 0) {
+					slot_msa = (int)i;
+					break;
+				}
+			}
+		}
+
+		if (slot_ce < 0 || slot_msa < 0) {
+			printf("WIFI PROBE: [3D.2] FAILED: unable to find 2 free SMR slots\n");
+			return;
+		}
+
+		printf("WIFI PROBE: [3D.2] Selected candidate SMR slots: CE=SMR[%02d], MSA=SMR[%02d]\n", slot_ce, slot_msa);
+
+		/*
+		 * Programming sequence per ARM SMMUv2 architecture (ARM IHI 0062D):
+		 * 1. Set S2CR to FAULT (TYPE=2, CBNDX=0xff) to ensure no transient invalid translation.
+		 * 2. Set SMR with VALID=1, MASK=0x0000, ID=StreamID.
+		 * 3. Set S2CR to BYPASS (TYPE=1, CBNDX=0) or Context Bank translation.
+		 */
+		/* Primary StreamID: 0x1900 (Copy Engine Data Path) */
+		probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_ce * 4u, (2u << 16) | 0xffu);
+		probe_wr32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_ce * 4u,
+		    SMMU_SMR_VALID | (0x0000u << 16) | WLAN_STREAM_ID_PRIMARY);
+		probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_ce * 4u, (1u << 16));
+
+		/* Secondary StreamID: 0x1901 (Firmware / MSA Path) */
+		probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_msa * 4u, (2u << 16) | 0xffu);
+		probe_wr32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_msa * 4u,
+		    SMMU_SMR_VALID | (0x0000u << 16) | WLAN_STREAM_ID_SECONDARY);
+		probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_msa * 4u, (1u << 16));
+
+		/* Read-back verification */
+		smr_ce = probe_rd32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_ce * 4u);
+		s2cr_ce = probe_rd32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_ce * 4u);
+		smr_msa = probe_rd32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_msa * 4u);
+		s2cr_msa = probe_rd32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_msa * 4u);
+
+		printf("WIFI PROBE: [3D.2] Verified CE  SMR[%02d]=0x%08x (valid=%u ID=0x%04x) -> S2CR=0x%08x (type=%u: %s)\n",
+		    slot_ce, smr_ce, (smr_ce >> 31) & 1u, smr_ce & 0x7fffu,
+		    s2cr_ce, (s2cr_ce >> 16) & 3u, ((s2cr_ce >> 16) & 3u) == 1 ? "BYPASS" : "OTHER");
+		printf("WIFI PROBE: [3D.2] Verified MSA SMR[%02d]=0x%08x (valid=%u ID=0x%04x) -> S2CR=0x%08x (type=%u: %s)\n",
+		    slot_msa, smr_msa, (smr_msa >> 31) & 1u, smr_msa & 0x7fffu,
+		    s2cr_msa, (s2cr_msa >> 16) & 3u, ((s2cr_msa >> 16) & 3u) == 1 ? "BYPASS" : "OTHER");
+
+		/* Audit Global Fault Status Register */
+		post_gfsr = probe_rd32(smmu, ARM_SMMU_GR0_sGFSR);
+		printf("WIFI PROBE: [3D.2] Post-config sGFSR=0x%08x (USF=%u SMCF=%u MULTI=%u) -> %s\n",
+		    post_gfsr, (post_gfsr >> 1) & 1u, (post_gfsr >> 2) & 1u, (post_gfsr >> 31) & 1u,
+		    post_gfsr == 0 ? "CLEAN (zero SMMU faults)" : "FAULT DETECTED");
+
+		/* Rollback test check */
+		(void)PE_parse_boot_argn("smmu_rollback", &rollback_test, sizeof(rollback_test));
+		if (rollback_test == 1) {
+			printf("WIFI PROBE: [3D.2] smmu_rollback=1 requested: testing teardown sequence...\n");
+			probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_ce * 4u, (2u << 16) | 0xffu);
+			probe_wr32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_ce * 4u, 0);
+			probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_msa * 4u, (2u << 16) | 0xffu);
+			probe_wr32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_msa * 4u, 0);
+			printf("WIFI PROBE: [3D.2] Rollback complete: SMR[%02d] and SMR[%02d] restored to valid=0 / FAULT\n",
+			    slot_ce, slot_msa);
+		} else {
+			printf("WIFI PROBE: [3D.2] Stream routes remain active in BYPASS mode (WCSS dormant in reset).\n");
+		}
+		printf("WIFI PROBE: [3D.2] SMMU stream routing preparation successfully completed.\n\n");
+	} else {
+		printf("WIFI PROBE: [3D.2] sweetwifi=0 (default): Sub-Phase 3D.2 SMMU programming skipped (dormant).\n");
+	}
+}
+
+/*
+ * --- 3. PM8998 GPIO3 SPMI Arbiter Probe ---
+ * Inspects SPMI v3 Arbiter APID mapping registers in CORE and CNFG space.
+ * 100% PASSIVE READ-ONLY MMIO:
+ * Active observer command transactions have been completely removed
+ * to eliminate any risk of unverified writes or SPMI arbiter collision.
+ */
+static void
+probe_pm8998_gpio3(void)
+{
+	vm_offset_t core, cnfg;
+	uint32_t arb_ver, map_base, owner;
+	uint16_t target_ppid, found_apid;
+	uint32_t i;
+
+	printf("WIFI PROBE: [SPMI] mapping SPMI CORE @ 0x%08x & CNFG @ 0x%08x (read-only)\n",
+	    POPLAR_SPMI_CORE_PA, POPLAR_SPMI_CNFG_PA);
+
+	core = ml_io_map(POPLAR_SPMI_CORE_PA, 0x1000);
+	cnfg = ml_io_map(POPLAR_SPMI_CNFG_PA, 0x3000);
+	if (!core || !cnfg) {
+		printf("WIFI PROBE: [SPMI] FAILED: ml_io_map failed for CORE or CNFG\n");
+		return;
+	}
+
+	arb_ver = probe_rd32(core, 0x00);
+	printf("WIFI PROBE: [SPMI] Arbiter HW version: 0x%08x (%s)\n",
+	    arb_ver, (arb_ver < 0x50000000u) ? "v2/v3 (MSM8998)" : "v5 (SM7150+)");
+
+	/* On SPMI v3, APID mapping table is at CORE + 0x800, ownership at CNFG + 0x700 */
+	map_base = (arb_ver >= 0x50000000u) ? 0x900u : SPMI_V3_MAP_BASE;
+	target_ppid = PM8998_GPIO3_PPID; /* 0x00c2 */
+	found_apid = 0xffffu;
+	owner = 0xffffffffu;
+
+	for (i = 0; i < 512u; i++) {
+		uint32_t entry = probe_rd32(core, map_base + i * 4u);
+		if (entry != 0 && ((entry >> 8) & 0xfffu) == target_ppid) {
+			found_apid = (uint16_t)i;
+			owner = probe_rd32(cnfg, SPMI_V3_OWNER_BASE + i * 4u) & 7u;
+			break;
+		}
+	}
+
+	if (found_apid == 0xffffu) {
+		printf("WIFI PROBE: [SPMI] PM8998 GPIO3 (PPID 0x00c2) has no APID assigned in SPMI table\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [SPMI] PM8998 GPIO3 (PPID 0x00c2) mapped to APID %u (owner EE=%u: %s)\n",
+	    found_apid, owner, (owner == 0) ? "APPS" : "OTHER/SECURE");
+	printf("WIFI PROBE: [SPMI] active command transactions completely removed (100%% passive diagnostic)\n");
+}
+
+/*
+ * --- 4. RPM GLINK Message RAM Header & Ring Buffer Decoder ---
+ * Reads TOC at 0x00778000 + 0x7000 - 256 using probe_rd32().
+ * Stage 3D Sub-Phase 3D.3a: Decodes pre-existing ABL GLINK communication
+ * from the r2pa and pa2r ring buffers in Message RAM.
+ * Stage 3D Sub-Phase 3D.3b: Exercises controlled PM8998 voltage / clock inquiry
+ * with immediate reverse-order rollback when sweetwifi_rails=1 is passed.
+ */
+
+static void
+decode_glink_ring(vm_offset_t ram, uint32_t off, uint32_t sz, const char *tag)
+{
+	uint32_t head, tail, fifo_base, fifo_len;
+	uint32_t dump_len, w, pos;
+	unsigned int msg_idx = 0;
+
+	if (off >= 0x7000u || sz < 8u || sz > 0x7000u - off) {
+		printf("WIFI PROBE: [RPM-GLINK] %s: invalid ring bounds off=0x%04x sz=%u\n",
+		    tag, off, sz);
+		return;
+	}
+
+	head = probe_rd32(ram, off);
+	tail = probe_rd32(ram, off + 4u);
+	fifo_base = off + 8u;
+	fifo_len = sz - 8u;
+
+	printf("\nWIFI PROBE: [RPM-GLINK] === Decoding %s Ring (off=0x%04x, sz=%u) ===\n",
+	    tag, off, sz);
+	printf("WIFI PROBE: [RPM-GLINK]   Indices: head=%u (0x%x), tail=%u (0x%x), fifo_len=%u\n",
+	    head, head, tail, tail, fifo_len);
+
+	/* 1. Raw Hex Dump (first min(head, 256) bytes or 64 bytes if head==0) */
+	dump_len = head;
+	if (dump_len > 256u) {
+		dump_len = 256u;
+	}
+	if (dump_len == 0 && fifo_len >= 64u) {
+		dump_len = 64u;
+	}
+
+	printf("WIFI PROBE: [RPM-GLINK]   Raw FIFO Dump (first %u bytes):\n", dump_len);
+	for (w = 0; w < dump_len; w += 16u) {
+		uint32_t d0 = (w + 0u < fifo_len) ? probe_rd32(ram, fifo_base + w) : 0;
+		uint32_t d1 = (w + 4u < fifo_len) ? probe_rd32(ram, fifo_base + w + 4u) : 0;
+		uint32_t d2 = (w + 8u < fifo_len) ? probe_rd32(ram, fifo_base + w + 8u) : 0;
+		uint32_t d3 = (w + 12u < fifo_len) ? probe_rd32(ram, fifo_base + w + 12u) : 0;
+		printf("WIFI PROBE: [RPM-GLINK]     [+0x%03x] %08x %08x %08x %08x\n",
+		    w, d0, d1, d2, d3);
+	}
+
+	/* 2. Structured GLINK Command Walk */
+	pos = 0;
+	while (pos + 8u <= head && pos + 8u <= fifo_len && msg_idx < 32u) {
+		uint32_t w0 = probe_rd32(ram, fifo_base + pos);
+		uint32_t w1 = probe_rd32(ram, fifo_base + pos + 4u);
+		uint16_t cmd = (uint16_t)(w0 & 0xffffu);
+		uint16_t p1 = (uint16_t)((w0 >> 16) & 0xffffu);
+		uint32_t p2 = w1;
+		uint32_t pkt_len = 8u;
+
+		msg_idx++;
+
+		switch (cmd) {
+		case GLINK_CMD_VERSION:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_VERSION ver=%u feat=0x%08x\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_VERSION_ACK:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_VERSION_ACK ver=%u feat=0x%08x\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_OPEN: {
+			uint16_t lcid = p1;
+			uint32_t nlen = p2;
+			char chname[32] = {0};
+			uint32_t k;
+			for (k = 0; k < nlen && k < sizeof(chname) - 1; k += 4u) {
+				uint32_t nw = probe_rd32(ram, fifo_base + pos + 8u + k);
+				chname[k] = (char)(nw & 0xff);
+				if (k + 1 < sizeof(chname) - 1) chname[k + 1] = (char)((nw >> 8) & 0xff);
+				if (k + 2 < sizeof(chname) - 1) chname[k + 2] = (char)((nw >> 16) & 0xff);
+				if (k + 3 < sizeof(chname) - 1) chname[k + 3] = (char)((nw >> 24) & 0xff);
+			}
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_OPEN lcid=%u name='%s'\n",
+			    tag, pos, lcid, chname);
+			pkt_len = 8u + ((nlen + 7u) & ~7u);
+			break;
+		}
+		case GLINK_CMD_CLOSE:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_CLOSE lcid=%u reason=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_OPEN_ACK:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_OPEN_ACK lcid=%u rcid=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_INTENT:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_INTENT lcid=%u count=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u + p2 * 8u;
+			break;
+		case GLINK_CMD_RX_DONE:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_RX_DONE lcid=%u riid=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_RX_INTENT_REQ:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_RX_INTENT_REQ lcid=%u size=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_RX_INTENT_REQ_ACK:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_RX_INTENT_REQ_ACK lcid=%u granted=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_TX_DATA: {
+			uint16_t lcid = p1;
+			uint32_t riid = p2;
+			uint32_t chunk = probe_rd32(ram, fifo_base + pos + 8u);
+			uint32_t left = probe_rd32(ram, fifo_base + pos + 12u);
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_TX_DATA lcid=%u riid=%u chunk=%u left=%u\n",
+			    tag, pos, lcid, riid, chunk, left);
+			if (chunk >= 16u && pos + 16u + chunk <= fifo_len) {
+				uint32_t svc = probe_rd32(ram, fifo_base + pos + 16u);
+				uint32_t req_id = probe_rd32(ram, fifo_base + pos + 20u);
+				uint32_t ver = probe_rd32(ram, fifo_base + pos + 24u);
+				uint32_t rlen = probe_rd32(ram, fifo_base + pos + 28u);
+				printf("WIFI PROBE: [RPM-SMD]     hdr: svc=%u req_id=%u ver=%u len=%u\n",
+				    svc, req_id, ver, rlen);
+				if (rlen >= 12u && pos + 32u + rlen <= fifo_len) {
+					uint32_t rtype = probe_rd32(ram, fifo_base + pos + 32u);
+					uint32_t rid = probe_rd32(ram, fifo_base + pos + 36u);
+					uint32_t dlen = probe_rd32(ram, fifo_base + pos + 40u);
+					char rt_str[5];
+					rt_str[0] = (char)(rtype & 0xff);
+					rt_str[1] = (char)((rtype >> 8) & 0xff);
+					rt_str[2] = (char)((rtype >> 16) & 0xff);
+					rt_str[3] = (char)((rtype >> 24) & 0xff);
+					rt_str[4] = 0;
+					printf("WIFI PROBE: [RPM-SMD]     rsc='%s' (0x%08x) id=%u dlen=%u\n",
+					    rt_str, rtype, rid, dlen);
+					if (dlen >= 12u && pos + 44u + dlen <= fifo_len) {
+						uint32_t kvp_k = probe_rd32(ram, fifo_base + pos + 44u);
+						uint32_t kvp_n = probe_rd32(ram, fifo_base + pos + 48u);
+						uint32_t kvp_v = probe_rd32(ram, fifo_base + pos + 52u);
+						char k_str[5];
+						k_str[0] = (char)(kvp_k & 0xff);
+						k_str[1] = (char)((kvp_k >> 8) & 0xff);
+						k_str[2] = (char)((kvp_k >> 16) & 0xff);
+						k_str[3] = (char)((kvp_k >> 24) & 0xff);
+						k_str[4] = 0;
+						printf("WIFI PROBE: [RPM-SMD]       kvp[0]: key='%s' (0x%08x) nbytes=%u val=%u (0x%x)\n",
+						    k_str, kvp_k, kvp_n, kvp_v, kvp_v);
+					}
+				}
+			}
+			pkt_len = 16u + ((chunk + 7u) & ~7u);
+			break;
+		}
+		case GLINK_CMD_CLOSE_ACK:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_CLOSE_ACK lcid=%u\n",
+			    tag, pos, p1);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_SIGNALS:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_SIGNALS lcid=%u sig=0x%08x\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		default:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: unknown cmd=%u (0x%04x) p1=%u p2=0x%08x\n",
+			    tag, pos, cmd, cmd, p1, p2);
+			pkt_len = 8u;
+			break;
+		}
+
+		if (pkt_len < 8u || pkt_len > fifo_len - pos) {
+			break;
+		}
+		pos += pkt_len;
+	}
+}
+
+/*
+ * Sub-Phase 3D.4: WCSS Reset De-assertion, Power/Clock Activation & MMIO Read Inquiry
+ * Gated strictly behind boot-args:
+ *   sweetwifi_rails=1: Enables PM8998 LDOs & RF_CLK2 via RPM GLINK with immediate rollback.
+ *   sweetwifi_mmio=1:  Allows guarded MMIO read of WCSS aperture (0x18800000) while powered.
+ */
+static void
+probe_rpm_rail_inquiry(vm_offset_t ram)
+{
+	(void)ram;
+	int sweetwifi_rails = 0;
+	int sweetwifi_mmio = 0;
+	(void)PE_parse_boot_argn("sweetwifi_rails", &sweetwifi_rails, sizeof(sweetwifi_rails));
+	(void)PE_parse_boot_argn("sweetwifi_mmio", &sweetwifi_mmio, sizeof(sweetwifi_mmio));
+
+	printf("\nWIFI PROBE: [3D.4] === SUB-PHASE 3D.4: WCSS POWER/CLOCK & MMIO INQUIRY ===\n");
+
+	if (sweetwifi_rails <= 0) {
+		printf("WIFI PROBE: [3D.4] Gate: sweetwifi_rails=0 (dormant default).\n");
+		printf("WIFI PROBE: [3D.4] Zero PM8998 regulator / clock votes issued (WCSS strictly unpowered).\n\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [3D.4] Gate: sweetwifi_rails=1 ACTIVE. Initiating monotonic bringup...\n");
+	printf("WIFI PROBE: [3D.4] Monotonic bringup sequence:\n");
+
+	/* 1. PM8998 LDO5A (0.80V) -> vdd-0.8-cx-mx */
+	bool ok_l5 = poplar_rpm_ldoa(5, 800000u);
+	printf("WIFI PROBE: [3D.4]   1. PM8998 LDO5A  (0.80V,  800000 uV) -> %s\n", ok_l5 ? "ACK OK" : "FAILED");
+
+	/* 2. PM8998 LDO7A (1.80V) -> vdd-1.8-xo */
+	bool ok_l7 = poplar_rpm_ldoa(7, 1800000u);
+	printf("WIFI PROBE: [3D.4]   2. PM8998 LDO7A  (1.80V, 1800000 uV) -> %s\n", ok_l7 ? "ACK OK" : "FAILED");
+
+	/* 3. PM8998 LDO17A (1.304V) -> vdd-1.3-rfa */
+	bool ok_l17 = poplar_rpm_ldoa(17, 1304000u);
+	printf("WIFI PROBE: [3D.4]   3. PM8998 LDO17A (1.304V, 1304000 uV) -> %s\n", ok_l17 ? "ACK OK" : "FAILED");
+
+	/* 4. PM8998 LDO25A (3.30V) -> vdd-3.3-ch0 */
+	bool ok_l25 = poplar_rpm_ldoa(25, 3300000u);
+	printf("WIFI PROBE: [3D.4]   4. PM8998 LDO25A (3.30V, 3300000 uV) -> %s\n", ok_l25 ? "ACK OK" : "FAILED");
+
+	/* 5. PM8998 RF_CLK2 (19.2MHz) -> cxo_ref_clk_pin */
+	bool ok_clk = poplar_rpm_clka(5, 1u);
+	printf("WIFI PROBE: [3D.4]   5. PM8998 RF_CLK2 (19.2MHz XO buf)   -> %s\n", ok_clk ? "ACK OK" : "FAILED");
+
+	printf("WIFI PROBE: [3D.4] Monotonic bringup status: L5=%d L7=%d L17=%d L25=%d CLK=%d\n",
+	    ok_l5, ok_l7, ok_l17, ok_l25, ok_clk);
+
+	/* 5ms voltage/clock stabilization delay */
+	delay(5000);
+
+	/* Controlled WCSS MMIO Inquiry */
+	if (sweetwifi_mmio >= 1) {
+		printf("WIFI PROBE: [3D.4] Gate: sweetwifi_mmio=1 ACTIVE. Probing WCSS MMIO (4KB page mappings)...\n");
+
+		vm_offset_t wcss_top = ml_io_map(POPLAR_WCSS_PA, POPLAR_WCSS_PAGE_SZ);
+		if (!wcss_top) {
+			printf("WIFI PROBE: [3D.4] FAILED: ml_io_map failed for WCSS top-level @ 0x%08x\n", POPLAR_WCSS_PA);
+		} else {
+			uint32_t top_val = probe_rd32(wcss_top, 0x00);
+			printf("WIFI PROBE: [3D.4] WCSS +0x00000000 (Top-Level ID) = 0x%08x\n", top_val);
+		}
+
+		vm_offset_t wcss_ce0 = ml_io_map(POPLAR_WCSS_CE0_PAGE_PA, POPLAR_WCSS_PAGE_SZ);
+		if (!wcss_ce0) {
+			printf("WIFI PROBE: [3D.4] FAILED: ml_io_map failed for WCSS CE0 @ 0x%08x\n", POPLAR_WCSS_CE0_PAGE_PA);
+		} else {
+			uint32_t ce0_val = probe_rd32(wcss_ce0, POPLAR_WCSS_CE0_PAGE_OFF);
+			printf("WIFI PROBE: [3D.4] WCSS +0x00057400 (CE0 Base Reg) = 0x%08x\n", ce0_val);
+		}
+	} else {
+		printf("WIFI PROBE: [3D.4] sweetwifi_mmio=0 (default): MMIO access held dormant. Rails verified live.\n");
+	}
+
+	/* Immediate Orderly Reverse Rollback */
+	printf("WIFI PROBE: [3D.4] Initiating immediate reverse rollback (teardown)...\n");
+
+	bool rb_clk = poplar_rpm_clka(5, 0u);
+	printf("WIFI PROBE: [3D.4]   Teardown 1. RF_CLK2  (disable) -> %s\n", rb_clk ? "ACK OK" : "FAILED");
+
+	bool rb_l25 = poplar_rpm_ldoa(25, 0u);
+	printf("WIFI PROBE: [3D.4]   Teardown 2. LDO25A   (disable) -> %s\n", rb_l25 ? "ACK OK" : "FAILED");
+
+	bool rb_l17 = poplar_rpm_ldoa(17, 0u);
+	printf("WIFI PROBE: [3D.4]   Teardown 3. LDO17A   (disable) -> %s\n", rb_l17 ? "ACK OK" : "FAILED");
+
+	bool rb_l7 = poplar_rpm_ldoa(7, 0u);
+	printf("WIFI PROBE: [3D.4]   Teardown 4. LDO7A    (disable) -> %s\n", rb_l7 ? "ACK OK" : "FAILED");
+
+	bool rb_l5 = poplar_rpm_ldoa(5, 0u);
+	printf("WIFI PROBE: [3D.4]   Teardown 5. LDO5A    (disable) -> %s\n", rb_l5 ? "ACK OK" : "FAILED");
+
+	printf("WIFI PROBE: [3D.4] Reverse rollback complete: CLK=%d L25=%d L17=%d L7=%d L5=%d\n",
+	    rb_clk, rb_l25, rb_l17, rb_l7, rb_l5);
+	printf("WIFI PROBE: [3D.4] Hardware safely returned to dormant state.\n\n");
+}
+
+static void
+probe_rpm_msgram(void)
+{
+	vm_offset_t ram;
+	uint32_t magic, count, i;
+	uint32_t r2pa_off = 0, r2pa_sz = 0;
+	uint32_t pa2r_off = 0, pa2r_sz = 0;
+
+	printf("WIFI PROBE: [RPM] inspecting Message RAM @ 0x%08x (28KB)\n", POPLAR_RPM_MSGRAM_PA);
+	ram = ml_io_map(POPLAR_RPM_MSGRAM_PA, 0x7000);
+	if (!ram) {
+		printf("WIFI PROBE: [RPM] FAILED: ml_io_map returned NULL\n");
+		return;
+	}
+
+	magic = probe_rd32(ram, RPM_TOC_OFFSET);
+	count = probe_rd32(ram, RPM_TOC_OFFSET + 4u);
+
+	if (magic != RPM_TOC_MAGIC) { /* "grt0" */
+		printf("WIFI PROBE: [RPM] invalid TOC magic 0x%08x (expected 'grt0')\n", magic);
+		return;
+	}
+
+	printf("WIFI PROBE: [RPM] valid TOC magic 'grt0' entry_count=%u\n", count);
+
+	/* Cap count to available 256-byte TOC window: (256 - 8) / 12 = 20 entries max */
+	if (count > 20u) {
+		count = 20u;
+	}
+
+	for (i = 0; i < count; i++) {
+		uint32_t e_off = RPM_TOC_OFFSET + 8u + i * 12u;
+		uint32_t id, off, size;
+		char id_str[5];
+
+		if (e_off + 12u > 0x7000u) {
+			printf("WIFI PROBE: [RPM] entry[%u] TOC entry header exceeds mapped RAM\n", i);
+			break;
+		}
+
+		id = probe_rd32(ram, e_off);
+		off = probe_rd32(ram, e_off + 4u);
+		size = probe_rd32(ram, e_off + 8u);
+
+		id_str[0] = (char)(id & 0xff);
+		id_str[1] = (char)((id >> 8) & 0xff);
+		id_str[2] = (char)((id >> 16) & 0xff);
+		id_str[3] = (char)((id >> 24) & 0xff);
+		id_str[4] = 0;
+
+		/* Overflow-safe bounds check within 28KB Message RAM */
+		if (off < 0x7000u && size >= 8u && size <= 0x7000u - off) {
+			uint32_t head = probe_rd32(ram, off);
+			uint32_t tail = probe_rd32(ram, off + 4u);
+			printf("WIFI PROBE: [RPM] entry[%u] '%s' off=0x%04x sz=%u head=%u tail=%u\n",
+			    i, id_str, off, size, head, tail);
+
+			if (id_str[0] == 'r' && id_str[1] == '2' && id_str[2] == 'p' && id_str[3] == 'a') {
+				r2pa_off = off;
+				r2pa_sz = size;
+			} else if (id_str[0] == 'p' && id_str[1] == 'a' && id_str[2] == '2' && id_str[3] == 'r') {
+				pa2r_off = off;
+				pa2r_sz = size;
+			}
+		} else {
+			printf("WIFI PROBE: [RPM] entry[%u] '%s' [INVALID/OUT-OF-BOUNDS] off=0x%04x sz=%u\n",
+			    i, id_str, off, size);
+		}
+	}
+
+	/* Stage 3D Sub-Phase 3D.3a: Decode pre-existing ABL GLINK communication */
+	if (r2pa_sz > 0) {
+		decode_glink_ring(ram, r2pa_off, r2pa_sz, "r2pa (RPM->APPS)");
+	}
+	if (pa2r_sz > 0) {
+		decode_glink_ring(ram, pa2r_off, pa2r_sz, "pa2r (APPS->RPM)");
+	}
+
+	/* Stage 3D Sub-Phase 3D.3b: Controlled Rail & Clock Enable Inquiry */
+	probe_rpm_rail_inquiry(ram);
+}
+
+/*
+ * --- 5. WLAN Device-Tree Inspection & Target Reference ---
+ * A. Live Apple Device Tree (ADT) Inspection:
+ *    Queries properties passed to XNU by the bootloader shim.
+ *    Validates /chosen/mac-address-wifi0 and checks for any attached WLAN node.
+ *
+ * B. Compile-Time Platform Reference Data (MSM8998 Stock DTB):
+ *    Documents verified target hardware parameters from /soc/qcom,icnss@18800000.
+ *    Crucially: Zero MMIO access to unclocked WCSS registers is performed.
+ */
+static void
+probe_wlan_device_tree(void)
+{
+	DTEntry node = NULL;
+	void const *prop = NULL;
+	unsigned int prop_size = 0;
+	int sweetwifi = 0;
+	unsigned int i = 0, count = 0;
+	const uint8_t *mac = NULL;
+	const uint64_t *reg64 = NULL;
+	const uint32_t *irqs = NULL;
+	const uint32_t *sids = NULL;
+	const uint32_t *msa = NULL;
+	uint64_t rel_addr = 0, size = 0, phys_base = 0;
+
+	/* 5A: Live Apple Device Tree inspection */
+	if (SecureDTLookupEntry(NULL, "/chosen", &node) == kSuccess) {
+		if (SecureDTGetProperty(node, "mac-address-wifi0", &prop, &prop_size) == kSuccess &&
+		    prop_size == 6) {
+			mac = (const uint8_t *)prop;
+			printf("WIFI PROBE: [ADT] live /chosen/mac-address-wifi0 = %02x:%02x:%02x:%02x:%02x:%02x\n",
+			    mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+		}
+	}
+
+	if (SecureDTLookupEntry(NULL, "/arm-io/wlan", &node) != kSuccess &&
+	    SecureDTLookupEntry(NULL, "/wlan", &node) != kSuccess) {
+		printf("WIFI PROBE: [ADT] live device-tree has no active WLAN node (WCN3990 driver unattached)\n");
+	} else {
+		printf("WIFI PROBE: [ADT] live device-tree contains /arm-io/wlan platform node\n");
+
+		/* Parse compatible */
+		if (SecureDTGetProperty(node, "compatible", &prop, &prop_size) == kSuccess && prop_size > 0) {
+			printf("WIFI PROBE: [ADT]   compatible = '%.*s'\n", (int)prop_size, (const char *)prop);
+		}
+
+		/* Parse reg: address is relative to arm-io SOC_BASE (0x01000000) */
+		if (SecureDTGetProperty(node, "reg", &prop, &prop_size) == kSuccess && prop_size >= 16) {
+			reg64 = (const uint64_t *)prop;
+			rel_addr = reg64[0];
+			size = reg64[1];
+			phys_base = rel_addr + 0x01000000u;
+			printf("WIFI PROBE: [ADT]   reg = <0x%llx 0x%llx> (rel) -> phys base 0x%llx size 0x%llx (8MB)\n",
+			    (unsigned long long)rel_addr, (unsigned long long)size,
+			    (unsigned long long)phys_base, (unsigned long long)size);
+		}
+
+		/* Parse Copy Engine interrupts */
+		if ((SecureDTGetProperty(node, "qcom,interrupts", &prop, &prop_size) == kSuccess ||
+		     SecureDTGetProperty(node, "interrupts", &prop, &prop_size) == kSuccess) && prop_size >= 4) {
+			irqs = (const uint32_t *)prop;
+			count = prop_size / 4;
+			printf("WIFI PROBE: [ADT]   interrupts (%u Copy Engine lines):", count);
+			for (i = 0; i < count && i < 12; i++) {
+				printf(" %u", irqs[i]);
+			}
+			printf("\n");
+		}
+
+		/* Parse ANOC2 SMMU StreamIDs */
+		if ((SecureDTGetProperty(node, "qcom,stream-ids", &prop, &prop_size) == kSuccess ||
+		     SecureDTGetProperty(node, "iommus", &prop, &prop_size) == kSuccess) && prop_size >= 8) {
+			sids = (const uint32_t *)prop;
+			printf("WIFI PROBE: [ADT]   stream-ids (ANOC2 SMMU): CE=0x%04x, MSA=0x%04x\n", sids[0], sids[1]);
+		}
+
+		/* Parse MSA memory size */
+		if (SecureDTGetProperty(node, "qcom,wlan-msa-memory", &prop, &prop_size) == kSuccess && prop_size >= 4) {
+			msa = (const uint32_t *)prop;
+			printf("WIFI PROBE: [ADT]   qcom,wlan-msa-memory = 0x%x (%u KB)\n", *msa, *msa / 1024u);
+		}
+
+		/* Check Stage 3 activation gate: sweetwifi */
+		(void)PE_parse_boot_argn("sweetwifi", &sweetwifi, sizeof(sweetwifi));
+		if (sweetwifi <= 0) {
+			printf("WIFI PROBE: [GATE] sweetwifi=0 (disabled default): WLAN hardware activation dormant (zero WCSS MMIO/regulator/clock/SMMU programming).\n");
+		} else if (sweetwifi == 1) {
+			printf("WIFI PROBE: [GATE] sweetwifi=1 active: Sub-Phase 3D.2 SMMU routing & Sub-Phase 3D.3a GLINK decode enabled.\n");
+		} else {
+			printf("WIFI PROBE: [GATE] sweetwifi=%d active: advanced hardware activation requested.\n", sweetwifi);
+		}
+
+		int sweetwifi_rails = 0;
+		(void)PE_parse_boot_argn("sweetwifi_rails", &sweetwifi_rails, sizeof(sweetwifi_rails));
+		if (sweetwifi_rails > 0) {
+			printf("WIFI PROBE: [GATE] sweetwifi_rails=%d active: Sub-Phase 3D.4 controlled rail bringup enabled.\n", sweetwifi_rails);
+		} else {
+			printf("WIFI PROBE: [GATE] sweetwifi_rails=0 (default): PM8998 voltage / clock voting dormant.\n");
+		}
+
+		int sweetwifi_mmio = 0;
+		(void)PE_parse_boot_argn("sweetwifi_mmio", &sweetwifi_mmio, sizeof(sweetwifi_mmio));
+		if (sweetwifi_mmio > 0) {
+			printf("WIFI PROBE: [GATE] sweetwifi_mmio=%d active: Sub-Phase 3D.4 controlled WCSS MMIO read inquiry enabled.\n", sweetwifi_mmio);
+		} else {
+			printf("WIFI PROBE: [GATE] sweetwifi_mmio=0 (default): WCSS MMIO aperture (0x18800000) access held dormant.\n");
+		}
+	}
+
+	/* 5B: Compile-time reference hardware specification (from Sony MSM8998 stock DTB) */
+	printf("WIFI PROBE: [DT-REF] Reference hardware spec (from Sony MSM8998 stock DTB):\n");
+	printf("WIFI PROBE: [DT-REF]   Target node: '/soc/qcom,icnss@18800000' (compatible: 'qcom,icnss')\n");
+	printf("WIFI PROBE: [DT-REF]   SMMU instance: ANOC2 @ 0x016c0000 (phandle 0x6a)\n");
+	printf("WIFI PROBE: [DT-REF]   StreamIDs: Primary=0x1900 (data/CE), Secondary=0x1901 (firmware/MSA)\n");
+	printf("WIFI PROBE: [DT-REF]   Memory: membase=0x18800000 (8MB) iova_base=0xa0000000 msa_sz=1MB\n");
+	printf("WIFI PROBE: [DT-REF]   Supplies: vdd-0.8-cx-mx, vdd-1.8-xo, vdd-1.3-rfa, vdd-3.3-ch0\n");
+	printf("WIFI PROBE: [DT-REF]   Interrupts: 12 Copy Engine SPIs (413..425) on GICv3\n");
+	printf("WIFI PROBE: [DT-REF]   Notice: Above is compile-time specification data; no WCSS MMIO touched.\n");
+}
+
+/*
+ * Main Probe Entry Point
+ * Invoked exactly once from sweet_ufs_init() in bsd/dev/sweet_ufs.c
+ * during single-threaded early BSD bootstrap before userland launch.
+ */
+void
+sweet_poplar_wifi_probe(void)
+{
+	int probe = 0;
+	(void)PE_parse_boot_argn("wifiprobe", &probe, sizeof(probe));
+
+	/* Default: completely dormant */
+	if (probe <= 0) {
+		return;
+	}
+
+	if (probe != 1) {
+		printf("WIFI PROBE: wifiprobe=%d unsupported; defaulting to Level 1 read-only diagnostic\n", probe);
+	}
+
+	printf("\n=======================================================\n");
+	printf("=== SWEET POPLAR WI-FI DIAGNOSTIC PROBE (LEVEL 1)   ===\n");
+	printf("=======================================================\n");
+
+	/* Level 1 Probes: 100% Non-invasive, safe, always-clocked buses */
+	probe_smem();
+	probe_smmu();
+	probe_pm8998_gpio3();
+	probe_rpm_msgram();
+	probe_wlan_device_tree();
+
+	printf("=======================================================\n");
+	printf("=== SWEET POPLAR WI-FI DIAGNOSTIC PROBE COMPLETE    ===\n");
+	printf("=======================================================\n\n");
+}
