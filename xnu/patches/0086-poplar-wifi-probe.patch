+ */
+#define POPLAR_GCC_MSS_PAGE_PA      0x0018a000u   /* GCC MSS clock branch registers (4KB page) */
+#define GCC_MSS_CFG_AHB_CBCR_OFF    0x000u        /* GCC_MSS_CFG_AHB_CBCR (0x0018a000) */
+#define GCC_MSS_MNOC_BIMC_CBCR_OFF  0x004u        /* GCC_MSS_MNOC_BIMC_AXI_CBCR (0x0018a004) */
+#define GCC_MSS_SNOC_AXI_CBCR_OFF   0x03cu        /* GCC_MSS_SNOC_AXI_CBCR (0x0018a03c) */
+#define GCC_MSS_Q6_BIMC_CBCR_OFF    0x040u        /* GCC_MSS_Q6_BIMC_AXI_CBCR (0x0018a040) */
+
