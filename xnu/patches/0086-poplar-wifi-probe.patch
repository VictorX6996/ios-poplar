+static void
+s5b_smp2p_kick(void)
+{
+	static bool s_kick_logged = false;
+	if (!s_kick_logged) {
+		s_kick_logged = true;
+		printf("WIFI PROBE: [5B.2] SMP2P kick: APCS IPC PA=0x%08x + 0x08, bit 14 (mask 0x%04x)\n",
+		    POPLAR_APCS_IPC_PAGE_PA, APCS_IPC_MPSS_SMP2P_MASK);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	probe_wr32(s5b.ipc_va, 0x08u, APCS_IPC_MPSS_SMP2P_MASK);
+}
