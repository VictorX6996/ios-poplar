+static inline uint32_t
+probe_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+probe_wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb sy; isb" ::: "memory");
+}
+
+/*
+ * --- 1. SMEM Partition Table Probe ---
+ * Safely reads the Qualcomm SMEM TOC at 0x861ff000.
+ * Layout per Qualcomm Linux drivers/soc/qcom/smem.c:
+ *   Header (32 bytes):
+ *     u32 magic ("$TOC" = 0x434f5424)
+ *     u32 version (= 1)
+ *     u32 num_entries
+ *     u32 max_entries
+ *     u32 reserved[4]
+ *   Entry (48 bytes):
+ *     u32 offset (byte offset from 2MB SMEM base)
+ *     u32 size   (byte size of partition)
+ *     u32 flags
+ *     u16 host0  (subsystem host 0, e.g. APPS=1)
+ *     u16 host1  (subsystem host 1, e.g. Modem=2)
+ *     u32 size_cacheline
+ *     u32 reserved[7]
+ *
+ * Restricts logging to partition headers; never reads partition payloads.
+ */
+static void
+probe_smem(void)
+{
+	vm_offset_t toc;
+	uint32_t magic, ver, num_entries, max_entries, max_safe_entries;
+	uint32_t i;
+
+	printf("WIFI PROBE: [SMEM] mapping TOC @ 0x%08x (4KB)\n", POPLAR_SMEM_TOC_PA);
+	toc = ml_io_map(POPLAR_SMEM_TOC_PA, 0x1000);
+	if (!toc) {
+		printf("WIFI PROBE: [SMEM] FAILED: ml_io_map returned NULL\n");
+		return;
+	}
+
+	magic = probe_rd32(toc, 0);
+	ver = probe_rd32(toc, 4);
+	num_entries = probe_rd32(toc, 8);
+	max_entries = probe_rd32(toc, 12);
+
+	if (magic != 0x434f5424) { /* "$TOC" */
+		printf("WIFI PROBE: [SMEM] invalid magic 0x%08x (expected '$TOC')\n", magic);
+		return;
+	}
+
+	printf("WIFI PROBE: [SMEM] valid $TOC ver=%u entries=%u max=%u\n", ver, num_entries, max_entries);
+
+	/* Bound scan by mapped 4KB page: 32 bytes header + 48 bytes per entry */
+	max_safe_entries = (0x1000u - 32u) / 48u; /* 84 entries max */
+	if (max_entries > 0 && num_entries > max_entries) {
+		num_entries = max_entries;
+	}
+	if (num_entries > max_safe_entries) {
+		num_entries = max_safe_entries;
+	}
+
+	for (i = 0; i < num_entries; i++) {
+		uint32_t e_off = 32u + i * 48u;
+		uint32_t off = probe_rd32(toc, e_off);
+		uint32_t size = probe_rd32(toc, e_off + 4);
+		uint32_t flags = probe_rd32(toc, e_off + 8);
+		uint32_t hosts = probe_rd32(toc, e_off + 12);
+		uint16_t h0 = (uint16_t)hosts;
+		uint16_t h1 = (uint16_t)(hosts >> 16);
+		bool in_bounds, is_global, is_apps;
+
+		/* Explicitly classify empty vs malformed vs valid entries */
+		if (off == 0 && size == 0) {
+			printf("WIFI PROBE: [SMEM] p[%02u] [EMPTY] off=0x00000 sz=0KB (unallocated entry)\n", i);
+			continue;
+		}
+		if (size == 0) {
+			printf("WIFI PROBE: [SMEM] p[%02u] [MALFORMED-ZERO-SIZE] off=0x%05x sz=0KB fl=0x%x\n",
+			    i, off, flags);
+			continue;
+		}
+
+		/* Overflow-safe range check within 2MB SMEM region */
+		in_bounds = (size <= 0x200000u && off <= 0x200000u - size);
+		if (!in_bounds) {
+			printf("WIFI PROBE: [SMEM] p[%02u] [OUT-OF-BOUNDS] off=0x%08x sz=%u fl=0x%x\n",
+			    i, off, size, flags);
+			continue;
+		}
+
+		/*
+		 * Qualcomm SMEM Host IDs: Global = 0, APPS = 1, Modem = 2, ADSP = 3.
+		 * Partitions not including APPS (h0!=1 && h1!=1 && not global) are
+		 * access-protected by the XPU MPU. Reading their payloads causes a bus hang.
+		 */
+		is_global = (h0 == 0 && h1 == 0);
+		is_apps = (h0 == 1 || h1 == 1);
+		printf("WIFI PROBE: [SMEM] p[%02u] off=0x%05x sz=%uKB fl=0x%x h=%u:%u %s\n",
+			i, off, size / 1024u, flags, h0, h1,
+			(is_global || is_apps) ? "APPS-accessible" : "XPU-restricted");
+	}
+}
+
+/*
+ * --- 2. SMMU ANOC2 Probe ---
+ * Reads ARM SMMUv2 capability registers (IDR0, IDR1, IDR2, sCR0).
+ * Decodes all control bits (CLIENTPD, USFCFG, SMCFCFG, GFRE, GFIE, GCFGFRE).
+ * Reads SMMU Global Fault Status and Syndrome registers (sGFSR, sGFSYNR0..2).
+ * Dumps all implemented SMR and S2CR entries bounded by hardware and mapping.
+ */
+static void
+probe_smmu(void)
+{
+	vm_offset_t smmu;
+	uint32_t scr0, idr0, idr1, idr2;
+	uint32_t gfsr, gfsynr0, gfsynr1, gfsynr2;
+	uint32_t num_smr, num_cb, num_s2cb, num_sidb, max_smr_mapped;
+	bool s1ts, s2ts, nts, sms, smcd;
+	bool clientpd, gfre, gfie, gcfgfre, smcfcfg, usfcfg;
+	uint32_t matched_1900, matched_1901, i;
+
+	printf("WIFI PROBE: [SMMU] mapping ANOC2 @ 0x%08x (16KB window)\n", POPLAR_SMMU_ANOC2_PA);
+	smmu = ml_io_map(POPLAR_SMMU_ANOC2_PA, POPLAR_SMMU_ANOC2_SIZE);
+	if (!smmu) {
+		printf("WIFI PROBE: [SMMU] FAILED: ml_io_map returned NULL\n");
+		return;
+	}
+
+	scr0 = probe_rd32(smmu, ARM_SMMU_GR0_sCR0);
+	idr0 = probe_rd32(smmu, ARM_SMMU_GR0_IDR0);
+	idr1 = probe_rd32(smmu, ARM_SMMU_GR0_IDR1);
+	idr2 = probe_rd32(smmu, ARM_SMMU_GR0_IDR2);
+
+	gfsr = probe_rd32(smmu, ARM_SMMU_GR0_sGFSR);
+	gfsynr0 = probe_rd32(smmu, ARM_SMMU_GR0_sGFSYNR0);
+	gfsynr1 = probe_rd32(smmu, ARM_SMMU_GR0_sGFSYNR1);
+	gfsynr2 = probe_rd32(smmu, ARM_SMMU_GR0_sGFSYNR2);
+
+	clientpd = (scr0 & (1u << 0)) != 0;
+	gfre     = (scr0 & (1u << 1)) != 0;
+	gfie     = (scr0 & (1u << 2)) != 0;
+	gcfgfre  = (scr0 & (1u << 5)) != 0;
+	smcfcfg  = (scr0 & (1u << 9)) != 0;
+	usfcfg   = (scr0 & (1u << 10)) != 0;
+
+	sms = (idr0 & SMMU_IDR0_SMS) != 0;
+	num_smr = idr0 & SMMU_IDR0_NUMSMRG_MASK;
+	num_sidb = (idr0 >> SMMU_IDR0_NUMSIDB_SHIFT) & SMMU_IDR0_NUMSIDB_MASK;
+	s1ts = (idr0 & SMMU_IDR0_S1TS) != 0;
+	s2ts = (idr0 & SMMU_IDR0_S2TS) != 0;
+	nts = (idr0 & SMMU_IDR0_NTS) != 0;
+
+	num_cb = idr1 & SMMU_IDR1_NUMCB_MASK;
+	smcd = (idr1 & SMMU_IDR1_SMCD) != 0;
+	num_s2cb = (idr1 >> SMMU_IDR1_NUMS2CB_SHIFT) & SMMU_IDR1_NUMS2CB_MASK;
+
+	printf("WIFI PROBE: [SMMU] sCR0=0x%08x -> CLIENTPD=%u GFRE=%u GFIE=%u GCFGFRE=%u SMCFCFG=%u USFCFG=%u\n",
+	    scr0, clientpd, gfre, gfie, gcfgfre, smcfcfg, usfcfg);
+	printf("WIFI PROBE: [SMMU] IDR0=0x%08x -> NUMSMRG=%u SIDB=%u SMS=%u S1TS=%u S2TS=%u NTS=%u BTM=%u CTTW=%u\n",
+	    idr0, num_smr, num_sidb, sms, s1ts, s2ts, nts, (idr0 >> 13) & 1u, (idr0 >> 14) & 1u);
+	printf("WIFI PROBE: [SMMU] IDR1=0x%08x -> NUMCB=%u SMCD=%u NUMS2CB=%u (raw=0x%02x, %s) NUMPAGENDXB=%u PAGESIZE=%s\n",
+	    idr1, num_cb, smcd, num_s2cb, (idr1 >> 16) & 0xffu, s2ts ? "active" : "N/A (S2TS=0)",
+	    (idr1 >> 28) & 7u, (idr1 & (1u << 31)) ? "64KB" : "4KB");
+	printf("WIFI PROBE: [SMMU] IDR2=0x%08x -> IAS=%u OAS=%u\n",
+	    idr2, idr2 & 0xfu, (idr2 >> 4) & 0xfu);
+	printf("WIFI PROBE: [SMMU] sampled sGFSR=0x%08x (USF=%u SMCF=%u MULTI=%u) sGFSYNR0=0x%08x sGFSYNR1=0x%08x (fault_SID=0x%04x) sGFSYNR2=0x%08x\n",
+	    gfsr, (gfsr >> 1) & 1u, (gfsr >> 2) & 1u, (gfsr >> 31) & 1u,
+	    gfsynr0, gfsynr1, gfsynr1 & 0x7fffu, gfsynr2);
+
+	if (!sms) {
+		printf("WIFI PROBE: [SMMU] SMS=0: SMMU operates in Stream Indexing mode (linear S2CR table)\n");
+		return;
+	}
+
+	/* Double-bound scan by hardware limit and mapped 16KB window */
+	if (num_smr > 128u) {
+		num_smr = 128u;
+	}
+	max_smr_mapped = (POPLAR_SMMU_ANOC2_SIZE > ARM_SMMU_GR0_S2CR_BASE) ?
+	    (POPLAR_SMMU_ANOC2_SIZE - ARM_SMMU_GR0_S2CR_BASE) / 4u : 0u;
+	if (num_smr > max_smr_mapped) {
+		num_smr = max_smr_mapped;
+	}
+
+	printf("WIFI PROBE: [SMMU] dumping all %u SMR / S2CR register pairs:\n", num_smr);
+	matched_1900 = 0;
+	matched_1901 = 0;
+	for (i = 0; i < num_smr; i++) {
+		uint32_t smr_off = ARM_SMMU_GR0_SMR_BASE + i * 4u;
+		uint32_t s2cr_off = ARM_SMMU_GR0_S2CR_BASE + i * 4u;
+		uint32_t smr, s2cr, mask, sid, type, cbndx;
+		bool valid, match_1900, match_1901;
+		const char *type_str;
+
+		/* Explicit per-entry bounds check against mapped window */
+		if (smr_off + 4u > POPLAR_SMMU_ANOC2_SIZE || s2cr_off + 4u > POPLAR_SMMU_ANOC2_SIZE) {
+			printf("WIFI PROBE: [SMMU] SMR[%02u] offset exceeds mapped window, stopping dump\n", i);
+			break;
+		}
+
+		smr = probe_rd32(smmu, smr_off);
+		s2cr = probe_rd32(smmu, s2cr_off);
+		valid = (smr & SMMU_SMR_VALID) != 0;
+		mask = (smr >> SMMU_SMR_MASK_SHIFT) & SMMU_SMR_MASK_MASK;
+		sid = smr & SMMU_SMR_ID_MASK;
+		type = (s2cr >> SMMU_S2CR_TYPE_SHIFT) & SMMU_S2CR_TYPE_MASK;
+		cbndx = s2cr & SMMU_S2CR_CBNDX_MASK;
+		type_str = (type == 1) ? "BYPASS" : (type == 0) ? "TRANS" : (type == 2) ? "FAULT" : "RSVD";
+
+		/* ARM SMMUv2 stream matching rule: ((StreamID ^ sid) & ~mask) == 0 */
+		match_1900 = valid && (((WLAN_STREAM_ID_PRIMARY ^ sid) & ~mask) == 0);
+		match_1901 = valid && (((WLAN_STREAM_ID_SECONDARY ^ sid) & ~mask) == 0);
+
+		printf("WIFI PROBE: [SMMU] SMR[%02u]: valid=%u ID=0x%04x mask=0x%04x -> S2CR: %s (type=%u cb=%u)%s%s\n",
+		    i, valid, sid, mask, type_str, type, cbndx,
+		    match_1900 ? " [MATCH 0x1900]" : "",
+		    match_1901 ? " [MATCH 0x1901]" : "");
+
+		if (match_1900) {
+			matched_1900++;
+		}
+		if (match_1901) {
+			matched_1901++;
+		}
+	}
+
+	printf("WIFI PROBE: [SMMU] RESULT: StreamID 0x1900 (primary): %u match(es), StreamID 0x1901 (secondary): %u match(es)\n",
+	    matched_1900, matched_1901);
+	if (matched_1900 == 0 && matched_1901 == 0) {
+		printf("WIFI PROBE: [SMMU] RESULT: Neither WLAN StreamID has an SMR route. Under USFCFG=1, transactions will raise USF aborts.\n");
+	}
+
+	/* Stage 3D Sub-Phase 3D.2: SMMU Stream Routing Preparation (WCSS Held in Reset) */
+	int sweetwifi = 0;
+	(void)PE_parse_boot_argn("sweetwifi", &sweetwifi, sizeof(sweetwifi));
+	if (sweetwifi >= 1) {
+		int slot_ce = -1, slot_msa = -1;
+		uint32_t smr_ce, s2cr_ce, smr_msa, s2cr_msa;
+		uint32_t post_gfsr;
+		int rollback_test = 0;
+
+		printf("\nWIFI PROBE: [3D.2] === SUB-PHASE 3D.2: SMMU STREAM ROUTING PREPARATION ===\n");
+		printf("WIFI PROBE: [3D.2] Gate: sweetwifi=%d authorized for SMMU preparation (WCSS held in reset).\n", sweetwifi);
+		printf("WIFI PROBE: [3D.2] Safety constraint: WCSS unpowered and held in reset; zero rail/clock/MMIO changes.\n");
+
+		/* Find 2 candidate invalid SMR slots */
+		for (i = 0; i < num_smr; i++) {
+			uint32_t smr_off = ARM_SMMU_GR0_SMR_BASE + i * 4u;
+			uint32_t smr_val = probe_rd32(smmu, smr_off);
+			if ((smr_val & SMMU_SMR_VALID) == 0) {
+				if (slot_ce < 0) {
+					slot_ce = (int)i;
+				} else if (slot_msa < 0) {
+					slot_msa = (int)i;
+					break;
+				}
+			}
+		}
+
+		if (slot_ce < 0 || slot_msa < 0) {
+			printf("WIFI PROBE: [3D.2] FAILED: unable to find 2 free SMR slots\n");
+			return;
+		}
+
+		printf("WIFI PROBE: [3D.2] Selected candidate SMR slots: CE=SMR[%02d], MSA=SMR[%02d]\n", slot_ce, slot_msa);
+
+		/*
+		 * Programming sequence per ARM SMMUv2 architecture (ARM IHI 0062D):
+		 * 1. Set S2CR to FAULT (TYPE=2, CBNDX=0xff) to ensure no transient invalid translation.
+		 * 2. Set SMR with VALID=1, MASK=0x0000, ID=StreamID.
+		 * 3. Set S2CR to BYPASS (TYPE=1, CBNDX=0) or Context Bank translation.
+		 */
+		/* Primary StreamID: 0x1900 (Copy Engine Data Path) */
+		probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_ce * 4u, (2u << 16) | 0xffu);
+		probe_wr32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_ce * 4u,
+		    SMMU_SMR_VALID | (0x0000u << 16) | WLAN_STREAM_ID_PRIMARY);
+		probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_ce * 4u, (1u << 16));
+
+		/* Secondary StreamID: 0x1901 (Firmware / MSA Path) */
+		probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_msa * 4u, (2u << 16) | 0xffu);
+		probe_wr32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_msa * 4u,
+		    SMMU_SMR_VALID | (0x0000u << 16) | WLAN_STREAM_ID_SECONDARY);
+		probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_msa * 4u, (1u << 16));
+
+		/* Read-back verification */
+		smr_ce = probe_rd32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_ce * 4u);
+		s2cr_ce = probe_rd32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_ce * 4u);
+		smr_msa = probe_rd32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_msa * 4u);
+		s2cr_msa = probe_rd32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_msa * 4u);
+
+		printf("WIFI PROBE: [3D.2] Verified CE  SMR[%02d]=0x%08x (valid=%u ID=0x%04x) -> S2CR=0x%08x (type=%u: %s)\n",
+		    slot_ce, smr_ce, (smr_ce >> 31) & 1u, smr_ce & 0x7fffu,
+		    s2cr_ce, (s2cr_ce >> 16) & 3u, ((s2cr_ce >> 16) & 3u) == 1 ? "BYPASS" : "OTHER");
+		printf("WIFI PROBE: [3D.2] Verified MSA SMR[%02d]=0x%08x (valid=%u ID=0x%04x) -> S2CR=0x%08x (type=%u: %s)\n",
+		    slot_msa, smr_msa, (smr_msa >> 31) & 1u, smr_msa & 0x7fffu,
+		    s2cr_msa, (s2cr_msa >> 16) & 3u, ((s2cr_msa >> 16) & 3u) == 1 ? "BYPASS" : "OTHER");
+
+		/* Audit Global Fault Status Register */
+		post_gfsr = probe_rd32(smmu, ARM_SMMU_GR0_sGFSR);
+		printf("WIFI PROBE: [3D.2] Post-config sGFSR=0x%08x (USF=%u SMCF=%u MULTI=%u) -> %s\n",
+		    post_gfsr, (post_gfsr >> 1) & 1u, (post_gfsr >> 2) & 1u, (post_gfsr >> 31) & 1u,
+		    post_gfsr == 0 ? "CLEAN (zero SMMU faults)" : "FAULT DETECTED");
+
+		/* Rollback test check */
+		(void)PE_parse_boot_argn("smmu_rollback", &rollback_test, sizeof(rollback_test));
+		if (rollback_test == 1) {
+			printf("WIFI PROBE: [3D.2] smmu_rollback=1 requested: testing teardown sequence...\n");
+			probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_ce * 4u, (2u << 16) | 0xffu);
+			probe_wr32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_ce * 4u, 0);
+			probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + (uint32_t)slot_msa * 4u, (2u << 16) | 0xffu);
+			probe_wr32(smmu, ARM_SMMU_GR0_SMR_BASE + (uint32_t)slot_msa * 4u, 0);
+			printf("WIFI PROBE: [3D.2] Rollback complete: SMR[%02d] and SMR[%02d] restored to valid=0 / FAULT\n",
+			    slot_ce, slot_msa);
+		} else {
+			printf("WIFI PROBE: [3D.2] Stream routes remain active in BYPASS mode (WCSS dormant in reset).\n");
+		}
+		printf("WIFI PROBE: [3D.2] SMMU stream routing preparation successfully completed.\n\n");
+	} else {
+		printf("WIFI PROBE: [3D.2] sweetwifi=0 (default): Sub-Phase 3D.2 SMMU programming skipped (dormant).\n");
+	}
+}
+
+/*
+ * --- 3. PM8998 GPIO3 SPMI Arbiter Probe ---
+ * Inspects SPMI v3 Arbiter APID mapping registers in CORE and CNFG space.
+ * 100% PASSIVE READ-ONLY MMIO:
+ * Active observer command transactions have been completely removed
+ * to eliminate any risk of unverified writes or SPMI arbiter collision.
+ */
+static void
+probe_pm8998_gpio3(void)
+{
+	vm_offset_t core, cnfg;
+	uint32_t arb_ver, map_base, owner;
+	uint16_t target_ppid, found_apid;
+	uint32_t i;
+
+	printf("WIFI PROBE: [SPMI] mapping SPMI CORE @ 0x%08x & CNFG @ 0x%08x (read-only)\n",
+	    POPLAR_SPMI_CORE_PA, POPLAR_SPMI_CNFG_PA);
+
+	core = ml_io_map(POPLAR_SPMI_CORE_PA, 0x1000);
+	cnfg = ml_io_map(POPLAR_SPMI_CNFG_PA, 0x3000);
+	if (!core || !cnfg) {
+		printf("WIFI PROBE: [SPMI] FAILED: ml_io_map failed for CORE or CNFG\n");
+		return;
+	}
+
+	arb_ver = probe_rd32(core, 0x00);
+	printf("WIFI PROBE: [SPMI] Arbiter HW version: 0x%08x (%s)\n",
+	    arb_ver, (arb_ver < 0x50000000u) ? "v2/v3 (MSM8998)" : "v5 (SM7150+)");
+
+	/* On SPMI v3, APID mapping table is at CORE + 0x800, ownership at CNFG + 0x700 */
+	map_base = (arb_ver >= 0x50000000u) ? 0x900u : SPMI_V3_MAP_BASE;
+	target_ppid = PM8998_GPIO3_PPID; /* 0x00c2 */
+	found_apid = 0xffffu;
+	owner = 0xffffffffu;
+
+	for (i = 0; i < 512u; i++) {
+		uint32_t entry = probe_rd32(core, map_base + i * 4u);
+		if (entry != 0 && ((entry >> 8) & 0xfffu) == target_ppid) {
+			found_apid = (uint16_t)i;
+			owner = probe_rd32(cnfg, SPMI_V3_OWNER_BASE + i * 4u) & 7u;
+			break;
+		}
+	}
+
+	if (found_apid == 0xffffu) {
+		printf("WIFI PROBE: [SPMI] PM8998 GPIO3 (PPID 0x00c2) has no APID assigned in SPMI table\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [SPMI] PM8998 GPIO3 (PPID 0x00c2) mapped to APID %u (owner EE=%u: %s)\n",
+	    found_apid, owner, (owner == 0) ? "APPS" : "OTHER/SECURE");
+	printf("WIFI PROBE: [SPMI] active command transactions completely removed (100%% passive diagnostic)\n");
+}
+
+/*
+ * --- 4. RPM GLINK Message RAM Header & Ring Buffer Decoder ---
+ * Reads TOC at 0x00778000 + 0x7000 - 256 using probe_rd32().
+ * Stage 3D Sub-Phase 3D.3a: Decodes pre-existing ABL GLINK communication
+ * from the r2pa and pa2r ring buffers in Message RAM.
+ * Stage 3D Sub-Phase 3D.3b: Exercises controlled PM8998 voltage / clock inquiry
+ * with immediate reverse-order rollback when sweetwifi_rails=1 is passed.
+ */
+
+static void
+decode_glink_ring(vm_offset_t ram, uint32_t off, uint32_t sz, const char *tag)
+{
+	uint32_t head, tail, fifo_base, fifo_len;
+	uint32_t dump_len, w, pos;
+	unsigned int msg_idx = 0;
+
+	if (off >= 0x7000u || sz < 8u || sz > 0x7000u - off) {
+		printf("WIFI PROBE: [RPM-GLINK] %s: invalid ring bounds off=0x%04x sz=%u\n",
+		    tag, off, sz);
+		return;
+	}
+
+	head = probe_rd32(ram, off);
+	tail = probe_rd32(ram, off + 4u);
+	fifo_base = off + 8u;
+	fifo_len = sz - 8u;
+
+	printf("\nWIFI PROBE: [RPM-GLINK] === Decoding %s Ring (off=0x%04x, sz=%u) ===\n",
+	    tag, off, sz);
+	printf("WIFI PROBE: [RPM-GLINK]   Indices: head=%u (0x%x), tail=%u (0x%x), fifo_len=%u\n",
+	    head, head, tail, tail, fifo_len);
+
+	/* 1. Raw Hex Dump (first min(head, 256) bytes or 64 bytes if head==0) */
+	dump_len = head;
+	if (dump_len > 256u) {
+		dump_len = 256u;
+	}
+	if (dump_len == 0 && fifo_len >= 64u) {
+		dump_len = 64u;
+	}
+
+	printf("WIFI PROBE: [RPM-GLINK]   Raw FIFO Dump (first %u bytes):\n", dump_len);
+	for (w = 0; w < dump_len; w += 16u) {
+		uint32_t d0 = (w + 0u < fifo_len) ? probe_rd32(ram, fifo_base + w) : 0;
+		uint32_t d1 = (w + 4u < fifo_len) ? probe_rd32(ram, fifo_base + w + 4u) : 0;
+		uint32_t d2 = (w + 8u < fifo_len) ? probe_rd32(ram, fifo_base + w + 8u) : 0;
+		uint32_t d3 = (w + 12u < fifo_len) ? probe_rd32(ram, fifo_base + w + 12u) : 0;
+		printf("WIFI PROBE: [RPM-GLINK]     [+0x%03x] %08x %08x %08x %08x\n",
+		    w, d0, d1, d2, d3);
+	}
+
+	/* 2. Structured GLINK Command Walk */
+	pos = 0;
+	while (pos + 8u <= head && pos + 8u <= fifo_len && msg_idx < 32u) {
+		uint32_t w0 = probe_rd32(ram, fifo_base + pos);
+		uint32_t w1 = probe_rd32(ram, fifo_base + pos + 4u);
+		uint16_t cmd = (uint16_t)(w0 & 0xffffu);
+		uint16_t p1 = (uint16_t)((w0 >> 16) & 0xffffu);
+		uint32_t p2 = w1;
+		uint32_t pkt_len = 8u;
+
+		msg_idx++;
+
+		switch (cmd) {
+		case GLINK_CMD_VERSION:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_VERSION ver=%u feat=0x%08x\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_VERSION_ACK:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_VERSION_ACK ver=%u feat=0x%08x\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_OPEN: {
+			uint16_t lcid = p1;
+			uint32_t nlen = p2;
+			char chname[32] = {0};
+			uint32_t k;
+			for (k = 0; k < nlen && k < sizeof(chname) - 1; k += 4u) {
+				uint32_t nw = probe_rd32(ram, fifo_base + pos + 8u + k);
+				chname[k] = (char)(nw & 0xff);
+				if (k + 1 < sizeof(chname) - 1) chname[k + 1] = (char)((nw >> 8) & 0xff);
+				if (k + 2 < sizeof(chname) - 1) chname[k + 2] = (char)((nw >> 16) & 0xff);
+				if (k + 3 < sizeof(chname) - 1) chname[k + 3] = (char)((nw >> 24) & 0xff);
+			}
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_OPEN lcid=%u name='%s'\n",
+			    tag, pos, lcid, chname);
+			pkt_len = 8u + ((nlen + 7u) & ~7u);
+			break;
+		}
+		case GLINK_CMD_CLOSE:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_CLOSE lcid=%u reason=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_OPEN_ACK:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_OPEN_ACK lcid=%u rcid=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_INTENT:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_INTENT lcid=%u count=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u + p2 * 8u;
+			break;
+		case GLINK_CMD_RX_DONE:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_RX_DONE lcid=%u riid=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_RX_INTENT_REQ:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_RX_INTENT_REQ lcid=%u size=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_RX_INTENT_REQ_ACK:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_RX_INTENT_REQ_ACK lcid=%u granted=%u\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_TX_DATA: {
+			uint16_t lcid = p1;
+			uint32_t riid = p2;
+			uint32_t chunk = probe_rd32(ram, fifo_base + pos + 8u);
+			uint32_t left = probe_rd32(ram, fifo_base + pos + 12u);
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_TX_DATA lcid=%u riid=%u chunk=%u left=%u\n",
+			    tag, pos, lcid, riid, chunk, left);
+			if (chunk >= 16u && pos + 16u + chunk <= fifo_len) {
+				uint32_t svc = probe_rd32(ram, fifo_base + pos + 16u);
+				uint32_t req_id = probe_rd32(ram, fifo_base + pos + 20u);
+				uint32_t ver = probe_rd32(ram, fifo_base + pos + 24u);
+				uint32_t rlen = probe_rd32(ram, fifo_base + pos + 28u);
+				printf("WIFI PROBE: [RPM-SMD]     hdr: svc=%u req_id=%u ver=%u len=%u\n",
+				    svc, req_id, ver, rlen);
+				if (rlen >= 12u && pos + 32u + rlen <= fifo_len) {
+					uint32_t rtype = probe_rd32(ram, fifo_base + pos + 32u);
+					uint32_t rid = probe_rd32(ram, fifo_base + pos + 36u);
+					uint32_t dlen = probe_rd32(ram, fifo_base + pos + 40u);
+					char rt_str[5];
+					rt_str[0] = (char)(rtype & 0xff);
+					rt_str[1] = (char)((rtype >> 8) & 0xff);
+					rt_str[2] = (char)((rtype >> 16) & 0xff);
+					rt_str[3] = (char)((rtype >> 24) & 0xff);
+					rt_str[4] = 0;
+					printf("WIFI PROBE: [RPM-SMD]     rsc='%s' (0x%08x) id=%u dlen=%u\n",
+					    rt_str, rtype, rid, dlen);
+					if (dlen >= 12u && pos + 44u + dlen <= fifo_len) {
+						uint32_t kvp_k = probe_rd32(ram, fifo_base + pos + 44u);
+						uint32_t kvp_n = probe_rd32(ram, fifo_base + pos + 48u);
+						uint32_t kvp_v = probe_rd32(ram, fifo_base + pos + 52u);
+						char k_str[5];
+						k_str[0] = (char)(kvp_k & 0xff);
+						k_str[1] = (char)((kvp_k >> 8) & 0xff);
+						k_str[2] = (char)((kvp_k >> 16) & 0xff);
+						k_str[3] = (char)((kvp_k >> 24) & 0xff);
+						k_str[4] = 0;
+						printf("WIFI PROBE: [RPM-SMD]       kvp[0]: key='%s' (0x%08x) nbytes=%u val=%u (0x%x)\n",
+						    k_str, kvp_k, kvp_n, kvp_v, kvp_v);
+					}
+				}
+			}
+			pkt_len = 16u + ((chunk + 7u) & ~7u);
+			break;
+		}
+		case GLINK_CMD_CLOSE_ACK:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_CLOSE_ACK lcid=%u\n",
+			    tag, pos, p1);
+			pkt_len = 8u;
+			break;
+		case GLINK_CMD_SIGNALS:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: CMD_SIGNALS lcid=%u sig=0x%08x\n",
+			    tag, pos, p1, p2);
+			pkt_len = 8u;
+			break;
+		default:
+			printf("WIFI PROBE: [RPM-GLINK] %s @ +0x%03x: unknown cmd=%u (0x%04x) p1=%u p2=0x%08x\n",
+			    tag, pos, cmd, cmd, p1, p2);
+			pkt_len = 8u;
+			break;
+		}
+
+		if (pkt_len < 8u || pkt_len > fifo_len - pos) {
+			break;
+		}
+		pos += pkt_len;
+	}
+}
