+/*
+ * Sub-Phase 3D.4: WCSS Reset De-assertion, Power/Clock Activation & MMIO Read Inquiry
+ * Gated strictly behind boot-args:
+ *   sweetwifi_rails=1: Enables PM8998 LDOs & RF_CLK2 via RPM GLINK with immediate rollback.
+ *   sweetwifi_mmio=1:  Allows guarded MMIO read of WCSS aperture (0x18800000) while powered.
+ */
+static void
+probe_rpm_rail_inquiry(vm_offset_t ram)
+{
+	(void)ram;
+	int sweetwifi_rails = 0;
+	int sweetwifi_mmio = 0;
+	(void)PE_parse_boot_argn("sweetwifi_rails", &sweetwifi_rails, sizeof(sweetwifi_rails));
+	(void)PE_parse_boot_argn("sweetwifi_mmio", &sweetwifi_mmio, sizeof(sweetwifi_mmio));
+
+	printf("\nWIFI PROBE: [3D.4] === SUB-PHASE 3D.4: WCSS POWER/CLOCK & MMIO INQUIRY ===\n");
+
+	if (sweetwifi_rails <= 0) {
+		printf("WIFI PROBE: [3D.4] Gate: sweetwifi_rails=0 (dormant default).\n");
+		printf("WIFI PROBE: [3D.4] Zero PM8998 regulator / clock votes issued (WCSS strictly unpowered).\n\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [3D.4] Gate: sweetwifi_rails=1 ACTIVE. Initiating monotonic bringup...\n");
+	printf("WIFI PROBE: [3D.4] Monotonic bringup sequence:\n");
+
+	/* 1. PM8998 LDO5A (0.80V) -> vdd-0.8-cx-mx */
+	bool ok_l5 = poplar_rpm_ldoa(5, 800000u);
+	printf("WIFI PROBE: [3D.4]   1. PM8998 LDO5A  (0.80V,  800000 uV) -> %s\n", ok_l5 ? "ACK OK" : "FAILED");
+
+	/* 2. PM8998 LDO7A (1.80V) -> vdd-1.8-xo */
+	bool ok_l7 = poplar_rpm_ldoa(7, 1800000u);
+	printf("WIFI PROBE: [3D.4]   2. PM8998 LDO7A  (1.80V, 1800000 uV) -> %s\n", ok_l7 ? "ACK OK" : "FAILED");
+
+	/* 3. PM8998 LDO17A (1.304V) -> vdd-1.3-rfa */
+	bool ok_l17 = poplar_rpm_ldoa(17, 1304000u);
+	printf("WIFI PROBE: [3D.4]   3. PM8998 LDO17A (1.304V, 1304000 uV) -> %s\n", ok_l17 ? "ACK OK" : "FAILED");
+
+	/* 4. PM8998 LDO25A (3.30V) -> vdd-3.3-ch0 */
+	bool ok_l25 = poplar_rpm_ldoa(25, 3300000u);
+	printf("WIFI PROBE: [3D.4]   4. PM8998 LDO25A (3.30V, 3300000 uV) -> %s\n", ok_l25 ? "ACK OK" : "FAILED");
+
+	/* 5. PM8998 RF_CLK2 (19.2MHz) -> cxo_ref_clk_pin */
+	bool ok_clk = poplar_rpm_clka(5, 1u);
+	printf("WIFI PROBE: [3D.4]   5. PM8998 RF_CLK2 (19.2MHz XO buf)   -> %s\n", ok_clk ? "ACK OK" : "FAILED");
+
+	printf("WIFI PROBE: [3D.4] Monotonic bringup status: L5=%d L7=%d L17=%d L25=%d CLK=%d\n",
+	    ok_l5, ok_l7, ok_l17, ok_l25, ok_clk);
+
+	/* 5ms voltage/clock stabilization delay */
+	delay(5000);
+
+	/* Controlled WCSS MMIO Inquiry */
+	if (sweetwifi_mmio >= 1) {
+		printf("WIFI PROBE: [3D.4] Gate: sweetwifi_mmio=1 DISCONTINUED (interconnect bus stall discovered).\n");
+		printf("WIFI PROBE: [3D.4] WCSS MMIO aperture (0x18800000) requires Modem DSP PIL / QMI handshake (Stage 4).\n");
+		printf("WIFI PROBE: [3D.4] Holding MMIO read dormant to protect bootstrap thread.\n");
+	} else {
+		printf("WIFI PROBE: [3D.4] sweetwifi_mmio=0 (default): MMIO access held dormant. Rails verified live.\n");
+	}
+
+	/* Immediate Orderly Reverse Rollback */
+	printf("WIFI PROBE: [3D.4] Initiating immediate reverse rollback (teardown)...\n");
+
+	bool rb_clk = poplar_rpm_clka(5, 0u);
+	printf("WIFI PROBE: [3D.4]   Teardown 1. RF_CLK2  (disable) -> %s\n", rb_clk ? "ACK OK" : "FAILED");
+
+	bool rb_l25 = poplar_rpm_ldoa(25, 0u);
+	printf("WIFI PROBE: [3D.4]   Teardown 2. LDO25A   (disable) -> %s\n", rb_l25 ? "ACK OK" : "FAILED");
+
+	bool rb_l17 = poplar_rpm_ldoa(17, 0u);
+	printf("WIFI PROBE: [3D.4]   Teardown 3. LDO17A   (disable) -> %s\n", rb_l17 ? "ACK OK" : "FAILED");
+
+	bool rb_l7 = poplar_rpm_ldoa(7, 0u);
+	printf("WIFI PROBE: [3D.4]   Teardown 4. LDO7A    (disable) -> %s\n", rb_l7 ? "ACK OK" : "FAILED");
+
+	bool rb_l5 = poplar_rpm_ldoa(5, 0u);
+	printf("WIFI PROBE: [3D.4]   Teardown 5. LDO5A    (disable) -> %s\n", rb_l5 ? "ACK OK" : "FAILED");
+
+	printf("WIFI PROBE: [3D.4] Reverse rollback complete: CLK=%d L25=%d L17=%d L7=%d L5=%d\n",
+	    rb_clk, rb_l25, rb_l17, rb_l7, rb_l5);
+	printf("WIFI PROBE: [3D.4] Hardware safely returned to dormant state.\n\n");
+}
+
+static void
+probe_rpm_msgram(void)
+{
+	vm_offset_t ram;
+	uint32_t magic, count, i;
+	uint32_t r2pa_off = 0, r2pa_sz = 0;
+	uint32_t pa2r_off = 0, pa2r_sz = 0;
+
+	printf("WIFI PROBE: [RPM] inspecting Message RAM @ 0x%08x (28KB)\n", POPLAR_RPM_MSGRAM_PA);
+	ram = ml_io_map(POPLAR_RPM_MSGRAM_PA, 0x7000);
+	if (!ram) {
+		printf("WIFI PROBE: [RPM] FAILED: ml_io_map returned NULL\n");
+		return;
+	}
+
+	magic = probe_rd32(ram, RPM_TOC_OFFSET);
+	count = probe_rd32(ram, RPM_TOC_OFFSET + 4u);
+
+	if (magic != RPM_TOC_MAGIC) { /* "grt0" */
+		printf("WIFI PROBE: [RPM] invalid TOC magic 0x%08x (expected 'grt0')\n", magic);
+		return;
+	}
+
+	printf("WIFI PROBE: [RPM] valid TOC magic 'grt0' entry_count=%u\n", count);
+
+	/* Cap count to available 256-byte TOC window: (256 - 8) / 12 = 20 entries max */
+	if (count > 20u) {
+		count = 20u;
+	}
+
+	for (i = 0; i < count; i++) {
+		uint32_t e_off = RPM_TOC_OFFSET + 8u + i * 12u;
+		uint32_t id, off, size;
+		char id_str[5];
+
+		if (e_off + 12u > 0x7000u) {
+			printf("WIFI PROBE: [RPM] entry[%u] TOC entry header exceeds mapped RAM\n", i);
+			break;
+		}
+
+		id = probe_rd32(ram, e_off);
+		off = probe_rd32(ram, e_off + 4u);
+		size = probe_rd32(ram, e_off + 8u);
+
+		id_str[0] = (char)(id & 0xff);
+		id_str[1] = (char)((id >> 8) & 0xff);
+		id_str[2] = (char)((id >> 16) & 0xff);
+		id_str[3] = (char)((id >> 24) & 0xff);
+		id_str[4] = 0;
+
+		/* Overflow-safe bounds check within 28KB Message RAM */
+		if (off < 0x7000u && size >= 8u && size <= 0x7000u - off) {
+			uint32_t head = probe_rd32(ram, off);
+			uint32_t tail = probe_rd32(ram, off + 4u);
+			printf("WIFI PROBE: [RPM] entry[%u] '%s' off=0x%04x sz=%u head=%u tail=%u\n",
+			    i, id_str, off, size, head, tail);
+
+			if (id_str[0] == 'r' && id_str[1] == '2' && id_str[2] == 'p' && id_str[3] == 'a') {
+				r2pa_off = off;
+				r2pa_sz = size;
+			} else if (id_str[0] == 'p' && id_str[1] == 'a' && id_str[2] == '2' && id_str[3] == 'r') {
+				pa2r_off = off;
+				pa2r_sz = size;
+			}
+		} else {
+			printf("WIFI PROBE: [RPM] entry[%u] '%s' [INVALID/OUT-OF-BOUNDS] off=0x%04x sz=%u\n",
+			    i, id_str, off, size);
+		}
+	}
+
+	/* Stage 3D Sub-Phase 3D.3a: Decode pre-existing ABL GLINK communication */
+	if (r2pa_sz > 0) {
+		decode_glink_ring(ram, r2pa_off, r2pa_sz, "r2pa (RPM->APPS)");
+	}
+	if (pa2r_sz > 0) {
+		decode_glink_ring(ram, pa2r_off, pa2r_sz, "pa2r (APPS->RPM)");
+	}
+
+	/* Stage 3D Sub-Phase 3D.3b: Controlled Rail & Clock Enable Inquiry */
+	probe_rpm_rail_inquiry(ram);
+}
