+static void
+probe_stage4_passive_audit(void)
+{
+	int wlan_stage4_1_passive = 0;
+	(void)PE_parse_boot_argn("wlan_stage4_1_passive", &wlan_stage4_1_passive,
+	    sizeof(wlan_stage4_1_passive));
+
+	printf("\nWIFI PROBE: [4.1] === SUB-PHASE 4.1: PASSIVE SUBSYSTEM LIVE STATE AUDIT ===\n");
+
+	if (wlan_stage4_1_passive <= 0) {
+		printf("WIFI PROBE: [4.1] Gate: wlan_stage4_1_passive=0 (dormant default).\n");
+		printf("WIFI PROBE: [4.1] Zero Stage 4 memory reads issued.\n\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [4.1] Gate: wlan_stage4_1_passive=1 ACTIVE.\n");
+	printf("WIFI PROBE: [4.1] Safety: Pure passive DRAM reads; zero MMIO, zero doorbells, zero votes.\n");
+
+	probe_smem_p08_audit();
+	probe_pil_mba_audit();
+	printf("WIFI PROBE: [4.1] Sub-Phase 4.1 passive audit complete.\n\n");
+}
