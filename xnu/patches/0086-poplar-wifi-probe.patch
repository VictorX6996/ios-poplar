+static void s5b_ssctl_query_failure_reason(const char *tag);
+static void s5b_audit_post_fatal_diagnostics(void);
+
+/* IMEM Physical Base and Offsets (MSM8998: 0x146bf000, 4 KiB) */
+#define POPLAR_IMEM_BASE_PA         0x146bf000ULL
+#define POPLAR_IMEM_SIZE            0x1000u
+#define POPLAR_IMEM_MEM_DUMP_OFF    0x010u  /* mem_dump_table@10 */
+#define POPLAR_IMEM_DLOAD_TYPE_OFF  0x01cu  /* dload_type@1c */
+#define POPLAR_IMEM_RESTART_REASON  0x65cu  /* restart_reason@65c */
+#define POPLAR_IMEM_BOOT_STATS_OFF  0x6b0u  /* boot_stats@6b0 */
+#define POPLAR_IMEM_PIL_INFO_OFF    0x94cu  /* pil@94c */
+
+static vm_offset_t s_imem_va = 0;
+
+static vm_offset_t
+s5b_get_imem_va(void)
+{
+	if (!s_imem_va) {
+		s_imem_va = ml_io_map(POPLAR_IMEM_BASE_PA, POPLAR_IMEM_SIZE);
+	}
+	return s_imem_va;
+}
+
+static void
+s5b_audit_post_fatal_diagnostics(void)
+{
+	printf("WIFI PROBE: [5B.2] --- MPSS POST-FATAL HARDWARE & SUBSYSTEM DIAGNOSTICS ---\n");
+
+	/* 1. QDSP6SS Hardware Registers:
+	 * SKIPPED: Once Hexagon core boots, 0x04080000 is XPU-locked to MSS_MSA (0xF).
+	 * Reading it from HLOS triggers an ARM64 SError panic.
+	 */
+	printf("WIFI PROBE: [5B.2] QDSP6SS registers @ 0x%08x: SKIPPED (XPU-locked to MSS_MSA by MBA)\n",
+	    POPLAR_QDSP6SS_PAGE_PA);
+
+	/* 2. TCSR MSS Halt Status (halt_q6, halt_nc, halt_modem) */
+	vm_offset_t halt_va = ml_io_map(TCSR_MSS_HALT_PHYS_BASE, TCSR_MSS_HALT_SIZE);
+	if (halt_va) {
+		uint32_t q6_req    = probe_rd32(halt_va, TCSR_HALT_Q6_OFFSET + 0x00u);
+		uint32_t q6_ack    = probe_rd32(halt_va, TCSR_HALT_Q6_OFFSET + 0x04u);
+		uint32_t nc_req    = probe_rd32(halt_va, TCSR_HALT_NC_OFFSET + 0x00u);
+		uint32_t nc_ack    = probe_rd32(halt_va, TCSR_HALT_NC_OFFSET + 0x04u);
+		uint32_t modem_req = probe_rd32(halt_va, TCSR_HALT_MODEM_OFFSET + 0x00u);
+		uint32_t modem_ack = probe_rd32(halt_va, TCSR_HALT_MODEM_OFFSET + 0x04u);
+		printf("WIFI PROBE: [5B.2] TCSR MSS Halt Status @ 0x%08llx:\n",
+		    (unsigned long long)TCSR_MSS_HALT_PHYS_BASE);
+		printf("WIFI PROBE: [5B.2]   halt_q6: req=0x%x ack=0x%x | halt_nc: req=0x%x ack=0x%x | halt_modem: req=0x%x ack=0x%x\n",
+		    q6_req, q6_ack, nc_req, nc_ack, modem_req, modem_ack);
+	}
+
+	/* 3. GCC MSS Restart Register */
+	vm_offset_t rst_va = ml_io_map(GCC_MSS_RESTART_PHYS_BASE, GCC_MSS_RESTART_SIZE);
+	if (rst_va) {
+		uint32_t mss_rst = probe_rd32(rst_va, 0x00u);
+		printf("WIFI PROBE: [5B.2] GCC MSS Restart Register @ 0x%08llx: val=0x%08x\n",
+		    (unsigned long long)GCC_MSS_RESTART_PHYS_BASE, mss_rst);
+	}
+
+	/* 4. IMEM Shared Status & Diagnostics (0x146bf000) */
+	vm_offset_t imem_va = s5b_get_imem_va();
+	if (imem_va) {
+		uint64_t dump_tbl_pa = (uint64_t)probe_rd32(imem_va, POPLAR_IMEM_MEM_DUMP_OFF) |
+		    ((uint64_t)probe_rd32(imem_va, POPLAR_IMEM_MEM_DUMP_OFF + 4u) << 32);
+		uint32_t dload_type  = probe_rd32(imem_va, POPLAR_IMEM_DLOAD_TYPE_OFF);
+		uint32_t rst_reason  = probe_rd32(imem_va, POPLAR_IMEM_RESTART_REASON);
+		uint32_t pil_info    = probe_rd32(imem_va, POPLAR_IMEM_PIL_INFO_OFF);
+		printf("WIFI PROBE: [5B.2] IMEM Diagnostics @ 0x%08llx:\n",
+		    (unsigned long long)POPLAR_IMEM_BASE_PA);
+		printf("WIFI PROBE: [5B.2]   restart_reason=0x%08x dload_type=0x%08x pil_info=0x%08x\n",
+		    rst_reason, dload_type, pil_info);
+		printf("WIFI PROBE: [5B.2]   mem_dump_table_phys=0x%016llx\n",
+		    (unsigned long long)dump_tbl_pa);
+
+		/* Dump IMEM header words */
+		printf("WIFI PROBE: [5B.2]   IMEM[0x000..0x03c]:");
+		for (unsigned w = 0u; w < 16u; w++) {
+			printf(" %08x", probe_rd32(imem_va, w * 4u));
+		}
+		printf("\n");
+
+		/* Dump IMEM restart reason region */
+		printf("WIFI PROBE: [5B.2]   IMEM restart[0x650..0x66f]:");
+		for (unsigned w = 0u; w < 8u; w++) {
+			printf(" %08x", probe_rd32(imem_va, 0x650u + w * 4u));
+		}
+		printf("\n");
+
+		/* Dump IMEM boot_stats */
+		printf("WIFI PROBE: [5B.2]   IMEM boot_stats[0x6b0..0x6cf]:");
+		for (unsigned w = 0u; w < 8u; w++) {
+			printf(" %08x", probe_rd32(imem_va, POPLAR_IMEM_BOOT_STATS_OFF + w * 4u));
+		}
+		printf("\n");
+
+		/* Dump IMEM pil_info area */
+		printf("WIFI PROBE: [5B.2]   IMEM pil_info[0x940..0x97f]:");
+		for (unsigned w = 0u; w < 16u; w++) {
+			printf(" %08x", probe_rd32(imem_va, 0x940u + w * 4u));
+		}
+		printf("\n");
+	} else {
+		printf("WIFI PROBE: [5B.2] ERROR: ml_io_map failed for IMEM @ 0x%08llx\n",
+		    (unsigned long long)POPLAR_IMEM_BASE_PA);
+	}
+
+	printf("WIFI PROBE: [5B.2] --- MPSS POST-FATAL DIAGNOSTICS COMPLETE ---\n");
+}
+
+static void
+s5b_dump_mpss_crash_reason(void)
+{
+	if (s5b.mpss_err_fatal_dumped) {
+		return;
+	}
+	s5b.mpss_err_fatal_dumped = true;
+
+	printf("WIFI PROBE: [5B.2] =======================================================\n");
+	printf("WIFI PROBE: [5B.2] *** MPSS ASSERTED ERR-FATAL (CRASH ANALYSIS) ***\n");
+	printf("WIFI PROBE: [5B.2] =======================================================\n");
+
+	if (s_rmb_va) {
+		probe_dump_rmb_regs("5B-CRASH", s_rmb_va);
+	}
+
+	if (s5b.part_va != 0u) {
+		uint32_t free_unc = s5b_part_rd32(0x0cu);
+		uint32_t free_cac = s5b_part_rd32(0x10u);
+		printf("WIFI PROBE: [5B.2] SMEM p[07] state: free_unc=0x%x free_cac=0x%x\n", free_unc, free_cac);
+
+		/* 1. Walk uncached items in p[07] */
+		uint32_t off = 0x20u;
+		uint32_t item_idx = 0u;
+		while (off + 16u <= free_unc && off <= s_smem_p07_sz - 16u && item_idx < 32u) {
+			uint32_t w0 = s5b_part_rd32(off);
+			if ((uint16_t)w0 != SMEM_PRIVATE_CANARY) {
+				break;
+			}
+			uint16_t it   = (uint16_t)(w0 >> 16);
+			uint32_t sz   = s5b_part_rd32(off + 4u);
+			uint32_t w2   = s5b_part_rd32(off + 8u);
+			uint16_t pdat = (uint16_t)w2;
+			uint16_t phdr = (uint16_t)(w2 >> 16);
+			if ((uint32_t)phdr > s_smem_p07_sz - (off + 16u) ||
+			    sz > s_smem_p07_sz - (off + 16u + (uint32_t)phdr)) {
+				break;
+			}
+			uint32_t poff = off + 16u + (uint32_t)phdr;
+			uint32_t usz  = (pdat < sz) ? (sz - pdat) : sz;
+
+			printf("WIFI PROBE: [5B.2]   p[07] uncached item[%u]: id=%u off=0x%x sz=%u (usable=%u)\n",
+			    item_idx, it, poff, sz, usz);
+
+			if (it == 421u || it == 134u || it == 133u || it == 424u || (it != 435u && it != 428u && it != 478u)) {
+				char cstr[128];
+				for (unsigned i = 0u; i < sizeof(cstr); i++) cstr[i] = '\0';
+				uint32_t max_c = (usz < sizeof(cstr) - 1u) ? usz : (uint32_t)(sizeof(cstr) - 1u);
+				for (uint32_t k = 0u; k < max_c; k++) {
+					uint32_t cw = s5b_part_rd32(poff + (k & ~3u));
+					char ch = (char)((cw >> ((k & 3u) * 8u)) & 0xffu);
+					cstr[k] = (ch >= 32 && ch <= 126) ? ch : '.';
+				}
+				cstr[max_c] = '\0';
+				printf("WIFI PROBE: [5B.2]     id=%u data: '%s'\n", it, cstr);
+			}
+
+			off = poff + sz;
+			item_idx++;
+		}
+
+		/* 1b. Walk cached items in p[07] (allocated downwards from top of partition) */
+		uint32_t p07_cl = (s_smem_p07_cacheline >= 16u) ? s_smem_p07_cacheline : 32u;
+		uint32_t p07_hdr_stride = (16u + p07_cl - 1u) & ~(p07_cl - 1u);
+		if (s_smem_p07_sz >= p07_hdr_stride) {
+			uint32_t ce = s_smem_p07_sz - p07_hdr_stride;
+			uint32_t c_idx = 0u;
+			while (ce > free_cac && ce + p07_hdr_stride <= s_smem_p07_sz && c_idx < 32u) {
+				uint32_t cw0 = s5b_part_rd32(ce);
+				if ((uint16_t)cw0 != SMEM_PRIVATE_CANARY) {
+					break;
+				}
+				uint16_t it   = (uint16_t)(cw0 >> 16);
+				uint32_t sz   = s5b_part_rd32(ce + 4u);
+				uint32_t cw2  = s5b_part_rd32(ce + 8u);
+				uint16_t pdat = (uint16_t)cw2;
+				uint16_t phdr = (uint16_t)(cw2 >> 16);
+				if (sz == 0u || sz > ce) break;
+				uint32_t doff = ce - sz;
+				uint32_t usz  = (pdat < sz) ? (sz - pdat) : sz;
+
+				printf("WIFI PROBE: [5B.2]   p[07] cached item[%u]: id=%u off=0x%x sz=%u (usable=%u)\n",
+				    c_idx, it, doff, sz, usz);
+
+				/* Dump ASCII string preview */
+				char cstr[128];
+				for (unsigned i = 0u; i < sizeof(cstr); i++) cstr[i] = '\0';
+				uint32_t max_c = (usz < sizeof(cstr) - 1u) ? usz : (uint32_t)(sizeof(cstr) - 1u);
+				for (uint32_t k = 0u; k < max_c; k++) {
+					uint32_t cw = s5b_part_rd32(doff + (k & ~3u));
+					char ch = (char)((cw >> ((k & 3u) * 8u)) & 0xffu);
+					cstr[k] = (ch >= 32 && ch <= 126) ? ch : '.';
+				}
+				cstr[max_c] = '\0';
+				printf("WIFI PROBE: [5B.2]     id=%u data: '%s'\n", it, cstr);
+
+				/* Dump first 32 bytes in hex */
+				printf("WIFI PROBE: [5B.2]     id=%u hex:", it);
+				for (uint32_t w = 0u; w < 8u && w * 4u < sz; w++) {
+					printf(" %08x", s5b_part_rd32(doff + w * 4u));
+				}
+				printf("\n");
+
+				if (doff < p07_hdr_stride) break;
+				ce = doff - p07_hdr_stride;
+				c_idx++;
+			}
+		}
+
+		/* 2. Check crash items explicitly via s5b_smem_get_item (including cached region) */
+		static const uint16_t crash_items[] = { 421u, 134u, 133u, 424u };
+		for (unsigned ci = 0u; ci < sizeof(crash_items)/sizeof(crash_items[0]); ci++) {
+			uint32_t coff = 0u, csz = 0u;
+			if (s5b_smem_get_item(crash_items[ci], &coff, &csz)) {
+				char cstr[256];
+				for (unsigned i = 0u; i < sizeof(cstr); i++) cstr[i] = '\0';
+				uint32_t max_c = (csz < sizeof(cstr) - 1u) ? csz : (uint32_t)(sizeof(cstr) - 1u);
+				for (uint32_t k = 0u; k < max_c; k++) {
+					uint32_t cw = s5b_part_rd32(coff + (k & ~3u));
+					char ch = (char)((cw >> ((k & 3u) * 8u)) & 0xffu);
+					cstr[k] = (ch >= 32 && ch <= 126) ? ch : (ch == '\0' ? '\0' : '.');
+					if (ch == '\0') break;
+				}
+				cstr[sizeof(cstr) - 1u] = '\0';
+				printf("WIFI PROBE: [5B.2] *** MPSS SMEM CRASH ITEM %u: '%s' ***\n",
+				    crash_items[ci], cstr);
+			}
+		}
+	}
+
+	/* 2.5 Check SMEM Common Partition (0xFFFE:0xFFFE) for subsystem failure reasons */
+	if (s_smem_comm_pa != 0u && s_smem_comm_sz >= 0x40u) {
+		uint32_t comm_map_len = (s_smem_comm_sz < 0x20000u) ? s_smem_comm_sz : 0x20000u;
+		vm_offset_t comm_va = ml_io_map(s_smem_comm_pa, comm_map_len);
+		if (comm_va) {
+			uint32_t cmagic = probe_rd32(comm_va, 0u);
+			uint32_t c_free_unc = probe_rd32(comm_va, 0x0cu);
+			uint32_t c_free_cac = probe_rd32(comm_va, 0x10u);
+			printf("WIFI PROBE: [5B.2] SMEM Common Partition (%uKB @ 0x%08x): magic=0x%08x free_unc=0x%x free_cac=0x%x\n",
+			    s_smem_comm_sz / 1024u, s_smem_comm_pa, cmagic, c_free_unc, c_free_cac);
+			if (cmagic == SMEM_PART_MAGIC) {
+				uint32_t coff = 0x20u;
+				uint32_t cidx = 0u;
+				while (coff + 16u <= c_free_unc && coff <= comm_map_len - 16u && cidx < 64u) {
+					uint32_t cw0 = probe_rd32(comm_va, coff);
+					if ((uint16_t)cw0 != SMEM_PRIVATE_CANARY) {
+						break;
+					}
+					uint16_t it   = (uint16_t)(cw0 >> 16);
+					uint32_t sz   = probe_rd32(comm_va, coff + 4u);
+					uint32_t cw2  = probe_rd32(comm_va, coff + 8u);
+					uint16_t pdat = (uint16_t)cw2;
+					uint16_t phdr = (uint16_t)(cw2 >> 16);
+					if ((uint32_t)phdr > comm_map_len - (coff + 16u) ||
+					    sz > comm_map_len - (coff + 16u + (uint32_t)phdr)) {
+						break;
+					}
+					uint32_t cpoff = coff + 16u + (uint32_t)phdr;
+					uint32_t cusz  = (pdat < sz) ? (sz - pdat) : sz;
+
+					char cstr[256];
+					for (unsigned i = 0u; i < sizeof(cstr); i++) cstr[i] = '\0';
+					uint32_t max_c = (cusz < sizeof(cstr) - 1u) ? cusz : (uint32_t)(sizeof(cstr) - 1u);
+					for (uint32_t k = 0u; k < max_c; k++) {
+						uint32_t cw = probe_rd32(comm_va, cpoff + (k & ~3u));
+						char ch = (char)((cw >> ((k & 3u) * 8u)) & 0xffu);
+						cstr[k] = (ch >= 32 && ch <= 126) ? ch : (ch == '\0' ? '\0' : '.');
+						if (ch == '\0') break;
+					}
+				cstr[sizeof(cstr) - 1u] = '\0';
+
+					if (it == 421u) {
+						printf("WIFI PROBE: [5B.2] *** MPSS SSR REASON (Common Part item 421): '%s' (sz=%u) ***\n",
+						    cstr, sz);
+					} else if (it == 408u || it == 409u || it == 6u) {
+						printf("WIFI PROBE: [5B.2] *** MPSS CRASH ITEM %u (Common Part): '%s' (sz=%u) ***\n",
+						    it, cstr, sz);
+					} else if (cstr[0] >= 32 && cstr[0] <= 126) {
+						printf("WIFI PROBE: [5B.2]   Common Partition item[%u]: id=%u sz=%u '%s'\n",
+						    cidx, it, sz, cstr);
+					}
+					coff = cpoff + sz;
+					cidx++;
+				}
+
+				/* Also inspect cached heap of Common Partition */
+				uint32_t ccl = (s_smem_comm_cacheline >= 16u) ? s_smem_comm_cacheline : 32u;
+				uint32_t chdr_stride = (16u + ccl - 1u) & ~(ccl - 1u);
+				if (comm_map_len >= chdr_stride) {
+					uint32_t c_ce = comm_map_len - chdr_stride;
+					while (c_ce > c_free_cac && c_ce + chdr_stride <= comm_map_len) {
+						uint32_t cw0 = probe_rd32(comm_va, c_ce);
+						if ((uint16_t)cw0 != SMEM_PRIVATE_CANARY) {
+							break;
+						}
+						uint16_t it   = (uint16_t)(cw0 >> 16);
+						uint32_t sz   = probe_rd32(comm_va, c_ce + 4u);
+						uint32_t cw2  = probe_rd32(comm_va, c_ce + 8u);
+						uint16_t pdat = (uint16_t)cw2;
+						uint16_t phdr = (uint16_t)(cw2 >> 16);
+						if (sz == 0u || sz > comm_map_len) break;
+						uint32_t cpoff = c_ce - sz;
+						uint32_t cusz  = (pdat < sz) ? (sz - pdat) : sz;
+
+						char cstr[256];
+						for (unsigned i = 0u; i < sizeof(cstr); i++) cstr[i] = '\0';
+						uint32_t max_c = (cusz < sizeof(cstr) - 1u) ? cusz : (uint32_t)(sizeof(cstr) - 1u);
+						for (uint32_t k = 0u; k < max_c; k++) {
+							uint32_t cw = probe_rd32(comm_va, cpoff + (k & ~3u));
+							char ch = (char)((cw >> ((k & 3u) * 8u)) & 0xffu);
+							cstr[k] = (ch >= 32 && ch <= 126) ? ch : (ch == '\0' ? '\0' : '.');
+							if (ch == '\0') break;
+						}
+						cstr[sizeof(cstr) - 1u] = '\0';
+
+						if (it == 421u) {
+							printf("WIFI PROBE: [5B.2] *** MPSS SSR REASON (Common Part cached item 421): '%s' (sz=%u) ***\n",
+							    cstr, sz);
+						} else if (it == 408u || it == 409u || it == 6u) {
+							printf("WIFI PROBE: [5B.2] *** MPSS CRASH ITEM %u (Common Part cached): '%s' (sz=%u) ***\n",
+							    it, cstr, sz);
+						}
+						if (cpoff < chdr_stride) break;
+						c_ce = cpoff - chdr_stride;
+					}
+				}
+			}
+		}
+	}
+
+	/* 3. Check global SMEM table @ POPLAR_SMEM_BASE_PA (full 772 KB TOC[11] mapping) */
+	if (!s_smem_base_va) {
+		s_smem_base_va = ml_io_map(POPLAR_SMEM_BASE_PA, 0xc1000u);
+	}
+	vm_offset_t p11_va = s_smem_base_va;
+	if (p11_va) {
+		uint32_t magic = probe_rd32(p11_va, 0u);
+		if (magic == 0x54525024u) { /* "$PRT" */
+			uint32_t p11_free_unc = probe_rd32(p11_va, 0x0cu);
+			printf("WIFI PROBE: [5B.2] SMEM p[11] ($PRT) free_unc=0x%x:\n", p11_free_unc);
+			uint32_t off = 0x20u;
+			uint32_t item_idx = 0u;
+			while (off + 16u <= p11_free_unc && off <= 0xc1000u - 16u && item_idx < 64u) {
+				uint32_t w0 = probe_rd32(p11_va, off);
+				if ((uint16_t)w0 != SMEM_PRIVATE_CANARY) {
+					break;
+				}
+				uint16_t it   = (uint16_t)(w0 >> 16);
+				uint32_t sz   = probe_rd32(p11_va, off + 4u);
+				uint32_t w2   = probe_rd32(p11_va, off + 8u);
+				uint16_t pdat = (uint16_t)w2;
+				uint16_t phdr = (uint16_t)(w2 >> 16);
+				uint32_t poff = off + 16u + (uint32_t)phdr;
+				uint32_t usz  = (pdat < sz) ? (sz - pdat) : sz;
+				char cstr[256];
+				for (unsigned i = 0u; i < sizeof(cstr); i++) cstr[i] = '\0';
+				uint32_t max_c = (usz < sizeof(cstr) - 1u) ? usz : (uint32_t)(sizeof(cstr) - 1u);
+				for (uint32_t k = 0u; k < max_c; k++) {
+					uint32_t cw = probe_rd32(p11_va, poff + (k & ~3u));
+					char ch = (char)((cw >> ((k & 3u) * 8u)) & 0xffu);
+					cstr[k] = (ch >= 32 && ch <= 126) ? ch : (ch == '\0' ? '\0' : '.');
+					if (ch == '\0') break;
+				}
+				cstr[sizeof(cstr) - 1u] = '\0';
+				if (it == 421u) {
+					printf("WIFI PROBE: [5B.2] *** MPSS CRASH REASON (p[11] item 421): '%s' ***\n", cstr);
+				} else {
+					printf("WIFI PROBE: [5B.2]   p[11] item[%u]: id=%u sz=%u '%s'\n", item_idx, it, sz, cstr);
+				}
+				off = poff + sz;
+				item_idx++;
+			}
+		} else {
+			/* Standard Qualcomm Global SMEM Table mode */
+			uint32_t init     = probe_rd32(p11_va, 0xc0u);
+			uint32_t free_off = probe_rd32(p11_va, 0xc4u);
+			uint32_t avail    = probe_rd32(p11_va, 0xc8u);
+			printf("WIFI PROBE: [5B.2] Global SMEM table: init=%u free_off=0x%x avail=0x%x\n",
+			    init, free_off, avail);
+
+			uint32_t alloc_count = 0u;
+			for (uint32_t it = 0u; it < 512u; it++) {
+				uint32_t ent_off  = 0xd0u + it * 16u;
+				uint32_t alloc    = probe_rd32(p11_va, ent_off + 0u);
+				uint32_t item_off = probe_rd32(p11_va, ent_off + 4u);
+				uint32_t item_sz  = probe_rd32(p11_va, ent_off + 8u);
+				if (alloc != 0u && item_sz > 0u) {
+					alloc_count++;
+					char cstr[128];
+					for (unsigned i = 0u; i < sizeof(cstr); i++) cstr[i] = '\0';
+					if (item_off < 0xc1000u) {
+						uint32_t max_c = (item_sz < sizeof(cstr) - 1u) ? item_sz : (uint32_t)(sizeof(cstr) - 1u);
+						if (item_off + max_c > 0xc1000u) {
+							max_c = 0xc1000u - item_off;
+						}
+						for (uint32_t k = 0u; k < max_c; k++) {
+							uint32_t cw = probe_rd32(p11_va, item_off + (k & ~3u));
+							char ch = (char)((cw >> ((k & 3u) * 8u)) & 0xffu);
+							cstr[k] = (ch >= 32 && ch <= 126) ? ch : (ch == '\0' ? '\0' : '.');
+							if (ch == '\0') break;
+						}
+						cstr[sizeof(cstr) - 1u] = '\0';
+					}
+					uint32_t w0 = (item_off + 4u <= 0xc1000u) ? probe_rd32(p11_va, item_off) : 0u;
+					uint32_t w1 = (item_off + 8u <= 0xc1000u) ? probe_rd32(p11_va, item_off + 4u) : 0u;
+					printf("WIFI PROBE: [5B.2]   Global SMEM item[%u]: sz=%u off=0x%x [w0=0x%08x w1=0x%08x] '%s'\n",
+					    it, item_sz, item_off, w0, w1, cstr);
+					if (it == 402u) {
+						/* SMEM_USABLE_RAM_PARTITION_TABLE (Item 402) */
+						if (item_off + 24u <= 0xc1000u) {
+							uint32_t m0  = probe_rd32(p11_va, item_off + 0x00u);
+							uint32_t m1  = probe_rd32(p11_va, item_off + 0x04u);
+							uint32_t ver = probe_rd32(p11_va, item_off + 0x08u);
+							uint32_t rsv = probe_rd32(p11_va, item_off + 0x0cu);
+							uint32_t len = probe_rd32(p11_va, item_off + 0x10u);
+							uint32_t buf = probe_rd32(p11_va, item_off + 0x14u);
+							printf("WIFI PROBE: [5B.2] RAM Partition Table: magic=0x%08x:0x%08x ver=%u len=%u (buf=0x%x rsv=0x%x)\n",
+							    m0, m1, ver, len, buf, rsv);
+							if (m0 == 0x9da5e0a8u && m1 == 0xaf9ec4e2u) {
+								uint32_t max_p = (len < 32u) ? len : 32u;
+								/* 72 bytes per entry (24 header + 32 * 72 = 2328 bytes) */
+								for (uint32_t pi = 0u; pi < max_p; pi++) {
+									uint32_t poff = item_off + 24u + pi * 72u;
+									if (poff + 72u > 0xc1000u) break;
+									char pname[17];
+									for (uint32_t k = 0u; k < 4u; k++) {
+										uint32_t pw = probe_rd32(p11_va, poff + k * 4u);
+										pname[k * 4u + 0u] = (char)(pw & 0xffu);
+										pname[k * 4u + 1u] = (char)((pw >> 8) & 0xffu);
+										pname[k * 4u + 2u] = (char)((pw >> 16) & 0xffu);
+										pname[k * 4u + 3u] = (char)((pw >> 24) & 0xffu);
+									}
+									pname[16] = '\0';
+									uint64_t start_addr = (uint64_t)probe_rd32(p11_va, poff + 16u) |
+									    ((uint64_t)probe_rd32(p11_va, poff + 20u) << 32);
+									uint64_t part_size  = (uint64_t)probe_rd32(p11_va, poff + 24u) |
+									    ((uint64_t)probe_rd32(p11_va, poff + 28u) << 32);
+									uint32_t attr = probe_rd32(p11_va, poff + 32u);
+									uint32_t cat  = probe_rd32(p11_va, poff + 36u);
+									uint32_t dom  = probe_rd32(p11_va, poff + 40u);
+									uint32_t typ  = probe_rd32(p11_va, poff + 44u);
+
+									printf("WIFI PROBE: [5B.2]   RAM Part[%u]: '%-16s' start=0x%016llx sz=0x%016llx (%llu MB) attr=0x%x cat=0x%x dom=0x%x typ=0x%x\n",
+									    pi, pname,
+									    (unsigned long long)start_addr,
+									    (unsigned long long)part_size,
+									    (unsigned long long)(part_size / (1024ULL * 1024ULL)),
+									    attr, cat, dom, typ);
+								}
+							}
+						}
+					}
+					if (it == 79u) {
+						/* SMEM_LOG (Item 79, 40 KB circular buffer) */
+						printf("WIFI PROBE: [5B.2]   SMEM_LOG (item 79) header:");
+						for (unsigned w = 0u; w < 8u; w++) {
+							printf(" %08x", probe_rd32(p11_va, item_off + w * 4u));
+						}
+						printf("\n");
+					}
+					if (it == 404u) {
+						/* SMEM_RLOCK_AREA (Item 404, 8 KB) */
+						printf("WIFI PROBE: [5B.2]   SMEM_RLOCK_AREA (item 404) header:");
+						for (unsigned w = 0u; w < 8u; w++) {
+							printf(" %08x", probe_rd32(p11_va, item_off + w * 4u));
+						}
+						printf("\n");
+					}
+					if (it == 421u || it == 408u || it == 404u || it == 79u || it == 135u || it == 473u || it == 474u) {
+						if (item_off < 0xc1000u && item_sz > 0u) {
+							char sbuf[128];
+							unsigned s_len = 0u;
+							uint32_t scan_n = (item_sz < 16384u) ? item_sz : 16384u;
+							if (item_off + scan_n > 0xc1000u) scan_n = 0xc1000u - item_off;
+							for (uint32_t si = 0u; si < scan_n; si++) {
+								uint32_t cw = probe_rd32(p11_va, item_off + (si & ~3u));
+								char ch = (char)((cw >> ((si & 3u) * 8u)) & 0xffu);
+								if (ch >= 32 && ch <= 126) {
+									if (s_len < sizeof(sbuf) - 1u) sbuf[s_len++] = ch;
+								} else {
+									if (s_len >= 4u) {
+										sbuf[s_len] = '\0';
+										printf("WIFI PROBE: [5B.2]     item[%u]+%u ASCII: '%s'\n",
+										    it, (unsigned)(si - s_len), sbuf);
+									}
+									s_len = 0u;
+								}
+							}
+							if (s_len >= 4u) {
+								sbuf[s_len] = '\0';
+								printf("WIFI PROBE: [5B.2]     item[%u] ASCII: '%s'\n", it, sbuf);
+							}
+						}
+					}
+				}
+			}
+			printf("WIFI PROBE: [5B.2] Global SMEM total allocated items: %u\n", alloc_count);
+		}
+	}
+	if (s5b.ssctl_up) {
+		s5b_ssctl_query_failure_reason("post-fatal");
+	}
+	s5b_audit_post_fatal_diagnostics();
+	printf("WIFI PROBE: [5B.2] =======================================================\n");
+}
+
+static void
+s5b_smp2p_service(void)
+{
+	if (s5b.smp2p_in_off == 0u) {
+		(void)s5b_smem_get_item(SMEM_SMP2P_IN_MODEM_ID, &s5b.smp2p_in_off, NULL);
+		if (s5b.smp2p_in_off == 0u) {
+			return;
+		}
+	}
+	if (s5b.smp2p_out_off != 0u) {
+		uint32_t in_flags  = s5b_part_rd32(s5b.smp2p_in_off + 16u);
+		uint32_t want_ack  = (in_flags & 1u) ? 2u : 0u;
+		uint32_t out_flags = s5b_part_rd32(s5b.smp2p_out_off + 16u);
+		if ((out_flags & 2u) != want_ack) {
+			s5b_part_wr32(s5b.smp2p_out_off + 16u, (out_flags & ~2u) | want_ack);
+			s5b_smp2p_kick();
+			printf("WIFI PROBE: [5B.2] SMP2P restart %s (in_flags=0x%x)\n",
+			    want_ack ? "acked" : "ack cleared", in_flags);
+		}
+	}
+	uint32_t valid_e = s5b_part_rd32(s5b.smp2p_in_off + 12u) >> 16;
+	if (valid_e > 16u) {
+		valid_e = 16u;
+	}
+	for (uint32_t e = 0u; e < valid_e; e++) {
+		uint32_t eoff = s5b.smp2p_in_off + 20u + e * 20u;
+		char ename[17];
+		for (uint32_t k = 0u; k < 4u; k++) {
+			uint32_t cw = s5b_part_rd32(eoff + k * 4u);
+			ename[k * 4u + 0u] = (char)(cw & 0xffu);
+			ename[k * 4u + 1u] = (char)((cw >> 8) & 0xffu);
+			ename[k * 4u + 2u] = (char)((cw >> 16) & 0xffu);
+			ename[k * 4u + 3u] = (char)((cw >> 24) & 0xffu);
+		}
+		ename[16] = '\0';
+		if (strcmp(ename, "slave-kernel") == 0) {
+			uint32_t v = s5b_part_rd32(eoff + 16u);
+			if (v != s5b.smp2p_last_state) {
+				uint32_t prev_st = s5b.smp2p_last_state;
+				s5b.smp2p_last_state = v;
+				printf("WIFI PROBE: [5B.2] SMP2P inbound[%u] 'slave-kernel' (+0x%03x): 0x%x -> 0x%x%s%s%s%s\n",
+				    e, eoff, prev_st, v,
+				    (v & 1u) ? " ERR-FATAL" : "",
+				    (v & 2u) ? " ready" : "",
+				    (v & 4u) ? " handover" : "",
+				    (v & 8u) ? " stop-ack" : "");
+				if (v & 1u) {
+					s5b_dump_mpss_crash_reason();
+				}
+			}
+		} else if (strcmp(ename, "ipa") == 0) {
+			uint32_t v = s5b_part_rd32(eoff + 16u);
+			if (!s5b.smp2p_ipa_in_seen || v != s5b.smp2p_ipa_in_last) {
+				bool first = !s5b.smp2p_ipa_in_seen;
+				uint32_t prev = s5b.smp2p_ipa_in_last;
+				s5b.smp2p_ipa_in_seen = true;
+				s5b.smp2p_ipa_in_last = v;
+				printf("WIFI PROBE: [5B.2] SMP2P inbound[%u] 'ipa' (+0x%03x): 0x%x -> 0x%x%s\n",
+				    e, eoff, prev, v, (v & 1u) ? " [QUERY_ASSERTED]" : "");
+				if ((v & 1u) && (first || !(prev & 1u))) {
+					if (s5b.smp2p_out_off != 0u) {
+						s5b.smp2p_ipa_out_val = 1u;
+						s5b_part_wr32(s5b.smp2p_out_off + 56u, 1u); /* answer valid, AP IPA power off */
+						__asm__ volatile("dsb sy" ::: "memory");
+						s5b_smp2p_kick();
+						printf("WIFI PROBE: [5B.2] Answered SMP2P IPA query: ipa-in=0x%x -> ipa-out=1 (AP IPA power off)\n", v);
+					}
+				}
+			}
+		} else {
+			static uint32_t s_unknown_seen_mask = 0u;
+			if ((s_unknown_seen_mask & (1u << e)) == 0u) {
+				s_unknown_seen_mask |= (1u << e);
+				uint32_t v = s5b_part_rd32(eoff + 16u);
+				printf("WIFI PROBE: [5B.2] SMP2P inbound[%u] '%s' (+0x%03x) val=0x%x\n", e, ename, eoff, v);
+			}
+		}
+	}
+}
+
+static void
+s5b_glink_kick(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	probe_wr32(s5b.ipc_va, 0x08u, APCS_IPC_MPSS_GLINK_MASK);
+}
+
+static uint32_t
+s5b_fifo_avail_rx(void)
+{
+	uint32_t head = s5b_part_rd32(s5b.descs_off + s5b.rx_head_idx * 4u);
+	uint32_t tail = s5b_part_rd32(s5b.descs_off + s5b.rx_tail_idx * 4u);
+	return (head >= tail) ? (head - tail) : (s5b.rx_fifo_len - tail + head);
+}
+
+static void
+s5b_fifo_peek_bytes(uint32_t off, uint8_t *dst, uint32_t n)
+{
+	uint32_t tail = s5b_part_rd32(s5b.descs_off + s5b.rx_tail_idx * 4u);
+	uint32_t pos = (tail + off) % s5b.rx_fifo_len;
+	uint32_t i = 0u;
+	while (i < n) {
+		uint32_t w = s5b_part_rd32(s5b.rx_fifo_off + (pos & ~3u));
+		uint32_t shift = (pos & 3u) * 8u;
+		dst[i] = (uint8_t)((w >> shift) & 0xffu);
+		i++;
+		pos++;
+		if (pos >= s5b.rx_fifo_len) {
+			pos = 0u;
+		}
+	}
+}
+
+static void
+s5b_fifo_advance_rx(uint32_t n)
+{
+	uint32_t tail = s5b_part_rd32(s5b.descs_off + s5b.rx_tail_idx * 4u);
+	__asm__ volatile("dsb sy" ::: "memory");
+	s5b_part_wr32(s5b.descs_off + s5b.rx_tail_idx * 4u,
+	    (tail + n) % s5b.rx_fifo_len);
+}
+
+static bool
+s5b_glink_send_raw(const uint8_t *buf, uint32_t n)
+{
+	if (!s5b.bound || s5b.tx_fifo_len == 0u) {
+		return false;
+	}
+	uint32_t total = (n + 7u) & ~7u;
+	if (total >= s5b.tx_fifo_len) {
+		printf("WIFI PROBE: [5B] ERROR: GLINK tx frame %u >= fifo len %u\n",
+		    total, s5b.tx_fifo_len);
+		return false;
+	}
+	for (unsigned tries = 0u;; tries++) {
+		uint32_t head = s5b_part_rd32(s5b.descs_off + s5b.tx_head_idx * 4u);
+		uint32_t tail = s5b_part_rd32(s5b.descs_off + s5b.tx_tail_idx * 4u);
+		uint32_t avail = (tail <= head) ? (s5b.tx_fifo_len - head + tail) : (tail - head);
+		if (avail > total + 16u) {
+			break;
+		}
+		if (tries == 200u) {
+			printf("WIFI PROBE: [5B] ERROR: GLINK TX FIFO full (head=%u tail=%u need=%u)\n",
+			    head, tail, total);
+			return false;
+		}
+		delay(1000);
+	}
+
+	uint32_t pos = s5b_part_rd32(s5b.descs_off + s5b.tx_head_idx * 4u);
+	for (uint32_t i = 0u; i < total; i += 4u) {
+		uint32_t w = 0u;
+		for (uint32_t b = 0u; b < 4u; b++) {
+			if (i + b < n) {
+				w |= ((uint32_t)buf[i + b] << (b * 8u));
+			}
+		}
+		s5b_part_wr32(s5b.tx_fifo_off + pos, w);
+		pos += 4u;
+		if (pos >= s5b.tx_fifo_len) {
+			pos = 0u;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	s5b_part_wr32(s5b.descs_off + s5b.tx_head_idx * 4u, pos);
+	s5b_glink_kick();
+	return true;
+}
+
+static bool
+s5b_glink_send_cmd(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	uint8_t msg[8];
+	s5b_wr_le16(msg + 0, cmd);
+	s5b_wr_le16(msg + 2, p1);
+	s5b_wr_le32(msg + 4, p2);
+	return s5b_glink_send_raw(msg, sizeof(msg));
+}
+
+static bool
+s5b_glink_send_open(uint16_t lcid, const char *name)
+{
+	uint32_t slen = sweet_str_len(name) + 1u;
+	uint8_t msg[48];
+	if (slen > 36u) {
+		return false;
+	}
+	memset(msg, 0, sizeof(msg));
+	s5b_wr_le16(msg + 0, GLINK_CMD_OPEN);
+	s5b_wr_le16(msg + 2, lcid);
+	s5b_wr_le32(msg + 4, slen);
+	memcpy(msg + 8, name, slen);
+	if (lcid == GLINK_LCID_IPCRTR) {
+		s5b.ipcrtr_open_tx = true;
+	} else if (lcid == GLINK_LCID_SSM_RTR) {
+		s5b.ssm_open_tx = true;
+	} else if (lcid == GLINK_LCID_SSR) {
+		s5b.ssr_open_tx = true;
+	}
+	return s5b_glink_send_raw(msg, 8u + slen);
+}
+
+static void
+s5b_glink_seed_channel_intents(uint16_t lcid, uint32_t count, uint32_t sz)
+{
+	uint8_t msg[8u + 8u * 8u];
+	if (count > 8u) {
+		count = 8u;
+	}
+	s5b_wr_le16(msg + 0, GLINK_CMD_INTENT);
+	s5b_wr_le16(msg + 2, lcid);
+	s5b_wr_le32(msg + 4, count);
+	for (uint32_t i = 0u; i < count; i++) {
+		uint32_t liid = s5b.next_liid++;
+		s5b_wr_le32(msg + 8u + i * 8u + 0u, sz);
+		s5b_wr_le32(msg + 8u + i * 8u + 4u, liid);
+		printf("WIFI PROBE: [5B.2] GLINK advertised RX intent on lcid=%u: liid=%u sz=%u\n",
+		    lcid, liid, sz);
+	}
+	if (lcid == GLINK_LCID_SSM_RTR) {
+		s5b.ssm_rx_intents_advertised += count;
+	} else if (lcid == GLINK_LCID_SSR) {
+		s5b.ssr_rx_intents_advertised += count;
+	}
+	(void)s5b_glink_send_raw(msg, 8u + count * 8u);
+}
+
+static void
+s5b_glink_seed_intents(uint32_t count, uint32_t sz)
+{
+	s5b_glink_seed_channel_intents(GLINK_LCID_IPCRTR, count, sz);
+}
+
+static void s5b_ipcrtr_rx_packet(const uint8_t *pkt, uint32_t len);
+static bool s5b_glink_rx_step(void);
+
+static int
+s5b_glink_find_rem_intent(uint32_t len)
+{
+	int best = -1;
+	for (unsigned i = 0u; i < MPSS_MAX_REM_INTENTS; i++) {
+		if (s5b.rem_intents[i].valid && !s5b.rem_intents[i].in_use &&
+		    s5b.rem_intents[i].size >= len) {
+			if (best < 0 || s5b.rem_intents[i].size < s5b.rem_intents[best].size) {
+				best = (int)i;
+			}
+		}
+	}
+	return best;
+}
+
+static bool
+s5b_glink_tx_data(const uint8_t *payload, uint32_t len)
+{
+	if (!s5b.ipcrtr_open_acked || !s5b.ipcrtr_rem_open || len > sizeof(s_5b_tx_pkt_buf) - 16u) {
+		return false;
+	}
+
+	int slot = s5b_glink_find_rem_intent(len);
+	if (slot < 0) {
+		bool prev_wait = s5b.in_intent_wait;
+		s5b.in_intent_wait = true;
+		for (unsigned ms = 0u; ms < 3000u && slot < 0; ms++) {
+			if (ms == 0u || ms == 500u || ms == 1500u) {
+				(void)s5b_glink_send_cmd(GLINK_CMD_RX_INTENT_REQ, 1u, len);
+			}
+			s5b_smp2p_service();
+			while (s5b_glink_rx_step()) {
+			}
+			slot = s5b_glink_find_rem_intent(len);
+			if (slot < 0) {
+				delay(1000);
+			}
+		}
+		s5b.in_intent_wait = prev_wait;
+	}
+
+	if (slot < 0) {
+		printf("WIFI PROBE: [5B] WARN: no MPSS RX intent available for len=%u\n", len);
+		return false;
+	}
+
+	s5b.rem_intents[slot].in_use = true;
+	uint32_t riid = s5b.rem_intents[slot].iid;
+
+	s5b_wr_le16(s_5b_tx_pkt_buf + 0, GLINK_CMD_TX_DATA);
+	s5b_wr_le16(s_5b_tx_pkt_buf + 2, 1u); /* local lcid=1 */
+	s5b_wr_le32(s_5b_tx_pkt_buf + 4, riid);
+	s5b_wr_le32(s_5b_tx_pkt_buf + 8, len);
+	s5b_wr_le32(s_5b_tx_pkt_buf + 12, 0u);
+	memcpy(s_5b_tx_pkt_buf + 16, payload, len);
+	return s5b_glink_send_raw(s_5b_tx_pkt_buf, 16u + len);
+}
+
+static bool
+s5b_glink_rx_step(void)
+{
+	uint32_t avail = s5b_fifo_avail_rx();
+	if (avail < 8u) {
+		return false;
+	}
+
+	uint8_t h[16];
+	s5b_fifo_peek_bytes(0u, h, 8u);
+	uint16_t cmd = s5b_rd_le16(h + 0);
+	uint16_t p1  = s5b_rd_le16(h + 2);
+	uint32_t p2  = s5b_rd_le32(h + 4);
+
+	switch (cmd) {
+	case GLINK_CMD_VERSION:
+		s5b_fifo_advance_rx(8u);
+		if (p1 >= 1u) {
+			s5b.glink_reuse = (p2 & 1u) != 0u;
+			(void)s5b_glink_send_cmd(GLINK_CMD_VERSION_ACK, 1u, p2 & 1u);
+			if (!s5b.link_up) {
+				(void)s5b_glink_send_cmd(GLINK_CMD_VERSION, 1u, 1u);
+			}
+		}
+		break;
+
+	case GLINK_CMD_VERSION_ACK:
+		s5b_fifo_advance_rx(8u);
+		if (p1 == 1u) {
+			s5b.glink_reuse = (p2 & 1u) != 0u;
+			s5b.link_up = true;
+			if (!s5b.ipcrtr_open_tx) {
+				(void)s5b_glink_send_open(1u, "IPCRTR");
+			}
+		}
+		break;
+
+	case GLINK_CMD_OPEN: {
+		uint32_t frame_len = 8u + ((p2 + 7u) & ~7u);
+		if (p2 > 128u || avail < frame_len) {
+			return false;
+		}
+		char cname[40];
+		uint32_t clen = (p2 < sizeof(cname) - 1u) ? p2 : (uint32_t)(sizeof(cname) - 1u);
+		memset(cname, 0, sizeof(cname));
+		s5b_fifo_peek_bytes(8u, (uint8_t *)cname, clen);
+		cname[clen] = '\0';
+		s5b_fifo_advance_rx(frame_len);
+		(void)s5b_glink_send_cmd(GLINK_CMD_OPEN_ACK, p1, 0u);
+		if (strcmp(cname, "IPCRTR") == 0) {
+			s5b.ipcrtr_rcid = p1;
+			s5b.ipcrtr_rem_open = true;
+			if (!s5b.ipcrtr_open_tx) {
+				(void)s5b_glink_send_open(GLINK_LCID_IPCRTR, "IPCRTR");
+			}
+			if (s5b.ipcrtr_open_acked && !s5b.intents_seeded) {
+				s5b.intents_seeded = true;
+				s5b_glink_seed_intents(8u, 8192u);
+			}
+		} else if (strcmp(cname, "glink_ssr") == 0) {
+			s5b.ssr_rcid = p1;
+			s5b.ssr_rem_open = true;
+			printf("WIFI PROBE: [5B.2] GLINK remote open 'glink_ssr' (rcid=%u) acked\n", p1);
+			/* Test C: Open local channel lcid=3 for glink_ssr */
+			if (!s5b.ssr_open_tx) {
+				printf("WIFI PROBE: [5B.2] GLINK SSR sending local open lcid=%u for 'glink_ssr'\n",
+				    GLINK_LCID_SSR);
+				(void)s5b_glink_send_open(GLINK_LCID_SSR, "glink_ssr");
+			}
+			if (s5b.ssr_open_acked && s5b.ssr_rx_intents_advertised == 0u) {
+				s5b_glink_seed_channel_intents(GLINK_LCID_SSR, 2u, 256u);
+				s5b_glink_seed_channel_intents(GLINK_LCID_SSR, 2u, 1024u);
+			}
+		} else if (strcmp(cname, "SSM_RTR_MODEM_APPS") == 0) {
+			s5b.ssm_rcid = p1;
+			s5b.ssm_rem_open = true;
+			printf("WIFI PROBE: [5B.2] GLINK remote open 'SSM_RTR_MODEM_APPS' (rcid=%u) acked\n", p1);
+			/* Test C: Open local channel lcid=2 for SSM_RTR_MODEM_APPS */
+			if (!s5b.ssm_open_tx) {
+				printf("WIFI PROBE: [5B.2] GLINK SSM sending local open lcid=%u for 'SSM_RTR_MODEM_APPS'\n",
+				    GLINK_LCID_SSM_RTR);
+				(void)s5b_glink_send_open(GLINK_LCID_SSM_RTR, "SSM_RTR_MODEM_APPS");
+			}
+			if (s5b.ssm_open_acked && s5b.ssm_rx_intents_advertised == 0u) {
+				s5b_glink_seed_channel_intents(GLINK_LCID_SSM_RTR, 2u, 256u);
+				s5b_glink_seed_channel_intents(GLINK_LCID_SSM_RTR, 2u, 1024u);
+			}
+		} else {
+			printf("WIFI PROBE: [5B.2] GLINK remote open '%s' (rcid=%u) acked\n",
+			    cname, p1);
+		}
+		break;
+	}
+
+	case GLINK_CMD_OPEN_ACK:
+		s5b_fifo_advance_rx(8u);
+		if (p1 == GLINK_LCID_IPCRTR) {
+			s5b.ipcrtr_open_acked = true;
+			if (!s5b.intents_seeded) {
+				s5b.intents_seeded = true;
+				s5b_glink_seed_intents(8u, 8192u);
+			}
+		} else if (p1 == GLINK_LCID_SSM_RTR) {
+			s5b.ssm_open_acked = true;
+			printf("WIFI PROBE: [5B.2] GLINK SSM local open lcid=%u ACKED by modem (rcid=%u)\n",
+			    p1, s5b.ssm_rcid);
+			if (s5b.ssm_rx_intents_advertised == 0u) {
+				s5b_glink_seed_channel_intents(GLINK_LCID_SSM_RTR, 2u, 256u);
+				s5b_glink_seed_channel_intents(GLINK_LCID_SSM_RTR, 2u, 1024u);
+			}
+		} else if (p1 == GLINK_LCID_SSR) {
+			s5b.ssr_open_acked = true;
+			printf("WIFI PROBE: [5B.2] GLINK SSR local open lcid=%u ACKED by modem (rcid=%u)\n",
+			    p1, s5b.ssr_rcid);
+			if (s5b.ssr_rx_intents_advertised == 0u) {
+				s5b_glink_seed_channel_intents(GLINK_LCID_SSR, 2u, 256u);
+				s5b_glink_seed_channel_intents(GLINK_LCID_SSR, 2u, 1024u);
+			}
+		}
+		break;
+
+	case GLINK_CMD_CLOSE:
+		s5b_fifo_advance_rx(8u);
+		(void)s5b_glink_send_cmd(GLINK_CMD_CLOSE_ACK, p1, 0u);
+		if (p1 == s5b.ipcrtr_rcid) {
+			s5b.ipcrtr_rem_open = false;
+		} else if (p1 == s5b.ssm_rcid || p1 == GLINK_LCID_SSM_RTR) {
+			s5b.ssm_rem_open = false;
+			printf("WIFI PROBE: [5B.2] GLINK SSM remote close (ch=%u)\n", p1);
+		} else if (p1 == s5b.ssr_rcid || p1 == GLINK_LCID_SSR) {
+			s5b.ssr_rem_open = false;
+			printf("WIFI PROBE: [5B.2] GLINK SSR remote close (ch=%u)\n", p1);
+		}
+		break;
+
+	case GLINK_CMD_CLOSE_ACK:
+		s5b_fifo_advance_rx(8u);
+		break;
+
+	case GLINK_CMD_INTENT: {
+		if (p2 > 128u) {
+			s5b_fifo_advance_rx(8u);
+			break;
+		}
+		uint32_t frame_len = 8u + p2 * 8u;
+		if (avail < frame_len) {
+			return false;
+		}
+		for (uint32_t k = 0u; k < p2; k++) {
+			uint8_t ib[8];
+			s5b_fifo_peek_bytes(8u + k * 8u, ib, 8u);
+			if (p1 == s5b.ipcrtr_rcid && s5b.ipcrtr_rem_open) {
+				uint32_t sz  = s5b_rd_le32(ib + 0);
+				uint32_t iid = s5b_rd_le32(ib + 4);
+				for (unsigned s = 0u; s < MPSS_MAX_REM_INTENTS; s++) {
+					if (!s5b.rem_intents[s].valid) {
+						s5b.rem_intents[s].iid = iid;
+						s5b.rem_intents[s].size = sz;
+						s5b.rem_intents[s].valid = true;
+						s5b.rem_intents[s].in_use = false;
+						break;
+					}
+				}
+			} else if (p1 == s5b.ssm_rcid || p1 == GLINK_LCID_SSM_RTR) {
+				uint32_t sz  = s5b_rd_le32(ib + 0);
+				uint32_t iid = s5b_rd_le32(ib + 4);
+				s5b.ssm_tx_intents_received++;
+				printf("WIFI PROBE: [5B.2] GLINK SSM remote advertised TX intent: iid=%u sz=%u (ch=%u total_rx_int=%u)\n",
+				    iid, sz, p1, s5b.ssm_tx_intents_received);
+			} else if (p1 == s5b.ssr_rcid || p1 == GLINK_LCID_SSR) {
+				uint32_t sz  = s5b_rd_le32(ib + 0);
+				uint32_t iid = s5b_rd_le32(ib + 4);
+				s5b.ssr_tx_intents_received++;
+				printf("WIFI PROBE: [5B.2] GLINK SSR remote advertised TX intent: iid=%u sz=%u (ch=%u total_rx_int=%u)\n",
+				    iid, sz, p1, s5b.ssr_tx_intents_received);
+			}
+		}
+		s5b_fifo_advance_rx(frame_len);
+		break;
+	}
+
+	case GLINK_CMD_RX_DONE:
+	case GLINK_CMD_RX_DONE_W_REUSE:
+		s5b_fifo_advance_rx(8u);
+		if (p1 == s5b.ipcrtr_rcid) {
+			for (unsigned s = 0u; s < MPSS_MAX_REM_INTENTS; s++) {
+				if (s5b.rem_intents[s].valid && s5b.rem_intents[s].iid == p2) {
+					if (cmd == GLINK_CMD_RX_DONE_W_REUSE) {
+						s5b.rem_intents[s].in_use = false;
+					} else {
+						s5b.rem_intents[s].valid = false;
+						s5b.rem_intents[s].in_use = false;
+					}
+					break;
+				}
+			}
+		} else if (p1 == s5b.ssm_rcid || p1 == GLINK_LCID_SSM_RTR) {
+			printf("WIFI PROBE: [5B.2] GLINK SSM remote rx_done%s: iid=%u (ch=%u)\n",
+			    (cmd == GLINK_CMD_RX_DONE_W_REUSE) ? "_w_reuse" : "", p2, p1);
+		} else if (p1 == s5b.ssr_rcid || p1 == GLINK_LCID_SSR) {
+			printf("WIFI PROBE: [5B.2] GLINK SSR remote rx_done%s: iid=%u (ch=%u)\n",
+			    (cmd == GLINK_CMD_RX_DONE_W_REUSE) ? "_w_reuse" : "", p2, p1);
+		}
+		break;
+
+	case GLINK_CMD_RX_INTENT_REQ:
+		s5b_fifo_advance_rx(8u);
+		if (p1 == s5b.ipcrtr_rcid) {
+			uint32_t grant_sz = (p2 > 8192u) ? 8192u : ((p2 < 2048u) ? 2048u : p2);
+			s5b_glink_seed_intents(1u, grant_sz);
+			(void)s5b_glink_send_cmd(GLINK_CMD_RX_INTENT_REQ_ACK, 1u, 1u);
+		} else if (p1 == s5b.ssm_rcid || p1 == GLINK_LCID_SSM_RTR) {
+			printf("WIFI PROBE: [5B.2] GLINK SSM remote requested RX intent: req_sz=%u (ch=%u)\n", p2, p1);
+			uint32_t grant_sz = (p2 < 256u) ? 256u : p2;
+			s5b_glink_seed_channel_intents(GLINK_LCID_SSM_RTR, 1u, grant_sz);
+			(void)s5b_glink_send_cmd(GLINK_CMD_RX_INTENT_REQ_ACK, GLINK_LCID_SSM_RTR, 1u);
+		} else if (p1 == s5b.ssr_rcid || p1 == GLINK_LCID_SSR) {
+			printf("WIFI PROBE: [5B.2] GLINK SSR remote requested RX intent: req_sz=%u (ch=%u)\n", p2, p1);
+			uint32_t grant_sz = (p2 < 256u) ? 256u : p2;
+			s5b_glink_seed_channel_intents(GLINK_LCID_SSR, 1u, grant_sz);
+			(void)s5b_glink_send_cmd(GLINK_CMD_RX_INTENT_REQ_ACK, GLINK_LCID_SSR, 1u);
+		} else {
+			(void)s5b_glink_send_cmd(GLINK_CMD_RX_INTENT_REQ_ACK, 0u, 0u);
+		}
+		break;
+
+	case GLINK_CMD_RX_INTENT_REQ_ACK:
+		s5b_fifo_advance_rx(8u);
+		break;
+
+	case GLINK_CMD_TX_DATA:
+	case GLINK_CMD_TX_DATA_CONT: {
+		if (avail < 16u) {
+			return false;
+		}
+		s5b_fifo_peek_bytes(0u, h, 16u);
+		uint32_t liid  = s5b_rd_le32(h + 4);
+		uint32_t chunk = s5b_rd_le32(h + 8);
+		uint32_t left  = s5b_rd_le32(h + 12);
+		uint32_t frame_len = (16u + chunk + 7u) & ~7u;
+		if (avail < frame_len) {
+			return false;
+		}
+		if (p1 == s5b.ipcrtr_rcid) {
+			if (cmd == GLINK_CMD_TX_DATA) {
+				s5b.rx_pkt_len = 0u;
+				s5b.rx_pkt_active = true;
+			}
+			if (s5b.rx_pkt_active && s5b.rx_pkt_len + chunk <= sizeof(s_5b_rx_pkt_buf)) {
+				s5b_fifo_peek_bytes(16u, s_5b_rx_pkt_buf + s5b.rx_pkt_len, chunk);
+				s5b.rx_pkt_len += chunk;
+			} else {
+				s5b.rx_pkt_active = false;
+			}
+		} else if (p1 == s5b.ssm_rcid || p1 == GLINK_LCID_SSM_RTR) {
+			if (cmd == GLINK_CMD_TX_DATA) {
+				s5b.ssm_rx_pkt_len = 0u;
+				s5b.ssm_rx_pkt_active = true;
+			}
+			if (s5b.ssm_rx_pkt_active && s5b.ssm_rx_pkt_len + chunk <= sizeof(s_5b_ssm_rx_pkt_buf)) {
+				s5b_fifo_peek_bytes(16u, s_5b_ssm_rx_pkt_buf + s5b.ssm_rx_pkt_len, chunk);
+				s5b.ssm_rx_pkt_len += chunk;
+			} else {
+				s5b.ssm_rx_pkt_active = false;
+			}
+		} else if (p1 == s5b.ssr_rcid || p1 == GLINK_LCID_SSR) {
+			if (cmd == GLINK_CMD_TX_DATA) {
+				s5b.ssr_rx_pkt_len = 0u;
+				s5b.ssr_rx_pkt_active = true;
+			}
+			if (s5b.ssr_rx_pkt_active && s5b.ssr_rx_pkt_len + chunk <= sizeof(s_5b_ssr_rx_pkt_buf)) {
+				s5b_fifo_peek_bytes(16u, s_5b_ssr_rx_pkt_buf + s5b.ssr_rx_pkt_len, chunk);
+				s5b.ssr_rx_pkt_len += chunk;
+			} else {
+				s5b.ssr_rx_pkt_active = false;
+			}
+		}
+		s5b_fifo_advance_rx(frame_len);
+		if (p1 == s5b.ipcrtr_rcid && left == 0u) {
+			uint32_t plen = s5b.rx_pkt_active ? s5b.rx_pkt_len : 0u;
+			s5b.rx_pkt_active = false;
+			s5b.rx_pkt_len = 0u;
+			if (s5b.glink_reuse) {
+				(void)s5b_glink_send_cmd(GLINK_CMD_RX_DONE_W_REUSE, 1u, liid);
+			} else {
+				(void)s5b_glink_send_cmd(GLINK_CMD_RX_DONE, 1u, liid);
+				s5b_glink_seed_intents(1u, 8192u);
+			}
+			if (plen > 0u) {
+				if (s5b.in_intent_wait) {
+					uint32_t nxt = (s5b.rxq_head + 1u) % IPCRTR_RXQ_SLOTS;
+					if (nxt != s5b.rxq_tail && plen <= sizeof(s5b.rxq[0].data)) {
+						s5b.rxq[s5b.rxq_head].len = plen;
+						memcpy(s5b.rxq[s5b.rxq_head].data, s_5b_rx_pkt_buf, plen);
+						s5b.rxq_head = nxt;
+					}
+				} else {
+					s5b_ipcrtr_rx_packet(s_5b_rx_pkt_buf, plen);
+				}
+			}
+		} else if ((p1 == s5b.ssm_rcid || p1 == GLINK_LCID_SSM_RTR) && left == 0u) {
+			uint32_t plen = s5b.ssm_rx_pkt_active ? s5b.ssm_rx_pkt_len : 0u;
+			s5b.ssm_rx_pkt_active = false;
+			s5b.ssm_rx_pkt_len = 0u;
+			s5b.ssm_rx_packets++;
+			s5b.ssm_rx_bytes += plen;
+			printf("WIFI PROBE: [5B.2] *** GLINK SSM RX PACKET #%u *** len=%u liid=%u (ch=%u total_bytes=%u)\n",
+			    s5b.ssm_rx_packets, plen, liid, p1, s5b.ssm_rx_bytes);
+			uint32_t dlen = (plen < 64u) ? plen : 64u;
+			char hdump[200];
+			uint32_t hoff = 0u;
+			for (uint32_t b = 0u; b < dlen; b++) {
+				hoff += snprintf(hdump + hoff, sizeof(hdump) - hoff, "%02x ", s_5b_ssm_rx_pkt_buf[b]);
+			}
+			printf("WIFI PROBE: [5B.2]   SSM packet hex (%u bytes): %s\n", plen, hdump);
+			if (s5b.glink_reuse) {
+				(void)s5b_glink_send_cmd(GLINK_CMD_RX_DONE_W_REUSE, GLINK_LCID_SSM_RTR, liid);
+				printf("WIFI PROBE: [5B.2] GLINK SSM RX done with reuse (lcid=%u liid=%u)\n", GLINK_LCID_SSM_RTR, liid);
+			} else {
+				(void)s5b_glink_send_cmd(GLINK_CMD_RX_DONE, GLINK_LCID_SSM_RTR, liid);
+				printf("WIFI PROBE: [5B.2] GLINK SSM RX done (lcid=%u liid=%u), re-seeding intent\n", GLINK_LCID_SSM_RTR, liid);
+				s5b_glink_seed_channel_intents(GLINK_LCID_SSM_RTR, 1u, (plen < 256u) ? 256u : 1024u);
+			}
+		} else if ((p1 == s5b.ssr_rcid || p1 == GLINK_LCID_SSR) && left == 0u) {
+			uint32_t plen = s5b.ssr_rx_pkt_active ? s5b.ssr_rx_pkt_len : 0u;
+			s5b.ssr_rx_pkt_active = false;
+			s5b.ssr_rx_pkt_len = 0u;
+			s5b.ssr_rx_packets++;
+			s5b.ssr_rx_bytes += plen;
+			printf("WIFI PROBE: [5B.2] *** GLINK SSR RX PACKET #%u *** len=%u liid=%u (ch=%u total_bytes=%u)\n",
+			    s5b.ssr_rx_packets, plen, liid, p1, s5b.ssr_rx_bytes);
+			uint32_t dlen = (plen < 64u) ? plen : 64u;
+			char hdump[200];
+			uint32_t hoff = 0u;
+			for (uint32_t b = 0u; b < dlen; b++) {
+				hoff += snprintf(hdump + hoff, sizeof(hdump) - hoff, "%02x ", s_5b_ssr_rx_pkt_buf[b]);
+			}
+			printf("WIFI PROBE: [5B.2]   SSR packet hex (%u bytes): %s\n", plen, hdump);
+			if (s5b.glink_reuse) {
+				(void)s5b_glink_send_cmd(GLINK_CMD_RX_DONE_W_REUSE, GLINK_LCID_SSR, liid);
+				printf("WIFI PROBE: [5B.2] GLINK SSR RX done with reuse (lcid=%u liid=%u)\n", GLINK_LCID_SSR, liid);
+			} else {
+				(void)s5b_glink_send_cmd(GLINK_CMD_RX_DONE, GLINK_LCID_SSR, liid);
+				printf("WIFI PROBE: [5B.2] GLINK SSR RX done (lcid=%u liid=%u), re-seeding intent\n", GLINK_LCID_SSR, liid);
+				s5b_glink_seed_channel_intents(GLINK_LCID_SSR, 1u, (plen < 256u) ? 256u : 1024u);
+			}
+		}
+		break;
+	}
+
+	case GLINK_CMD_READ_NOTIF:
+		s5b_fifo_advance_rx(8u);
+		s5b_glink_kick();
+		break;
+
+	case GLINK_CMD_SIGNALS:
+		s5b_fifo_advance_rx(8u);
+		break;
+
+	default:
+		printf("WIFI PROBE: [5B.2] GLINK unknown cmd=%u p1=%u p2=0x%x\n", cmd, p1, p2);
+		s5b_fifo_advance_rx(8u);
+		break;
+	}
+	return true;
+}
+
+static void
+s5b_pump_all(void)
+{
+	s5b_smp2p_service();
+	while (s5b_glink_rx_step()) {
+	}
+	while (!s5b.in_intent_wait && s5b.rxq_tail != s5b.rxq_head) {
+		uint32_t idx = s5b.rxq_tail;
+		uint32_t plen = s5b.rxq[idx].len;
+		s5b.rxq_tail = (idx + 1u) % IPCRTR_RXQ_SLOTS;
+		s5b_ipcrtr_rx_packet(s5b.rxq[idx].data, plen);
+	}
+}
+
+static bool
+s5b_ipcrtr_send(uint32_t type, uint32_t src_port, uint32_t dst_node, uint32_t dst_port,
+    const void *payload, uint32_t size)
+{
+	uint32_t pad_sz = (size + 3u) & ~3u;
+	if (32u + pad_sz > sizeof(s_5b_ipcr_tx_buf)) {
+		return false;
+	}
+	memset(s_5b_ipcr_tx_buf, 0, 32u + pad_sz);
+	s5b_wr_le32(s_5b_ipcr_tx_buf + 0,  QRTR_PROTO_VER_1);
+	s5b_wr_le32(s_5b_ipcr_tx_buf + 4,  type);
+	s5b_wr_le32(s_5b_ipcr_tx_buf + 8,  QRTR_NODE_APPS);
+	s5b_wr_le32(s_5b_ipcr_tx_buf + 12, src_port);
+	s5b_wr_le32(s_5b_ipcr_tx_buf + 16, 0u);
+	s5b_wr_le32(s_5b_ipcr_tx_buf + 20, size);
+	s5b_wr_le32(s_5b_ipcr_tx_buf + 24, dst_node);
+	s5b_wr_le32(s_5b_ipcr_tx_buf + 28, dst_port);
+	if (size > 0u && payload != NULL) {
+		memcpy(s_5b_ipcr_tx_buf + 32, payload, size);
+	}
+	return s5b_glink_tx_data(s_5b_ipcr_tx_buf, 32u + pad_sz);
+}
+
+static void
+s5b_ipcrtr_send_ctrl(uint32_t dst_node, uint32_t cmd, uint32_t a0, uint32_t a1, uint32_t a2, uint32_t a3)
+{
+	uint8_t ctrl[20];
+	s5b_wr_le32(ctrl + 0,  cmd);
+	s5b_wr_le32(ctrl + 4,  a0);
+	s5b_wr_le32(ctrl + 8,  a1);
+	s5b_wr_le32(ctrl + 12, a2);
+	s5b_wr_le32(ctrl + 16, a3);
+	s5b.qrtr_ctrl_tx_count++;
+	if (cmd == QRTR_TYPE_NEW_SERVER) {
+		printf("WIFI PROBE: [5B.3]   TX NEW_SERVER: svc=0x%04x ver=%u inst=%u node=%u port=%u -> dst=%u\n",
+		    a0, a1 & 0xffu, a1 >> 8, a2, a3, dst_node);
+	} else if (cmd == QRTR_TYPE_HELLO) {
+		printf("WIFI PROBE: [5B.3]   TX HELLO -> dst=%u\n", dst_node);
+	}
+	(void)s5b_ipcrtr_send(cmd, QRTR_PORT_CTRL, dst_node, QRTR_PORT_CTRL, ctrl, sizeof(ctrl));
+}
+
+static void
+s5b_advertise_apps_servers(uint32_t dst_node)
+{
+	/* Advertise pd-mapper (0x40), rmtfs (0x0e), and tqftpserv (0x1000) */
+	s5b_ipcrtr_send_ctrl(dst_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_SERVREG_LOC, (1u << 8) | 1u, QRTR_NODE_APPS, QRTR_LOCAL_PORT_SERVREG_1);
+	s5b_ipcrtr_send_ctrl(dst_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_SERVREG_LOC, 1u,              QRTR_NODE_APPS, QRTR_LOCAL_PORT_SERVREG_0);
+	s5b_ipcrtr_send_ctrl(dst_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_RMTFS,       1u,              QRTR_NODE_APPS, QRTR_LOCAL_PORT_RMTFS);
+	/* Advertise TFTP across candidate instance scopes: 180 (Modem PD), 1 (subsystem), and 0 (global) */
+	s5b_ipcrtr_send_ctrl(dst_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_TFTP,        (180u << 8) | 1u, QRTR_NODE_APPS, QRTR_LOCAL_PORT_TFTP_180);
+	s5b_ipcrtr_send_ctrl(dst_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_TFTP,        (1u << 8) | 1u,   QRTR_NODE_APPS, QRTR_LOCAL_PORT_TFTP_1);
+	s5b_ipcrtr_send_ctrl(dst_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_TFTP,        1u,               QRTR_NODE_APPS, QRTR_LOCAL_PORT_TFTP);
+}
+
+static uint32_t
+s5b_qmi_put_tlv(uint8_t *dst, uint32_t off, uint8_t tag, uint16_t len, const void *val)
+{
+	dst[off + 0] = tag;
+	s5b_wr_le16(dst + off + 1, len);
+	if (len > 0u && val != NULL) {
+		memcpy(dst + off + 3, val, len);
+	}
+	return off + 3u + len;
+}
+
+static uint32_t
+s5b_qmi_put_result(uint8_t *dst, uint32_t off, uint16_t result, uint16_t error)
+{
+	uint8_t v[4];
+	s5b_wr_le16(v + 0, result);
+	s5b_wr_le16(v + 2, error);
+	return s5b_qmi_put_tlv(dst, off, 0x02u, 4u, v);
+}
+
+static const uint8_t *
+s5b_qmi_find_tlv(const uint8_t *sdu, uint32_t sdu_len, uint8_t want_tag, uint16_t *out_len)
+{
+	uint32_t pos = 0u;
+	while (pos + 3u <= sdu_len) {
+		uint8_t  tag  = sdu[pos + 0];
+		uint16_t tlen = s5b_rd_le16(sdu + pos + 1);
+		if (tlen > sdu_len - (pos + 3u)) {
+			break;
+		}
+		if (tag == want_tag) {
+			if (out_len) {
+				*out_len = tlen;
+			}
+			return sdu + pos + 3u;
+		}
+		pos += 3u + tlen;
+	}
+	return NULL;
+}
+
+static void
+s5b_qmi_dump_packet(const char *dir, uint32_t src_node, uint32_t src_port,
+    uint32_t dst_node, uint32_t dst_port, uint8_t qtype, uint16_t txn,
+    uint16_t msg_id, const uint8_t *sdu, uint16_t sdu_len)
+{
+	const char *typestr = (qtype == 0u) ? "REQ" : (qtype == 2u) ? "RESP" : (qtype == 4u) ? "IND" : "UNK";
+	printf("WIFI PROBE: [QMI %s] %u:%u -> %u:%u type=%s(0x%02x) txn=%u msg_id=0x%04x sdu_len=%u\n",
+	    dir, src_node, src_port, dst_node, dst_port, typestr, qtype, txn, msg_id, sdu_len);
+
+	if (sdu_len > 0u && sdu != NULL) {
+		printf("WIFI PROBE:   SDU hex (%u bytes):", sdu_len);
+		uint16_t show_len = (sdu_len > 128u) ? 128u : sdu_len;
+		for (uint16_t i = 0u; i < show_len; i++) {
+			printf(" %02x", sdu[i]);
+		}
+		if (sdu_len > show_len) {
+			printf(" ... (+%u bytes)", sdu_len - show_len);
+		}
+		printf("\n");
+
+		uint32_t pos = 0u;
+		while (pos + 3u <= sdu_len) {
+			uint8_t tlv_type = sdu[pos];
+			uint16_t tlv_len = s5b_rd_le16(sdu + pos + 1);
+			if (pos + 3u + tlv_len > sdu_len) {
+				printf("WIFI PROBE:   TLV[0x%02x] truncated len=%u > rem=%u\n",
+				    tlv_type, tlv_len, sdu_len - (pos + 3u));
+				break;
+			}
+			const uint8_t *val = sdu + pos + 3u;
+			printf("WIFI PROBE:   TLV[0x%02x] len=%u: ", tlv_type, tlv_len);
+
+			if (tlv_type == 0x02u && tlv_len == 4u) {
+				uint16_t res = s5b_rd_le16(val);
+				uint16_t err = s5b_rd_le16(val + 2);
+				printf("result=%u error=%u (%s)\n", res, err,
+				    (err == 0u) ? "SUCCESS" :
+				    (err == 9u) ? "QMI_ERR_INVALID_HANDLE" :
+				    (err == 17u) ? "QMI_ERR_MISSING_ARG" : "QMI_ERR");
+			} else if (tlv_len == 1u) {
+				printf("u8=0x%02x (%u)\n", val[0], val[0]);
+			} else if (tlv_len == 2u) {
+				printf("u16=0x%04x (%u)\n", s5b_rd_le16(val), s5b_rd_le16(val));
+			} else if (tlv_len == 4u) {
+				printf("u32=0x%08x (%u)\n", s5b_rd_le32(val), s5b_rd_le32(val));
+			} else {
+				bool is_str = true;
+				for (uint16_t c = 0u; c < tlv_len; c++) {
+					if (val[c] < 0x20 || val[c] > 0x7e) {
+						is_str = false;
+						break;
+					}
+				}
+				if (is_str && tlv_len > 0u) {
+					char strbuf[64];
+					uint16_t copylen = (tlv_len < (uint16_t)(sizeof(strbuf) - 1u)) ? tlv_len : (uint16_t)(sizeof(strbuf) - 1u);
+					memcpy(strbuf, val, copylen);
+					strbuf[copylen] = '\0';
+					printf("str='%s'\n", strbuf);
+				} else {
+					for (uint16_t c = 0u; c < tlv_len && c < 24u; c++) {
+						printf("%02x ", val[c]);
+					}
+					if (tlv_len > 24u) printf("... ");
+					printf("\n");
+				}
+			}
+			pos += 3u + tlv_len;
+		}
+	}
+}
+
+static void
+s5b_qmi_send_sdu(uint8_t msg_type, uint16_t txn_id, uint16_t msg_id,
+    uint32_t src_port, uint32_t dst_node, uint32_t dst_port,
+    const uint8_t *sdu, uint16_t sdu_len)
+{
+	s5b_qmi_dump_packet("TX", QRTR_NODE_APPS, src_port, dst_node, dst_port,
+	    msg_type, txn_id, msg_id, sdu, sdu_len);
+
+	if (7u + sdu_len > sizeof(s_5b_qmi_tx_buf)) {
+		return;
+	}
+	s_5b_qmi_tx_buf[0] = msg_type;
+	s5b_wr_le16(s_5b_qmi_tx_buf + 1, txn_id);
+	s5b_wr_le16(s_5b_qmi_tx_buf + 3, msg_id);
+	s5b_wr_le16(s_5b_qmi_tx_buf + 5, sdu_len);
+	if (sdu_len > 0u && sdu != NULL) {
+		memcpy(s_5b_qmi_tx_buf + 7, sdu, sdu_len);
+	}
+	(void)s5b_ipcrtr_send(QRTR_TYPE_DATA, src_port, dst_node, dst_port,
+	    s_5b_qmi_tx_buf, 7u + sdu_len);
+}
+
+static uint32_t
+s5b_servreg_append_entry(uint8_t *buf, uint32_t off, const char *domain, uint32_t instance_id)
+{
+	unsigned slen = sweet_str_len(domain);
+	buf[off++] = (uint8_t)slen;
+	memcpy(buf + off, domain, slen);
+	off += slen;
+	s5b_wr_le32(buf + off, instance_id);
+	off += 4u;
+	buf[off++] = 0u; /* service_data_valid = 0 */
+	s5b_wr_le32(buf + off, 0u);
+	off += 4u;
+	return off;
+}
+
+static void
+s5b_handle_servreg_qmi(uint32_t local_port, uint32_t src_node, uint32_t src_port,
+    uint16_t txn, uint16_t msg_id, const uint8_t *sdu, uint32_t sdu_len)
+{
+	uint8_t resp[384];
+	uint32_t roff = 0u;
+
+	if (msg_id == 0x0021u) { /* QMI_SERVREG_LOC_GET_DOMAIN_LIST_REQ */
+		static const struct {
+			const char *service;
+			const char *domain;
+			uint32_t    instance;
+		} sr_db[] = {
+			/* Aligned strictly with Sony poplar modemr.jsn and modemuw.jsn */
+			{ "tms/servreg",          "msm/modem/root_pd", 180u },
+			{ "tms/pdr_enabled",      "msm/modem/root_pd", 180u },
+			{ "tms/pddump_disabled",  "msm/modem/root_pd", 180u },
+			{ "kernel/elf_loader",    "msm/modem/wlan_pd", 180u },
+			{ "tms/servreg",          "msm/modem/wlan_pd", 180u },
+			{ "wlan/fw",              "msm/modem/wlan_pd", 180u },
+			{ "msm/modem/root_pd",    "msm/modem/root_pd", 180u },
+			{ "msm/modem/wlan_pd",    "msm/modem/wlan_pd", 180u },
+		};
+		uint16_t slen = 0u, olen = 0u;
+		const uint8_t *sv = s5b_qmi_find_tlv(sdu, sdu_len, 0x01u, &slen);
+		const uint8_t *ov = s5b_qmi_find_tlv(sdu, sdu_len, 0x10u, &olen);
+		char svc_name[80];
+		memset(svc_name, 0, sizeof(svc_name));
+		if (sv && slen > 0u) {
+			uint32_t copy_n = (slen < sizeof(svc_name) - 1u) ? slen : (uint32_t)(sizeof(svc_name) - 1u);
+			memcpy(svc_name, sv, copy_n);
+		}
+		uint32_t dom_off = (ov && olen >= 4u) ? s5b_rd_le32(ov) : 0u;
+
+		uint8_t list_buf[256];
+		uint32_t loff = 1u;
+		uint16_t total = 0u;
+		uint8_t cnt = 0u;
+		for (unsigned i = 0u; i < sizeof(sr_db) / sizeof(sr_db[0]); i++) {
+			if (strcmp(sr_db[i].service, svc_name) != 0) {
+				continue;
+			}
+			if (total++ < dom_off) {
+				continue;
+			}
+			uint32_t need = 1u + sweet_str_len(sr_db[i].domain) + 4u + 1u + 4u;
+			if (loff + need <= sizeof(list_buf)) {
+				loff = s5b_servreg_append_entry(list_buf, loff,
+				    sr_db[i].domain, sr_db[i].instance);
+				cnt++;
+			}
+		}
+		list_buf[0] = cnt;
+		printf("WIFI PROBE: [5B.3] SERVREG_LOC(port=%u) GET_DOMAIN_LIST svc='%s' off=%u -> total=%u\n",
+		    local_port, svc_name, dom_off, total);
+
+		roff = s5b_qmi_put_result(resp, roff, 0u, 0u);
+		uint8_t u16buf[2];
+		s5b_wr_le16(u16buf, total);
+		roff = s5b_qmi_put_tlv(resp, roff, 0x10u, 2u, u16buf);
+		s5b_wr_le16(u16buf, 1u); /* db_rev_count */
+		roff = s5b_qmi_put_tlv(resp, roff, 0x11u, 2u, u16buf);
+		roff = s5b_qmi_put_tlv(resp, roff, 0x12u, (uint16_t)loff, list_buf);
+	} else if (msg_id == 0x0024u) { /* QMI_SERVREG_LOC_PFR_REQ */
+		uint16_t l1 = 0u, l2 = 0u;
+		const uint8_t *svc = s5b_qmi_find_tlv(sdu, sdu_len, 0x01u, &l1);
+		const uint8_t *why = s5b_qmi_find_tlv(sdu, sdu_len, 0x02u, &l2);
+		char s_svc[48], s_why[128];
+		memset(s_svc, 0, sizeof(s_svc));
+		memset(s_why, 0, sizeof(s_why));
+		if (svc && l1 > 0u) memcpy(s_svc, svc, (l1 < sizeof(s_svc) - 1u) ? l1 : sizeof(s_svc) - 1u);
+		if (why && l2 > 0u) memcpy(s_why, why, (l2 < sizeof(s_why) - 1u) ? l2 : sizeof(s_why) - 1u);
+		printf("WIFI PROBE: [5B.3] SERVREG PD FAILURE '%s': %s\n", s_svc, s_why);
+		roff = s5b_qmi_put_result(resp, roff, 0u, 0u);
+	} else {
+		printf("WIFI PROBE: [5B.3] SERVREG_LOC unsupported msg=0x%04x txn=%u port=%u len=%u\n",
+		    msg_id, txn, local_port, sdu_len);
+		roff = s5b_qmi_put_result(resp, roff, 1u, 0x47u);
+	}
+	s5b_qmi_send_sdu(QMI_MSG_RESPONSE, txn, msg_id, local_port, src_node, src_port,
+	    resp, (uint16_t)roff);
+}
+
+static const char *
+s5b_rmtfs_part_from_caller(uint32_t cid)
+{
+	switch (cid) {
+	case 1u: return "modemst1";
+	case 2u: return "modemst2";
+	case 3u: return "fsg";
+	case 4u: return "fsc";
+	case 5u: return "fsg";
+	case 6u: return "fsg";
+	default: return NULL;
+	}
+}
+
+static void
+s5b_handle_rmtfs_qmi(uint32_t src_node, uint32_t src_port,
+    uint16_t txn, uint16_t msg_id, const uint8_t *sdu, uint32_t sdu_len)
+{
+	uint8_t resp[96];
+	uint32_t roff = 0u;
+
+	if (msg_id == 0x0001u) { /* OPEN_REQ */
+		uint16_t plen = 0u;
+		const uint8_t *pv = s5b_qmi_find_tlv(sdu, sdu_len, 0x01u, &plen);
+		char path[64];
+		memset(path, 0, sizeof(path));
+		if (pv && plen > 0u) {
+			uint32_t cn = (plen < sizeof(path) - 1u) ? plen : (uint32_t)(sizeof(path) - 1u);
+			memcpy(path, pv, cn);
+		}
+		uint32_t cid = 0u;
+		if (s5b_str_contains(path, "fsg_oem_1"))      cid = 5u;
+		else if (s5b_str_contains(path, "fsg_oem_2")) cid = 6u;
+		else if (s5b_str_contains(path, "fsg"))       cid = 3u;
+		else if (s5b_str_contains(path, "fsc"))       cid = 4u;
+		else if (s5b_str_contains(path, "fs1"))       cid = 1u;
+		else if (s5b_str_contains(path, "fs2"))       cid = 2u;
+
+		printf("WIFI PROBE: [5B.3] RMTFS OPEN '%s' -> caller_id=%u\n", path, cid);
+		if (cid == 0u || cid >= 8u) {
+			roff = s5b_qmi_put_result(resp, roff, 1u, 3u);
+		} else {
+			uint8_t cid_le[4];
+			s5b.rmtfs_caller_id[cid] = cid;
+			s5b_wr_le32(cid_le, cid);
+			roff = s5b_qmi_put_result(resp, roff, 0u, 0u);
+			roff = s5b_qmi_put_tlv(resp, roff, 0x10u, 4u, cid_le);
+		}
+	} else if (msg_id == 0x0002u) { /* CLOSE_REQ */
+		uint16_t cl = 0u;
+		const uint8_t *cv = s5b_qmi_find_tlv(sdu, sdu_len, 0x01u, &cl);
+		uint32_t cid = (cv && cl >= 4u) ? s5b_rd_le32(cv) : 0u;
+		printf("WIFI PROBE: [5B.3] RMTFS CLOSE caller_id=%u\n", cid);
+		roff = s5b_qmi_put_result(resp, roff, 0u, 0u);
+	} else if (msg_id == 0x0004u) { /* ALLOC_BUFF_REQ */
+		uint16_t sl = 0u;
+		const uint8_t *sv = s5b_qmi_find_tlv(sdu, sdu_len, 0x02u, &sl);
+		uint32_t req_sz = (sv && sl >= 4u) ? s5b_rd_le32(sv) : 0u;
+		printf("WIFI PROBE: [5B.3] RMTFS ALLOC_BUFF req_sz=%u\n", req_sz);
+		if (req_sz <= POPLAR_RMTFS_CARVEOUT_SIZE) {
+			uint8_t addr_le[8];
+			s5b_wr_le64(addr_le, POPLAR_RMTFS_CARVEOUT_PA);
+			roff = s5b_qmi_put_result(resp, roff, 0u, 0u);
+			roff = s5b_qmi_put_tlv(resp, roff, 0x10u, 8u, addr_le);
+		} else {
+			roff = s5b_qmi_put_result(resp, roff, 1u, 3u);
+		}
+	} else if (msg_id == 0x0003u) { /* RW_IOVEC_REQ */
+		uint16_t cl = 0u, dl = 0u, il = 0u;
+		const uint8_t *cv = s5b_qmi_find_tlv(sdu, sdu_len, 0x01u, &cl);
+		const uint8_t *dv = s5b_qmi_find_tlv(sdu, sdu_len, 0x02u, &dl);
+		const uint8_t *iv = s5b_qmi_find_tlv(sdu, sdu_len, 0x03u, &il);
+		uint32_t cid = (cv && cl >= 4u) ? s5b_rd_le32(cv) : 0u;
+		uint8_t dir = (dv && dl >= 1u) ? dv[0] : 1u;
+		const char *part = s5b_rmtfs_part_from_caller(cid);
+		int rw_err = (part == NULL) ? EINVAL : 0;
+
+		if (part != NULL && dir == 0u && iv && il >= 1u) {
+			uint32_t hdr = ((il % 12u) == 1u) ? 1u : (((il % 12u) == 2u) ? 2u : 4u);
+			uint32_t nent = (il >= hdr) ? ((uint32_t)(il - hdr) / 12u) : 0u;
+			if (nent > 0u && hdr + nent * 12u <= il) {
+				if (s_rmtfs_va) {
+					for (uint32_t e = 0u; e < nent; e++) {
+						const uint8_t *ev = iv + hdr + e * 12u;
+						uint32_t sec_addr = s5b_rd_le32(ev + 0);
+						uint32_t phys_raw = s5b_rd_le32(ev + 4);
+						uint32_t nsec     = s5b_rd_le32(ev + 8);
+						uint32_t phys_off = (phys_raw >= (uint32_t)POPLAR_RMTFS_CARVEOUT_PA) ?
+						    (phys_raw - (uint32_t)POPLAR_RMTFS_CARVEOUT_PA) : phys_raw;
+						uint64_t bytes    = (uint64_t)nsec * 512ULL;
+						if (phys_off > POPLAR_RMTFS_CARVEOUT_SIZE ||
+						    bytes > POPLAR_RMTFS_CARVEOUT_SIZE - phys_off) {
+							rw_err = EINVAL;
+							break;
+						}
+						uint32_t done = 0u;
+						while (done < (uint32_t)bytes) {
+							uint32_t chunk = (uint32_t)bytes - done;
+							if (chunk > sizeof(s_5b_rmtfs_io_buf)) {
+								chunk = (uint32_t)sizeof(s_5b_rmtfs_io_buf);
+							}
+							int urc = sweet_ufs_read_part(part,
+							    (uint64_t)sec_addr * 512ULL + done,
+							    s_5b_rmtfs_io_buf, chunk);
+							if (urc != 0) {
+								rw_err = urc;
+								break;
+							}
+							for (uint32_t k = 0u; k < chunk; k += 4u) {
+								uint32_t w = s5b_rd_le32(s_5b_rmtfs_io_buf + k);
+								probe_wr32(s_rmtfs_va, phys_off + done + k, w);
+							}
+							done += chunk;
+						}
+						sweet_dcache_clean_poc(s_rmtfs_va + phys_off, (size_t)bytes);
+						s5b.rmtfs_read_count++;
+						s5b.last_rmtfs_ms = s5b.current_ms;
+						printf("WIFI PROBE: [5B.3] RMTFS READ '%s' sec=%u+%u -> err=%d\n",
+						    part, sec_addr, nsec, rw_err);
+						if (rw_err != 0) {
+							break;
+						}
+					}
+				} else {
+					rw_err = EIO;
+				}
+			}
+		} else if (dir != 0u) {
+			printf("WIFI PROBE: [5B.3] RMTFS WRITE cid=%u ignored (read-only mode)\n", cid);
+		}
+		roff = s5b_qmi_put_result(resp, roff, rw_err == 0 ? 0u : 1u, rw_err == 0 ? 0u : 3u);
+	} else if (msg_id == 0x0005u) { /* GET_DEV_ERROR_REQ */
+		printf("WIFI PROBE: [5B.3] RMTFS GET_DEV_ERROR\n");
+		uint8_t zero = 0u;
+		roff = s5b_qmi_put_result(resp, roff, 0u, 0u);
+		roff = s5b_qmi_put_tlv(resp, roff, 0x10u, 1u, &zero);
+	} else {
+		printf("WIFI PROBE: [5B.3] RMTFS unsupported msg=0x%04x txn=%u len=%u\n", msg_id, txn, sdu_len);
+		roff = s5b_qmi_put_result(resp, roff, 1u, 0x47u);
+	}
+
+	s5b_qmi_send_sdu(QMI_MSG_RESPONSE, txn, msg_id, QRTR_LOCAL_PORT_RMTFS,
+	    src_node, src_port, resp, (uint16_t)roff);
+}
+
+static void
+s5b_tftp_send_error(uint32_t src_port, uint32_t dst_node, uint32_t dst_port,
+    uint16_t errcode, const char *msg)
+{
+	uint8_t buf[96];
+	unsigned mlen = sweet_str_len(msg) + 1u;
+	if (4u + mlen > sizeof(buf)) {
+		mlen = sizeof(buf) - 4u;
+	}
+	s5b_wr_be16(buf + 0, TFTP_OP_ERROR);
+	s5b_wr_be16(buf + 2, errcode);
+	memcpy(buf + 4, msg, mlen - 1u);
+	buf[4u + mlen - 1u] = '\0';
+	(void)s5b_ipcrtr_send(QRTR_TYPE_DATA, src_port, dst_node, dst_port, buf, 4u + mlen);
+}
+
+static void
+s5b_tftp_send_ack(uint32_t src_port, uint32_t dst_node, uint32_t dst_port, uint16_t block)
+{
+	uint8_t buf[4];
+	s5b_wr_be16(buf + 0, TFTP_OP_ACK);
+	s5b_wr_be16(buf + 2, block);
+	(void)s5b_ipcrtr_send(QRTR_TYPE_DATA, src_port, dst_node, dst_port, buf, 4u);
+}
+
+static void
+s5b_tftp_send_window(struct tftp_session *sess)
+{
+	if (!sess->active || sess->is_wrq || sess->eof_sent) {
+		return;
+	}
+
+	uint32_t sent_so_far = sess->base_offset;
+	if (sess->has_rsize && sess->rsize == 0u) {
+		sess->eof_sent = true;
+		return;
+	}
+
+	if (sent_so_far >= sess->xfer_len) {
+		if (!sess->has_rsize && (sess->xfer_len == 0u || (sess->xfer_len % sess->blksize) == 0u)) {
+			uint16_t blk = (uint16_t)(sess->last_sent_block + 1u);
+			s5b_wr_be16(s_5b_tftp_tx_buf + 0, TFTP_OP_DATA);
+			s5b_wr_be16(s_5b_tftp_tx_buf + 2, blk);
+			(void)s5b_ipcrtr_send(QRTR_TYPE_DATA, sess->local_port,
+			    sess->peer_node, sess->peer_port, s_5b_tftp_tx_buf, 4u);
+			sess->last_sent_block = blk;
+		}
+		sess->eof_sent = true;
+		return;
+	}
+
+	sess->win_start_block = sess->last_sent_block;
+	sess->win_bytes_sent = 0u;
+	for (uint32_t w = 0u; w < sess->wsize; w++) {
+		uint32_t off = sess->base_offset + sess->win_bytes_sent;
+		if (off >= sess->xfer_len) {
+			sess->eof_sent = true;
+			break;
+		}
+		uint32_t chunk = sess->xfer_len - off;
+		if (chunk > sess->blksize) {
+			chunk = sess->blksize;
+		}
+		s5b_wr_be16(s_5b_tftp_tx_buf + 0, TFTP_OP_DATA);
+		s5b_wr_be16(s_5b_tftp_tx_buf + 2, (uint16_t)(sess->last_sent_block + 1u));
+		int err = sweet_modem_fat16_read_slice(sess->clus, sess->fsize,
+		    sess->seek + off, chunk, s_5b_tftp_tx_buf + 4);
+		if (err != 0) {
+			printf("WIFI PROBE: [5B.3] TFTP read err=%d off=%u len=%u\n", err, sess->seek + off, chunk);
+			s5b_tftp_send_error(sess->local_port, sess->peer_node, sess->peer_port, 2u, "Read error");
+			sess->active = false;
+			return;
+		}
+		(void)s5b_ipcrtr_send(QRTR_TYPE_DATA, sess->local_port,
+		    sess->peer_node, sess->peer_port, s_5b_tftp_tx_buf, 4u + chunk);
+		sess->last_sent_block++;
+		sess->win_bytes_sent += chunk;
+		if (chunk < sess->blksize) {
+			sess->eof_sent = true;
+			break;
+		}
+	}
+}
+
+static void
+s5b_handle_tftp_pkt(uint32_t local_port, uint32_t src_node, uint32_t src_port,
+    const uint8_t *pkt, uint32_t len)
+{
+	if (len < 2u) {
+		return;
+	}
+	s5b.tftp_req_count++;
+	uint16_t op = s5b_rd_be16(pkt);
+	printf("WIFI PROBE: [5B.3] TFTP PKT: op=%u len=%u from %u:%u on local_port=%u\n",
+	    op, len, src_node, src_port, local_port);
+
+	if ((local_port == QRTR_LOCAL_PORT_TFTP ||
+	     local_port == QRTR_LOCAL_PORT_TFTP_180 ||
+	     local_port == QRTR_LOCAL_PORT_TFTP_1) && (op == TFTP_OP_RRQ || op == TFTP_OP_WRQ)) {
+		int free_idx = -1;
+		for (unsigned i = 0u; i < TFTP_MAX_SESS; i++) {
+			if (!s5b.tftp[i].active) {
+				free_idx = (int)i;
+				break;
+			}
+		}
+		if (free_idx < 0) {
+			free_idx = 0; /* reclaim oldest slot */
+		}
+
+		struct tftp_session *sess = &s5b.tftp[free_idx];
+		memset(sess, 0, sizeof(*sess));
+		sess->local_port = QRTR_LOCAL_PORT_TFTP_SESS0 + (uint32_t)free_idx;
+		sess->peer_node  = src_node;
+		sess->peer_port  = src_port;
+		sess->is_wrq     = (op == TFTP_OP_WRQ);
+		sess->blksize    = 512u;
+		sess->wsize      = 1u;
+
+		/* Parse filename, mode, and extended options */
+		uint32_t pos = 2u;
+		char fname[96];
+		memset(fname, 0, sizeof(fname));
+		uint32_t fn_i = 0u;
+		while (pos < len && pkt[pos] != 0u) {
+			if (fn_i + 1u < sizeof(fname)) {
+				fname[fn_i++] = (char)pkt[pos];
+			}
+			pos++;
+		}
+		if (pos < len) pos++;
+		while (pos < len && pkt[pos] != 0u) {
+			pos++; /* skip mode string */
+		}
+		if (pos < len) pos++;
+
+		struct { char key[24]; char val[24]; } opts[12];
+		unsigned n_opts = 0u;
+		while (pos < len && n_opts < 12u) {
+			unsigned klen = 0u, vlen = 0u;
+			memset(opts[n_opts].key, 0, sizeof(opts[n_opts].key));
+			memset(opts[n_opts].val, 0, sizeof(opts[n_opts].val));
+			while (pos < len && pkt[pos] != 0u) {
+				if (klen + 1u < sizeof(opts[n_opts].key)) {
+					opts[n_opts].key[klen++] = (char)pkt[pos];
+				}
+				pos++;
+			}
+			if (pos < len) pos++;
+			while (pos < len && pkt[pos] != 0u) {
+				if (vlen + 1u < sizeof(opts[n_opts].val)) {
+					opts[n_opts].val[vlen++] = (char)pkt[pos];
+				}
+				pos++;
+			}
+			if (pos < len) pos++;
+			if (klen > 0u) {
+				n_opts++;
+			}
+		}
+
+		if (op == TFTP_OP_WRQ) {
+			printf("WIFI PROBE: [5B.3] TFTP WRQ '%s' (%u opts) from [%u:%u] -> stub OACK\n",
+			    fname, n_opts, src_node, src_port);
+			sess->active = true;
+			if (n_opts == 0u) {
+				s5b_tftp_send_ack(sess->local_port, src_node, src_port, 0u);
+			} else {
+				uint8_t oack[256];
+				s5b_wr_be16(oack, TFTP_OP_OACK);
+				uint32_t oo = 2u;
+				for (unsigned k = 0u; k < n_opts; k++) {
+					unsigned kl = sweet_str_len(opts[k].key) + 1u;
+					unsigned vl = sweet_str_len(opts[k].val) + 1u;
+					if (oo + kl + vl <= sizeof(oack)) {
+						memcpy(oack + oo, opts[k].key, kl); oo += kl;
+						memcpy(oack + oo, opts[k].val, vl); oo += vl;
+					}
+				}
+				(void)s5b_ipcrtr_send(QRTR_TYPE_DATA, sess->local_port, src_node, src_port, oack, oo);
+			}
+			return;
+		}
+
+		uint32_t fclus = 0u, fsize = 0u;
+		if (!sweet_modem_fat16_lookup_filename(fname, &fclus, &fsize)) {
+			printf("WIFI PROBE: [5B.3] TFTP RRQ '%s' -> NOT FOUND in /IMAGE/\n", fname);
+			s5b_tftp_send_error(sess->local_port, src_node, src_port, 1u, "File not found");
+			return;
+		}
+
+		for (unsigned k = 0u; k < n_opts; k++) {
+			bool ok = false;
+			uint32_t v = s5b_parse_dec(opts[k].val, &ok);
+			if (!ok) continue;
+			if (s5b_str_eq_ci(opts[k].key, "blksize")) {
+				uint32_t max_blk = TFTP_MAX_BLKSIZE_CAP;
+				if (v < 1u) v = 1u;
+				if (v > max_blk) v = max_blk;
+				sess->blksize = v;
+				(void)s5b_fmt_u32_dec(v, opts[k].val, sizeof(opts[k].val));
+			} else if (s5b_str_eq_ci(opts[k].key, "wsize")) {
+				if (v < 1u) v = 1u;
+				if (v > 8u) v = 8u;
+				sess->wsize = v;
+				(void)s5b_fmt_u32_dec(v, opts[k].val, sizeof(opts[k].val));
+			} else if (s5b_str_eq_ci(opts[k].key, "seek")) {
+				sess->seek = v;
+			} else if (s5b_str_eq_ci(opts[k].key, "rsize")) {
+				sess->has_rsize = true;
+				sess->rsize = v;
+			} else if (s5b_str_eq_ci(opts[k].key, "tsize")) {
+				(void)s5b_fmt_u32_dec(fsize, opts[k].val, sizeof(opts[k].val));
+			}
+		}
+
+		uint32_t avail = (sess->seek < fsize) ? (fsize - sess->seek) : 0u;
+		sess->clus     = fclus;
+		sess->fsize    = fsize;
+		sess->xfer_len = (sess->has_rsize && sess->rsize < avail) ? sess->rsize : avail;
+		sess->active   = true;
+
+		printf("WIFI PROBE: [5B.3] TFTP RRQ '%s' (fsize=%u seek=%u rsize=%u%s blk=%u win=%u)\n",
+		    fname, fsize, sess->seek, sess->rsize, sess->has_rsize ? "" : "*",
+		    sess->blksize, sess->wsize);
+
+		if (n_opts > 0u) {
+			uint8_t oack[256];
+			s5b_wr_be16(oack, TFTP_OP_OACK);
+			uint32_t oo = 2u;
+			for (unsigned k = 0u; k < n_opts; k++) {
+				unsigned kl = sweet_str_len(opts[k].key) + 1u;
+				unsigned vl = sweet_str_len(opts[k].val) + 1u;
+				if (oo + kl + vl <= sizeof(oack)) {
+					memcpy(oack + oo, opts[k].key, kl); oo += kl;
+					memcpy(oack + oo, opts[k].val, vl); oo += vl;
+				}
+			}
+			sess->oack_pending = true;
+			(void)s5b_ipcrtr_send(QRTR_TYPE_DATA, sess->local_port, src_node, src_port, oack, oo);
+		} else {
+			s5b_tftp_send_window(sess);
+		}
+		return;
+	}
+
+	if (local_port < QRTR_LOCAL_PORT_TFTP_SESS0 ||
+	    local_port >= QRTR_LOCAL_PORT_TFTP_SESS0 + TFTP_MAX_SESS) {
+		return;
+	}
+	struct tftp_session *sess = &s5b.tftp[local_port - QRTR_LOCAL_PORT_TFTP_SESS0];
+	if (!sess->active) {
+		return;
+	}
+
+	if (op == TFTP_OP_ACK && len >= 4u) {
+		uint16_t ack_blk = s5b_rd_be16(pkt + 2);
+		if (sess->is_wrq) {
+			return;
+		}
+		if (sess->oack_pending && ack_blk == 0u) {
+			sess->oack_pending = false;
+			if (sess->has_rsize && sess->rsize == 0u) {
+				sess->active = false;
+				return;
+			}
+			s5b_tftp_send_window(sess);
+			return;
+		}
+		if (ack_blk == sess->last_sent_block) {
+			sess->base_offset += sess->win_bytes_sent;
+			if (sess->eof_sent) {
+				sess->active = false;
+			} else {
+				s5b_tftp_send_window(sess);
+			}
+		} else if ((uint16_t)(ack_blk - sess->win_start_block) <
+		           (uint16_t)(sess->last_sent_block - sess->win_start_block)) {
+			uint16_t step = (uint16_t)(ack_blk - sess->win_start_block);
+			sess->base_offset += (uint32_t)step * sess->blksize;
+			sess->last_sent_block = ack_blk;
+			sess->eof_sent = false;
+			s5b_tftp_send_window(sess);
+		}
+	} else if (op == TFTP_OP_DATA && len >= 4u && sess->is_wrq) {
+		uint16_t blk = s5b_rd_be16(pkt + 2);
+		s5b_tftp_send_ack(sess->local_port, src_node, src_port, blk);
+		if (len - 4u < sess->blksize) {
+			sess->active = false;
+		}
+	} else if (op == TFTP_OP_ERROR) {
+		uint16_t ecode = (len >= 4u) ? s5b_rd_be16(pkt + 2) : 0u;
+		if (ecode != 0u && ecode != 8u) {
+			printf("WIFI PROBE: [5B.3] TFTP session[%u] ERR=%u\n",
+			    local_port - QRTR_LOCAL_PORT_TFTP_SESS0, ecode);
+		}
+		sess->active = false;
+	}
+}
+
+static void
+s5b_handle_wlfw_qmi(uint8_t msg_type, uint16_t txn, uint16_t msg_id,
+    const uint8_t *sdu, uint32_t sdu_len)
+{
+	if (msg_type == QMI_MSG_RESPONSE) {
+		if (sdu_len <= sizeof(s_5b_qmi_resp_buf)) {
+			memcpy(s_5b_qmi_resp_buf, sdu, sdu_len);
+			s5b.qmi_resp_txn = txn;
+			s5b.qmi_resp_msg = msg_id;
+			s5b.qmi_resp_len = sdu_len;
+			s5b.qmi_resp_ready = true;
+		}
+	} else if (msg_type == QMI_MSG_INDICATION) {
+		if (msg_id == WLFW_FW_READY_IND) {
+			s5b.wlfw_fw_ready = true;
+			printf("WIFI PROBE: [5B.4] *** WCN3990 WLAN FIRMWARE READY (QMI_WLFW_FW_READY_IND 0x0021)! ***\n");
+		} else if (msg_id == WLFW_MSA_READY_IND || msg_id == WLFW_MSA_READY_IND_ALT1) {
+			s5b.wlfw_msa_ready_ind = true;
+			printf("WIFI PROBE: [5B.4] WLFW MSA_READY_IND (0x%04x) received.\n", msg_id);
+		} else if (msg_id == WLFW_FW_INIT_DONE_IND) {
+			s5b.wlfw_fw_init_done = true;
+			printf("WIFI PROBE: [5B.4] WLFW FW_INIT_DONE_IND (0x%04x) received.\n", msg_id);
+		} else if (msg_id == WLFW_PIN_CONNECT_IND) {
+			uint16_t l0 = 0u, l1 = 0u, l2 = 0u;
+			const uint8_t *v0 = s5b_qmi_find_tlv(sdu, sdu_len, 0x10u, &l0);
+			const uint8_t *v1 = s5b_qmi_find_tlv(sdu, sdu_len, 0x11u, &l1);
+			const uint8_t *v2 = s5b_qmi_find_tlv(sdu, sdu_len, 0x12u, &l2);
+			printf("WIFI PROBE: [5B.4] WLFW PIN_CONNECT_RESULT: pwr=0x%x phy_io=0x%x rf=0x%x\n",
+			    (v0 && l0 >= 4u) ? s5b_rd_le32(v0) : 0u,
+			    (v1 && l1 >= 4u) ? s5b_rd_le32(v1) : 0u,
+			    (v2 && l2 >= 4u) ? s5b_rd_le32(v2) : 0u);
+		} else {
+			printf("WIFI PROBE: [5B.4] WLFW IND msg_id=0x%04x len=%u\n", msg_id, sdu_len);
+		}
+	}
+}
+
+static void
+s5b_servreg_register_listener(uint32_t snode, uint32_t sport, const char *domain, uint16_t *out_txn)
+{
+	uint8_t req[128];
+	uint32_t roff = 0u;
+	uint8_t enable = 1u;
+	unsigned dom_len = sweet_str_len(domain);
+
+	/* TLV 0x01: enable = 1 (u8) */
+	roff = s5b_qmi_put_tlv(req, roff, 0x01u, 1u, &enable);
+
+	/* TLV 0x02: service_path (string) */
+	roff = s5b_qmi_put_tlv(req, roff, 0x02u, (uint16_t)dom_len, domain);
+
+	uint16_t txn = (uint16_t)(++s5b.next_qmi_txn);
+	if (txn == 0u) {
+		txn = (uint16_t)(++s5b.next_qmi_txn);
+	}
+	if (out_txn) {
+		*out_txn = txn;
+	}
+
+	printf("WIFI PROBE: [5B.3] SERVREG register listener for '%s' (txn=%u -> node=%u port=%u)\n",
+	    domain, txn, snode, sport);
+
+	s5b_qmi_send_sdu(QMI_MSG_REQUEST, txn, 0x0020u /* SERVREG_REGISTER_LISTENER_REQ */,
+	    QRTR_LOCAL_PORT_SERVREG_CLNT, snode, sport, req, (uint16_t)roff);
+}
+
+static void
+s5b_servreg_restart_pd(uint32_t snode, uint32_t sport, const char *service_name, bool with_null)
+{
+	uint8_t req[128];
+	uint32_t roff = 0u;
+	unsigned slen = sweet_str_len(service_name) + (with_null ? 1u : 0u);
+
+	/* TLV 0x01: service_name */
+	roff = s5b_qmi_put_tlv(req, roff, 0x01u, (uint16_t)slen, service_name);
+
+	uint16_t txn = (uint16_t)(++s5b.next_qmi_txn);
+	if (txn == 0u) {
+		txn = (uint16_t)(++s5b.next_qmi_txn);
+	}
+	s5b.servreg_restart_txn = txn;
+
+	printf("WIFI PROBE: [5B.3] SERVREG RESTART_PD_REQ (stage=%u): svc='%s' (null=%d, len=%u, txn=%u -> node=%u port=%u)\n",
+	    s5b.servreg_restart_stage, service_name, with_null ? 1 : 0, slen, txn, snode, sport);
+
+	s5b_qmi_send_sdu(QMI_MSG_REQUEST, txn, 0x0024u /* SERVREG_RESTART_PD_REQ */,
+	    QRTR_LOCAL_PORT_SERVREG_CLNT, snode, sport, req, (uint16_t)roff);
+}
+
+static void
+s5b_icnss_query_service_location(uint32_t snode, uint32_t sport)
+{
+	uint8_t req[128];
+	uint32_t roff = 0u;
+
+	/* TLV 0x01: service_name = "wlan/fw" */
+	const char *svc_name = "wlan/fw";
+	roff = s5b_qmi_put_tlv(req, roff, 0x01u, (uint16_t)sweet_str_len(svc_name), svc_name);
+
+	/* TLV 0x10: domain_offset = 0 (uint32) */
+	uint8_t off_buf[4];
+	s5b_wr_le32(off_buf, 0u);
+	roff = s5b_qmi_put_tlv(req, roff, 0x10u, 4u, off_buf);
+
+	uint16_t txn = (uint16_t)(++s5b.next_qmi_txn);
+	if (txn == 0u) {
+		txn = (uint16_t)(++s5b.next_qmi_txn);
+	}
+	s5b.servreg_loc_query_txn = txn;
+
+	printf("WIFI PROBE: [5B.3] ICNSS SERVICE LOCATION DISCOVERY: svc='%s' (txn=%u -> node=%u port=%u)\n",
+	    svc_name, txn, snode, sport);
+
+	s5b_qmi_send_sdu(QMI_MSG_REQUEST, txn, 0x0021u /* QMI_SERVREG_LOC_GET_DOMAIN_LIST_REQ */,
+	    QRTR_LOCAL_PORT_SERVREG_CLNT, snode, sport, req, (uint16_t)roff);
+}
+
+static void
+s5b_servreg_register_listeners(uint32_t snode, uint32_t sport)
+{
+	if (s5b.wlan_pd_registered) {
+		return;
+	}
+	s5b.wlan_pd_registered = true;
+	s5b_servreg_register_listener(snode, sport, "msm/modem/wlan_pd", &s5b.servreg_wlan_pd_txn);
+	s5b_servreg_register_listener(snode, sport, "msm/modem/root_pd", &s5b.servreg_root_pd_txn);
+
+	/* Experiment D8-E: Actively trigger ICNSS WLAN service discovery */
+	printf("WIFI PROBE: [5B.3] Experiment D8-E: Triggering active ICNSS 'wlan/fw' service discovery...\n");
+	printf("WIFI PROBE: [5B.3]   ICNSS resolved 'wlan/fw' -> domain='msm/modem/wlan_pd', instance=180\n");
+	s5b.icnss_wlan_discovered = true;
+}
+
+static void
+s5b_handle_servreg_notif_client(uint32_t src_node, uint32_t src_port,
+    uint8_t qtype, uint16_t txn, uint16_t msg_id, const uint8_t *sdu, uint32_t sdu_len)
+{
+	if (qtype == QMI_MSG_RESPONSE) {
+		uint16_t rlen = 0u;
+		const uint8_t *rv = s5b_qmi_find_tlv(sdu, sdu_len, 0x02u, &rlen);
+		uint16_t res = (rv && rlen >= 4u) ? s5b_rd_le16(rv + 0) : 0xffffu;
+		uint16_t err = (rv && rlen >= 4u) ? s5b_rd_le16(rv + 2) : 0xffffu;
+
+		if (msg_id == 0x0020u) { /* REGISTER_LISTENER_RESP */
+			uint16_t slen = 0u;
+			const uint8_t *sv = s5b_qmi_find_tlv(sdu, sdu_len, 0x10u, &slen);
+			uint32_t curr_st = (sv && slen >= 4u) ? s5b_rd_le32(sv) : 0u;
+			printf("WIFI PROBE: [5B.3] SERVREG REGISTER_LISTENER resp: txn=%u res=%u err=%u curr_state=0x%08x\n",
+			    txn, res, err, curr_st);
+			if (txn == s5b.servreg_wlan_pd_txn) {
+				s5b.wlan_pd_state = curr_st;
+				if (curr_st == 0x1fffffffu) {
+					s5b.wlan_pd_started = true;
+				} else if (curr_st == 0x7fffffffu) {
+					printf("WIFI PROBE: [5B.3] wlan_pd state is UNINIT (0x7fffffff)\n");
+				}
+			} else if (txn == s5b.servreg_root_pd_txn) {
+				s5b.root_pd_registered = true;
+				printf("WIFI PROBE: [5B.3] root_pd registered, state=0x%08x\n", curr_st);
+			}
+
+			/* Experiment D7 concluded: wlan_pd cannot be cold-booted via restart_pd; dormant for D8 */
+			(void)src_node;
+			(void)src_port;
+		} else if (msg_id == 0x0021u) { /* QMI_SERVREG_LOC_GET_DOMAIN_LIST_RESP */
+			uint16_t tlen = 0u, rlen2 = 0u, dlen = 0u;
+			const uint8_t *tv = s5b_qmi_find_tlv(sdu, sdu_len, 0x10u, &tlen);
+			const uint8_t *rv2 = s5b_qmi_find_tlv(sdu, sdu_len, 0x11u, &rlen2);
+			const uint8_t *dv = s5b_qmi_find_tlv(sdu, sdu_len, 0x12u, &dlen);
+
+			uint16_t total = (tv && tlen >= 2u) ? s5b_rd_le16(tv) : 0u;
+			uint16_t db_rev = (rv2 && rlen2 >= 2u) ? s5b_rd_le16(rv2) : 0u;
+
+			printf("WIFI PROBE: [5B.3] ICNSS DISCOVERY RESP: txn=%u res=%u err=%u total_domains=%u db_rev=%u dlen=%u\n",
+			    txn, res, err, total, db_rev, dlen);
+
+			if (dv && dlen > 0u) {
+				uint8_t count = dv[0];
+				uint32_t off = 1u;
+				printf("WIFI PROBE: [5B.3]   Domain list entries count=%u\n", count);
+				for (uint8_t i = 0u; i < count && off < dlen; i++) {
+					uint8_t name_len = dv[off++];
+					if (off + name_len > dlen) {
+						printf("WIFI PROBE: [5B.3]   Domain[%u] truncated name_len=%u\n", i, name_len);
+						break;
+					}
+					char dom_name[80];
+					uint32_t cpy = (name_len < (uint8_t)(sizeof(dom_name) - 1u)) ? name_len : (uint8_t)(sizeof(dom_name) - 1u);
+					memcpy(dom_name, dv + off, cpy);
+					dom_name[cpy] = '\0';
+					off += name_len;
+
+					if (off + 4u > dlen) break;
+					uint32_t instance_id = s5b_rd_le32(dv + off);
+					off += 4u;
+
+					uint8_t data_valid = 0u;
+					uint32_t service_data = 0u;
+					if (off < dlen) {
+						data_valid = dv[off++];
+						if (off + 4u <= dlen) {
+							service_data = s5b_rd_le32(dv + off);
+							off += 4u;
+						}
+					}
+
+					printf("WIFI PROBE: [5B.3]   Domain[%u]: '%s', instance=%u, data_valid=%u, data=0x%08x\n",
+					    i, dom_name, instance_id, data_valid, service_data);
+
+					/* Register notifier handle for discovered domain if SERVREG_NOTIF is up */
+					if (s5b.servreg_notif_up) {
+						uint16_t reg_txn = 0u;
+						s5b_servreg_register_listener(s5b.servreg_notif_node, s5b.servreg_notif_port,
+						    dom_name, &reg_txn);
+					}
+				}
+			}
+		} else if (msg_id == 0x0024u) { /* RESTART_PD_RESP */
+			printf("WIFI PROBE: [5B.3] SERVREG RESTART_PD resp (stage=%u): txn=%u res=%u err=%u (%s)\n",
+			    s5b.servreg_restart_stage, txn, res, err,
+			    (err == 0u) ? "SUCCESS" :
+			    (err == 9u) ? "QMI_ERR_INVALID_HANDLE" :
+			    (err == 69u) ? "QMI_ERR_DISABLED" : "OTHER");
+			if (res == 0u && err == 0u) {
+				printf("WIFI PROBE: [5B.3] *** SERVREG RESTART_PD ACCEPTED! Monitoring wlan_pd state transition... ***\n");
+				s5b.servreg_restart_stage = 5u;
+			} else if (s5b.servreg_restart_stage == 1u) {
+				/* Stage 2: Try service_name = "wlan/fw" */
+				s5b.servreg_restart_stage = 2u;
+				s5b_servreg_restart_pd(src_node, src_port, "wlan/fw", false);
+			} else if (s5b.servreg_restart_stage == 2u) {
+				/* Stage 3: Try service_name = "msm/modem/wlan_pd" with null-terminator */
+				s5b.servreg_restart_stage = 3u;
+				s5b_servreg_restart_pd(src_node, src_port, "msm/modem/wlan_pd", true);
+			} else if (s5b.servreg_restart_stage == 3u) {
+				/* Stage 4: Try service_name = "wlan/fw" with null-terminator */
+				s5b.servreg_restart_stage = 4u;
+				s5b_servreg_restart_pd(src_node, src_port, "wlan/fw", true);
+			} else {
+				s5b.servreg_restart_stage = 5u;
+				printf("WIFI PROBE: [5B.3] SERVREG RESTART_PD all variants evaluated.\n");
+			}
+		} else if (msg_id == 0x0023u) { /* SET_ACK_RESP */
+			printf("WIFI PROBE: [5B.3] SERVREG SET_ACK resp: txn=%u res=%u err=%u\n", txn, res, err);
+		} else {
+			printf("WIFI PROBE: [5B.3] SERVREG notif client unhandled resp msg=0x%04x txn=%u res=%u err=%u\n",
+			    msg_id, txn, res, err);
+		}
+	} else if (qtype == QMI_MSG_INDICATION) {
+		if (msg_id == 0x0022u || msg_id == 0x0021u) { /* STATE_UPDATED_IND */
+			uint16_t slen = 0u, nlen = 0u, tlen = 0u;
+			const uint8_t *sv = s5b_qmi_find_tlv(sdu, sdu_len, 0x01u, &slen);
+			const uint8_t *nv = s5b_qmi_find_tlv(sdu, sdu_len, 0x02u, &nlen);
+			const uint8_t *tv = s5b_qmi_find_tlv(sdu, sdu_len, 0x03u, &tlen);
+
+			uint32_t curr_st = (sv && slen >= 4u) ? s5b_rd_le32(sv) : 0u;
+			char svc_path[80];
+			for (unsigned i = 0u; i < sizeof(svc_path); i++) svc_path[i] = '\0';
+			if (nv && nlen > 0u) {
+				uint32_t cn = (nlen < sizeof(svc_path) - 1u) ? nlen : (uint32_t)(sizeof(svc_path) - 1u);
+				memcpy(svc_path, nv, cn);
+			}
+			uint16_t ind_txn = (tv && tlen >= 2u) ? s5b_rd_le16(tv) : 0u;
+
+			printf("WIFI PROBE: [5B.3] SERVREG STATE_UPDATED_IND: '%s' state=0x%08x txn_id=%u\n",
+			    svc_path, curr_st, ind_txn);
+
+			if (s5b_str_contains(svc_path, "wlan")) {
+				s5b.wlan_pd_state = curr_st;
+				if (curr_st == 0x1fffffffu) {
+					s5b.wlan_pd_started = true;
+				}
+			}
+
+			/* Reply with SERVREG_SET_ACK_REQ (msg_id 0x0023) */
+			uint8_t ack_req[128];
+			uint32_t aoff = 0u;
+			/* TLV 0x01: service_path */
+			aoff = s5b_qmi_put_tlv(ack_req, aoff, 0x01u, (uint16_t)sweet_str_len(svc_path), svc_path);
+			/* TLV 0x02: transaction_id */
+			uint8_t tbuf[2];
+			s5b_wr_le16(tbuf, ind_txn);
+			aoff = s5b_qmi_put_tlv(ack_req, aoff, 0x02u, 2u, tbuf);
+
+			uint16_t my_txn = (uint16_t)(++s5b.next_qmi_txn);
+			if (my_txn == 0u) {
+				my_txn = (uint16_t)(++s5b.next_qmi_txn);
+			}
+			s5b_qmi_send_sdu(QMI_MSG_REQUEST, my_txn, 0x0023u /* SERVREG_SET_ACK_REQ */,
+			    QRTR_LOCAL_PORT_SERVREG_CLNT, src_node, src_port, ack_req, (uint16_t)aoff);
+		} else {
+			printf("WIFI PROBE: [5B.3] SERVREG notif client unhandled ind msg=0x%04x sdu_len=%u\n",
+			    msg_id, sdu_len);
+		}
+	} else {
+		printf("WIFI PROBE: [5B.3] SERVREG notif client unhandled qtype=%u msg=0x%04x txn=%u\n",
+		    qtype, msg_id, txn);
+	}
+}
