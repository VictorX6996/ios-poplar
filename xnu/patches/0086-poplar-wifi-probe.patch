@@ -0,0 +1,543 @@
+/*
+ * sweet_poplar_wifi_probe.c - Step 8 Stage 1B Poplar Wi-Fi Read-Only Diagnostic Probe
+ *
+ * Controlled by boot-args:
+ *   wifiprobe=0 (default): Completely dormant; normal boot path untouched.
+ *   wifiprobe=1: Level 1 non-invasive read-only diagnostic probe of:
+ *                1. SMEM TOC (0x861ff000)
+ *                2. SMMU ANOC2 capabilities, fault status, and full SMR/S2CR dump (0x016c0000)
+ *                3. SPMI v3 Arbiter APID mapping and ownership (0x0800f000 / 0x0800a000)
+ *                4. RPM GLINK Message RAM TOC (0x00778000)
+ *                5. Device-Tree: live Apple Device Tree inspection + MSM8998 stock DT reference
+ *
+ * Safety Boundaries (100% Passive):
+ *   - Zero writes to SMMU registers, context banks, or translation tables.
+ *   - Zero writes to PMIC peripheral registers (no power rail / GPIO changes).
+ *   - Zero active SPMI command transactions (all active observer writes removed).
+ *   - Zero access to unclocked MMIO (WCSS 0x18800000 and MSS/RMB 0x04180000
+ *     are strictly excluded).
+ */
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <mach/vm_types.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void delay(int usec);
+extern int printf(const char *format, ...) __printflike(1, 2);
+
+void sweet_poplar_wifi_probe(void);
+
+/*
+ * Verified Base Addresses from Poplar Device Tree (dtb/live.dtb)
+ */
+#define POPLAR_SMEM_TOC_PA      0x861ff000u   /* Last 4KB of 2MB SMEM region */
+#define POPLAR_SMMU_ANOC2_PA    0x016c0000u   /* /soc/arm,smmu-anoc2@16c0000 */
+#define POPLAR_SMMU_ANOC2_SIZE  0x4000u       /* 16KB GR0 mapping window */
+#define POPLAR_SPMI_CORE_PA     0x0800f000u   /* /soc/qcom,spmi@800f000 'core' */
+#define POPLAR_SPMI_CNFG_PA     0x0800a000u   /* /soc/qcom,spmi@800f000 'cnfg' */
+#define POPLAR_RPM_MSGRAM_PA    0x00778000u   /* /soc/qcom,glink-rpm 'aux-mem1' (28KB) */
+
+/*
+ * ARM SMMUv2 Architecture Register Offsets (ARM IHI 0062D)
+ */
+#define ARM_SMMU_GR0_sCR0       0x0000u
+#define ARM_SMMU_GR0_IDR0       0x0020u
+#define ARM_SMMU_GR0_IDR1       0x0024u
+#define ARM_SMMU_GR0_IDR2       0x0028u
+#define ARM_SMMU_GR0_sGFSR      0x0048u
+#define ARM_SMMU_GR0_sGFSYNR0   0x0050u
+#define ARM_SMMU_GR0_sGFSYNR1   0x0054u
+#define ARM_SMMU_GR0_sGFSYNR2   0x0058u
+#define ARM_SMMU_GR0_SMR_BASE   0x0800u
+#define ARM_SMMU_GR0_S2CR_BASE  0x0c00u
+
+/* SMMUv2 IDR0 Bitfields */
+#define SMMU_IDR0_NUMSMRG_MASK  0x000000ffu   /* bits [7:0]: Num SMR groups */
+#define SMMU_IDR0_NUMSIDB_SHIFT 9
+#define SMMU_IDR0_NUMSIDB_MASK  0x0000000fu   /* bits [12:9]: Num StreamID bits */
+#define SMMU_IDR0_BTM           (1u << 13)    /* bit 13: Broadcast TLB maint */
+#define SMMU_IDR0_CTTW          (1u << 14)    /* bit 14: Coherent walk */
+#define SMMU_IDR0_NUMIRPT_SHIFT 16
+#define SMMU_IDR0_NUMIRPT_MASK  0x000000ffu   /* bits [23:16]: Num interrupt lines */
+#define SMMU_IDR0_SMS           (1u << 27)    /* bit 27: Stream Match Support */
+#define SMMU_IDR0_NTS           (1u << 28)    /* bit 28: Nested translation */
+#define SMMU_IDR0_S2TS          (1u << 29)    /* bit 29: Stage 2 translation */
+#define SMMU_IDR0_S1TS          (1u << 30)    /* bit 30: Stage 1 translation */
+
+/* SMMUv2 IDR1 Bitfields */
+#define SMMU_IDR1_NUMCB_MASK    0x000000ffu   /* bits [7:0]: Total Context Banks */
+#define SMMU_IDR1_SMCD          (1u << 15)    /* bit 15: Stream Match Disable */
+#define SMMU_IDR1_NUMS2CB_SHIFT 16
+#define SMMU_IDR1_NUMS2CB_MASK  0x000000ffu   /* bits [23:16]: Num Stage 2-only CBs */
+#define SMMU_IDR1_PAGESIZE      (1u << 31)    /* bit 31: 0=4KB, 1=64KB */
+
+/* SMMUv2 SMR Bitfields */
+#define SMMU_SMR_VALID          (1u << 31)    /* bit 31: Entry valid */
+#define SMMU_SMR_MASK_SHIFT     16
+#define SMMU_SMR_MASK_MASK      0x00007fffu   /* bits [30:16]: 15-bit StreamID mask */
+#define SMMU_SMR_ID_MASK        0x00007fffu   /* bits [14:0]: 15-bit StreamID */
+
+/* SMMUv2 S2CR Bitfields */
+#define SMMU_S2CR_CBNDX_MASK    0x000000ffu   /* bits [7:0]: Context Bank index */
+#define SMMU_S2CR_TYPE_SHIFT    16
+#define SMMU_S2CR_TYPE_MASK     0x00000003u   /* bits [17:16]: 0=trans, 1=bypass, 2=fault */
+
+/* Target WLAN StreamIDs for investigation (from MSM8998 DTB) */
+#define WLAN_STREAM_ID_PRIMARY   0x1900u      /* Copy Engine data path */
+#define WLAN_STREAM_ID_SECONDARY 0x1901u      /* Firmware / MSA path */
+
+/* Qualcomm SPMI Arbiter v3 Offsets (MSM8998) */
+#define SPMI_V3_MAP_BASE        0x0800u       /* In CORE region */
+#define SPMI_V3_OWNER_BASE      0x0700u       /* In CNFG region */
+#define PM8998_GPIO3_PPID       0x00c2u       /* SID 0, Peripheral 0xc2 */
+
+/* RPM GLINK Message RAM Constants */
+#define RPM_TOC_OFFSET          (0x7000u - 256u)
+#define RPM_TOC_MAGIC           0x67727430u   /* "grt0" */
+
+static inline uint32_t
+probe_rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+/*
+ * --- 1. SMEM Partition Table Probe ---
+ * Safely reads the Qualcomm SMEM TOC at 0x861ff000.
+ * Layout per Qualcomm Linux drivers/soc/qcom/smem.c:
+ *   Header (32 bytes):
+ *     u32 magic ("$TOC" = 0x434f5424)
+ *     u32 version (= 1)
+ *     u32 num_entries
+ *     u32 max_entries
+ *     u32 reserved[4]
+ *   Entry (48 bytes):
+ *     u32 offset (byte offset from 2MB SMEM base)
+ *     u32 size   (byte size of partition)
+ *     u32 flags
+ *     u16 host0  (subsystem host 0, e.g. APPS=1)
+ *     u16 host1  (subsystem host 1, e.g. Modem=2)
+ *     u32 size_cacheline
+ *     u32 reserved[7]
+ *
+ * Restricts logging to partition headers; never reads partition payloads.
+ */
+static void
+probe_smem(void)
+{
+	vm_offset_t toc;
+	uint32_t magic, ver, num_entries, max_entries, max_safe_entries;
+	uint32_t i;
+
+	printf("WIFI PROBE: [SMEM] mapping TOC @ 0x%08x (4KB)\n", POPLAR_SMEM_TOC_PA);
+	toc = ml_io_map(POPLAR_SMEM_TOC_PA, 0x1000);
+	if (!toc) {
+		printf("WIFI PROBE: [SMEM] FAILED: ml_io_map returned NULL\n");
+		return;
+	}
+
+	magic = probe_rd32(toc, 0);
+	ver = probe_rd32(toc, 4);
+	num_entries = probe_rd32(toc, 8);
+	max_entries = probe_rd32(toc, 12);
+
+	if (magic != 0x434f5424) { /* "$TOC" */
+		printf("WIFI PROBE: [SMEM] invalid magic 0x%08x (expected '$TOC')\n", magic);
+		return;
+	}
+
+	printf("WIFI PROBE: [SMEM] valid $TOC ver=%u entries=%u max=%u\n", ver, num_entries, max_entries);
+
+	/* Bound scan by mapped 4KB page: 32 bytes header + 48 bytes per entry */
+	max_safe_entries = (0x1000u - 32u) / 48u; /* 84 entries max */
+	if (max_entries > 0 && num_entries > max_entries) {
+		num_entries = max_entries;
+	}
+	if (num_entries > max_safe_entries) {
+		num_entries = max_safe_entries;
+	}
+
+	for (i = 0; i < num_entries; i++) {
+		uint32_t e_off = 32u + i * 48u;
+		uint32_t off = probe_rd32(toc, e_off);
+		uint32_t size = probe_rd32(toc, e_off + 4);
+		uint32_t flags = probe_rd32(toc, e_off + 8);
+		uint32_t hosts = probe_rd32(toc, e_off + 12);
+		uint16_t h0 = (uint16_t)hosts;
+		uint16_t h1 = (uint16_t)(hosts >> 16);
+		bool in_bounds, is_global, is_apps;
+
+		/* Explicitly classify empty vs malformed vs valid entries */
+		if (off == 0 && size == 0) {
+			printf("WIFI PROBE: [SMEM] p[%02u] [EMPTY] off=0x00000 sz=0KB (unallocated entry)\n", i);
+			continue;
+		}
+		if (size == 0) {
+			printf("WIFI PROBE: [SMEM] p[%02u] [MALFORMED-ZERO-SIZE] off=0x%05x sz=0KB fl=0x%x\n",
+			    i, off, flags);
+			continue;
+		}
+
+		/* Overflow-safe range check within 2MB SMEM region */
+		in_bounds = (size <= 0x200000u && off <= 0x200000u - size);
+		if (!in_bounds) {
+			printf("WIFI PROBE: [SMEM] p[%02u] [OUT-OF-BOUNDS] off=0x%08x sz=%u fl=0x%x\n",
+			    i, off, size, flags);
+			continue;
+		}
+
+		/*
+		 * Qualcomm SMEM Host IDs: Global = 0, APPS = 1, Modem = 2, ADSP = 3.
+		 * Partitions not including APPS (h0!=1 && h1!=1 && not global) are
+		 * access-protected by the XPU MPU. Reading their payloads causes a bus hang.
+		 */
+		is_global = (h0 == 0 && h1 == 0);
+		is_apps = (h0 == 1 || h1 == 1);
+		printf("WIFI PROBE: [SMEM] p[%02u] off=0x%05x sz=%uKB fl=0x%x h=%u:%u %s\n",
+			i, off, size / 1024u, flags, h0, h1,
+			(is_global || is_apps) ? "APPS-accessible" : "XPU-restricted");
+	}
+}
+
+/*
+ * --- 2. SMMU ANOC2 Probe ---
+ * Reads ARM SMMUv2 capability registers (IDR0, IDR1, IDR2, sCR0).
+ * Decodes all control bits (CLIENTPD, USFCFG, SMCFCFG, GFRE, GFIE, GCFGFRE).
+ * Reads SMMU Global Fault Status and Syndrome registers (sGFSR, sGFSYNR0..2).
+ * Dumps all implemented SMR and S2CR entries bounded by hardware and mapping.
+ */
+static void
+probe_smmu(void)
+{
+	vm_offset_t smmu;
+	uint32_t scr0, idr0, idr1, idr2;
+	uint32_t gfsr, gfsynr0, gfsynr1, gfsynr2;
+	uint32_t num_smr, num_cb, num_s2cb, num_sidb, max_smr_mapped;
+	bool s1ts, s2ts, nts, sms, smcd;
+	bool clientpd, gfre, gfie, gcfgfre, smcfcfg, usfcfg;
+	uint32_t matched_1900, matched_1901, i;
+
+	printf("WIFI PROBE: [SMMU] mapping ANOC2 @ 0x%08x (16KB window)\n", POPLAR_SMMU_ANOC2_PA);
+	smmu = ml_io_map(POPLAR_SMMU_ANOC2_PA, POPLAR_SMMU_ANOC2_SIZE);
+	if (!smmu) {
+		printf("WIFI PROBE: [SMMU] FAILED: ml_io_map returned NULL\n");
+		return;
+	}
+
+	scr0 = probe_rd32(smmu, ARM_SMMU_GR0_sCR0);
+	idr0 = probe_rd32(smmu, ARM_SMMU_GR0_IDR0);
+	idr1 = probe_rd32(smmu, ARM_SMMU_GR0_IDR1);
+	idr2 = probe_rd32(smmu, ARM_SMMU_GR0_IDR2);
+
+	gfsr = probe_rd32(smmu, ARM_SMMU_GR0_sGFSR);
+	gfsynr0 = probe_rd32(smmu, ARM_SMMU_GR0_sGFSYNR0);
+	gfsynr1 = probe_rd32(smmu, ARM_SMMU_GR0_sGFSYNR1);
+	gfsynr2 = probe_rd32(smmu, ARM_SMMU_GR0_sGFSYNR2);
+
+	clientpd = (scr0 & (1u << 0)) != 0;
+	gfre     = (scr0 & (1u << 1)) != 0;
+	gfie     = (scr0 & (1u << 2)) != 0;
+	gcfgfre  = (scr0 & (1u << 5)) != 0;
+	smcfcfg  = (scr0 & (1u << 9)) != 0;
+	usfcfg   = (scr0 & (1u << 10)) != 0;
+
+	sms = (idr0 & SMMU_IDR0_SMS) != 0;
+	num_smr = idr0 & SMMU_IDR0_NUMSMRG_MASK;
+	num_sidb = (idr0 >> SMMU_IDR0_NUMSIDB_SHIFT) & SMMU_IDR0_NUMSIDB_MASK;
+	s1ts = (idr0 & SMMU_IDR0_S1TS) != 0;
+	s2ts = (idr0 & SMMU_IDR0_S2TS) != 0;
+	nts = (idr0 & SMMU_IDR0_NTS) != 0;
+
+	num_cb = idr1 & SMMU_IDR1_NUMCB_MASK;
+	smcd = (idr1 & SMMU_IDR1_SMCD) != 0;
+	num_s2cb = (idr1 >> SMMU_IDR1_NUMS2CB_SHIFT) & SMMU_IDR1_NUMS2CB_MASK;
+
+	printf("WIFI PROBE: [SMMU] sCR0=0x%08x -> CLIENTPD=%u GFRE=%u GFIE=%u GCFGFRE=%u SMCFCFG=%u USFCFG=%u\n",
+	    scr0, clientpd, gfre, gfie, gcfgfre, smcfcfg, usfcfg);
+	printf("WIFI PROBE: [SMMU] IDR0=0x%08x -> NUMSMRG=%u SIDB=%u SMS=%u S1TS=%u S2TS=%u NTS=%u BTM=%u CTTW=%u\n",
+	    idr0, num_smr, num_sidb, sms, s1ts, s2ts, nts, (idr0 >> 13) & 1u, (idr0 >> 14) & 1u);
+	printf("WIFI PROBE: [SMMU] IDR1=0x%08x -> NUMCB=%u SMCD=%u NUMS2CB=%u (raw=0x%02x, %s) NUMPAGENDXB=%u PAGESIZE=%s\n",
+	    idr1, num_cb, smcd, num_s2cb, (idr1 >> 16) & 0xffu, s2ts ? "active" : "N/A (S2TS=0)",
+	    (idr1 >> 28) & 7u, (idr1 & (1u << 31)) ? "64KB" : "4KB");
+	printf("WIFI PROBE: [SMMU] IDR2=0x%08x -> IAS=%u OAS=%u\n",
+	    idr2, idr2 & 0xfu, (idr2 >> 4) & 0xfu);
+	printf("WIFI PROBE: [SMMU] sampled sGFSR=0x%08x (USF=%u SMCF=%u MULTI=%u) sGFSYNR0=0x%08x sGFSYNR1=0x%08x (fault_SID=0x%04x) sGFSYNR2=0x%08x\n",
+	    gfsr, (gfsr >> 1) & 1u, (gfsr >> 2) & 1u, (gfsr >> 31) & 1u,
+	    gfsynr0, gfsynr1, gfsynr1 & 0x7fffu, gfsynr2);
+
+	if (!sms) {
+		printf("WIFI PROBE: [SMMU] SMS=0: SMMU operates in Stream Indexing mode (linear S2CR table)\n");
+		return;
+	}
+
+	/* Double-bound scan by hardware limit and mapped 16KB window */
+	if (num_smr > 128u) {
+		num_smr = 128u;
+	}
+	max_smr_mapped = (POPLAR_SMMU_ANOC2_SIZE > ARM_SMMU_GR0_S2CR_BASE) ?
+	    (POPLAR_SMMU_ANOC2_SIZE - ARM_SMMU_GR0_S2CR_BASE) / 4u : 0u;
+	if (num_smr > max_smr_mapped) {
+		num_smr = max_smr_mapped;
+	}
+
+	printf("WIFI PROBE: [SMMU] dumping all %u SMR / S2CR register pairs:\n", num_smr);
+	matched_1900 = 0;
+	matched_1901 = 0;
+	for (i = 0; i < num_smr; i++) {
+		uint32_t smr_off = ARM_SMMU_GR0_SMR_BASE + i * 4u;
+		uint32_t s2cr_off = ARM_SMMU_GR0_S2CR_BASE + i * 4u;
+		uint32_t smr, s2cr, mask, sid, type, cbndx;
+		bool valid, match_1900, match_1901;
+		const char *type_str;
+
+		/* Explicit per-entry bounds check against mapped window */
+		if (smr_off + 4u > POPLAR_SMMU_ANOC2_SIZE || s2cr_off + 4u > POPLAR_SMMU_ANOC2_SIZE) {
+			printf("WIFI PROBE: [SMMU] SMR[%02u] offset exceeds mapped window, stopping dump\n", i);
+			break;
+		}
+
+		smr = probe_rd32(smmu, smr_off);
+		s2cr = probe_rd32(smmu, s2cr_off);
+		valid = (smr & SMMU_SMR_VALID) != 0;
+		mask = (smr >> SMMU_SMR_MASK_SHIFT) & SMMU_SMR_MASK_MASK;
+		sid = smr & SMMU_SMR_ID_MASK;
+		type = (s2cr >> SMMU_S2CR_TYPE_SHIFT) & SMMU_S2CR_TYPE_MASK;
+		cbndx = s2cr & SMMU_S2CR_CBNDX_MASK;
+		type_str = (type == 1) ? "BYPASS" : (type == 0) ? "TRANS" : (type == 2) ? "FAULT" : "RSVD";
+
+		/* ARM SMMUv2 stream matching rule: ((StreamID ^ sid) & ~mask) == 0 */
+		match_1900 = valid && (((WLAN_STREAM_ID_PRIMARY ^ sid) & ~mask) == 0);
+		match_1901 = valid && (((WLAN_STREAM_ID_SECONDARY ^ sid) & ~mask) == 0);
+
+		printf("WIFI PROBE: [SMMU] SMR[%02u]: valid=%u ID=0x%04x mask=0x%04x -> S2CR: %s (type=%u cb=%u)%s%s\n",
+		    i, valid, sid, mask, type_str, type, cbndx,
+		    match_1900 ? " [MATCH 0x1900]" : "",
+		    match_1901 ? " [MATCH 0x1901]" : "");
+
+		if (match_1900) {
+			matched_1900++;
+		}
+		if (match_1901) {
+			matched_1901++;
+		}
+	}
+
+	printf("WIFI PROBE: [SMMU] RESULT: StreamID 0x1900 (primary): %u match(es), StreamID 0x1901 (secondary): %u match(es)\n",
+	    matched_1900, matched_1901);
+	if (matched_1900 == 0 && matched_1901 == 0) {
+		printf("WIFI PROBE: [SMMU] RESULT: Neither WLAN StreamID has an SMR route. Under USFCFG=1, transactions will raise USF aborts.\n");
+	}
+}
+
+/*
+ * --- 3. PM8998 GPIO3 SPMI Arbiter Probe ---
+ * Inspects SPMI v3 Arbiter APID mapping registers in CORE and CNFG space.
+ * 100% PASSIVE READ-ONLY MMIO:
+ * Active observer command transactions have been completely removed
+ * to eliminate any risk of unverified writes or SPMI arbiter collision.
+ */
+static void
+probe_pm8998_gpio3(void)
+{
+	vm_offset_t core, cnfg;
+	uint32_t arb_ver, map_base, owner;
+	uint16_t target_ppid, found_apid;
+	uint32_t i;
+
+	printf("WIFI PROBE: [SPMI] mapping SPMI CORE @ 0x%08x & CNFG @ 0x%08x (read-only)\n",
+	    POPLAR_SPMI_CORE_PA, POPLAR_SPMI_CNFG_PA);
+
+	core = ml_io_map(POPLAR_SPMI_CORE_PA, 0x1000);
+	cnfg = ml_io_map(POPLAR_SPMI_CNFG_PA, 0x3000);
+	if (!core || !cnfg) {
+		printf("WIFI PROBE: [SPMI] FAILED: ml_io_map failed for CORE or CNFG\n");
+		return;
+	}
+
+	arb_ver = probe_rd32(core, 0x00);
+	printf("WIFI PROBE: [SPMI] Arbiter HW version: 0x%08x (%s)\n",
+	    arb_ver, (arb_ver < 0x50000000u) ? "v2/v3 (MSM8998)" : "v5 (SM7150+)");
+
+	/* On SPMI v3, APID mapping table is at CORE + 0x800, ownership at CNFG + 0x700 */
+	map_base = (arb_ver >= 0x50000000u) ? 0x900u : SPMI_V3_MAP_BASE;
+	target_ppid = PM8998_GPIO3_PPID; /* 0x00c2 */
+	found_apid = 0xffffu;
+	owner = 0xffffffffu;
+
+	for (i = 0; i < 512u; i++) {
+		uint32_t entry = probe_rd32(core, map_base + i * 4u);
+		if (entry != 0 && ((entry >> 8) & 0xfffu) == target_ppid) {
+			found_apid = (uint16_t)i;
+			owner = probe_rd32(cnfg, SPMI_V3_OWNER_BASE + i * 4u) & 7u;
+			break;
+		}
+	}
+
+	if (found_apid == 0xffffu) {
+		printf("WIFI PROBE: [SPMI] PM8998 GPIO3 (PPID 0x00c2) has no APID assigned in SPMI table\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [SPMI] PM8998 GPIO3 (PPID 0x00c2) mapped to APID %u (owner EE=%u: %s)\n",
+	    found_apid, owner, (owner == 0) ? "APPS" : "OTHER/SECURE");
+	printf("WIFI PROBE: [SPMI] active command transactions completely removed (100%% passive diagnostic)\n");
+}
+
+/*
+ * --- 4. RPM GLINK Message RAM Header Probe ---
+ * Reads TOC at 0x00778000 + 0x7000 - 256 using probe_rd32().
+ * Completely read-only: does not kick IPC doorbell and does not send requests.
+ * TOC layout per Qualcomm RPM GLINK transport:
+ *   Header: u32 magic ("grt0"), u32 entry_count
+ *   Entries: u32 id, u32 offset, u32 size
+ */
+static void
+probe_rpm_msgram(void)
+{
+	vm_offset_t ram;
+	uint32_t magic, count, i;
+
+	printf("WIFI PROBE: [RPM] inspecting Message RAM @ 0x%08x (28KB)\n", POPLAR_RPM_MSGRAM_PA);
+	ram = ml_io_map(POPLAR_RPM_MSGRAM_PA, 0x7000);
+	if (!ram) {
+		printf("WIFI PROBE: [RPM] FAILED: ml_io_map returned NULL\n");
+		return;
+	}
+
+	magic = probe_rd32(ram, RPM_TOC_OFFSET);
+	count = probe_rd32(ram, RPM_TOC_OFFSET + 4u);
+
+	if (magic != RPM_TOC_MAGIC) { /* "grt0" */
+		printf("WIFI PROBE: [RPM] invalid TOC magic 0x%08x (expected 'grt0')\n", magic);
+		return;
+	}
+
+	printf("WIFI PROBE: [RPM] valid TOC magic 'grt0' entry_count=%u\n", count);
+
+	/* Cap count to available 256-byte TOC window: (256 - 8) / 12 = 20 entries max */
+	if (count > 20u) {
+		count = 20u;
+	}
+
+	for (i = 0; i < count; i++) {
+		uint32_t e_off = RPM_TOC_OFFSET + 8u + i * 12u;
+		uint32_t id, off, size;
+		char id_str[5];
+
+		if (e_off + 12u > 0x7000u) {
+			printf("WIFI PROBE: [RPM] entry[%u] TOC entry header exceeds mapped RAM\n", i);
+			break;
+		}
+
+		id = probe_rd32(ram, e_off);
+		off = probe_rd32(ram, e_off + 4u);
+		size = probe_rd32(ram, e_off + 8u);
+
+		id_str[0] = (char)(id & 0xff);
+		id_str[1] = (char)((id >> 8) & 0xff);
+		id_str[2] = (char)((id >> 16) & 0xff);
+		id_str[3] = (char)((id >> 24) & 0xff);
+		id_str[4] = 0;
+
+		/* Overflow-safe bounds check within 28KB Message RAM */
+		if (off < 0x7000u && size >= 8u && size <= 0x7000u - off) {
+			uint32_t head = probe_rd32(ram, off);
+			uint32_t tail = probe_rd32(ram, off + 4u);
+			printf("WIFI PROBE: [RPM] entry[%u] '%s' off=0x%04x sz=%u head=%u tail=%u\n",
+			    i, id_str, off, size, head, tail);
+		} else {
+			printf("WIFI PROBE: [RPM] entry[%u] '%s' [INVALID/OUT-OF-BOUNDS] off=0x%04x sz=%u\n",
+			    i, id_str, off, size);
+		}
+	}
+}
+
+/*
+ * --- 5. WLAN Device-Tree Inspection & Target Reference ---
+ * A. Live Apple Device Tree (ADT) Inspection:
+ *    Queries properties passed to XNU by the bootloader shim.
+ *    Validates /chosen/mac-address-wifi0 and checks for any attached WLAN node.
+ *
+ * B. Compile-Time Platform Reference Data (MSM8998 Stock DTB):
+ *    Documents verified target hardware parameters from /soc/qcom,icnss@18800000.
+ *    Crucially: Zero MMIO access to unclocked WCSS registers is performed.
+ */
+static void
+probe_wlan_device_tree(void)
+{
+	DTEntry node = NULL;
+	void const *prop = NULL;
+	unsigned int prop_size = 0;
+
+	/* 5A: Live Apple Device Tree inspection */
+	if (SecureDTLookupEntry(NULL, "/chosen", &node) == kSuccess) {
+		if (SecureDTGetProperty(node, "mac-address-wifi0", &prop, &prop_size) == kSuccess &&
+		    prop_size == 6) {
+			const uint8_t *mac = (const uint8_t *)prop;
+			printf("WIFI PROBE: [ADT] live /chosen/mac-address-wifi0 = %02x:%02x:%02x:%02x:%02x:%02x\n",
+			    mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+		}
+	}
+
+	if (SecureDTLookupEntry(NULL, "/arm-io/wlan", &node) != kSuccess &&
+	    SecureDTLookupEntry(NULL, "/wlan", &node) != kSuccess) {
+		printf("WIFI PROBE: [ADT] live device-tree has no active WLAN node (WCN3990 driver unattached)\n");
+	} else {
+		printf("WIFI PROBE: [ADT] live device-tree contains WLAN node\n");
+	}
+
+	/* 5B: Compile-time reference hardware specification (from Sony MSM8998 stock DTB) */
+	printf("WIFI PROBE: [DT-REF] Reference hardware spec (from Sony MSM8998 stock DTB):\n");
+	printf("WIFI PROBE: [DT-REF]   Target node: '/soc/qcom,icnss@18800000' (compatible: 'qcom,icnss')\n");
+	printf("WIFI PROBE: [DT-REF]   SMMU instance: ANOC2 @ 0x016c0000 (phandle 0x6a)\n");
+	printf("WIFI PROBE: [DT-REF]   StreamIDs: Primary=0x1900 (data/CE), Secondary=0x1901 (firmware/MSA)\n");
+	printf("WIFI PROBE: [DT-REF]   Memory: membase=0x18800000 (8MB) iova_base=0xa0000000 msa_sz=1MB\n");
+	printf("WIFI PROBE: [DT-REF]   Supplies: vdd-0.8-cx-mx, vdd-1.8-xo, vdd-1.3-rfa, vdd-3.3-ch0\n");
+	printf("WIFI PROBE: [DT-REF]   Interrupts: 12 Copy Engine SPIs (413..425) on GICv3\n");
+	printf("WIFI PROBE: [DT-REF]   Notice: Above is compile-time specification data; no WCSS MMIO touched.\n");
+}
+
+/*
+ * Main Probe Entry Point
+ * Invoked exactly once from sweet_ufs_init() in bsd/dev/sweet_ufs.c
+ * during single-threaded early BSD bootstrap before userland launch.
+ */
+void
+sweet_poplar_wifi_probe(void)
+{
+	int probe = 0;
+	(void)PE_parse_boot_argn("wifiprobe", &probe, sizeof(probe));
+
+	/* Default: completely dormant */
+	if (probe <= 0) {
+		return;
+	}
+
+	if (probe != 1) {
+		printf("WIFI PROBE: wifiprobe=%d unsupported; defaulting to Level 1 read-only diagnostic\n", probe);
+	}
+
+	printf("\n=======================================================\n");
+	printf("=== SWEET POPLAR WI-FI DIAGNOSTIC PROBE (LEVEL 1)   ===\n");
+	printf("=======================================================\n");
+
+	/* Level 1 Probes: 100% Non-invasive, safe, always-clocked buses */
+	probe_smem();
+	probe_smmu();
+	probe_pm8998_gpio3();
+	probe_rpm_msgram();
+	probe_wlan_device_tree();
+
+	printf("=======================================================\n");
+	printf("=== SWEET POPLAR WI-FI DIAGNOSTIC PROBE COMPLETE    ===\n");
+	printf("=======================================================\n\n");
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
