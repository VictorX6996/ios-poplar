+void sweet_poplar_wifi_probe(void);
+extern bool poplar_rpm_ldoa(unsigned ldo, uint32_t uv);
+extern bool poplar_rpm_clka(unsigned clk_id, uint32_t enable);
+
+/*
+ * Verified Base Addresses from Poplar Device Tree (dtb/live.dtb)
+ */
+#define POPLAR_SMEM_TOC_PA      0x861ff000u   /* Last 4KB of 2MB SMEM region */
+#define POPLAR_SMMU_ANOC2_PA    0x016c0000u   /* /soc/arm,smmu-anoc2@16c0000 */
+#define POPLAR_SMMU_ANOC2_SIZE  0x4000u       /* 16KB GR0 mapping window */
+#define POPLAR_SPMI_CORE_PA     0x0800f000u   /* /soc/qcom,spmi@800f000 'core' */
+#define POPLAR_SPMI_CNFG_PA     0x0800a000u   /* /soc/qcom,spmi@800f000 'cnfg' */
+#define POPLAR_RPM_MSGRAM_PA    0x00778000u   /* /soc/qcom,glink-rpm 'aux-mem1' (28KB) */
+#define POPLAR_WCSS_PA              0x18800000u   /* /soc/qcom,icnss@18800000 'membase' */
+#define POPLAR_WCSS_CE0_PAGE_PA     0x18857000u   /* Copy Engine 0 page-aligned base (0x18800000 + 0x57000) */
+#define POPLAR_WCSS_CE0_PAGE_OFF    0x00000400u   /* Offset of CE0 base register within 4KB page (0x57400 - 0x57000) */
+#define POPLAR_WCSS_PAGE_SZ         0x00001000u   /* 4KB targeted page mapping (prevents io_submap exhaustion) */
+
+/*
+ * Sub-Phase 4.1: Passive Subsystem Live State & Shared Memory Audit Definitions
+ */
+#define POPLAR_SMEM_BASE_PA         0x86000000u   /* /soc/qcom,smem@86000000 2MB base */
+#define POPLAR_SMEM_P08_OFFSET      0x000d3000u   /* p[08] APPS:Modem partition offset */
+#define POPLAR_SMEM_P08_PA          (POPLAR_SMEM_BASE_PA + POPLAR_SMEM_P08_OFFSET) /* 0x860d3000 */
+#define POPLAR_SMEM_P08_SZ          0x00020000u   /* 128KB partition size */
+#define POPLAR_PIL_MBA_PA           0x94100000u   /* /reserved-memory/pil_mba_region@94100000 (2MB) */
+#define SMEM_PART_MAGIC             0x54525024u   /* "$PRT" in little-endian (0x24, 0x50, 0x52, 0x54) */
+#define SMEM_PRIVATE_CANARY         0xa5a5u
