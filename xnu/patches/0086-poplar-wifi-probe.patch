+static void
+s5b_ssctl_send_event(uint32_t snode, uint32_t sport, const char *subsys_name, uint32_t event)
+{
+	uint8_t req[64];
+	uint32_t roff = 0u;
+	uint8_t name_buf[16];
+	unsigned nlen = sweet_str_len(subsys_name);
+	if (nlen > 14u) {
+		nlen = 14u;
+	}
+	name_buf[0] = (uint8_t)nlen;
+	memcpy(name_buf + 1, subsys_name, nlen);
+
+	/* TLV 0x01: subsys_name (1 byte len prefix + ASCII chars) */
+	roff = s5b_qmi_put_tlv(req, roff, 0x01u, (uint16_t)(1u + nlen), name_buf);
+
+	/* TLV 0x02: event (uint32 enum) */
+	uint8_t ev_buf[4];
+	s5b_wr_le32(ev_buf, event);
+	roff = s5b_qmi_put_tlv(req, roff, 0x02u, 4u, ev_buf);
+
+	/* TLV 0x10: evt_driven (uint32 enum, forced=0) */
+	uint8_t drv_buf[4];
+	s5b_wr_le32(drv_buf, SSCTL_SSR_EVENT_FORCED);
+	roff = s5b_qmi_put_tlv(req, roff, 0x10u, 4u, drv_buf);
+
+	uint16_t txn = (uint16_t)(++s5b.next_qmi_txn);
+	if (txn == 0u) {
+		txn = (uint16_t)(++s5b.next_qmi_txn);
+	}
+	s5b.ssctl_event_txn = txn;
+	s5b.ssctl_event_sent = true;
+
+	printf("WIFI PROBE: [5B.3] SSCTL send subsys_event '%s' event=%u (txn=%u -> node=%u port=%u)\n",
+	    subsys_name, event, txn, snode, sport);
+
+	s5b_qmi_send_sdu(QMI_MSG_REQUEST, txn, SSCTL_SUBSYS_EVENT_REQ,
+	    QRTR_LOCAL_PORT_SSCTL, snode, sport, req, (uint16_t)roff);
+}
+
+static void
+s5b_handle_ssctl_client(uint32_t src_node, uint32_t src_port,
+    uint8_t qtype, uint16_t txn, uint16_t msg_id, const uint8_t *sdu, uint32_t sdu_len)
+{
+	(void)src_node;
+	(void)src_port;
+	if (qtype == QMI_MSG_RESPONSE) {
+		uint16_t rlen = 0u;
+		const uint8_t *rv = s5b_qmi_find_tlv(sdu, sdu_len, 0x02u, &rlen);
+		uint16_t res = (rv && rlen >= 4u) ? s5b_rd_le16(rv + 0) : 0xffffu;
+		uint16_t err = (rv && rlen >= 4u) ? s5b_rd_le16(rv + 2) : 0xffffu;
+
+		if (msg_id == SSCTL_SUBSYS_EVENT_REQ) {
+			s5b.ssctl_event_acked = (res == 0u);
+			printf("WIFI PROBE: [5B.3] SSCTL SUBSYS_EVENT resp: txn=%u res=%u err=%u (%s)\n",
+			    txn, res, err, (res == 0u && err == 0u) ? "SUCCESS" : "ERROR");
+			if (res == 0u && !s5b.ssctl_wcnss_sent) {
+				s5b.ssctl_wcnss_sent = true;
+				s5b_ssctl_send_event(s5b.ssctl_node, s5b.ssctl_port, "wcnss", SSCTL_SSR_EVENT_AFTER_POWERUP);
+			} else if (res == 0u && s5b.ssctl_wcnss_sent) {
+				s5b.ssctl_wcnss_acked = true;
+			}
+		} else if (msg_id == SSCTL_GET_FAILURE_REASON_REQ) {
+			s5b.ssctl_sfr_recvd = true;
+			printf("WIFI PROBE: [5B.3] SSCTL GET_FAILURE_REASON resp: txn=%u res=%u err=%u (%s)\n",
+			    txn, res, err, (res == 0u && err == 0u) ? "SUCCESS" : "ERROR");
+			uint16_t mlen = 0u;
+			const uint8_t *mv = s5b_qmi_find_tlv(sdu, sdu_len, 0x10u, &mlen);
+			if (mv && mlen > 0u) {
+				const char *str_start = (const char *)mv;
+				uint16_t str_len = mlen;
+				if (mlen >= 2u && (mv[0] == 0u || mv[0] == 1u) && (uint16_t)mv[1] <= mlen - 2u) {
+					str_start = (const char *)(mv + 2u);
+					str_len = mv[1];
+				}
+				char sfr[96];
+				uint16_t copylen = (str_len < (uint16_t)(sizeof(sfr) - 1u)) ? str_len : (uint16_t)(sizeof(sfr) - 1u);
+				memcpy(sfr, str_start, copylen);
+				sfr[copylen] = '\0';
+				printf("WIFI PROBE: [5B.3] *** SSCTL Subsystem Failure Reason (SFR): '%s' ***\n", sfr);
+			} else {
+				printf("WIFI PROBE: [5B.3] SSCTL GET_FAILURE_REASON returned no error string (len=%u)\n", sdu_len);
+			}
+		} else {
+			printf("WIFI PROBE: [5B.3] SSCTL unhandled resp msg=0x%04x txn=%u res=%u err=%u\n",
+			    msg_id, txn, res, err);
+		}
+	} else if (qtype == QMI_MSG_INDICATION) {
+		printf("WIFI PROBE: [5B.3] SSCTL IND msg=0x%04x len=%u\n", msg_id, sdu_len);
+		if (msg_id == SSCTL_SUBSYS_EVENT_REQ) {
+			printf("WIFI PROBE: [5B.3] SSCTL SUBSYS_EVENT_READY_IND received\n");
+		}
+	} else {
+		printf("WIFI PROBE: [5B.3] SSCTL unhandled qtype=%u msg=0x%04x txn=%u\n",
+		    qtype, msg_id, txn);
+	}
+}
+
+static void
+s5b_ssctl_query_failure_reason(const char *tag)
+{
+	if (!s5b.ssctl_up) {
+		return;
+	}
+	uint16_t txn = (uint16_t)(++s5b.next_qmi_txn);
+	if (txn == 0u) {
+		txn = (uint16_t)(++s5b.next_qmi_txn);
+	}
+	s5b.ssctl_sfr_txn = txn;
+	s5b.ssctl_sfr_sent = true;
+
+	printf("WIFI PROBE: [5B.3] SSCTL query failure reason [%s] (txn=%u -> node=%u port=%u)\n",
+	    tag ? tag : "poll", txn, s5b.ssctl_node, s5b.ssctl_port);
+
+	s5b_qmi_send_sdu(QMI_MSG_REQUEST, txn, SSCTL_GET_FAILURE_REASON_REQ,
+	    QRTR_LOCAL_PORT_SSCTL, s5b.ssctl_node, s5b.ssctl_port, NULL, 0u);
+}
+
+static void
+s5b_ipcrtr_rx_packet(const uint8_t *pkt, uint32_t len)
+{
+	if (len < 32u) {
+		printf("WIFI PROBE: [5B.3] IPCRTR packet too short: len=%u\n", len);
+		return;
+	}
+	uint32_t ver        = s5b_rd_le32(pkt + 0);
+	uint32_t type       = s5b_rd_le32(pkt + 4);
+	uint32_t src_node   = s5b_rd_le32(pkt + 8);
+	uint32_t src_port   = s5b_rd_le32(pkt + 12);
+	uint32_t confirm_rx = s5b_rd_le32(pkt + 16);
+	uint32_t size       = s5b_rd_le32(pkt + 20);
+	uint32_t dst_node   = s5b_rd_le32(pkt + 24);
+	uint32_t dst_port   = s5b_rd_le32(pkt + 28);
+
+	if (ver != QRTR_PROTO_VER_1 || size > len - 32u) {
+		printf("WIFI PROBE: [5B.3] IPCRTR bad ver=%u or size=%u > len=%u\n", ver, size, len);
+		return;
+	}
+	const uint8_t *body = pkt + 32u;
+
+	if (confirm_rx != 0u) {
+		s5b_ipcrtr_send_ctrl(src_node, QRTR_TYPE_RESUME_TX, dst_node, dst_port, 0u, 0u);
+	}
+
+	if (dst_port == QRTR_PORT_CTRL || type != QRTR_TYPE_DATA) {
+		s5b.qrtr_ctrl_rx_count++;
+		uint32_t cmd = (size >= 4u) ? s5b_rd_le32(body + 0) : type;
+		if (cmd == QRTR_TYPE_HELLO) {
+			s5b.qrtr_hello_count++;
+			if (!s5b.hello_recvd || s5b.mpss_node_id != src_node) {
+				printf("WIFI PROBE: [5B.3] IPCRTR HELLO from node=%u port=0x%x size=%u\n",
+				    src_node, src_port, size);
+			}
+			s5b.hello_recvd = true;
+			s5b.mpss_node_id = src_node;
+			if (!s5b.hello_sent) {
+				s5b.hello_sent = true;
+				s5b_ipcrtr_send_ctrl(src_node, QRTR_TYPE_HELLO, 0u, 0u, 0u, 0u);
+				s5b_advertise_apps_servers(src_node);
+			}
+		} else if (cmd == QRTR_TYPE_NEW_SERVER && size >= 20u) {
+			s5b.qrtr_new_server_rx_count++;
+			uint32_t svc  = s5b_rd_le32(body + 4);
+			uint32_t inst = s5b_rd_le32(body + 8);
+			uint32_t snode = s5b_rd_le32(body + 12);
+			uint32_t sport = s5b_rd_le32(body + 16);
+			printf("WIFI PROBE: [5B.3]   NEW_SERVER: svc=0x%04x ver=%u inst=%u node=%u port=%u\n",
+			    svc, inst & 0xffu, inst >> 8, snode, sport);
+			if (svc == QRTR_SVC_SERVREG_NOTIF) {
+				s5b.servreg_notif_up   = true;
+				s5b.servreg_notif_node = snode;
+				s5b.servreg_notif_port = sport;
+				s5b.servreg_notif_inst = inst >> 8;
+				s5b_servreg_register_listeners(snode, sport);
+			}
+			if (svc == QRTR_SVC_SERVREG_LOC) {
+				s5b.servreg_loc_up          = true;
+				s5b.servreg_loc_remote_node = snode;
+				s5b.servreg_loc_remote_port = sport;
+				s5b_icnss_query_service_location(snode, sport);
+			}
+			if (svc == QRTR_SVC_WLFW && !s5b.wlfw_up) {
+				s5b.wlfw_up   = true;
+				s5b.wlfw_node = snode;
+				s5b.wlfw_port = sport;
+			}
+			if (svc == QRTR_SVC_SSCTL) {
+				s5b.ssctl_up   = true;
+				s5b.ssctl_node = snode;
+				s5b.ssctl_port = sport;
+				s5b.ssctl_inst = inst >> 8;
+				s5b_ssctl_send_event(snode, sport, "modem", SSCTL_SSR_EVENT_AFTER_POWERUP);
+			}
+		} else if (cmd == QRTR_TYPE_NEW_LOOKUP && size >= 12u) {
+			s5b.qrtr_lookup_count++;
+			uint32_t svc  = s5b_rd_le32(body + 4);
+			uint32_t inst = s5b_rd_le32(body + 8);
+			printf("WIFI PROBE: [5B.3] *** RX NEW_LOOKUP: svc=0x%04x ver=%u inst=%u from node=%u port=%u ***\n",
+			    svc, inst & 0xffu, inst >> 8, src_node, src_port);
+			uint32_t resp_inst = (inst != 0u) ? inst : 1u;
+			if (svc == QRTR_SVC_TFTP) {
+				s5b.qrtr_lookup_tftp_count++;
+				printf("WIFI PROBE: [5B.3]   -> Answering TFTP LOOKUP with inst=%u (resp_inst=%u)\n", inst, resp_inst);
+				s5b_ipcrtr_send_ctrl(src_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_TFTP,
+				    (180u << 8) | 1u, QRTR_NODE_APPS, QRTR_LOCAL_PORT_TFTP_180);
+				s5b_ipcrtr_send_ctrl(src_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_TFTP,
+				    (1u << 8) | 1u, QRTR_NODE_APPS, QRTR_LOCAL_PORT_TFTP_1);
+				s5b_ipcrtr_send_ctrl(src_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_TFTP,
+				    resp_inst, QRTR_NODE_APPS, QRTR_LOCAL_PORT_TFTP);
+			} else if (svc == QRTR_SVC_SERVREG_LOC) {
+				s5b_ipcrtr_send_ctrl(src_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_SERVREG_LOC,
+				    (1u << 8) | 1u, QRTR_NODE_APPS, QRTR_LOCAL_PORT_SERVREG_1);
+				s5b_ipcrtr_send_ctrl(src_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_SERVREG_LOC,
+				    1u, QRTR_NODE_APPS, QRTR_LOCAL_PORT_SERVREG_0);
+			} else if (svc == QRTR_SVC_RMTFS) {
+				s5b_ipcrtr_send_ctrl(src_node, QRTR_TYPE_NEW_SERVER, QRTR_SVC_RMTFS,
+				    resp_inst, QRTR_NODE_APPS, QRTR_LOCAL_PORT_RMTFS);
+			} else {
+				s5b.qrtr_lookup_other_count++;
+				printf("WIFI PROBE: [5B.3]   -> Unhandled LOOKUP: svc=0x%04x inst=%u from %u:%u\n",
+				    svc, inst, src_node, src_port);
+			}
+		} else if (cmd == QRTR_TYPE_DEL_CLIENT && size >= 12u) {
+			s5b.qrtr_del_client_count++;
+			uint32_t cnode = s5b_rd_le32(body + 4);
+			uint32_t cport = s5b_rd_le32(body + 8);
+			if (cnode != QRTR_NODE_APPS) {
+				printf("WIFI PROBE: [5B.3] IPCRTR DEL_CLIENT %u:%u\n", cnode, cport);
+			}
+		} else {
+			printf("WIFI PROBE: [5B.3] IPCRTR CTRL cmd=%u type=%u src=%u:%u dst=%u:%u sz=%u\n",
+			    cmd, type, src_node, src_port, dst_node, dst_port, size);
+		}
+		return;
+	}
+
+	if (dst_port == QRTR_LOCAL_PORT_TFTP ||
+	    dst_port == QRTR_LOCAL_PORT_TFTP_180 ||
+	    dst_port == QRTR_LOCAL_PORT_TFTP_1 ||
+	    (dst_port >= QRTR_LOCAL_PORT_TFTP_SESS0 && dst_port < QRTR_LOCAL_PORT_TFTP_SESS0 + TFTP_MAX_SESS)) {
+		s5b_handle_tftp_pkt(dst_port, src_node, src_port, body, size);
+		return;
+	}
+
+	if (size < 7u) {
+		printf("WIFI PROBE: [5B.3] IPCRTR DATA short size=%u dst_port=%u src=%u:%u\n",
+		    size, dst_port, src_node, src_port);
+		return;
+	}
+	uint8_t  qtype = body[0];
+	uint16_t qtxn  = s5b_rd_le16(body + 1);
+	uint16_t qmsg  = s5b_rd_le16(body + 3);
+	uint16_t qlen  = s5b_rd_le16(body + 5);
+	if ((uint32_t)qlen > size - 7u) {
+		printf("WIFI PROBE: [5B.3] IPCRTR QMI bad qlen=%u > size-7=%u\n", qlen, size - 7u);
+		return;
+	}
+	const uint8_t *qsdu = body + 7u;
+
+	if (dst_port == QRTR_LOCAL_PORT_SERVREG_1 || dst_port == QRTR_LOCAL_PORT_SERVREG_0) {
+		s5b_qmi_dump_packet("RX", src_node, src_port, QRTR_NODE_APPS, dst_port,
+		    qtype, qtxn, qmsg, qsdu, qlen);
+		if (qtype == QMI_MSG_REQUEST) {
+			s5b_handle_servreg_qmi(dst_port, src_node, src_port, qtxn, qmsg, qsdu, qlen);
+		} else {
+			printf("WIFI PROBE: [5B.3] SERVREG_LOC unhandled qtype=%u msg=0x%04x txn=%u\n",
+			    qtype, qmsg, qtxn);
+		}
+	} else if (dst_port == QRTR_LOCAL_PORT_SERVREG_CLNT) {
+		s5b_qmi_dump_packet("RX", src_node, src_port, QRTR_NODE_APPS, dst_port,
+		    qtype, qtxn, qmsg, qsdu, qlen);
+		s5b_handle_servreg_notif_client(src_node, src_port, qtype, qtxn, qmsg, qsdu, qlen);
+	} else if (dst_port == QRTR_LOCAL_PORT_SSCTL) {
+		s5b_qmi_dump_packet("RX", src_node, src_port, QRTR_NODE_APPS, dst_port,
+		    qtype, qtxn, qmsg, qsdu, qlen);
+		s5b_handle_ssctl_client(src_node, src_port, qtype, qtxn, qmsg, qsdu, qlen);
+	} else if (dst_port == QRTR_LOCAL_PORT_RMTFS) {
+		if (qtype == QMI_MSG_REQUEST) {
+			s5b_handle_rmtfs_qmi(src_node, src_port, qtxn, qmsg, qsdu, qlen);
+		} else {
+			printf("WIFI PROBE: [5B.3] RMTFS unhandled qtype=%u msg=0x%04x txn=%u\n",
+			    qtype, qmsg, qtxn);
+		}
+	} else if (dst_port == QRTR_LOCAL_PORT_WLFW_CLNT) {
+		s5b_handle_wlfw_qmi(qtype, qtxn, qmsg, qsdu, qlen);
+	} else {
+		printf("WIFI PROBE: [5B.3] IPCRTR UNHANDLED: dst_port=%u src=%u:%u type=%u size=%u qtype=%u txn=%u msg=0x%04x qlen=%u\n",
+		    dst_port, src_node, src_port, type, size, qtype, qtxn, qmsg, qlen);
+	}
+}
+
+static bool
+s5b_wlfw_qmi_sync(uint16_t msg_id, const uint8_t *req_sdu, uint16_t req_len,
+    uint16_t *out_result, uint16_t *out_error)
+{
+	uint16_t txn = (uint16_t)(++s5b.next_qmi_txn);
+	if (txn == 0u) {
+		txn = (uint16_t)(++s5b.next_qmi_txn);
+	}
+	s5b.qmi_resp_ready = false;
+	s5b_qmi_send_sdu(QMI_MSG_REQUEST, txn, msg_id, QRTR_LOCAL_PORT_WLFW_CLNT,
+	    s5b.wlfw_node, s5b.wlfw_port, req_sdu, req_len);
+
+	for (unsigned ms = 0u; ms < 5000u; ms++) {
+		s5b_pump_all();
+		if (s5b.qmi_resp_ready && s5b.qmi_resp_msg == msg_id && s5b.qmi_resp_txn == txn) {
+			uint16_t rlen = 0u;
+			const uint8_t *rv = s5b_qmi_find_tlv(s_5b_qmi_resp_buf, s5b.qmi_resp_len, 0x02u, &rlen);
+			uint16_t res = (rv && rlen >= 4u) ? s5b_rd_le16(rv + 0) : 0xffffu;
+			uint16_t err = (rv && rlen >= 4u) ? s5b_rd_le16(rv + 2) : 0xffffu;
+			if (out_result) *out_result = res;
+			if (out_error)  *out_error  = err;
+			return (res == 0u);
+		}
+		delay(1000);
+	}
+	if (out_result) *out_result = 0xfffeu;
+	if (out_error)  *out_error  = 0xfffeu;
+	printf("WIFI PROBE: [5B.4] ERROR: WLFW QMI 0x%04x timeout\n", msg_id);
+	return false;
+}
+
+static void
+s5b_anoc2_smmu_bypass(void)
+{
+	vm_offset_t smmu = ml_io_map(POPLAR_SMMU_ANOC2_PA, POPLAR_SMMU_ANOC2_FULL_SIZE);
+	if (!smmu) {
+		printf("WIFI PROBE: [5B.1] ERROR: failed to map ANOC2 SMMU\n");
+		return;
+	}
+	uint32_t idr0 = probe_rd32(smmu, ARM_SMMU_GR0_IDR0);
+	uint32_t idr1 = probe_rd32(smmu, ARM_SMMU_GR0_IDR1);
+	uint32_t num_smr = idr0 & SMMU_IDR0_NUMSMRG_MASK;
+	uint32_t num_cb  = idr1 & SMMU_IDR1_NUMCB_MASK;
+	uint32_t psize   = (idr1 & SMMU_IDR1_PAGESIZE) ? 0x10000u : 0x1000u;
+	uint32_t npage   = 1u << (((idr1 >> 28) & 7u) + 1u);
+	if (num_smr > 64u) num_smr = 64u;
+	if (num_cb > 64u)  num_cb  = 64u;
+
+	uint32_t sids[2] = { WLAN_STREAM_ID_PRIMARY, WLAN_STREAM_ID_SECONDARY };
+	const char *names[2] = { "CE", "MSA" };
+	int smr_slot[2] = { -1, -1 };
+	bool smr_existing[2] = { false, false };
+	uint64_t used_cb = 0u;
+
+	for (uint32_t i = 0u; i < num_smr; i++) {
+		uint32_t smr  = probe_rd32(smmu, ARM_SMMU_GR0_SMR_BASE + i * 4u);
+		uint32_t s2cr = probe_rd32(smmu, ARM_SMMU_GR0_S2CR_BASE + i * 4u);
+		if ((smr & SMMU_SMR_VALID) == 0u) {
+			if (smr_slot[0] < 0) {
+				smr_slot[0] = (int)i;
+			} else if (smr_slot[1] < 0) {
+				smr_slot[1] = (int)i;
+			}
+			continue;
+		}
+		if (((s2cr >> 16) & 3u) == 0u) {
+			used_cb |= (1ULL << (s2cr & 0x3fu));
+		}
+		uint32_t id = smr & SMMU_SMR_ID_MASK;
+		uint32_t mask = (smr >> SMMU_SMR_MASK_SHIFT) & SMMU_SMR_MASK_MASK;
+		for (unsigned t = 0u; t < 2u; t++) {
+			if (((sids[t] ^ id) & ~mask) == 0u) {
+				smr_slot[t] = (int)i;
+				smr_existing[t] = true;
+			}
+		}
+	}
+
+	uint32_t gr1_off = psize;
+	uint64_t cb_base_off = (uint64_t)npage * psize;
+	int cb = -1;
+	for (uint32_t c = 0u; c < num_cb; c++) {
+		uint64_t cbp_off = cb_base_off + (uint64_t)c * psize;
+		if (cbp_off + psize > POPLAR_SMMU_ANOC2_FULL_SIZE) {
+			break;
+		}
+		if ((used_cb & (1ULL << c)) == 0u &&
+		    (probe_rd32(smmu, (uint32_t)cbp_off) & 1u) == 0u &&
+		    probe_rd32(smmu, gr1_off + 4u * c) == 0u) {
+			cb = (int)c;
+			break;
+		}
+	}
+
+	if (cb < 0 || smr_slot[0] < 0 || smr_slot[1] < 0) {
+		printf("WIFI PROBE: [5B.1] ERROR: no free ANOC2 CB (%d) or SMR slots (%d, %d)\n",
+		    cb, smr_slot[0], smr_slot[1]);
+		return;
+	}
+
+	/* Configure free Context Bank cb for S1-bypass (SCTLR.M=0) without Secure GR0 TLB writes */
+	uint32_t cbo = (uint32_t)cb_base_off + (uint32_t)cb * psize;
+	probe_wr32(smmu, cbo + 0x58u, 0xffffffffu); /* FSR clear */
+	probe_wr32(smmu, cbo + 0x20u, 0u);          /* TTBR0_L */
+	probe_wr32(smmu, cbo + 0x24u, 0u);          /* TTBR0_H */
+	probe_wr32(smmu, cbo + 0x30u, 0u);          /* TCR */
+	probe_wr32(smmu, cbo + 0x10u, 0u);          /* TCR2 */
+	probe_wr32(smmu, cbo + 0x38u, 0u);          /* MAIR0 */
+	probe_wr32(smmu, cbo + 0x3cu, 0u);          /* MAIR1 */
+	probe_wr32(smmu, gr1_off + 0x800u + 4u * (uint32_t)cb, 0x00000001u); /* CBA2R: AArch64 */
+	probe_wr32(smmu, gr1_off + 4u * (uint32_t)cb, 0x0001f000u);          /* CBAR: S1 trans, S2 bypass */
+	probe_wr32(smmu, cbo + 0x00u, 0x000000a0u);                          /* SCTLR: CFCFG|CFRE, M=0, CFIE=0 */
+
+	uint32_t r_cba2r = probe_rd32(smmu, gr1_off + 0x800u + 4u * (uint32_t)cb);
+	uint32_t r_cbar  = probe_rd32(smmu, gr1_off + 4u * (uint32_t)cb);
+	uint32_t r_sctlr = probe_rd32(smmu, cbo + 0x00u);
+	printf("WIFI PROBE: [5B.1] ANOC2 CB[%d] @ +0x%05x: CBAR=0x%08x CBA2R=0x%08x SCTLR=0x%08x\n",
+	    cb, cbo, r_cbar, r_cba2r, r_sctlr);
+
+	for (unsigned t = 0u; t < 2u; t++) {
+		uint32_t s = (uint32_t)smr_slot[t];
+		probe_wr32(smmu, ARM_SMMU_GR0_S2CR_BASE + s * 4u, (uint32_t)cb); /* TYPE=0 TRANS -> cb */
+		if (!smr_existing[t]) {
+			probe_wr32(smmu, ARM_SMMU_GR0_SMR_BASE + s * 4u, SMMU_SMR_VALID | sids[t]);
+		}
+		uint32_t r_smr  = probe_rd32(smmu, ARM_SMMU_GR0_SMR_BASE + s * 4u);
+		uint32_t r_s2cr = probe_rd32(smmu, ARM_SMMU_GR0_S2CR_BASE + s * 4u);
+		printf("WIFI PROBE: [5B.1] Programmed ANOC2 %s SID=0x%04x -> SMR[%02u]=0x%08x S2CR=0x%08x (TRANS->CB%d)\n",
+		    names[t], sids[t], s, r_smr, r_s2cr, cb);
+	}
+	uint32_t gfsr = probe_rd32(smmu, ARM_SMMU_GR0_sGFSR);
+	printf("WIFI PROBE: [5B.1] ANOC2 post-config sGFSR=0x%08x\n", gfsr);
+}
+
+static bool
+s5b_setup_smem_glink(void)
+{
+	s5b.hwlock_va = ml_io_map(POPLAR_SMEM_HWLOCK_PA, 0x1000u);
+	s5b.ipc_va    = ml_io_map(POPLAR_APCS_IPC_PAGE_PA, 0x1000u);
+	s5b.part_va   = ml_io_map(s_smem_p07_pa, s_smem_p07_sz);
+	if (!s5b.hwlock_va || !s5b.ipc_va || !s5b.part_va) {
+		printf("WIFI PROBE: [5B.2] ERROR: SMEM/IPC map failed\n");
+		return false;
+	}
+	s5b.smp2p_last_state = 0xffffffffu;
+	s5b.smp2p_ipa_in_seen = false;
+	s5b.smp2p_ipa_in_last = 0xffffffffu;
+	s5b.smp2p_ipa_out_val = 0u;
+
+	uint32_t free_unc = s5b_part_rd32(0x0cu);
+	uint32_t free_cac = s5b_part_rd32(0x10u);
+	uint32_t cl = (s_smem_p07_cacheline >= 16u) ? s_smem_p07_cacheline : 32u;
+	uint32_t hdr_stride = (16u + cl - 1u) & ~(cl - 1u);
+	printf("WIFI PROBE: [5B.2] SMEM p[07] free_unc=0x%x free_cac=0x%x cl=%u\n",
+	    free_unc, free_cac, cl);
+
+	/* Log existing cached SMEM items (if any) */
+	if (s_smem_p07_sz >= hdr_stride) {
+		uint32_t ce = s_smem_p07_sz - hdr_stride;
+		while (ce > free_cac && ce + hdr_stride <= s_smem_p07_sz) {
+			uint32_t w0 = s5b_part_rd32(ce + 0u);
+			if ((uint16_t)w0 != SMEM_PRIVATE_CANARY) {
+				break;
+			}
+			uint16_t cid  = (uint16_t)(w0 >> 16);
+			uint32_t csz  = s5b_part_rd32(ce + 4u);
+			uint16_t cpad = (uint16_t)s5b_part_rd32(ce + 8u);
+			uint32_t ulen = (cpad < csz) ? (csz - cpad) : csz;
+			if (csz > ce) break;
+			uint32_t doff = ce - csz;
+			printf("WIFI PROBE: [5B.2]   cached item @ +0x%05x: id=%u sz=0x%x (usable=0x%x)\n",
+			    doff, cid, csz, ulen);
+			if (doff < hdr_stride) break;
+			ce = doff - hdr_stride;
+		}
+	}
+
+	/* Locate SMP2P-in(435) and allocate/init SMP2P-out(428) with SSR_ACK feature */
+	if (s5b_smem_get_item(SMEM_SMP2P_IN_MODEM_ID, &s5b.smp2p_in_off, NULL)) {
+		uint32_t in_vf = s5b_part_rd32(s5b.smp2p_in_off + 4u);
+		uint32_t in_fl = s5b_part_rd32(s5b.smp2p_in_off + 16u);
+		uint32_t in_ve = s5b_part_rd32(s5b.smp2p_in_off + 12u) >> 16;
+		printf("WIFI PROBE: [5B.2] SMP2P-in(435) @ +0x%04x ver_feat=0x%08x flags=0x%08x valid_ent=%u\n",
+		    s5b.smp2p_in_off, in_vf, in_fl, in_ve);
+	}
+	if (s5b_smem_alloc_unc(SMEM_SMP2P_OUT_MODEM_ID, 340u, &s5b.smp2p_out_off)) {
+		if (s5b_part_rd32(s5b.smp2p_out_off + 0u) != 0x504d5324u) {
+			s5b_part_wr32(s5b.smp2p_out_off + 8u,  (1u << 16) | 0u);  /* local=0, rem=1 */
+			s5b_part_wr32(s5b.smp2p_out_off + 12u, (0u << 16) | 16u); /* valid=0 initially! total=16 */
+			s5b_part_wr32(s5b.smp2p_out_off + 16u, 0u);                /* flags = 0 */
+			/* Entry 0: master-kernel */
+			s5b_part_wr_ascii4(s5b.smp2p_out_off + 20u, "master-kernel", 16u);
+			s5b_part_wr32(s5b.smp2p_out_off + 36u, 0u);
+			/* Entry 1: ipa */
+			s5b_part_wr_ascii4(s5b.smp2p_out_off + 40u, "ipa", 16u);
+			s5b_part_wr32(s5b.smp2p_out_off + 56u, 0u);
+			s5b_part_wr32(s5b.smp2p_out_off + 0u,  0x504d5324u); /* "$SMP" */
+			s5b_part_wr32(s5b.smp2p_out_off + 4u,  1u | (1u << 8)); /* ver=1, feat=SSR_ACK */
+			__asm__ volatile("dsb sy" ::: "memory");
+			/* Now safely publish valid_entries = 2 */
+			s5b_part_wr32(s5b.smp2p_out_off + 12u, (2u << 16) | 16u);
+			__asm__ volatile("dsb sy" ::: "memory");
+			printf("WIFI PROBE: [5B.2] Allocated SMP2P-out(428) @ +0x%04x (published 2 entries: master-kernel=0, ipa=0)\n", s5b.smp2p_out_off);
+		} else {
+			uint32_t ve = s5b_part_rd32(s5b.smp2p_out_off + 12u) >> 16;
+			if (ve < 2u) {
+				s5b_part_wr_ascii4(s5b.smp2p_out_off + 40u, "ipa", 16u);
+				s5b_part_wr32(s5b.smp2p_out_off + 56u, 0u);
+				__asm__ volatile("dsb sy" ::: "memory");
+				s5b_part_wr32(s5b.smp2p_out_off + 12u, (2u << 16) | 16u);
+				__asm__ volatile("dsb sy" ::: "memory");
+				printf("WIFI PROBE: [5B.2] Extended SMP2P-out(428) with entry[1] 'ipa'=0\n");
+			}
+		}
+		s5b_smp2p_kick();
+	}
+	s5b_smp2p_service();
+
+	/* Locate or allocate GLINK_XPRT_DESC(478) and FIFOs 479/480 */
+	if (!s5b_smem_alloc_unc(SMEM_GLINK_XPRT_DESC_ID, 32u, &s5b.descs_off)) {
+		printf("WIFI PROBE: [5B.2] ERROR: GLINK_XPRT_DESC(478) unavailable\n");
+		return false;
+	}
+
+	uint32_t fifo0_off = 0u, fifo0_len = 0u, fifo1_off = 0u, fifo1_len = 0u;
+	bool mod_had_f0 = s5b_smem_get_item(SMEM_GLINK_FIFO_0_ID, &fifo0_off, &fifo0_len);
+	bool mod_had_f1 = s5b_smem_get_item(SMEM_GLINK_FIFO_1_ID, &fifo1_off, &fifo1_len);
+	if (!mod_had_f0) {
+		if (!s5b_smem_alloc_cac(SMEM_GLINK_FIFO_0_ID, SMEM_GLINK_FIFO_SIZE, &fifo0_off, &fifo0_len)) {
+			printf("WIFI PROBE: [5B.2] ERROR: unable to allocate GLINK FIFO_0(479)\n");
+			return false;
+		}
+		printf("WIFI PROBE: [5B.2] Allocated GLINK FIFO_0(479) @ +0x%05x (%u B cached)\n",
+		    fifo0_off, fifo0_len);
+	}
+	if (!mod_had_f1) {
+		if (!s5b_smem_alloc_cac(SMEM_GLINK_FIFO_1_ID, SMEM_GLINK_FIFO_SIZE, &fifo1_off, &fifo1_len)) {
+			printf("WIFI PROBE: [5B.2] ERROR: unable to allocate GLINK FIFO_1(480)\n");
+			return false;
+		}
+		printf("WIFI PROBE: [5B.2] Allocated GLINK FIFO_1(480) @ +0x%05x (%u B cached)\n",
+		    fifo1_off, fifo1_len);
+	}
+
+	s5b_glink_kick();
+	for (unsigned ms = 0u; ms < 50u; ms++) {
+		s5b_smp2p_service();
+		uint32_t d1 = s5b_part_rd32(s5b.descs_off + 4u);
+		uint32_t d3 = s5b_part_rd32(s5b.descs_off + 12u);
+		if (d1 != 0u || d3 != 0u) {
+			break;
+		}
+		delay(1000);
+	}
+
+	uint32_t d0 = s5b_part_rd32(s5b.descs_off + 0u);
+	uint32_t d1 = s5b_part_rd32(s5b.descs_off + 4u);
+	uint32_t d2 = s5b_part_rd32(s5b.descs_off + 8u);
+	uint32_t d3 = s5b_part_rd32(s5b.descs_off + 12u);
+	printf("WIFI PROBE: [5B.2] Post-doorbell desc[0..3]={%u,%u,%u,%u} f0=%08x f1=%08x (mod479=%d mod480=%d)\n",
+	    d0, d1, d2, d3, s5b_part_rd32(fifo0_off), s5b_part_rd32(fifo1_off),
+	    mod_had_f0 ? 1 : 0, mod_had_f1 ? 1 : 0);
+
+	/* Bind FIFO direction: Modem=RX if Modem pre-allocated that FIFO or already wrote its head */
+	bool f0_is_tx;
+	if (d3 != 0u && d1 == 0u) {
+		f0_is_tx = true;
+	} else if (d1 != 0u && d3 == 0u) {
+		f0_is_tx = false;
+	} else if (mod_had_f1 && !mod_had_f0) {
+		f0_is_tx = true;  /* g.c convention: 479=APPS->Modem TX, 480=Modem->APPS RX */
+	} else if (mod_had_f0 && !mod_had_f1) {
+		f0_is_tx = false; /* Modem owns 479=RX, APPS allocated 480=TX */
+	} else {
+		f0_is_tx = true;
+	}
+
+	if (f0_is_tx) {
+		s5b.tx_tail_idx = 0u; s5b.tx_head_idx = 1u;
+		s5b.tx_fifo_off = fifo0_off; s5b.tx_fifo_len = fifo0_len;
+		s5b.rx_tail_idx = 2u; s5b.rx_head_idx = 3u;
+		s5b.rx_fifo_off = fifo1_off; s5b.rx_fifo_len = fifo1_len;
+	} else {
+		s5b.rx_tail_idx = 0u; s5b.rx_head_idx = 1u;
+		s5b.rx_fifo_off = fifo0_off; s5b.rx_fifo_len = fifo0_len;
+		s5b.tx_tail_idx = 2u; s5b.tx_head_idx = 3u;
+		s5b.tx_fifo_off = fifo1_off; s5b.tx_fifo_len = fifo1_len;
+	}
+	s5b.bound = true;
+	s5b.next_liid = 1u;
+
+	if (s5b_fifo_avail_rx() == 0u) {
+		s5b_part_wr32(s5b.descs_off + s5b.rx_tail_idx * 4u, 0u);
+		s5b_part_wr32(s5b.descs_off + s5b.tx_head_idx * 4u, 0u);
+		(void)s5b_glink_send_cmd(GLINK_CMD_VERSION, 1u, 1u);
+		for (unsigned ms = 0u; ms < 200u; ms++) {
+			s5b_pump_all();
+			if (s5b.link_up) {
+				break;
+			}
+			delay(1000);
+		}
+		if (!s5b.link_up && s5b_fifo_avail_rx() == 0u) {
+			/* Reset prior TX slot and swap direction if Modem bound the opposite FIFO */
+			s5b_part_wr32(s5b.descs_off + s5b.tx_head_idx * 4u, 0u);
+			for (uint32_t k = 0u; k < 16u; k += 4u) {
+				s5b_part_wr32(s5b.tx_fifo_off + k, 0u);
+			}
+			uint32_t ot = s5b.tx_tail_idx, oh = s5b.tx_head_idx;
+			uint32_t oo = s5b.tx_fifo_off, ol = s5b.tx_fifo_len;
+			s5b.tx_tail_idx = s5b.rx_tail_idx; s5b.tx_head_idx = s5b.rx_head_idx;
+			s5b.tx_fifo_off = s5b.rx_fifo_off; s5b.tx_fifo_len = s5b.rx_fifo_len;
+			s5b.rx_tail_idx = ot; s5b.rx_head_idx = oh;
+			s5b.rx_fifo_off = oo; s5b.rx_fifo_len = ol;
+			s5b_part_wr32(s5b.descs_off + s5b.rx_tail_idx * 4u, 0u);
+			s5b_part_wr32(s5b.descs_off + s5b.tx_head_idx * 4u, 0u);
+			printf("WIFI PROBE: [5B.2] Swapped GLINK FIFOs -> tx=0x%x rx=0x%x\n",
+			    s5b.tx_fifo_off, s5b.rx_fifo_off);
+			(void)s5b_glink_send_cmd(GLINK_CMD_VERSION, 1u, 1u);
+		}
+	}
+
+	for (unsigned ms = 0u; ms < 2000u; ms++) {
+		s5b_pump_all();
+		if (s5b.ipcrtr_open_acked && s5b.ipcrtr_rem_open) {
+			break;
+		}
+		delay(1000);
+	}
+
+	printf("WIFI PROBE: [5B.2] GLINK link=%d rem_open=%d open_acked=%d rx_fifo=0x%x tx_fifo=0x%x reuse=%d\n",
+	    s5b.link_up ? 1 : 0, s5b.ipcrtr_rem_open ? 1 : 0,
+	    s5b.ipcrtr_open_acked ? 1 : 0, s5b.rx_fifo_off, s5b.tx_fifo_off,
+	    s5b.glink_reuse ? 1 : 0);
+
+	return (s5b.ipcrtr_open_acked && s5b.ipcrtr_rem_open);
+}
