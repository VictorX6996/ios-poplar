+/*
+ * --- 6. Sub-Phase 4.1: Passive Subsystem Live State & Shared Memory Audit ---
+ *
+ * Gated strictly behind dedicated opt-in boot-arg:
+ *   wlan_stage4_1_passive=1
+ *
+ * Safety Boundaries (100% Passive DRAM Reads):
+ *   - Zero MMIO register reads or writes (WCSS 0x18800000 held strictly dormant).
+ *   - Zero APCS doorbell writes (0x17911008 untouched).
+ *   - Zero PM8998 regulator / clock votes.
+ *   - Zero GPIO edits.
+ *   - Zero SMMU register writes or stream attachment.
+ *   - Zero PIL / PAS operations.
+ *   - Reads are strictly bounded within mapped DRAM pages.
+ */
+static void
+probe_smem_p08_audit(void)
+{
+	vm_offset_t p08;
+	uint32_t magic, size, free_uncached, free_cached;
+	uint16_t h0, h1;
+	uint32_t off;
+
+	printf("WIFI PROBE: [4.1A] SMEM p[08] Geometry: base=0x%08x off=0x%05x -> PA=0x%08x (128KB)\n",
+	    POPLAR_SMEM_BASE_PA, POPLAR_SMEM_P08_OFFSET, POPLAR_SMEM_P08_PA);
+
+	p08 = ml_io_map(POPLAR_SMEM_P08_PA, 0x1000u);
+	if (!p08) {
+		printf("WIFI PROBE: [4.1B] FAILED: ml_io_map failed for SMEM p[08] @ 0x%08x\n", POPLAR_SMEM_P08_PA);
+		return;
+	}
+
+	magic = probe_rd32(p08, 0x00);
+	uint32_t hosts = probe_rd32(p08, 0x04);
+	h0 = (uint16_t)hosts;
+	h1 = (uint16_t)(hosts >> 16);
+	size = probe_rd32(p08, 0x08);
+	free_uncached = probe_rd32(p08, 0x0c);
+	free_cached = probe_rd32(p08, 0x10);
+
+	printf("WIFI PROBE: [4.1B] p[08] Header: magic=0x%08x ('%c%c%c%c') hosts=%u:%u size=%u (0x%x)\n",
+	    magic,
+	    (char)(magic & 0xff), (char)((magic >> 8) & 0xff),
+	    (char)((magic >> 16) & 0xff), (char)((magic >> 24) & 0xff),
+	    h0, h1, size, size);
+	printf("WIFI PROBE: [4.1B] p[08] Heap: free_uncached=0x%x free_cached=0x%x\n",
+	    free_uncached, free_cached);
+
+	if (magic != SMEM_PART_MAGIC) {
+		printf("WIFI PROBE: [4.1B] WARNING: unexpected partition magic (expected '$PRT' 0x%08x)\n",
+		    SMEM_PART_MAGIC);
+		return;
+	}
+
+	if (h0 != 1 || h1 != 2) {
+		printf("WIFI PROBE: [4.1B] WARNING: unexpected host IDs (expected 1:2 for APPS:Modem)\n");
+	}
+
+	/* Bounded walk of allocated items in uncached heap */
+	off = 0x20u; /* smem_partition_header is 32 bytes */
+	if (free_uncached > 0x1000u) {
+		free_uncached = 0x1000u;
+	}
+
+	printf("WIFI PROBE: [4.1B] Scanning allocated items in p[08] [0x0020..0x%04x]:\n", free_uncached);
+	int item_count = 0;
+	while (off + 12u <= free_uncached && item_count < 16) {
+		uint32_t w0 = probe_rd32(p08, off);
+		uint16_t canary = (uint16_t)w0;
+		uint16_t item_id = (uint16_t)(w0 >> 16);
+		uint32_t item_sz = probe_rd32(p08, off + 4u);
+		uint32_t w2 = probe_rd32(p08, off + 8u);
+		uint16_t pad_data = (uint16_t)w2;
+		uint16_t pad_hdr = (uint16_t)(w2 >> 16);
+
+		if (canary != SMEM_PRIVATE_CANARY) {
+			break;
+		}
+
+		printf("WIFI PROBE: [4.1B]   item[%u] @ +0x%04x: id=%u sz=%u pad_data=%u pad_hdr=%u\n",
+		    item_count, off, item_id, item_sz, pad_data, pad_hdr);
+
+		uint32_t payload_off = off + 12u + (uint32_t)pad_hdr;
+		if (payload_off + 16u <= 0x1000u && item_sz >= 4u) {
+			char name_buf[17];
+			for (int k = 0; k < 16; k += 4) {
+				uint32_t cw = probe_rd32(p08, payload_off + (uint32_t)k);
+				name_buf[k] = (char)(cw & 0xff);
+				name_buf[k + 1] = (char)((cw >> 8) & 0xff);
+				name_buf[k + 2] = (char)((cw >> 16) & 0xff);
+				name_buf[k + 3] = (char)((cw >> 24) & 0xff);
+			}
+			name_buf[16] = '\0';
+			bool printable = true;
+			for (int k = 0; k < 8 && printable; k++) {
+				if (name_buf[k] < 32 || name_buf[k] > 126) {
+					if (name_buf[k] == 0 && k > 0) break;
+					printable = false;
+				}
+			}
+			if (printable && name_buf[0] != 0) {
+				printf("WIFI PROBE: [4.1B]     payload string preview: '%s'\n", name_buf);
+			}
+		}
+
+		uint32_t total_entry = 12u + (uint32_t)pad_hdr + item_sz + (uint32_t)pad_data;
+		total_entry = (total_entry + 7u) & ~7u;
+		if (total_entry == 0 || off + total_entry <= off) break;
+		off += total_entry;
+		item_count++;
+	}
+
+	if (item_count == 0) {
+		printf("WIFI PROBE: [4.1B]   No private items allocated in p[08] uncached heap (heap empty).\n");
+	}
+}
