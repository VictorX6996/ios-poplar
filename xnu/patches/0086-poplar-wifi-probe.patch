+
+static char
+sweet_ascii_toupper(char c)
+{
+	return (c >= 'a' && c <= 'z') ? (char)(c - ('a' - 'A')) : c;
+}
+
+static bool
+sweet_modem_fat16_lookup_filename(const char *basename, uint32_t *out_clus, uint32_t *out_size)
+{
+	if (!basename || basename[0] == '\0' || s_img_dir_cnt == 0u) {
+		return false;
+	}
+
+	/* Strip any leading path directories */
+	const char *base = basename;
+	for (const char *p = basename; *p != '\0'; p++) {
+		if (*p == '/' || *p == '\\') {
+			base = p + 1;
+		}
+	}
+	if (base[0] == '\0') {
+		return false;
+	}
+
+	char target83[11];
+	for (unsigned i = 0u; i < 11u; i++) {
+		target83[i] = ' ';
+	}
+
+	unsigned ni = 0u, ei = 0u;
+	bool in_ext = false;
+	for (const char *p = base; *p != '\0'; p++) {
+		if (*p == '.') {
+			if (in_ext) {
+				return false;
+			}
+			in_ext = true;
+			continue;
+		}
+		char uc = sweet_ascii_toupper(*p);
+		if (!in_ext) {
+			if (ni >= 8u) {
+				return false;
+			}
+			target83[ni++] = uc;
+		} else {
+			if (ei >= 3u) {
+				return false;
+			}
+			target83[8u + ei++] = uc;
+		}
+	}
+	if (ni == 0u) {
+		return false;
+	}
+
+	for (unsigned i = 0u; i < s_img_dir_cnt; i++) {
+		if (memcmp(s_img_dir[i].name83, target83, 11u) == 0) {
+			if (out_clus) {
+				*out_clus = s_img_dir[i].start_clus;
+			}
+			if (out_size) {
+				*out_size = s_img_dir[i].size;
+			}
+			return true;
+		}
+	}
+	return false;
+}
+
+static int
+sweet_modem_fat16_read_slice(uint32_t start_clus, uint32_t file_size,
+    uint32_t offset, uint32_t len, void *dst)
+{
+	if (len == 0u) {
+		return 0;
+	}
+	if (!s_fat16_valid || s_fat_bytes_per_sec == 0u || s_fat_sec_per_clus == 0u) {
+		return EINVAL;
+	}
+	if (offset > file_size || len > file_size - offset) {
+		return EINVAL;
+	}
+	uint32_t clus_bytes = s_fat_bytes_per_sec * s_fat_sec_per_clus;
+	if (clus_bytes == 0u || clus_bytes > sizeof(s_slice_clus_buf)) {
+		return EINVAL;
+	}
+
+	uint32_t skip_clus = offset / clus_bytes;
+	uint32_t cur = start_clus;
+	for (uint32_t k = 0u; k < skip_clus; k++) {
+		if (cur < 2u || cur >= 8192u) {
+			return EIO;
+		}
+		cur = s_fat16_table[cur];
+	}
+
+	uint32_t intra = offset % clus_bytes;
+	uint32_t done = 0u;
+	uint32_t hops = 0u;
+
+	/* Partial leading head within the starting cluster */
+	if (intra != 0u) {
+		if (cur < 2u || cur >= 8192u) {
+			return EIO;
+		}
+		if (s_slice_cached_clus != cur) {
+			uint64_t coff = (uint64_t)(s_fat_data_start_sec +
+			    (cur - 2u) * s_fat_sec_per_clus) * s_fat_bytes_per_sec;
+			int err = sweet_ufs_read_part("modem", coff, s_slice_clus_buf, clus_bytes);
+			if (err != 0) {
+				s_slice_cached_clus = 0xFFFFFFFFu;
+				return err;
+			}
+			s_slice_cached_clus = cur;
+		}
+		uint32_t take = clus_bytes - intra;
+		if (take > len) {
+			take = len;
+		}
+		memcpy(dst, s_slice_clus_buf + intra, take);
+		done += take;
+		if (done < len) {
+			cur = s_fat16_table[cur];
+			hops++;
+		}
+	}
+
+	/* Coalesced full-cluster middle runs + optional cached tail */
+	while (done < len) {
+		if (cur < 2u || cur >= 8192u || hops >= 8192u) {
+			return EIO;
+		}
+		uint32_t rem = len - done;
+		if (rem < clus_bytes) {
+			if (s_slice_cached_clus != cur) {
+				uint64_t coff = (uint64_t)(s_fat_data_start_sec +
+				    (cur - 2u) * s_fat_sec_per_clus) * s_fat_bytes_per_sec;
+				int err = sweet_ufs_read_part("modem", coff, s_slice_clus_buf, clus_bytes);
+				if (err != 0) {
+					s_slice_cached_clus = 0xFFFFFFFFu;
+					return err;
+				}
+				s_slice_cached_clus = cur;
+			}
+			memcpy((uint8_t *)dst + done, s_slice_clus_buf, rem);
+			done += rem;
+			break;
+		}
+
+		uint32_t run_start = cur;
+		uint32_t run_bytes = clus_bytes;
+		while (done + run_bytes + clus_bytes <= len && hops < 8192u) {
+			uint16_t nxt = s_fat16_table[cur];
+			if (nxt == cur + 1u && nxt < 8192u) {
+				cur = nxt;
+				run_bytes += clus_bytes;
+				hops++;
+			} else {
+				break;
+			}
+		}
+		uint64_t roff = (uint64_t)(s_fat_data_start_sec +
+		    (run_start - 2u) * s_fat_sec_per_clus) * s_fat_bytes_per_sec;
+		int err = sweet_ufs_read_part("modem", roff, (uint8_t *)dst + done, run_bytes);
+		if (err != 0) {
+			return err;
+		}
+		done += run_bytes;
+		hops++;
+		if (done < len) {
+			cur = s_fat16_table[cur];
+		}
+	}
+	return 0;
+}
+
+static bool
+sweet_fat16_check_contiguous(uint32_t start_clus, uint32_t fsize)
+{
+	if (fsize == 0) {
+		return true;
+	}
+	if (!s_fat16_valid || start_clus < 2 || start_clus >= 8192 ||
+	    s_fat_bytes_per_sec == 0 || s_fat_sec_per_clus == 0) {
+		return true;
+	}
+	uint32_t clus_bytes = s_fat_bytes_per_sec * s_fat_sec_per_clus;
+	uint32_t need_clus = (fsize + clus_bytes - 1u) / clus_bytes;
+	uint32_t cur = start_clus;
+	for (uint32_t k = 0; k < need_clus; k++) {
+		if (k + 1u < need_clus) {
+			if (cur < 2 || cur >= 8192) {
+				return false;
+			}
+			uint16_t nxt = s_fat16_table[cur];
+			if (nxt < 2 || nxt >= 0xfff0u) {
+				break;
+			}
+			if (nxt != cur + 1u) {
+				return false;
+			}
+			cur = nxt;
+		}
+	}
+	return true;
+}
+
+static int
+sweet_modem_fat16_read(uint32_t start_clus, uint32_t fsize, void *dst)
+{
+	if (fsize == 0) {
+		return 0;
+	}
+	if (!s_fat16_valid || s_fat_bytes_per_sec == 0 || s_fat_sec_per_clus == 0) {
+		return EINVAL;
+	}
+	uint32_t clus_bytes = s_fat_bytes_per_sec * s_fat_sec_per_clus;
+	uint32_t cur = start_clus;
+	uint32_t done = 0;
+	uint32_t hops = 0;
+
+	while (done < fsize) {
+		if (cur < 2 || cur >= 8192 || hops >= 8192) {
+			return EIO;
+		}
+		uint32_t run_start = cur;
+		uint32_t run_len = clus_bytes;
+		while (done + run_len < fsize && hops < 8192) {
+			uint16_t nxt = s_fat16_table[cur];
+			if (nxt == cur + 1u && nxt < 8192) {
+				cur = nxt;
+				run_len += clus_bytes;
+				hops++;
+			} else {
+				break;
+			}
+		}
+		uint32_t want = fsize - done;
+		if (run_len < want) {
+			want = run_len;
+		}
+		uint64_t off = (uint64_t)(s_fat_data_start_sec +
+		    (run_start - 2u) * s_fat_sec_per_clus) * s_fat_bytes_per_sec;
+		int err = sweet_ufs_read_part("modem", off, (uint8_t *)dst + done, want);
+		if (err != 0) {
+			return err;
+		}
+		done += want;
+		hops++;
+		if (done < fsize) {
+			cur = s_fat16_table[cur];
+			if (cur < 2 || cur >= 0xfff0u || cur >= 8192) {
+				return EIO;
+			}
+		}
+	}
+	return 0;
+}
+
+static void
+probe_stage4_3_passive_audit(void)
+{
+	int wlan_stage4_3_passive = 0;
+	(void)PE_parse_boot_argn("wlan_stage4_3_passive", &wlan_stage4_3_passive,
+	    sizeof(wlan_stage4_3_passive));
+
+	printf("WIFI PROBE: [4.3] === SUB-PHASE 4.3: STOCK UFS VFAT DIRECTORY & CLUSTER AUDIT ===\n");
+
+	if (wlan_stage4_3_passive <= 0) {
+		printf("WIFI PROBE: [4.3] Gate: wlan_stage4_3_passive=0 (dormant default).\n");
+		printf("WIFI PROBE: [4.3] Zero modem partition reads issued.\n\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [4.3] Gate: wlan_stage4_3_passive=1 ACTIVE.\n");
+	printf("WIFI PROBE: [4.3] Safety: Pure read-only SCSI READ(10) via sweet_ufs_read_part; zero writes.\n");
+
+	/* Step 4.3.1: Read LBA 0 (Boot Sector / BPB) of partition "modem" */
+	int err = sweet_ufs_read_part("modem", 0, s_fat_buf, 4096);
+	if (err != 0) {
+		printf("WIFI PROBE: [4.3] FAILED: sweet_ufs_read_part('modem', 0) returned error %d\n", err);
+		return;
+	}
+
+	uint16_t sig = (uint16_t)(s_fat_buf[510] | (s_fat_buf[511] << 8));
+	if (sig != 0xaa55) {
+		printf("WIFI PROBE: [4.3] FAILED: Invalid boot sector signature 0x%04x (expected 0xaa55)\n", sig);
+		return;
+	}
+
+	char oem[9];
+	memcpy(oem, &s_fat_buf[3], 8);
+	oem[8] = '\0';
+
+	uint16_t bytes_per_sec = (uint16_t)(s_fat_buf[11] | (s_fat_buf[12] << 8));
+	uint8_t  sec_per_clus  = s_fat_buf[13];
+	uint16_t rsvd_sec_cnt  = (uint16_t)(s_fat_buf[14] | (s_fat_buf[15] << 8));
+	uint8_t  num_fats      = s_fat_buf[16];
+	uint16_t root_ent_cnt  = (uint16_t)(s_fat_buf[17] | (s_fat_buf[18] << 8));
+	uint16_t tot_sec_16    = (uint16_t)(s_fat_buf[19] | (s_fat_buf[20] << 8));
+	uint16_t fat_sz_16     = (uint16_t)(s_fat_buf[22] | (s_fat_buf[23] << 8));
+	uint32_t tot_sec_32    = (uint32_t)(s_fat_buf[32] | (s_fat_buf[33] << 8) | (s_fat_buf[34] << 16) | (s_fat_buf[35] << 24));
+	uint32_t fat_sz_32     = (uint32_t)(s_fat_buf[36] | (s_fat_buf[37] << 8) | (s_fat_buf[38] << 16) | (s_fat_buf[39] << 24));
+	uint32_t root_clus     = (uint32_t)(s_fat_buf[44] | (s_fat_buf[45] << 8) | (s_fat_buf[46] << 16) | (s_fat_buf[47] << 24));
+
+	if (bytes_per_sec == 0 || sec_per_clus == 0) {
+		printf("WIFI PROBE: [4.3] FAILED: Invalid BPB geometry (bytes_per_sec=%u, sec_per_clus=%u)\n",
+		    bytes_per_sec, sec_per_clus);
+		return;
+	}
+
+	uint32_t tot_sec = (tot_sec_16 != 0) ? tot_sec_16 : tot_sec_32;
+	uint32_t fat_sz  = (fat_sz_16 != 0) ? fat_sz_16 : fat_sz_32;
+	bool is_fat32    = (fat_sz_16 == 0 && root_ent_cnt == 0);
+
+	printf("WIFI PROBE: [4.3] BPB Decoded: OEM='%s' Type=%s Bps=%u Spc=%u Rsvd=%u FATs=%u FatSz=%u TotSec=%u\n",
+	    oem, is_fat32 ? "FAT32" : "FAT16", bytes_per_sec, sec_per_clus, rsvd_sec_cnt, num_fats, fat_sz, tot_sec);
+	printf("WIFI PROBE: [4.3]   Cluster Size: %u bytes (%u KiB)\n",
+	    (uint32_t)bytes_per_sec * sec_per_clus, ((uint32_t)bytes_per_sec * sec_per_clus) / 1024);
+
+	uint32_t root_dir_sec = rsvd_sec_cnt + (num_fats * fat_sz);
+	uint32_t root_dir_sz_sec = ((uint32_t)root_ent_cnt * 32u + bytes_per_sec - 1u) / bytes_per_sec;
+	uint32_t data_start_sec = is_fat32 ? root_dir_sec : (root_dir_sec + root_dir_sz_sec);
+
+	printf("WIFI PROBE: [4.3]   Root Dir Start Sec: %u (sectors: %u), Data Start Sec: %u\n",
+	    root_dir_sec, root_dir_sz_sec, data_start_sec);
+
+	/* Cache FAT16 allocation table in BSS for cluster-chain reads (Final Stage readiness) */
+	s_fat16_valid = false;
+	s_img_dir_cnt = 0;
+	s_slice_cached_clus = 0xFFFFFFFFu;
+	memset(&s_fw_mba, 0, sizeof(s_fw_mba));
+	memset(&s_fw_mdt, 0, sizeof(s_fw_mdt));
+	memset(&s_fw_wlanmdsp, 0, sizeof(s_fw_wlanmdsp));
+	memset(&s_fw_bdwlan, 0, sizeof(s_fw_bdwlan));
+	memset(s_fw_modem_seg, 0, sizeof(s_fw_modem_seg));
+	if (!is_fat32 && fat_sz > 0 && (uint64_t)fat_sz * bytes_per_sec <= sizeof(s_fat16_table)) {
+		int ferr = sweet_ufs_read_part("modem",
+		    (uint64_t)rsvd_sec_cnt * bytes_per_sec,
+		    s_fat16_table, (uint64_t)fat_sz * bytes_per_sec);
+		if (ferr == 0) {
+			s_fat_bytes_per_sec  = bytes_per_sec;
+			s_fat_sec_per_clus   = sec_per_clus;
+			s_fat_data_start_sec = data_start_sec;
+			s_fat16_valid        = true;
+		}
+	}
+
+	/* Step 4.3.2: Walk Root Directory to find 'IMAGE' subdirectory */
+	uint32_t image_start_clus = 0;
+	bool found_image_dir = false;
+
+	if (!is_fat32) {
+		uint32_t root_entries_to_read = root_ent_cnt;
+		uint32_t root_bytes_read = 0;
+		while (root_entries_to_read > 0) {
+			uint32_t chunk_entries = root_entries_to_read > (4096 / 32) ? (4096 / 32) : root_entries_to_read;
+			uint64_t root_off = (uint64_t)root_dir_sec * bytes_per_sec + root_bytes_read;
+			err = sweet_ufs_read_part("modem", root_off, s_fat_buf, chunk_entries * 32);
+			if (err != 0) {
+				printf("WIFI PROBE: [4.3] FAILED reading root directory @ offset 0x%llx: %d\n", (unsigned long long)root_off, err);
+				break;
+			}
+			for (uint32_t i = 0; i < chunk_entries; i++) {
+				uint8_t *e = &s_fat_buf[i * 32];
+				if (e[0] == 0x00) { root_entries_to_read = 0; break; }
+				if (e[0] == 0xe5) continue;
+				if (e[11] == 0x0f) continue; /* LFN */
+				if (e[11] & 0x10) { /* Subdirectory */
+					if (memcmp(e, "IMAGE      ", 11) == 0) {
+						image_start_clus = (uint32_t)(e[26] | (e[27] << 8));
+						found_image_dir = true;
+						break;
+					}
+				}
+			}
+			if (found_image_dir || root_entries_to_read <= chunk_entries) {
+				break;
+			}
+			root_entries_to_read -= chunk_entries;
+			root_bytes_read += chunk_entries * 32;
+		}
+	} else {
+		/* FAT32 root directory cluster walk */
+		uint64_t root_off = (uint64_t)(data_start_sec + (root_clus - 2) * sec_per_clus) * bytes_per_sec;
+		err = sweet_ufs_read_part("modem", root_off, s_fat_buf, 4096);
+		if (err == 0) {
+			for (uint32_t i = 0; i < 4096 / 32; i++) {
+				uint8_t *e = &s_fat_buf[i * 32];
+				if (e[0] == 0x00) break;
+				if (e[0] == 0xe5 || e[11] == 0x0f) continue;
+				if (e[11] & 0x10) {
+					if (memcmp(e, "IMAGE      ", 11) == 0) {
+						image_start_clus = (uint32_t)(e[26] | (e[27] << 8) | (e[20] << 16) | (e[21] << 24));
+						found_image_dir = true;
+						break;
+					}
+				}
+			}
+		}
+	}
+
+	if (!found_image_dir) {
+		printf("WIFI PROBE: [4.3] Notice: 'IMAGE' subdirectory not found in root dir; scanning root dir.\n");
+	} else {
+		printf("WIFI PROBE: [4.3] Found 'IMAGE' subdirectory: Starting Cluster = %u\n", image_start_clus);
+	}
+
+	/* Step 4.3.3: Walk directory entries in /IMAGE/ (or root) to locate target firmware */
+	uint64_t dir_cluster_off = found_image_dir ?
+	    (uint64_t)(data_start_sec + (image_start_clus - 2) * sec_per_clus) * bytes_per_sec :
+	    (uint64_t)root_dir_sec * bytes_per_sec;
+
+	printf("WIFI PROBE: [4.3] Scanning directory entries @ offset 0x%llx...\n", (unsigned long long)dir_cluster_off);
+	static const struct { const char *s83; const char *friendly; } targets[] = {
+		{ "MBA     MBN", "mba.mbn" },
+		{ "MODEM   MDT", "modem.mdt" },
+		{ "WLANMDSPMBN", "wlanmdsp.mbn" },
+		{ "BDWLAN  BIN", "bdwlan.bin" },
+		{ "MODEM   B00", "modem.b00" },
+		{ "MODEM   B01", "modem.b01" },
+		{ "MODEM   B02", "modem.b02" },
+		{ "MODEM   B12", "modem.b12" },
+		{ "MODEM   B17", "modem.b17" },
+		{ "MODEM   B22", "modem.b22" },
+	};
+	unsigned target_count = sizeof(targets) / sizeof(targets[0]);
+	unsigned matched_count = 0;
+
+	uint32_t clus_bytes = (uint32_t)bytes_per_sec * sec_per_clus;
+	uint32_t chunks_per_clus = clus_bytes / 4096u;
+	if (chunks_per_clus == 0) {
+		chunks_per_clus = 1u;
+	}
+	uint32_t dir_clus = image_start_clus;
+	uint32_t max_dir_clus = found_image_dir ? 8u : 1u;
+
+	for (uint32_t dc = 0; dc < max_dir_clus; dc++) {
+		if (found_image_dir && (dir_clus < 2u || dir_clus >= 8192u)) {
+			break;
+		}
+		uint64_t base_off = found_image_dir ?
+		    (uint64_t)(data_start_sec + (dir_clus - 2u) * sec_per_clus) * bytes_per_sec :
+		    (uint64_t)root_dir_sec * bytes_per_sec;
+		uint32_t nchunks = found_image_dir ? chunks_per_clus : 4u;
+
+		for (uint32_t chunk = 0; chunk < nchunks; chunk++) {
+			err = sweet_ufs_read_part("modem", base_off + ((uint64_t)chunk * 4096u), s_fat_buf, 4096);
+			if (err != 0) {
+				goto done_scan;
+			}
+
+			for (uint32_t i = 0; i < 4096u / 32u; i++) {
+				uint8_t *e = &s_fat_buf[i * 32u];
+				if (e[0] == 0x00) {
+					goto done_scan;
+				}
+				if (e[0] == 0xe5 || e[11] == 0x0f || (e[11] & 0x10)) {
+					continue;
+				}
+
+				uint32_t clus = (uint32_t)(e[26] | (e[27] << 8));
+				if (is_fat32) {
+					clus |= ((uint32_t)(e[20] | (e[21] << 8)) << 16);
+				}
+				uint32_t fsize = (uint32_t)(e[28] | (e[29] << 8) | (e[30] << 16) | (e[31] << 24));
+				bool contig = sweet_fat16_check_contiguous(clus, fsize);
+
+				/* Cache full /IMAGE/ filename catalog for Stage 5B TFTP / BDF lookup */
+				if (s_img_dir_cnt < SWEET_IMG_DIR_MAX) {
+					memcpy(s_img_dir[s_img_dir_cnt].name83, e, 11u);
+					s_img_dir[s_img_dir_cnt].pad = 0u;
+					s_img_dir[s_img_dir_cnt].start_clus = clus;
+					s_img_dir[s_img_dir_cnt].size = fsize;
+					s_img_dir_cnt++;
+				}
+
+				/* Populate full Final-Stage firmware catalog */
+				if (memcmp(e, "MBA     MBN", 11) == 0) {
+					s_fw_mba = (struct sweet_fw_cat_entry){ clus, fsize, true, contig };
+					s_mba_start_clus = clus;
+				} else if (memcmp(e, "MODEM   MDT", 11) == 0) {
+					s_fw_mdt = (struct sweet_fw_cat_entry){ clus, fsize, true, contig };
+				} else if (memcmp(e, "WLANMDSPMBN", 11) == 0) {
+					s_fw_wlanmdsp = (struct sweet_fw_cat_entry){ clus, fsize, true, contig };
+				} else if (memcmp(e, "BDWLAN  BIN", 11) == 0) {
+					s_fw_bdwlan = (struct sweet_fw_cat_entry){ clus, fsize, true, contig };
+				} else if (memcmp(e, "MODEM   B", 9) == 0 &&
+				           e[9] >= '0' && e[9] <= '9' && e[10] >= '0' && e[10] <= '9') {
+					unsigned idx = (unsigned)((e[9] - '0') * 10 + (e[10] - '0'));
+					if (idx < 30u) {
+						s_fw_modem_seg[idx] = (struct sweet_fw_cat_entry){ clus, fsize, true, contig };
+					}
+				}
+
+				for (unsigned t = 0; t < target_count; t++) {
+					if (memcmp(e, targets[t].s83, 11) == 0) {
+						uint64_t file_part_off = (uint64_t)(data_start_sec + (clus - 2u) * sec_per_clus) * bytes_per_sec;
+
+						/* Read first 16 bytes of the file to verify magic header */
+						memset(s_hdr_buf, 0, sizeof(s_hdr_buf));
+						(void)sweet_ufs_read_part("modem", file_part_off, s_hdr_buf, 16);
+
+						printf("WIFI PROBE: [4.3]   MATCH: %-12s Clus=%-6u PartOff=0x%08llx Size=%-8u [Hdr: %02x %02x %02x %02x %02x %02x %02x %02x]\n",
+						    targets[t].friendly, clus, (unsigned long long)file_part_off, fsize,
+						    s_hdr_buf[0], s_hdr_buf[1], s_hdr_buf[2], s_hdr_buf[3],
+						    s_hdr_buf[4], s_hdr_buf[5], s_hdr_buf[6], s_hdr_buf[7]);
+
+						if (strcmp(targets[t].friendly, "mba.mbn") == 0) {
+							s_mba_part_off = file_part_off;
+							s_mba_size = fsize;
+						}
+
+						matched_count++;
+					}
+				}
+			}
+		}
+
+		if (!found_image_dir || !s_fat16_valid || dir_clus < 2u || dir_clus >= 8192u) {
+			break;
+		}
+		dir_clus = s_fat16_table[dir_clus];
+		if (dir_clus < 2u || dir_clus >= 0xfff0u) {
+			break;
+		}
+	}
+done_scan:
+	{
+		unsigned pt_found = 0, pt_frag = 0;
+		for (unsigned s = 2u; s <= 28u; s++) {
+			if (s == 15u || s == 19u) {
+				continue; /* Pure BSS segments (no file on disk) */
+			}
+			if (s_fw_modem_seg[s].found) {
+				pt_found++;
+				if (!s_fw_modem_seg[s].contiguous) {
+					pt_frag++;
+				}
+			}
+		}
+		printf("WIFI PROBE: [4.3] Target audit complete: %u key firmware files verified on live partition.\n", matched_count);
+		printf("WIFI PROBE: [4.3] Final-Stage Readiness: FAT16=%s | mdt=%uB | PT_LOAD=%u/25 (frag=%u) | wlanmdsp=%uB | bdwlan=%uB\n",
+		    s_fat16_valid ? "OK" : "NONE",
+		    s_fw_mdt.size, pt_found, pt_frag,
+		    s_fw_wlanmdsp.size, s_fw_bdwlan.size);
+	}
+	printf("WIFI PROBE: [4.3] Sub-Phase 4.3 passive audit complete.\n\n");
+}
+
+/*
+ * Sub-Phase 4.4: Passive SCM PAS (Peripheral Authentication Service) Support Query
+ * Controlled by: wlan_stage4_4_passive=1
+ * 100% read-only queries via SMC #0 (PAS_IS_SUPPORTED = 0x07).
+ * Zero writes, zero memory protection changes, zero resets.
+ */
+struct scm_smc_result {
+	int64_t  status; /* x0 */
+	uint64_t val1;   /* x1 */
+	uint64_t val2;   /* x2 */
+	uint64_t val3;   /* x3 */
+};
+
+static struct scm_smc_result
+sweet_scm_call(uint64_t fid, uint64_t arginfo, uint64_t arg0, uint64_t arg1)
+{
+	register uint64_t r0 __asm__("x0") = fid;
+	register uint64_t r1 __asm__("x1") = arginfo;
+	register uint64_t r2 __asm__("x2") = arg0;
+	register uint64_t r3 __asm__("x3") = arg1;
+
+	__asm__ volatile(
+		"smc #0\n"
+		: "+r"(r0), "+r"(r1), "+r"(r2), "+r"(r3)
+		:
+		: "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+		  "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory"
+	);
+
+	struct scm_smc_result res;
+	res.status = (int64_t)r0;
+	res.val1   = r1;
+	res.val2   = r2;
+	res.val3   = r3;
+	return res;
+}
+
+static struct scm_smc_result
+sweet_scm_call6(uint64_t fid, uint64_t arginfo, uint64_t arg0, uint64_t arg1, uint64_t arg2, uint64_t arg3)
+{
+	register uint64_t r0 __asm__("x0") = fid;
+	register uint64_t r1 __asm__("x1") = arginfo;
+	register uint64_t r2 __asm__("x2") = arg0;
+	register uint64_t r3 __asm__("x3") = arg1;
+	register uint64_t r4 __asm__("x4") = arg2;
+	register uint64_t r5 __asm__("x5") = arg3;
+
+	__asm__ volatile(
+		"smc #0\n"
+		: "+r"(r0), "+r"(r1), "+r"(r2), "+r"(r3), "+r"(r4), "+r"(r5)
+		:
+		: "x6", "x7", "x8", "x9", "x10", "x11",
+		  "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory"
+	);
+
+	struct scm_smc_result res;
+	res.status = (int64_t)r0;
+	res.val1   = r1;
+	res.val2   = r2;
+	res.val3   = r3;
+	return res;
+}
+
+/*
+ * Qualcomm SCM Memory Protection (MP) structures for QCOM_SCM_MP_ASSIGN (0x16)
+ * Upstream reference: drivers/firmware/qcom/qcom_scm.c
+ */
+struct qcom_scm_mem_map_info {
+	uint64_t mem_addr;
+	uint64_t mem_size;
+};
+
+struct qcom_scm_current_perm_info {
+	uint32_t vmid;
+	uint32_t perm;
+	uint64_t ctx;
+	uint32_t ctx_size;
+	uint32_t unused;
+};
+
+#define QCOM_SCM_VMID_HLOS          0x3
+#define QCOM_SCM_VMID_MSS_MSA       0xF
+#define QCOM_SCM_VMID_WLAN          0x18u
+#define QCOM_SCM_VMID_WLAN_CE       0x19u
+#define QCOM_SCM_PERM_RW            0x6
+#define QCOM_SCM_PERM_RWX           0x7
+
+#define PIL_MPSS_PHYS_BASE          0x8cc00000ULL
+#define PIL_MPSS_SIZE               0x07000000ULL /* 112 MiB */
+
+static uint64_t
+sweet_va_to_pa(vm_offset_t va)
+{
+	uint64_t par = 0;
+	__asm__ volatile(
+		"at s1e1r, %1\n"
+		"isb\n"
+		"mrs %0, par_el1\n"
+		: "=r"(par)
+		: "r"(va)
+		: "memory"
+	);
+	if (par & 1) {
+		return 0;
+	}
+	return (par & 0x0000FFFFFFFFF000ULL) | ((uint64_t)va & 0xFFFULL);
+}
+
+static uint8_t s_scm_scratch_buf[4096] __attribute__((aligned(4096)));
+
+#define SCM_OFFSET_MEM_MAP   0x000
+#define SCM_OFFSET_SRC       0x040
+#define SCM_OFFSET_DEST      0x080
+#define SCM_OFFSET_EXT_ARGS  0x0C0
+
+static int
+sweet_scm_assign_mem(uint64_t mem_addr, uint64_t mem_size, uint32_t src_vmid, uint32_t dest_vmid, uint32_t dest_perm)
+{
+	uint64_t buf_pa = sweet_va_to_pa((vm_offset_t)s_scm_scratch_buf);
+	if (buf_pa == 0) {
+		printf("WIFI PROBE: [4.5] sweet_va_to_pa returned fault; fallback to PA 0x942e0000\n");
+		buf_pa = 0x942e0000ULL;
+	}
+
+	uint64_t mem_map_pa  = buf_pa + SCM_OFFSET_MEM_MAP;
+	uint64_t src_pa      = buf_pa + SCM_OFFSET_SRC;
+	uint64_t dest_pa     = buf_pa + SCM_OFFSET_DEST;
+	uint64_t ext_args_pa = buf_pa + SCM_OFFSET_EXT_ARGS;
+
+	memset(s_scm_scratch_buf, 0, sizeof(s_scm_scratch_buf));
+
+	/* 1. Memory Region Descriptor */
+	struct qcom_scm_mem_map_info *map = (struct qcom_scm_mem_map_info *)(s_scm_scratch_buf + SCM_OFFSET_MEM_MAP);
+	map->mem_addr = mem_addr;
+	map->mem_size = mem_size;
+
+	/* 2. Source VMID Descriptor: 1 entry */
+	uint32_t *src = (uint32_t *)(s_scm_scratch_buf + SCM_OFFSET_SRC);
+	src[0] = src_vmid;
+	uint64_t src_sz = sizeof(uint32_t); /* 4 bytes */
+
+	/* 3. Destination Permission Descriptor: 1 entry */
+	struct qcom_scm_current_perm_info *dest = (struct qcom_scm_current_perm_info *)(s_scm_scratch_buf + SCM_OFFSET_DEST);
+	dest->vmid = dest_vmid;
+	dest->perm = dest_perm;
+	dest->ctx = 0;
+	dest->ctx_size = 0;
+	dest->unused = 0;
+	uint64_t dest_sz = sizeof(struct qcom_scm_current_perm_info); /* 24 bytes */
+
+	/* 4. Extended Arguments: [src_sz, dest_pa, dest_sz, 0] */
+	uint64_t *ext = (uint64_t *)(s_scm_scratch_buf + SCM_OFFSET_EXT_ARGS);
+	ext[0] = src_sz;
+	ext[1] = dest_pa;
+	ext[2] = dest_sz;
+	ext[3] = 0;
+
+	/* Clean cache to Point of Coherence for the descriptor buffer */
+	for (uintptr_t p = (uintptr_t)s_scm_scratch_buf;
+	     p < (uintptr_t)s_scm_scratch_buf + 256;
+	     p += 64) {
+		__asm__ volatile("dc cvac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile("dsb sy\nisb" ::: "memory");
+
+	uint64_t fid = 0xC2000C16ULL; /* SMC64 Fast Call: SIP, SVC_MP (0x0C), MP_ASSIGN (0x16) */
+	uint64_t arginfo = 0x1117ULL; /* 7 args: RO, VAL, RO, VAL, RO, VAL, VAL */
+
+	struct scm_smc_result res;
+	int retry = 0;
+	do {
+		res = sweet_scm_call6(fid, arginfo, mem_map_pa, sizeof(struct qcom_scm_mem_map_info), src_pa, ext_args_pa);
+		if (res.status == -12) { /* EBUSY */
+			delay(1000);
+		}
+	} while (res.status == -12 && ++retry < 20);
+
+	printf("WIFI PROBE: [4.5] MP_ASSIGN(0x%llx, 0x%llx [%llu KiB]) -> status=%lld, v1=0x%llx, v2=0x%llx (retries=%d)\n",
+	    (unsigned long long)mem_addr, (unsigned long long)mem_size, (unsigned long long)(mem_size >> 10),
+	    (long long)res.status, (unsigned long long)res.val1, (unsigned long long)res.val2, retry);
+
+	/* Fallback between PERM_RW (0x6) and PERM_RWX (0x7) if TrustZone rejects initial perm */
+	if (res.status != 0 && (dest_perm == QCOM_SCM_PERM_RW || dest_perm == QCOM_SCM_PERM_RWX)) {
+		uint32_t alt_perm = (dest_perm == QCOM_SCM_PERM_RW) ? QCOM_SCM_PERM_RWX : QCOM_SCM_PERM_RW;
+		printf("WIFI PROBE: [4.5]   Retrying MP_ASSIGN with perm=0x%x...\n", alt_perm);
+		dest->perm = alt_perm;
+		for (uintptr_t p = (uintptr_t)s_scm_scratch_buf; p < (uintptr_t)s_scm_scratch_buf + 256; p += 64) {
+			__asm__ volatile("dc cvac, %0" :: "r"(p) : "memory");
+		}
+		__asm__ volatile("dsb sy\nisb" ::: "memory");
+		res = sweet_scm_call6(fid, arginfo, mem_map_pa, sizeof(struct qcom_scm_mem_map_info), src_pa, ext_args_pa);
+		printf("WIFI PROBE: [4.5]   MP_ASSIGN fallback (0x%x): status=%lld, v1=0x%llx\n",
+		    alt_perm, (long long)res.status, (unsigned long long)res.val1);
+	}
+
+	return (int)res.status;
+}
+
+static int
+sweet_scm_assign_mem_multi(uint64_t mem_addr, uint64_t mem_size,
+    const uint32_t *src_vmids, unsigned n_src,
+    const uint32_t *dst_vmids, const uint32_t *dst_perms, unsigned n_dst)
+{
+	if (!src_vmids || !dst_vmids || !dst_perms ||
+	    n_src == 0u || n_src > 4u || n_dst == 0u || n_dst > 4u) {
+		return -22;
+	}
+
+	uint64_t buf_pa = sweet_va_to_pa((vm_offset_t)s_scm_scratch_buf);
+	if (buf_pa == 0u) {
+		printf("WIFI PROBE: [5B] sweet_va_to_pa returned fault; fallback to PA 0x942e0000\n");
+		buf_pa = 0x942e0000ULL;
+	}
+
+	uint64_t mem_map_pa  = buf_pa + SCM_OFFSET_MEM_MAP;
+	uint64_t src_pa      = buf_pa + SCM_OFFSET_SRC;
+	uint64_t dest_pa     = buf_pa + SCM_OFFSET_DEST;
+	uint64_t ext_args_pa = buf_pa + 0x180u;
+
+	memset(s_scm_scratch_buf, 0, sizeof(s_scm_scratch_buf));
+
+	struct qcom_scm_mem_map_info *map =
+	    (struct qcom_scm_mem_map_info *)(s_scm_scratch_buf + SCM_OFFSET_MEM_MAP);
+	map->mem_addr = mem_addr;
+	map->mem_size = mem_size;
+
+	uint32_t *src = (uint32_t *)(s_scm_scratch_buf + SCM_OFFSET_SRC);
+	for (unsigned i = 0u; i < n_src; i++) {
+		src[i] = src_vmids[i];
+	}
+	uint64_t src_sz = (uint64_t)n_src * sizeof(uint32_t);
+
+	struct qcom_scm_current_perm_info *dest =
+	    (struct qcom_scm_current_perm_info *)(s_scm_scratch_buf + SCM_OFFSET_DEST);
+	for (unsigned i = 0u; i < n_dst; i++) {
+		dest[i].vmid = dst_vmids[i];
+		dest[i].perm = dst_perms[i];
+		dest[i].ctx = 0u;
+		dest[i].ctx_size = 0u;
+		dest[i].unused = 0u;
+	}
+	uint64_t dest_sz = (uint64_t)n_dst * sizeof(struct qcom_scm_current_perm_info);
+
+	uint64_t *ext = (uint64_t *)(s_scm_scratch_buf + 0x180u);
+	ext[0] = src_sz;
+	ext[1] = dest_pa;
+	ext[2] = dest_sz;
+	ext[3] = 0u;
+
+	for (uintptr_t p = (uintptr_t)s_scm_scratch_buf;
+	     p < (uintptr_t)s_scm_scratch_buf + 512u;
+	     p += 64u) {
+		__asm__ volatile("dc cvac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile("dsb sy\nisb" ::: "memory");
+
+	uint64_t fid = 0xC2000C16ULL;
+	uint64_t arginfo = 0x1117ULL;
+	struct scm_smc_result res;
+	int retry = 0;
+	do {
+		res = sweet_scm_call6(fid, arginfo, mem_map_pa,
+		    sizeof(struct qcom_scm_mem_map_info), src_pa, ext_args_pa);
+		if (res.status == -12) {
+			delay(1000);
+		}
+	} while (res.status == -12 && ++retry < 20);
+
+	printf("WIFI PROBE: [5B] MP_ASSIGN_MULTI(0x%llx, 0x%llx [%llu KiB], src=%u dst=%u) -> status=%lld, v1=0x%llx\n",
+	    (unsigned long long)mem_addr, (unsigned long long)mem_size,
+	    (unsigned long long)(mem_size >> 10), n_src, n_dst,
+	    (long long)res.status, (unsigned long long)res.val1);
+
+	return (int)res.status;
+}
+
+static void
+probe_stage4_4_passive_audit(void)
+{
+	int wlan_stage4_4_passive = 0;
+	(void)PE_parse_boot_argn("wlan_stage4_4_passive", &wlan_stage4_4_passive,
+	    sizeof(wlan_stage4_4_passive));
+
+	printf("\nWIFI PROBE: [4.4] === SUB-PHASE 4.4: SCM PAS INTERFACE AUDIT ===\n");
+
+	if (wlan_stage4_4_passive <= 0) {
+		printf("WIFI PROBE: [4.4] Gate: wlan_stage4_4_passive=0 (dormant default).\n");
+		printf("WIFI PROBE: [4.4] Zero SCM PAS calls issued.\n\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [4.4] Gate: wlan_stage4_4_passive=1 ACTIVE.\n");
+	printf("WIFI PROBE: [4.4] Safety: Pure read-only PAS_IS_SUPPORTED (0x07) queries; zero resets, zero writes.\n");
+
+	/*
+	 * Qualcomm SCM Calling Convention on AArch64:
+	 * ARM_SMCCC_OWNER_SIP = 2
+	 * QCOM_SCM_SVC_PIL    = 0x02
+	 * PAS_IS_SUPPORTED    = 0x07
+	 * FNID(0x02, 0x07)    = 0x0207
+	 * SMC64 Fast Call:    0xC2000207
+	 * SMC32 Fast Call:    0x82000207
+	 */
+	uint32_t fid_64 = 0xC2000207u;
+	uint32_t fid_32 = 0x82000207u;
+
+	/* Probe calling convention with peripheral 4 (Modem) */
+	struct scm_smc_result t64 = sweet_scm_call(fid_64, 1, 4, 0);
+	struct scm_smc_result t32 = sweet_scm_call(fid_32, 1, 4, 0);
+
+	printf("WIFI PROBE: [4.4] SMC64 (0x%08x) -> status=%lld, val1=0x%llx\n",
+	    fid_64, (long long)t64.status, (unsigned long long)t64.val1);
+	printf("WIFI PROBE: [4.4] SMC32 (0x%08x) -> status=%lld, val1=0x%llx\n",
+	    fid_32, (long long)t32.status, (unsigned long long)t32.val1);
+
+	uint32_t active_fid = fid_64;
+	if (t64.status < 0 && t32.status >= 0) {
+		active_fid = fid_32;
+		printf("WIFI PROBE: [4.4] Selecting SMC32 convention (0x%08x)\n", active_fid);
+	} else {
+		printf("WIFI PROBE: [4.4] Selecting SMC64 convention (0x%08x)\n", active_fid);
+	}
+
+	/* Known Qualcomm Peripheral IDs */
+	static const struct {
+		uint32_t id;
+		const char *name;
+	} pas_table[] = {
+		{ 0,  "Reserved / None" },
+		{ 1,  "ADSP (Audio DSP / LPASS)" },
+		{ 2,  "Reserved" },
+		{ 3,  "Modem (Alt)" },
+		{ 4,  "Modem (MSS / MPSS)" },
+		{ 5,  "Venus (Video Core)" },
+		{ 6,  "Reserved" },
+		{ 7,  "Reserved" },
+		{ 8,  "Reserved" },
+		{ 9,  "IPA (IP Accelerator)" },
+		{ 10, "Reserved" },
+		{ 11, "Reserved" },
+		{ 12, "SLPI (Sensors Core)" },
+		{ 13, "Reserved" },
+		{ 14, "GPU / Zap" },
+		{ 15, "SPSS" },
+		{ 16, "Reserved" },
+	};
+
+	unsigned supported_count = 0;
+	printf("WIFI PROBE: [4.4] Querying PAS_IS_SUPPORTED for Peripheral IDs 0..16:\n");
+	for (unsigned i = 0; i < sizeof(pas_table) / sizeof(pas_table[0]); i++) {
+		uint32_t pid = pas_table[i].id;
+		struct scm_smc_result r = sweet_scm_call(active_fid, 1, pid, 0);
+		bool supported = (r.status == 0 && r.val1 != 0);
+		if (supported) {
+			supported_count++;
+		}
+		printf("WIFI PROBE: [4.4]   PAS_ID %2u (%-26s): status=%3lld, supp=%llu -> %s\n",
+		    pid, pas_table[i].name, (long long)r.status, (unsigned long long)r.val1,
+		    supported ? "SUPPORTED (READY)" : (r.status == 0 ? "NOT SUPPORTED" : "REJECTED/UNKNOWN"));
+	}
+
+	printf("WIFI PROBE: [4.4] PAS Query Complete: %u peripheral(s) supported by TrustZone.\n", supported_count);
+
+	/* Query SCM_SVC_INFO (0x06) / IS_CALL_AVAIL (0x01) */
+	printf("WIFI PROBE: [4.4] Querying SCM IS_CALL_AVAILABLE capabilities:\n");
+	static const struct {
+		uint32_t svc;
+		uint32_t cmd;
+		const char *name;
+	} scm_query_table[] = {
+		{ 0x01, 0x01, "SVC_BOOT / BOOT_ADDR" },
+		{ 0x02, 0x01, "SVC_PIL / PAS_INIT_IMAGE" },
+		{ 0x02, 0x02, "SVC_PIL / PAS_MEM_SETUP" },
+		{ 0x02, 0x05, "SVC_PIL / PAS_AUTH_AND_RESET" },
+		{ 0x02, 0x07, "SVC_PIL / PAS_IS_SUPPORTED" },
+		{ 0x06, 0x01, "SVC_INFO / IS_CALL_AVAIL" },
+		{ 0x0C, 0x16, "SVC_MP / MP_ASSIGN" },
+		{ 0x0C, 0x05, "SVC_MP / RESTORE_SEC_CFG" },
+		{ 0x0C, 0x10, "SVC_MP / IOMMU_SECURE_PTBL_INIT" },
+	};
+	uint32_t info_fid64 = 0xC2000601u;
+	uint32_t info_fid32 = 0x82000601u;
+	for (unsigned i = 0; i < sizeof(scm_query_table) / sizeof(scm_query_table[0]); i++) {
+		uint32_t target_fnid = (2u << 24) | (scm_query_table[i].svc << 8) | scm_query_table[i].cmd;
+		struct scm_smc_result r64 = sweet_scm_call(info_fid64, 1, target_fnid, 0);
+		struct scm_smc_result r32 = sweet_scm_call(info_fid32, 1, target_fnid, 0);
+		printf("WIFI PROBE: [4.4]   %-35s (FNID 0x%08x): SMC64=%lld(v1=%llx) SMC32=%lld(v1=%llx)\n",
+		    scm_query_table[i].name, target_fnid,
+		    (long long)r64.status, (unsigned long long)r64.val1,
+		    (long long)r32.status, (unsigned long long)r32.val1);
+	}
+
+	printf("WIFI PROBE: [4.4] Sub-Phase 4.4 passive audit complete.\n\n");
+}
