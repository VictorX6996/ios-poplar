+/*
+ * --- 5. WLAN Device-Tree Inspection & Target Reference ---
+ * A. Live Apple Device Tree (ADT) Inspection:
+ *    Queries properties passed to XNU by the bootloader shim.
+ *    Validates /chosen/mac-address-wifi0 and checks for any attached WLAN node.
+ *
+ * B. Compile-Time Platform Reference Data (MSM8998 Stock DTB):
+ *    Documents verified target hardware parameters from /soc/qcom,icnss@18800000.
+ *    Crucially: Zero MMIO access to unclocked WCSS registers is performed.
+ */
+static void
+probe_wlan_device_tree(void)
+{
+	DTEntry node = NULL;
+	void const *prop = NULL;
+	unsigned int prop_size = 0;
+	int sweetwifi = 0;
+	unsigned int i = 0, count = 0;
+	const uint8_t *mac = NULL;
+	const uint64_t *reg64 = NULL;
+	const uint32_t *irqs = NULL;
+	const uint32_t *sids = NULL;
+	const uint32_t *msa = NULL;
+	uint64_t rel_addr = 0, size = 0, phys_base = 0;
+
+	/* 5A: Live Apple Device Tree inspection */
+	if (SecureDTLookupEntry(NULL, "/chosen", &node) == kSuccess) {
+		if (SecureDTGetProperty(node, "mac-address-wifi0", &prop, &prop_size) == kSuccess &&
+		    prop_size == 6) {
+			mac = (const uint8_t *)prop;
+			printf("WIFI PROBE: [ADT] live /chosen/mac-address-wifi0 = %02x:%02x:%02x:%02x:%02x:%02x\n",
+			    mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+		}
+	}
+
+	if (SecureDTLookupEntry(NULL, "/arm-io/wlan", &node) != kSuccess &&
+	    SecureDTLookupEntry(NULL, "/wlan", &node) != kSuccess) {
+		printf("WIFI PROBE: [ADT] live device-tree has no active WLAN node (WCN3990 driver unattached)\n");
+	} else {
+		printf("WIFI PROBE: [ADT] live device-tree contains /arm-io/wlan platform node\n");
+
+		/* Parse compatible */
+		if (SecureDTGetProperty(node, "compatible", &prop, &prop_size) == kSuccess && prop_size > 0) {
+			printf("WIFI PROBE: [ADT]   compatible = '%.*s'\n", (int)prop_size, (const char *)prop);
+		}
+
+		/* Parse reg: address is relative to arm-io SOC_BASE (0x01000000) */
+		if (SecureDTGetProperty(node, "reg", &prop, &prop_size) == kSuccess && prop_size >= 16) {
+			reg64 = (const uint64_t *)prop;
+			rel_addr = reg64[0];
+			size = reg64[1];
+			phys_base = rel_addr + 0x01000000u;
+			printf("WIFI PROBE: [ADT]   reg = <0x%llx 0x%llx> (rel) -> phys base 0x%llx size 0x%llx (8MB)\n",
+			    (unsigned long long)rel_addr, (unsigned long long)size,
+			    (unsigned long long)phys_base, (unsigned long long)size);
+		}
+
+		/* Parse Copy Engine interrupts */
+		if ((SecureDTGetProperty(node, "qcom,interrupts", &prop, &prop_size) == kSuccess ||
+		     SecureDTGetProperty(node, "interrupts", &prop, &prop_size) == kSuccess) && prop_size >= 4) {
+			irqs = (const uint32_t *)prop;
+			count = prop_size / 4;
+			printf("WIFI PROBE: [ADT]   interrupts (%u Copy Engine lines):", count);
+			for (i = 0; i < count && i < 12; i++) {
+				printf(" %u", irqs[i]);
+			}
+			printf("\n");
+		}
+
+		/* Parse ANOC2 SMMU StreamIDs */
+		if ((SecureDTGetProperty(node, "qcom,stream-ids", &prop, &prop_size) == kSuccess ||
+		     SecureDTGetProperty(node, "iommus", &prop, &prop_size) == kSuccess) && prop_size >= 8) {
+			sids = (const uint32_t *)prop;
+			printf("WIFI PROBE: [ADT]   stream-ids (ANOC2 SMMU): CE=0x%04x, MSA=0x%04x\n", sids[0], sids[1]);
+		}
+
+		/* Parse MSA memory size */
+		if (SecureDTGetProperty(node, "qcom,wlan-msa-memory", &prop, &prop_size) == kSuccess && prop_size >= 4) {
+			msa = (const uint32_t *)prop;
+			printf("WIFI PROBE: [ADT]   qcom,wlan-msa-memory = 0x%x (%u KB)\n", *msa, *msa / 1024u);
+		}
+
+		/* Check Stage 3 activation gate: sweetwifi */
+		(void)PE_parse_boot_argn("sweetwifi", &sweetwifi, sizeof(sweetwifi));
+		if (sweetwifi <= 0) {
+			printf("WIFI PROBE: [GATE] sweetwifi=0 (disabled default): WLAN hardware activation dormant (zero WCSS MMIO/regulator/clock/SMMU programming).\n");
+		} else if (sweetwifi == 1) {
+			printf("WIFI PROBE: [GATE] sweetwifi=1 active: Sub-Phase 3D.2 SMMU routing & Sub-Phase 3D.3a GLINK decode enabled.\n");
+		} else {
+			printf("WIFI PROBE: [GATE] sweetwifi=%d active: advanced hardware activation requested.\n", sweetwifi);
+		}
+
+		int sweetwifi_rails = 0;
+		(void)PE_parse_boot_argn("sweetwifi_rails", &sweetwifi_rails, sizeof(sweetwifi_rails));
+		if (sweetwifi_rails > 0) {
+			printf("WIFI PROBE: [GATE] sweetwifi_rails=%d active: Sub-Phase 3D.4 controlled rail bringup enabled.\n", sweetwifi_rails);
+		} else {
+			printf("WIFI PROBE: [GATE] sweetwifi_rails=0 (default): PM8998 voltage / clock voting dormant.\n");
+		}
+
+		int sweetwifi_mmio = 0;
+		(void)PE_parse_boot_argn("sweetwifi_mmio", &sweetwifi_mmio, sizeof(sweetwifi_mmio));
+		if (sweetwifi_mmio > 0) {
+			printf("WIFI PROBE: [GATE] sweetwifi_mmio=%d: discontinued (interconnect stall discovered; held dormant).\n", sweetwifi_mmio);
+		} else {
+			printf("WIFI PROBE: [GATE] sweetwifi_mmio=0 (default): WCSS MMIO aperture (0x18800000) access held dormant.\n");
+		}
+
+		int wlan_stage4_1_passive = 0;
+		(void)PE_parse_boot_argn("wlan_stage4_1_passive", &wlan_stage4_1_passive, sizeof(wlan_stage4_1_passive));
+		if (wlan_stage4_1_passive > 0) {
+			printf("WIFI PROBE: [GATE] wlan_stage4_1_passive=%d active: Sub-Phase 4.1 passive subsystem audit enabled.\n", wlan_stage4_1_passive);
+		} else {
+			printf("WIFI PROBE: [GATE] wlan_stage4_1_passive=0 (default): Sub-Phase 4.1 passive audit dormant.\n");
+		}
+
+		int wlan_stage4_2a_passive = 0;
+		(void)PE_parse_boot_argn("wlan_stage4_2a_passive", &wlan_stage4_2a_passive, sizeof(wlan_stage4_2a_passive));
+		if (wlan_stage4_2a_passive > 0) {
+			printf("WIFI PROBE: [GATE] wlan_stage4_2a_passive=%d active: Sub-Phase 4.2A Q6v5/GCC audit enabled.\n", wlan_stage4_2a_passive);
+		} else {
+			printf("WIFI PROBE: [GATE] wlan_stage4_2a_passive=0 (default): Sub-Phase 4.2A audit dormant.\n");
+		}
+	}
+
+	/* 5B: Compile-time reference hardware specification (from Sony MSM8998 stock DTB) */
+	printf("WIFI PROBE: [DT-REF] Reference hardware spec (from Sony MSM8998 stock DTB):\n");
+	printf("WIFI PROBE: [DT-REF]   Target node: '/soc/qcom,icnss@18800000' (compatible: 'qcom,icnss')\n");
+	printf("WIFI PROBE: [DT-REF]   SMMU instance: ANOC2 @ 0x016c0000 (phandle 0x6a)\n");
+	printf("WIFI PROBE: [DT-REF]   StreamIDs: Primary=0x1900 (data/CE), Secondary=0x1901 (firmware/MSA)\n");
+	printf("WIFI PROBE: [DT-REF]   Memory: membase=0x18800000 (8MB) iova_base=0xa0000000 msa_sz=1MB\n");
+	printf("WIFI PROBE: [DT-REF]   Supplies: vdd-0.8-cx-mx, vdd-1.8-xo, vdd-1.3-rfa, vdd-3.3-ch0\n");
+	printf("WIFI PROBE: [DT-REF]   Interrupts: 12 Copy Engine SPIs (413..425) on GICv3\n");
+	printf("WIFI PROBE: [DT-REF]   Notice: Above is compile-time specification data; no WCSS MMIO touched.\n");
+}
+
+/*
+ * --- 6. Sub-Phase 4.1: Passive Subsystem Live State & Shared Memory Audit ---
+ *
+ * Gated strictly behind dedicated opt-in boot-arg:
+ *   wlan_stage4_1_passive=1
+ *
+ * Safety Boundaries (100% Passive DRAM Reads):
+ *   - Zero MMIO register reads or writes (WCSS 0x18800000 held strictly dormant).
+ *   - Zero APCS doorbell writes (0x17911008 untouched).
+ *   - Zero PM8998 regulator / clock votes.
+ *   - Zero GPIO edits.
+ *   - Zero SMMU register writes or stream attachment.
+ *   - Zero PIL / PAS operations.
+ *   - Reads are strictly bounded within mapped DRAM pages.
+ */
+static void
+probe_smem_p08_audit(void)
+{
+	vm_offset_t p08;
+	uint32_t magic, size, free_uncached, free_cached;
+	uint16_t h0, h1;
+	uint32_t off;
+
+	printf("WIFI PROBE: [4.1A] SMEM p[08] Geometry: base=0x%08x off=0x%05x -> PA=0x%08x (128KB)\n",
+	    POPLAR_SMEM_BASE_PA, POPLAR_SMEM_P08_OFFSET, POPLAR_SMEM_P08_PA);
+
+	p08 = ml_io_map(POPLAR_SMEM_P08_PA, 0x1000u);
+	if (!p08) {
+		printf("WIFI PROBE: [4.1B] FAILED: ml_io_map failed for SMEM p[08] @ 0x%08x\n", POPLAR_SMEM_P08_PA);
+		return;
+	}
+
+	magic = probe_rd32(p08, 0x00);
+	uint32_t hosts = probe_rd32(p08, 0x04);
+	h0 = (uint16_t)hosts;
+	h1 = (uint16_t)(hosts >> 16);
+	size = probe_rd32(p08, 0x08);
+	free_uncached = probe_rd32(p08, 0x0c);
+	free_cached = probe_rd32(p08, 0x10);
+
+	printf("WIFI PROBE: [4.1B] p[08] Header: magic=0x%08x ('%c%c%c%c') hosts=%u:%u size=%u (0x%x)\n",
+	    magic,
+	    (char)(magic & 0xff), (char)((magic >> 8) & 0xff),
+	    (char)((magic >> 16) & 0xff), (char)((magic >> 24) & 0xff),
+	    h0, h1, size, size);
+	printf("WIFI PROBE: [4.1B] p[08] Heap: free_uncached=0x%x free_cached=0x%x\n",
+	    free_uncached, free_cached);
+
+	if (magic != SMEM_PART_MAGIC) {
+		printf("WIFI PROBE: [4.1B] WARNING: unexpected partition magic (expected '$PRT' 0x%08x)\n",
+		    SMEM_PART_MAGIC);
+		return;
+	}
+
+	if (h0 != 1 || h1 != 2) {
+		printf("WIFI PROBE: [4.1B] WARNING: unexpected host IDs (expected 1:2 for APPS:Modem)\n");
+	}
+
+	/* Bounded walk of allocated items in uncached heap */
+	off = 0x20u; /* smem_partition_header is 32 bytes */
+	if (free_uncached > 0x1000u) {
+		free_uncached = 0x1000u;
+	}
+
+	printf("WIFI PROBE: [4.1B] Scanning allocated items in p[08] [0x0020..0x%04x]:\n", free_uncached);
+	int item_count = 0;
+	while (off + 12u <= free_uncached && item_count < 16) {
+		uint32_t w0 = probe_rd32(p08, off);
+		uint16_t canary = (uint16_t)w0;
+		uint16_t item_id = (uint16_t)(w0 >> 16);
+		uint32_t item_sz = probe_rd32(p08, off + 4u);
+		uint32_t w2 = probe_rd32(p08, off + 8u);
+		uint16_t pad_data = (uint16_t)w2;
+		uint16_t pad_hdr = (uint16_t)(w2 >> 16);
+
+		if (canary != SMEM_PRIVATE_CANARY) {
+			break;
+		}
+
+		printf("WIFI PROBE: [4.1B]   item[%u] @ +0x%04x: id=%u sz=%u pad_data=%u pad_hdr=%u\n",
+		    item_count, off, item_id, item_sz, pad_data, pad_hdr);
+
+		uint32_t payload_off = off + 12u + (uint32_t)pad_hdr;
+		if (payload_off + 16u <= 0x1000u && item_sz >= 4u) {
+			char name_buf[17];
+			for (int k = 0; k < 16; k += 4) {
+				uint32_t cw = probe_rd32(p08, payload_off + (uint32_t)k);
+				name_buf[k] = (char)(cw & 0xff);
+				name_buf[k + 1] = (char)((cw >> 8) & 0xff);
+				name_buf[k + 2] = (char)((cw >> 16) & 0xff);
+				name_buf[k + 3] = (char)((cw >> 24) & 0xff);
+			}
+			name_buf[16] = '\0';
+			bool printable = true;
+			for (int k = 0; k < 8 && printable; k++) {
+				if (name_buf[k] < 32 || name_buf[k] > 126) {
+					if (name_buf[k] == 0 && k > 0) break;
+					printable = false;
+				}
+			}
+			if (printable && name_buf[0] != 0) {
+				printf("WIFI PROBE: [4.1B]     payload string preview: '%s'\n", name_buf);
+			}
+		}
+
+		uint32_t total_entry = 12u + (uint32_t)pad_hdr + item_sz + (uint32_t)pad_data;
+		total_entry = (total_entry + 7u) & ~7u;
+		if (total_entry == 0 || off + total_entry <= off) break;
+		off += total_entry;
+		item_count++;
+	}
+
+	if (item_count == 0) {
+		printf("WIFI PROBE: [4.1B]   No private items allocated in p[08] uncached heap (heap empty).\n");
+	}
+}
+
+static void
+probe_pil_mba_audit(void)
+{
+	vm_offset_t mba;
+	uint32_t words[16];
+
+	printf("WIFI PROBE: [4.1C] MBA Region Audit @ 0x%08x (2MB reserved carveout)\n", POPLAR_PIL_MBA_PA);
+
+	mba = ml_io_map(POPLAR_PIL_MBA_PA, 0x1000u);
+	if (!mba) {
+		printf("WIFI PROBE: [4.1C] FAILED: ml_io_map failed for MBA region @ 0x%08x\n", POPLAR_PIL_MBA_PA);
+		return;
+	}
+
+	for (int i = 0; i < 16; i++) {
+		words[i] = probe_rd32(mba, (uint32_t)(i * 4));
+	}
+
+	printf("WIFI PROBE: [4.1C] MBA First 64 Bytes Dump:\n");
+	printf("WIFI PROBE: [4.1C]   [+0x00] %08x %08x %08x %08x\n", words[0], words[1], words[2], words[3]);
+	printf("WIFI PROBE: [4.1C]   [+0x10] %08x %08x %08x %08x\n", words[4], words[5], words[6], words[7]);
+	printf("WIFI PROBE: [4.1C]   [+0x20] %08x %08x %08x %08x\n", words[8], words[9], words[10], words[11]);
+	printf("WIFI PROBE: [4.1C]   [+0x30] %08x %08x %08x %08x\n", words[12], words[13], words[14], words[15]);
+
+	if (words[0] == 0x464c457fu) {
+		printf("WIFI PROBE: [4.1C] Signature: ELF executable header detected ('\\x7fELF')\n");
+	} else if (words[0] == 0x00000003u || words[0] == 0x00000005u || words[0] == 0x00000006u) {
+		printf("WIFI PROBE: [4.1C] Signature: Qualcomm MBN header detected (type=0x%x)\n", words[0]);
+	} else if (words[0] == 0 && words[1] == 0 && words[2] == 0 && words[3] == 0) {
+		printf("WIFI PROBE: [4.1C] Signature: Zero-filled / unpopulated region\n");
+	} else {
+		printf("WIFI PROBE: [4.1C] Signature: Non-zero data present (unidentified format)\n");
+	}
+	printf("WIFI PROBE: [4.1C] Note: Observational audit only; no inference of Modem running state.\n");
+}
