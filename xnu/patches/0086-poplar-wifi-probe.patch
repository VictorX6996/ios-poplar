+/*
+ * Main Probe Entry Point
+ * Invoked exactly once from sweet_ufs_init() in bsd/dev/sweet_ufs.c
+ * during single-threaded early BSD bootstrap before userland launch.
+ */
+/*
+ * Sub-Phase 4.5: Active MBA (Modem Boot Authenticator) Load & Handshake
+ * Physical Memory & Register Addresses
+ *
+ * Gated strictly behind dedicated opt-in boot-arg:
+ *   wlan_stage4_5_load=1
+ *
+ * Execution Steps (aligned with Sony pil-msa.c / pil-q6v5.c qdsp6v62_1_2):
+ *   1. Map MBA physical carveout (0x94100000, 2 MiB; assign lower 1 MiB MBA+DP to MSS_MSA).
+ *   2. Stream mba.mbn directly from UFS 'modem' partition into pil_mba_region@94100000.
+ *   3. Flush CPU caches to Point of Coherence (PoC) for the MBA carveout.
+ *   4. Map discrete 4 KiB GCC MSS (0x0018a000), GCC BIMC MSS (0x00144000),
+ *      GCC APCS Vote (0x00152000), TCSR MSS Halt (0x01f63000), and GCC MSS Restart (0x00179000).
+ *      (NEVER map or touch XPU-fenced 0x00138000 / 0x00138004).
+ *   5. Release TCSR AXI halts (0) and deassert GCC_MSS_RESTART (0x0 only; never assert 1).
+ *   6. Enable all 6 pil_mss_enable_clks() branches in order: AHB -> BIMC Q6 AXI ->
+ *      APCS vote BOOT_ROM_AHB (BIT 10) -> APCS vote_1 GPLL0_MSSCC (BIT 2) -> SNOC/MNOC/Q6BIMC.
+ *   7. HARD SAFETY CHECK: Poll MSS_CFG_AHB_CBCR for CLK_OFF == 0. If gated, ABORT before Q6/RMB MMIO.
+ *   8. Once AHB clock is ACTIVE, map QDSP6SS (0x04080000) and RMB (0x04180000).
+ *   9. Program RMB_MBA_IMAGE = 0x94100000 & DP length/start = 0 before pil_q6v5_reset().
+ *  10. Execute qdsp6v62_1_2 reset/power-up sequence (XO/SLEEP CBCRs, BHS_ON + 0x0C4 ack,
+ *      LDO_BYP, ~QMC, L2/SLP, 29-bank MEM_PWR_CTL, ~WL, ~IO).
+ *  11. Re-verify APCS vote bits & RMB_MBA_IMAGE readback, release core reset, enable GFMUX.
+ *  12. Poll RMB_PBL_STATUS_REG (0x04), RMB_MBA_STATUS_REG (0x0C), and RMB_MBA_DEBUG_INFO_REG (0x20).
+ */
+#define PIL_MBA_PHYS_BASE           0x94100000ULL
+#define PIL_MBA_SIZE                0x00200000ULL /* 2 MiB carveout */
+
+/* RMB Registers (MSM8998 DTB: 0x04180000, 0x20; strict pil-msa.c 0x00..0x20 range) */
+#define RMB_PHYS_BASE               0x04180000ULL
+#define RMB_SIZE                    0x00001000ULL /* 4 KiB page */
+#define RMB_MBA_IMAGE_REG           0x00
+#define RMB_PBL_STATUS_REG          0x04
+#define RMB_MBA_COMMAND_REG         0x08
+#define RMB_MBA_STATUS_REG          0x0C
+#define RMB_PMI_META_DATA_REG       0x10
+#define RMB_PMI_CODE_START_REG      0x14
+#define RMB_PMI_CODE_LENGTH_REG     0x18
+#define RMB_PROTOCOL_VERSION_REG    0x1C
+#define RMB_MBA_DEBUG_INFO_REG      0x20
+
+#define STATUS_PBL_SUCCESS          0x1
+#define STATUS_XPU_UNLOCKED         0x1
+#define STATUS_XPU_UNLOCKED_SCRIBBLED 0x2
+#define STATUS_META_DATA_AUTH_SUCCESS 0x3
+#define STATUS_AUTH_COMPLETE        0x4
+
+#define CMD_META_DATA_READY         0x1
+#define CMD_LOAD_READY              0x2
+#define PIL_MDT_PHYS_BASE           0x94200000ULL /* Upper 1 MiB of pil_mba_region@94100000 */
+
+/* QDSP6SS Registers (MSM8998 DTB: 0x04080000, 0x100) */
+#define QDSP6SS_PHYS_BASE           0x04080000ULL
+#define QDSP6SS_SIZE                0x00001000ULL /* 4 KiB page */
+#define QDSP6SS_RESET_REG           0x014
+#define QDSP6SS_GFMUX_CTL_REG       0x020
+#define QDSP6SS_PWR_CTL_REG         0x030
+#define QDSP6V6SS_MEM_PWR_CTL       0x034
+#define QDSP6SS_XO_CBCR             0x038
+#define QDSP6SS_SLEEP_CBCR          0x03C
+#define QDSP6SS_BHS_STATUS_REG      0x078
+#define QDSP6V62SS_BHS_STATUS       0x0C4
+
+/* QDSP6SS Control Bits (per Qualcomm pil-q6v5.c) */
+#define Q6SS_STOP_CORE              (1u << 0)
+#define Q6SS_CORE_ARES              (1u << 1)
+#define Q6SS_BUS_ARES_ENA           (1u << 2)
+
+#define Q6SS_CLK_ENA                (1u << 1)
+
+#define QDSP6v55_BHS_ON             (1u << 24)
+#define QDSP6v55_LDO_BYP            (1u << 25)
+#define QDSP6v55_CLAMP_QMC_MEM      (1u << 22)
+#define QDSP6v55_CLAMP_WL           (1u << 21)
+#define Q6SS_CLAMP_IO               (1u << 20)
+#define Q6SS_SLP_RET_N              (1u << 19)
+#define Q6SS_L2DATA_STBY_N          (1u << 18)
+
+#define QDSP6v55_BHS_EN_REST_ACK    (1u << 0)
+
+/* TCSR MSS Halt Ports (MSM8998 DTB: halt_q6=0x01f63000, halt_nc=0x01f64000, halt_modem=0x01f65000) */
+#define TCSR_MSS_HALT_PHYS_BASE     0x01f63000ULL
+#define TCSR_MSS_HALT_SIZE          0x00003000ULL /* 3 contiguous 4KB pages */
+#define TCSR_HALT_Q6_OFFSET         0x0000
+#define TCSR_HALT_NC_OFFSET         0x1000
+#define TCSR_HALT_MODEM_OFFSET      0x2000
+
+/* Discrete, verified-safe 4 KiB GCC / Reset control pages (ZERO access to XPU-fenced 0x00138004) */
+#define PIL_MBA_DP_SIZE                 0x00100000ULL /* 1 MiB MBA+DP per pil-msa.c SZ_1M; 0x94200000 kept in HLOS */
+#define GCC_MSS_AHB_PHYS_BASE           0x0018a000ULL
+#define GCC_MSS_AHB_SIZE                0x00001000ULL /* 4 KiB page covering MSS CBCRs */
+#define GCC_BIMC_MSS_PHYS_BASE          0x00144000ULL
+#define GCC_BIMC_MSS_SIZE               0x00001000ULL /* 4 KiB page covering GCC_BIMC_MSS_Q6_AXI_CBCR (0x4401C) */
+#define GCC_BIMC_MSS_Q6_AXI_CBCR_OFF    0x01Cu        /* BIT(0): branch enable (.has_sibling = 1) */
+#define GCC_APCS_VOTE_PHYS_BASE         0x00152000ULL
+#define GCC_APCS_VOTE_SIZE              0x00001000ULL /* 4 KiB page covering APCS_CLOCK_BRANCH_ENA_VOTE(_1) */
+#define GCC_APCS_CLK_ENA_VOTE_OFF       0x004u        /* 0x00152004: BIT(10) = gcc_boot_rom_ahb_clk (preserve BIT(17)!) */
+#define GCC_BOOT_ROM_AHB_VOTE_BIT       (1u << 10)
+#define GCC_APCS_CLK_ENA_VOTE_1_OFF     0x00Cu        /* 0x0015200C: BIT(2)  = gpll0_out_msscc */
+#define GCC_GPLL0_MSSCC_VOTE_BIT        (1u << 2)
+#define GCC_MSS_RESTART_PHYS_BASE       0x00179000ULL
+#define GCC_MSS_RESTART_SIZE            0x00001000ULL /* 4 KiB page covering GCC_MSS_RESTART */
+
+static bool        s_mba_boot_ok = false;
+static vm_offset_t s_mba_va      = 0;
+static vm_offset_t s_rmb_va      = 0;
+static vm_offset_t s_rmtfs_va    = 0;
+static vm_offset_t s_smem_base_va = 0;
+
+static void
+probe_stage4_5_active_mba_load(void)
+{
+	int wlan_stage4_5_load = 0;
+	(void)PE_parse_boot_argn("wlan_stage4_5_load", &wlan_stage4_5_load,
+	    sizeof(wlan_stage4_5_load));
+
+	s_mba_boot_ok = false;
+	printf("\nWIFI PROBE: [4.5] === SUB-PHASE 4.5: ACTIVE MBA FIRMWARE LOAD & RMB BOOTSTRAP ===\n");
+
+	if (wlan_stage4_5_load <= 0) {
+		printf("WIFI PROBE: [4.5] Gate: wlan_stage4_5_load=0 (dormant default).\n");
+		printf("WIFI PROBE: [4.5] Active MBA load skipped. To activate, set wlan_stage4_5_load=1.\n\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [4.5] Gate: wlan_stage4_5_load=1 ACTIVE.\n");
+	printf("WIFI PROBE: [4.5] Streaming mba.mbn from stock UFS 'modem' partition (offset 0x%llx, %u B) to pil_mba_region@94100000...\n",
+	    (unsigned long long)s_mba_part_off, s_mba_size);
+
+	/* 1. Map MBA physical carveout (0x94100000, 2 MiB) */
+	vm_offset_t mba_va = ml_io_map(PIL_MBA_PHYS_BASE, PIL_MBA_SIZE);
+	if (!mba_va) {
+		printf("WIFI PROBE: [4.5] ERROR: Failed to map MBA carveout @ 0x%llx\n", (unsigned long long)PIL_MBA_PHYS_BASE);
+		return;
+	}
+	s_mba_va = mba_va;
+
+	/* 2. Stream mba.mbn directly from UFS into 0x94100000 (via FAT16 chain if audited, else raw offset) */
+	int err = (s_fat16_valid && s_fw_mba.found) ?
+	    sweet_modem_fat16_read(s_mba_start_clus, s_mba_size, (void *)mba_va) :
+	    sweet_ufs_read_part("modem", s_mba_part_off, (void *)mba_va, s_mba_size);
+	if (err != 0) {
+		printf("WIFI PROBE: [4.5] ERROR: mba.mbn UFS read failed: %d\n", err);
+		return;
+	}
+
+	/* 3. Validate in-DRAM header magic (\x7fELF) */
+	const uint8_t *p = (const uint8_t *)mba_va;
+	printf("WIFI PROBE: [4.5] mba.mbn streamed successfully (%u bytes, via %s).\n",
+	    s_mba_size, (s_fat16_valid && s_fw_mba.found) ? "FAT16 chain" : "raw offset");
+	printf("WIFI PROBE: [4.5] In-DRAM Header: %02x %02x %02x %02x %02x %02x %02x %02x (%s)\n",
+	    p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7],
+	    (p[0] == 0x7f && p[1] == 'E' && p[2] == 'L' && p[3] == 'F') ? "VALID ELF" : "INVALID HEADER");
+
+	/* 4. Flush CPU caches to Point of Coherence so Hexagon reads memory directly from DRAM */
+	for (uintptr_t addr = (uintptr_t)mba_va; addr < (uintptr_t)mba_va + s_mba_size; addr += 64) {
+		__asm__ volatile("dc cvac, %0" :: "r"(addr) : "memory");
+	}
+	__asm__ volatile("dsb sy\nisb" ::: "memory");
+	printf("WIFI PROBE: [4.5] Data cache cleaned to Point of Coherence for MBA memory region.\n");
+
+	/* 4.1 Sub-Phase 4.5H: TrustZone Memory Protection Assignment (MP_ASSIGN) for MBA+DP (1 MiB) */
+	printf("WIFI PROBE: [4.5] Sub-Phase 4.5H: Reassigning MBA+DP (0x94100000, 1 MiB) HLOS (0x3) -> MSS_MSA (0xF)...\n");
+	int assign_mba = sweet_scm_assign_mem(PIL_MBA_PHYS_BASE, PIL_MBA_DP_SIZE,
+	    QCOM_SCM_VMID_HLOS, QCOM_SCM_VMID_MSS_MSA, QCOM_SCM_PERM_RW);
+
+	printf("WIFI PROBE: [4.5] MP_ASSIGN Result: MBA(1 MiB)=%s (%d) [0x94200000 & 0x8cc00000 kept in HLOS]\n",
+	    assign_mba == 0 ? "SUCCESS" : "FAILED", assign_mba);
+
+	/* 5. Map Discrete Safe Control Register Pages (GCC MSS/BIMC/VOTE, TCSR AXI Halts, GCC Restart) */
+	vm_offset_t gcc_va  = ml_io_map(GCC_MSS_AHB_PHYS_BASE, GCC_MSS_AHB_SIZE);
+	vm_offset_t bimc_va = ml_io_map(GCC_BIMC_MSS_PHYS_BASE, GCC_BIMC_MSS_SIZE);
+	vm_offset_t vote_va = ml_io_map(GCC_APCS_VOTE_PHYS_BASE, GCC_APCS_VOTE_SIZE);
+	vm_offset_t halt_va = ml_io_map(TCSR_MSS_HALT_PHYS_BASE, TCSR_MSS_HALT_SIZE);
+	vm_offset_t rst_va  = ml_io_map(GCC_MSS_RESTART_PHYS_BASE, GCC_MSS_RESTART_SIZE);
+
+	if (!gcc_va || !bimc_va || !vote_va || !halt_va || !rst_va) {
+		printf("WIFI PROBE: [4.5] ERROR: Failed to map GCC MSS/BIMC/VOTE, TCSR Halt, or Restart pages.\n");
+		return;
+	}
+
+	/* 6. TCSR AXI Halt Port Status & Release (halt_q6, halt_nc, halt_modem) */
+	uint32_t q6_req   = *(volatile uint32_t *)(halt_va + TCSR_HALT_Q6_OFFSET + AXI_HALTREQ_OFF);
+	uint32_t q6_ack   = *(volatile uint32_t *)(halt_va + TCSR_HALT_Q6_OFFSET + AXI_HALTACK_OFF);
+	uint32_t nc_req   = *(volatile uint32_t *)(halt_va + TCSR_HALT_NC_OFFSET + AXI_HALTREQ_OFF);
+	uint32_t nc_ack   = *(volatile uint32_t *)(halt_va + TCSR_HALT_NC_OFFSET + AXI_HALTACK_OFF);
+	uint32_t mss_req  = *(volatile uint32_t *)(halt_va + TCSR_HALT_MODEM_OFFSET + AXI_HALTREQ_OFF);
+	uint32_t mss_ack  = *(volatile uint32_t *)(halt_va + TCSR_HALT_MODEM_OFFSET + AXI_HALTACK_OFF);
+	printf("WIFI PROBE: [4.5] TCSR AXI Halt Initial States:\n");
+	printf("WIFI PROBE: [4.5]   halt_q6:   req=%u ack=%u | halt_nc: req=%u ack=%u | halt_modem: req=%u ack=%u\n",
+	    q6_req, q6_ack, nc_req, nc_ack, mss_req, mss_ack);
+
+	/* Release all three AXI halt requests to 0 */
+	*(volatile uint32_t *)(halt_va + TCSR_HALT_Q6_OFFSET + AXI_HALTREQ_OFF) = 0x0;
+	*(volatile uint32_t *)(halt_va + TCSR_HALT_NC_OFFSET + AXI_HALTREQ_OFF) = 0x0;
+	*(volatile uint32_t *)(halt_va + TCSR_HALT_MODEM_OFFSET + AXI_HALTREQ_OFF) = 0x0;
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	/* 7. Safe Reset Deassertion via GCC_MSS_RESTART (pil_mss_restart_reg(drv, 0); NEVER assert 1) */
+	uint32_t init_rst = *(volatile uint32_t *)(rst_va + 0x00);
+	printf("WIFI PROBE: [4.5] GCC_MSS_RESTART before deassert: 0x%08x\n", init_rst);
+	*(volatile uint32_t *)(rst_va + 0x00) = 0x0;
+	__asm__ volatile("dmb sy" ::: "memory");
+	delay(10);
+	printf("WIFI PROBE: [4.5] GCC_MSS_RESTART after deassert:  0x%08x\n",
+	    *(volatile uint32_t *)(rst_va + 0x00));
+
+	/* 8. Enable ALL 6 pil_mss_enable_clks() branches in pil-msa.c order (zero access to 0x00138004) */
+	uint32_t init_ahb   = *(volatile uint32_t *)(gcc_va  + GCC_MSS_CFG_AHB_CBCR_OFF);
+	uint32_t init_mnoc  = *(volatile uint32_t *)(gcc_va  + GCC_MSS_MNOC_BIMC_CBCR_OFF);
+	uint32_t init_snoc  = *(volatile uint32_t *)(gcc_va  + GCC_MSS_SNOC_AXI_CBCR_OFF);
+	uint32_t init_q6b   = *(volatile uint32_t *)(gcc_va  + GCC_MSS_Q6_BIMC_CBCR_OFF);
+	uint32_t init_bimc  = *(volatile uint32_t *)(bimc_va + GCC_BIMC_MSS_Q6_AXI_CBCR_OFF);
+	uint32_t init_vote0 = *(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_OFF);
+	uint32_t init_vote1 = *(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_1_OFF);
+	printf("WIFI PROBE: [4.5] GCC MSS Clocks Pre-Enable:\n");
+	printf("WIFI PROBE: [4.5]   AHB=0x%08x SNOC=0x%08x MNOC=0x%08x Q6BIMC=0x%08x\n",
+	    init_ahb, init_snoc, init_mnoc, init_q6b);
+	printf("WIFI PROBE: [4.5]   BIMC_Q6_AXI=0x%08x APCS_VOTE=0x%08x (BIT10=%u, BIT17=%u) APCS_VOTE_1=0x%08x (BIT2=%u)\n",
+	    init_bimc, init_vote0, (init_vote0 >> 10) & 1u, (init_vote0 >> 17) & 1u,
+	    init_vote1, (init_vote1 >> 2) & 1u);
+
+	/* 8a. ahb_clk: gcc_mss_cfg_ahb_clk (0x0018a000 |= 0x1) */
+	printf("WIFI PROBE: [4.5]   Step 8a: enabling gcc_mss_cfg_ahb_clk (0x0018a000)...\n");
+	*(volatile uint32_t *)(gcc_va + GCC_MSS_CFG_AHB_CBCR_OFF) |= 0x1u;
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	uint32_t ahb_after = 0;
+	bool ahb_active = false;
+	for (int i = 0; i < 1000; i++) {
+		ahb_after = *(volatile uint32_t *)(gcc_va + GCC_MSS_CFG_AHB_CBCR_OFF);
+		if (((ahb_after >> 31) & 1u) == 0) {
+			ahb_active = true;
+			break;
+		}
+		delay(100);
+	}
+	printf("WIFI PROBE: [4.5]     AHB=0x%08x (OFF=%u -> %s)\n",
+	    ahb_after, (ahb_after >> 31) & 1u, ahb_active ? "ACTIVE" : "GATED");
+
+	/* 8b. axi_clk: gcc_bimc_mss_q6_axi_clk (0x0014401C |= 0x1, non-fatal CLK_OFF check) */
+	printf("WIFI PROBE: [4.5]   Step 8b: enabling gcc_bimc_mss_q6_axi_clk (0x0014401C)...\n");
+	*(volatile uint32_t *)(bimc_va + GCC_BIMC_MSS_Q6_AXI_CBCR_OFF) |= 0x1u;
+	__asm__ volatile("dmb sy" ::: "memory");
+	uint32_t bimc_after = 0;
+	for (int i = 0; i < 200; i++) {
+		bimc_after = *(volatile uint32_t *)(bimc_va + GCC_BIMC_MSS_Q6_AXI_CBCR_OFF);
+		if (((bimc_after >> 31) & 1u) == 0) {
+			break;
+		}
+		delay(10);
+	}
+	printf("WIFI PROBE: [4.5]     BIMC_Q6_AXI=0x%08x (OFF=%u)\n",
+	    bimc_after, (bimc_after >> 31) & 1u);
+
+	/* 8c. rom_clk: gcc_boot_rom_ahb_clk via APCS vote (0x00152004 |= BIT(10), preserve BIT(17)) */
+	printf("WIFI PROBE: [4.5]   Step 8c: voting gcc_boot_rom_ahb_clk (0x00152004 |= BIT(10))...\n");
+	uint32_t v0_cur = *(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_OFF);
+	*(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_OFF) = v0_cur | GCC_BOOT_ROM_AHB_VOTE_BIT;
+	__asm__ volatile("dmb sy" ::: "memory");
+	delay(50);
+	uint32_t vote0_after = *(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_OFF);
+	printf("WIFI PROBE: [4.5]     APCS_VOTE=0x%08x (BIT10=%u, BIT17=%u)\n",
+	    vote0_after, (vote0_after >> 10) & 1u, (vote0_after >> 17) & 1u);
+
+	/* 8d. gpll0_mss_clk: gpll0_out_msscc via APCS vote_1 (0x0015200C |= BIT(2)) */
+	printf("WIFI PROBE: [4.5]   Step 8d: voting gpll0_out_msscc (0x0015200C |= BIT(2))...\n");
+	uint32_t v1_cur = *(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_1_OFF);
+	*(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_1_OFF) = v1_cur | GCC_GPLL0_MSSCC_VOTE_BIT;
+	__asm__ volatile("dmb sy" ::: "memory");
+	delay(50);
+	uint32_t vote1_after = *(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_1_OFF);
+	printf("WIFI PROBE: [4.5]     APCS_VOTE_1=0x%08x (BIT2=%u)\n",
+	    vote1_after, (vote1_after >> 2) & 1u);
+
+	/* 8e. snoc_axi_clk & mnoc_axi_clk (+ q6_bimc) on 0x0018a000 page */
+	printf("WIFI PROBE: [4.5]   Step 8e: enabling SNOC/MNOC/Q6BIMC AXI clocks (0x0018a000)...\n");
+	*(volatile uint32_t *)(gcc_va + GCC_MSS_SNOC_AXI_CBCR_OFF)  |= 0x1u;
+	*(volatile uint32_t *)(gcc_va + GCC_MSS_MNOC_BIMC_CBCR_OFF) |= 0x1u;
+	*(volatile uint32_t *)(gcc_va + GCC_MSS_Q6_BIMC_CBCR_OFF)   |= 0x1u;
+	__asm__ volatile("dmb sy" ::: "memory");
+	delay(20);
+
+	ahb_after = *(volatile uint32_t *)(gcc_va + GCC_MSS_CFG_AHB_CBCR_OFF);
+	ahb_active = (((ahb_after >> 31) & 1u) == 0);
+	uint32_t snoc_cbcr = *(volatile uint32_t *)(gcc_va + GCC_MSS_SNOC_AXI_CBCR_OFF);
+	uint32_t mnoc_cbcr = *(volatile uint32_t *)(gcc_va + GCC_MSS_MNOC_BIMC_CBCR_OFF);
+	uint32_t q6b_cbcr  = *(volatile uint32_t *)(gcc_va + GCC_MSS_Q6_BIMC_CBCR_OFF);
+	printf("WIFI PROBE: [4.5] GCC MSS Clocks Post-Enable:\n");
+	printf("WIFI PROBE: [4.5]   AHB=0x%08x (OFF=%u) SNOC=0x%08x (OFF=%u) MNOC=0x%08x (OFF=%u) Q6BIMC=0x%08x (OFF=%u) -> %s\n",
+	    ahb_after, (ahb_after >> 31) & 1u,
+	    snoc_cbcr, (snoc_cbcr >> 31) & 1u,
+	    mnoc_cbcr, (mnoc_cbcr >> 31) & 1u,
+	    q6b_cbcr,  (q6b_cbcr >> 31) & 1u,
+	    ahb_active ? "ACTIVE" : "GATED / FAILED");
+
+	/* 9. CRITICAL HARD SAFETY GATE: If AHB clock failed, ABORT immediately to prevent SError */
+	if (!ahb_active) {
+		printf("WIFI PROBE: [4.5] HARD LOCK: MSS CFG AHB clock is GATED (val=0x%08x, CLK_OFF=1).\n", ahb_after);
+		printf("WIFI PROBE: [4.5]   Skipping QDSP6SS & RMB MMIO accesses to PREVENT SError kernel panic.\n");
+		printf("WIFI PROBE: [4.5]   Sub-Phase 4.5 safely aborted; continuing normal boot.\n\n");
+		return;
+	}
+
+	/* 10. Map RMB & QDSP6SS ONLY After AHB Clock Is Active */
+	vm_offset_t rmb_va = ml_io_map(RMB_PHYS_BASE, RMB_SIZE);
+	vm_offset_t q6_va  = ml_io_map(QDSP6SS_PHYS_BASE, QDSP6SS_SIZE);
+	if (!rmb_va || !q6_va) {
+		printf("WIFI PROBE: [4.5] ERROR: Failed to map RMB or QDSP6SS registers.\n");
+		return;
+	}
+	s_rmb_va = rmb_va;
+
+	uint32_t init_rmb_img = *(volatile uint32_t *)(rmb_va + RMB_MBA_IMAGE_REG);
+	uint32_t init_rmb_pbl = *(volatile uint32_t *)(rmb_va + RMB_PBL_STATUS_REG);
+	uint32_t init_rmb_cmd = *(volatile uint32_t *)(rmb_va + RMB_MBA_COMMAND_REG);
+	uint32_t init_rmb_mba = *(volatile uint32_t *)(rmb_va + RMB_MBA_STATUS_REG);
+	uint32_t init_rmb_ver = *(volatile uint32_t *)(rmb_va + RMB_PROTOCOL_VERSION_REG);
+	uint32_t init_rmb_dbg = *(volatile uint32_t *)(rmb_va + RMB_MBA_DEBUG_INFO_REG);
+	uint32_t init_q6_rst  = *(volatile uint32_t *)(q6_va + QDSP6SS_RESET_REG);
+	uint32_t init_q6_gfm  = *(volatile uint32_t *)(q6_va + QDSP6SS_GFMUX_CTL_REG);
+	uint32_t init_q6_pwr  = *(volatile uint32_t *)(q6_va + QDSP6SS_PWR_CTL_REG);
+	uint32_t init_q6_xo   = *(volatile uint32_t *)(q6_va + QDSP6SS_XO_CBCR);
+	uint32_t init_q6_slp  = *(volatile uint32_t *)(q6_va + QDSP6SS_SLEEP_CBCR);
+	uint32_t init_q6_b78  = *(volatile uint32_t *)(q6_va + QDSP6SS_BHS_STATUS_REG);
+	uint32_t init_q6_bc4  = *(volatile uint32_t *)(q6_va + QDSP6V62SS_BHS_STATUS);
+	printf("WIFI PROBE: [4.5] Initial States (Clock Active):\n");
+	printf("WIFI PROBE: [4.5]   RMB:  IMG=0x%08x PBL=0x%08x CMD=0x%08x MBA=0x%08x VER=0x%08x DBG=0x%08x\n",
+	    init_rmb_img, init_rmb_pbl, init_rmb_cmd, init_rmb_mba, init_rmb_ver, init_rmb_dbg);
+	printf("WIFI PROBE: [4.5]   Q6SS: RST=0x%08x GFM=0x%08x PWR=0x%08x XO=0x%08x SLP=0x%08x\n",
+	    init_q6_rst, init_q6_gfm, init_q6_pwr, init_q6_xo, init_q6_slp);
+	printf("WIFI PROBE: [4.5]         BHS_078=0x%08x BHS_0C4=0x%08x\n",
+	    init_q6_b78, init_q6_bc4);
+
+	/* 10b. Program RMB image/DP registers before Q6v5 reset per pil_mss_reset() (pil-msa.c:500-525) */
+	*(volatile uint32_t *)(rmb_va + RMB_MBA_IMAGE_REG) = (uint32_t)PIL_MBA_PHYS_BASE;
+	if (init_rmb_cmd != 0) {
+		*(volatile uint32_t *)(rmb_va + RMB_MBA_COMMAND_REG) = 0x0;
+	}
+	*(volatile uint32_t *)(rmb_va + RMB_PMI_CODE_START_REG) = 0x0;
+	*(volatile uint32_t *)(rmb_va + RMB_PMI_CODE_LENGTH_REG) = 0x0;
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	/* 11. Assert resets & stop core per Qualcomm __pil_q6v55_reset */
+	*(volatile uint32_t *)(q6_va + QDSP6SS_RESET_REG) =
+	    (Q6SS_CORE_ARES | Q6SS_BUS_ARES_ENA | Q6SS_STOP_CORE); /* 0x7 */
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	/* 12. Enable Q6SS Subsystem Clocks: XO CBCR (0x038) and SLEEP CBCR (0x03C) */
+	*(volatile uint32_t *)(q6_va + QDSP6SS_XO_CBCR) |= 1;
+	__asm__ volatile("dmb sy" ::: "memory");
+	for (int i = 0; i < 200; i++) {
+		if ((*(volatile uint32_t *)(q6_va + QDSP6SS_XO_CBCR) & (1u << 31)) == 0)
+			break;
+		delay(1);
+	}
+
+	*(volatile uint32_t *)(q6_va + QDSP6SS_SLEEP_CBCR) |= 1;
+	__asm__ volatile("dmb sy" ::: "memory");
+	for (int i = 0; i < 200; i++) {
+		if ((*(volatile uint32_t *)(q6_va + QDSP6SS_SLEEP_CBCR) & (1u << 31)) == 0)
+			break;
+		delay(1);
+	}
+	uint32_t xo_now = *(volatile uint32_t *)(q6_va + QDSP6SS_XO_CBCR);
+	uint32_t slp_now = *(volatile uint32_t *)(q6_va + QDSP6SS_SLEEP_CBCR);
+	printf("WIFI PROBE: [4.5] Q6SS CBCRs un-gated: XO=0x%08x (off=%u) SLEEP=0x%08x (off=%u)\n",
+	    xo_now, (xo_now >> 31) & 1, slp_now, (slp_now >> 31) & 1);
+
+	/* 13. Turn on Block HeadSwitch (BHS) in QDSP6SS_PWR_CTL_REG */
+	uint32_t q6_pwr = *(volatile uint32_t *)(q6_va + QDSP6SS_PWR_CTL_REG);
+	q6_pwr |= QDSP6v55_BHS_ON; /* BIT 24 */
+	*(volatile uint32_t *)(q6_va + QDSP6SS_PWR_CTL_REG) = q6_pwr;
+	__asm__ volatile("dmb sy" ::: "memory");
+	delay(10);
+
+	/* 14. Poll QDSP6V62SS_BHS_STATUS (0x0C4) for BHS_EN_REST_ACK (bit 0) */
+	uint32_t bhs_0c4 = 0;
+	bool bhs_ack = false;
+	for (int i = 0; i < 500; i++) {
+		bhs_0c4 = *(volatile uint32_t *)(q6_va + QDSP6V62SS_BHS_STATUS);
+		if ((bhs_0c4 & QDSP6v55_BHS_EN_REST_ACK) != 0) {
+			bhs_ack = true;
+			break;
+		}
+		delay(10);
+	}
+	printf("WIFI PROBE: [4.5] Q6SS BHS Power-Up: BHS_0C4=0x%08x -> %s\n",
+	    bhs_0c4, bhs_ack ? "STABILIZED" : "TIMEOUT");
+
+	/* 15. Put LDO in bypass mode per __pil_q6v55_reset (BIT 25) */
+	q6_pwr = *(volatile uint32_t *)(q6_va + QDSP6SS_PWR_CTL_REG);
+	q6_pwr |= QDSP6v55_LDO_BYP; /* BIT 25 */
+	*(volatile uint32_t *)(q6_va + QDSP6SS_PWR_CTL_REG) = q6_pwr;
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	/* 16. Deassert QDSP6 compiler memory clamp before memory turn-on */
+	q6_pwr &= ~QDSP6v55_CLAMP_QMC_MEM; /* ~BIT 22 */
+	*(volatile uint32_t *)(q6_va + QDSP6SS_PWR_CTL_REG) = q6_pwr;
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	/* 17. Deassert memory peripheral sleep and L2 memory standby */
+	q6_pwr |= (Q6SS_L2DATA_STBY_N | Q6SS_SLP_RET_N); /* BIT 18 | BIT 19 */
+	*(volatile uint32_t *)(q6_va + QDSP6SS_PWR_CTL_REG) = q6_pwr;
+	__asm__ volatile("dmb sy" ::: "memory");
+	delay(1);
+
+	/* 18. Sequential Memory Power-Up: QDSP6V6SS_MEM_PWR_CTL (bits 28 down to 0) */
+	uint32_t mem_pwr = *(volatile uint32_t *)(q6_va + QDSP6V6SS_MEM_PWR_CTL);
+	for (int i = 28; i >= 0; i--) {
+		mem_pwr |= (1u << i);
+		*(volatile uint32_t *)(q6_va + QDSP6V6SS_MEM_PWR_CTL) = mem_pwr;
+		mem_pwr = *(volatile uint32_t *)(q6_va + QDSP6V6SS_MEM_PWR_CTL);
+		delay(1);
+	}
+	printf("WIFI PROBE: [4.5] Q6SS Memory Arrays: MEM_PWR_CTL=0x%08x (all 29 banks enabled)\n", mem_pwr);
+
+	/* 19. Remove word line clamp */
+	q6_pwr = *(volatile uint32_t *)(q6_va + QDSP6SS_PWR_CTL_REG);
+	q6_pwr &= ~QDSP6v55_CLAMP_WL; /* ~BIT 21 */
+	*(volatile uint32_t *)(q6_va + QDSP6SS_PWR_CTL_REG) = q6_pwr;
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	/* 20. Remove IO clamp */
+	q6_pwr &= ~Q6SS_CLAMP_IO; /* ~BIT 20 */
+	*(volatile uint32_t *)(q6_va + QDSP6SS_PWR_CTL_REG) = q6_pwr;
+	__asm__ volatile("dmb sy" ::: "memory");
+	delay(20);
+
+	uint32_t pwr_after = *(volatile uint32_t *)(q6_va + QDSP6SS_PWR_CTL_REG);
+	printf("WIFI PROBE: [4.5] Q6SS Clamps Released: PWR_CTL=0x%08x (BHS_ON=%u, LDO_BYP=%u, CLAMP_IO=%u, WL=%u, QMC=%u)\n",
+	    pwr_after, (pwr_after >> 24) & 1, (pwr_after >> 25) & 1,
+	    (pwr_after >> 20) & 1, (pwr_after >> 21) & 1, (pwr_after >> 22) & 1);
+
+	/* 21. Re-verify APCS clock vote bits & confirm RMB_MBA_IMAGE_REG readback before core release */
+	uint32_t v0_pre = *(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_OFF);
+	if ((v0_pre & GCC_BOOT_ROM_AHB_VOTE_BIT) == 0) {
+		*(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_OFF) = v0_pre | GCC_BOOT_ROM_AHB_VOTE_BIT;
+		__asm__ volatile("dmb sy" ::: "memory");
+	}
+	uint32_t v1_pre = *(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_1_OFF);
+	if ((v1_pre & GCC_GPLL0_MSSCC_VOTE_BIT) == 0) {
+		*(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_1_OFF) = v1_pre | GCC_GPLL0_MSSCC_VOTE_BIT;
+		__asm__ volatile("dmb sy" ::: "memory");
+	}
+	*(volatile uint32_t *)(rmb_va + RMB_MBA_IMAGE_REG) = (uint32_t)PIL_MBA_PHYS_BASE;
+	__asm__ volatile("dmb sy" ::: "memory");
+	uint32_t rmb_img_rb = *(volatile uint32_t *)(rmb_va + RMB_MBA_IMAGE_REG);
+	printf("WIFI PROBE: [4.5] Programmed RMB_MBA_IMAGE_REG = 0x%08x (readback=0x%08x)\n",
+	    (uint32_t)PIL_MBA_PHYS_BASE, rmb_img_rb);
+
+	/* 22. Bring Hexagon Core Out of Reset (clear Q6SS_CORE_ARES and Q6SS_STOP_CORE; KEEP BUS_ARES_ENA) */
+	uint32_t q6_rst = *(volatile uint32_t *)(q6_va + QDSP6SS_RESET_REG);
+	q6_rst &= ~(Q6SS_CORE_ARES | Q6SS_STOP_CORE);
+	*(volatile uint32_t *)(q6_va + QDSP6SS_RESET_REG) = q6_rst;
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	/* 23. Turn on Hexagon Core Clock (ZERO Q6SS MMIO reads after GFMUX write!) */
+	uint32_t q6_gfm = *(volatile uint32_t *)(q6_va + QDSP6SS_GFMUX_CTL_REG);
+	q6_gfm |= Q6SS_CLK_ENA; /* BIT 1 */
+	*(volatile uint32_t *)(q6_va + QDSP6SS_GFMUX_CTL_REG) = q6_gfm;
+	__asm__ volatile("dmb sy" ::: "memory");
+	printf("WIFI PROBE: [4.5] Hexagon Core Boot Triggered: RESET=0x%08x, GFMUX=0x%08x (Q6SS MMIO closed for MBA XPU)\n",
+	    q6_rst, q6_gfm);
+
+	/* 24. Monitor PBL and MBA Handshake (bounded 1,000 ms per pil-msa.c pbl_mba_boot_timeout_ms) */
+	printf("WIFI PROBE: [4.5] Polling RMB_MBA_STATUS_REG (0x0C) and RMB_PBL_STATUS_REG (0x04)...\n");
+	uint32_t last_pbl = 0xFFFFFFFF;
+	uint32_t last_mba = 0xFFFFFFFF;
+	uint32_t last_dbg = 0xFFFFFFFF;
+	bool pbl_logged = false;
+	bool success = false;
+
+	for (int iter = 0; iter <= 200; iter++) {
+		uint32_t cur_pbl = *(volatile uint32_t *)(rmb_va + RMB_PBL_STATUS_REG);
+		uint32_t cur_mba = *(volatile uint32_t *)(rmb_va + RMB_MBA_STATUS_REG);
+		uint32_t cur_dbg = *(volatile uint32_t *)(rmb_va + RMB_MBA_DEBUG_INFO_REG);
+
+		if (cur_pbl != last_pbl || cur_mba != last_mba || cur_dbg != last_dbg || iter == 0 || iter == 200) {
+			printf("WIFI PROBE: [4.5]   t=%4d ms | PBL=0x%08x MBA=0x%08x DBG=0x%08x\n",
+			    iter * 5, cur_pbl, cur_mba, cur_dbg);
+			last_pbl = cur_pbl;
+			last_mba = cur_mba;
+			last_dbg = cur_dbg;
+		}
+
+		if (cur_pbl == STATUS_PBL_SUCCESS && !pbl_logged) {
+			pbl_logged = true;
+			printf("WIFI PROBE: [4.5] *** PBL HANDSHAKE SUCCESS! PBL=0x00000001 (MBA Authenticated & Launched) at t=%d ms ***\n",
+			    iter * 5);
+		}
+
+		/*
+		 * Check for MBA Success:
+		 * 1: STATUS_XPU_UNLOCKED (MBA ready / boot done)
+		 * 2: STATUS_XPU_UNLOCKED_SCRIBBLED
+		 */
+		if (cur_mba == STATUS_XPU_UNLOCKED || cur_mba == STATUS_XPU_UNLOCKED_SCRIBBLED) {
+			printf("WIFI PROBE: [4.5] *** MBA BOOT SUCCESS! MBA Status = 0x%08x (MBA Ready / Boot Done) at t=%d ms ***\n",
+			    cur_mba, iter * 5);
+			success = true;
+			break;
+		}
+
+		/* Check for error codes */
+		if ((int32_t)cur_mba < 0) {
+			printf("WIFI PROBE: [4.5] MBA reported error status: 0x%08x (%d)\n", cur_mba, (int32_t)cur_mba);
+			break;
+		}
+		if ((int32_t)cur_pbl < 0) {
+			printf("WIFI PROBE: [4.5] PBL reported error status: 0x%08x (%d)\n", cur_pbl, (int32_t)cur_pbl);
+			break;
+		}
+
+		delay(5000); /* 5 ms delay per iteration */
+	}
+
+	if (!success) {
+		printf("WIFI PROBE: [4.5] Note: Polling cycle complete. Final: PBL=0x%08x MBA=0x%08x DBG=0x%08x\n",
+		    last_pbl, last_mba, last_dbg);
+	}
+	s_mba_boot_ok = success;
+
+	/*
+	 * 25. Post-Poll Register Audit (RMB 0x00..0x20 & GCC ONLY).
+	 * CRITICAL: NEVER read QDSP6SS (0x04080000) after Hexagon boot is triggered!
+	 * Once mba.mbn boots and arms the MSS XPUs (STATUS_XPU_UNLOCKED), 0x04080000
+	 * is XPU-locked to VMID_MSS_MSA (0xF); any HLOS read triggers an SError panic.
+	 */
+	printf("WIFI PROBE: [4.5] Register Audit Post-Poll (Q6SS 0x04080000 skipped: XPU-locked by MBA):\n");
+	printf("WIFI PROBE: [4.5]   RMB:  IMG=0x%08x PBL=0x%08x CMD=0x%08x MBA=0x%08x\n",
+	    *(volatile uint32_t *)(rmb_va + RMB_MBA_IMAGE_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_PBL_STATUS_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_MBA_COMMAND_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_MBA_STATUS_REG));
+	printf("WIFI PROBE: [4.5]         META=0x%08x START=0x%08x LEN=0x%08x VER=0x%08x DBG=0x%08x\n",
+	    *(volatile uint32_t *)(rmb_va + RMB_PMI_META_DATA_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_PMI_CODE_START_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_PMI_CODE_LENGTH_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_PROTOCOL_VERSION_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_MBA_DEBUG_INFO_REG));
+	printf("WIFI PROBE: [4.5]   GCC:  AHB=0x%08x BIMC_Q6_AXI=0x%08x APCS_VOTE=0x%08x APCS_VOTE_1=0x%08x\n",
+	    *(volatile uint32_t *)(gcc_va  + GCC_MSS_CFG_AHB_CBCR_OFF),
+	    *(volatile uint32_t *)(bimc_va + GCC_BIMC_MSS_Q6_AXI_CBCR_OFF),
+	    *(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_OFF),
+	    *(volatile uint32_t *)(vote_va + GCC_APCS_CLK_ENA_VOTE_1_OFF));
+	printf("WIFI PROBE: [4.5] Sub-Phase 4.5 active MBA load complete.\n\n");
+}
+
+/*
+ * Stage 5A: Full MPSS Self-Authenticating ELF Boot (modem.mdt + 28 PT_LOAD segments)
+ * and Post-Boot SMEM APPS:Modem (p[07], 0:1) GLINK / SMP2P Live Verification.
+ *
+ * Gated strictly behind opt-in boot-arg:
+ *   wlan_stage5a_mpss=1
+ */
+struct sweet_elf32_ehdr {
+	uint8_t  e_ident[16];
+	uint16_t e_type;
+	uint16_t e_machine;
+	uint32_t e_version;
+	uint32_t e_entry;
+	uint32_t e_phoff;
+	uint32_t e_shoff;
+	uint32_t e_flags;
+	uint16_t e_ehsize;
+	uint16_t e_phentsize;
+	uint16_t e_phnum;
+	uint16_t e_shentsize;
+	uint16_t e_shnum;
+	uint16_t e_shstrndx;
+};
+
+struct sweet_elf32_phdr {
+	uint32_t p_type;
+	uint32_t p_offset;
+	uint32_t p_vaddr;
+	uint32_t p_paddr;
+	uint32_t p_filesz;
+	uint32_t p_memsz;
+	uint32_t p_flags;
+	uint32_t p_align;
+};
+
+static uint8_t s_mdt_buf[16384] __attribute__((aligned(64)));
+
+/*
+ * Volatile zero helper: never uses memset/bzero (which lower to dc zva on XNU
+ * and fault with DFSC=0x21 on Non-Cacheable / Write-Combining WIMG=6 mappings).
+ */
+static void
+sweet_io_zero(void *dst, size_t len)
+{
+	uintptr_t addr = (uintptr_t)dst;
+	while (len > 0u && (addr & 7u) != 0u) {
+		*(volatile uint8_t *)addr = 0u;
+		addr++;
+		len--;
+	}
+	while (len >= 8u) {
+		*(volatile uint64_t *)addr = 0ULL;
+		addr += 8u;
+		len -= 8u;
+	}
+	while (len > 0u) {
+		*(volatile uint8_t *)addr = 0u;
+		addr++;
+		len--;
+	}
+	__asm__ volatile("dmb sy" ::: "memory");
+}
+
+static void
+sweet_dcache_clean_poc(vm_offset_t va, size_t len)
+{
+	uintptr_t start = ((uintptr_t)va) & ~(uintptr_t)63u;
+	uintptr_t end   = (uintptr_t)va + len;
+	for (uintptr_t p = start; p < end; p += 64u) {
+		__asm__ volatile("dc cvac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile("dsb sy\nisb" ::: "memory");
+}
+
+static void
+probe_dump_rmb_regs(const char *tag, vm_offset_t rmb_va)
+{
+	printf("WIFI PROBE: [%s]   RMB:  IMG=0x%08x PBL=0x%08x CMD=0x%08x MBA=0x%08x\n",
+	    tag,
+	    *(volatile uint32_t *)(rmb_va + RMB_MBA_IMAGE_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_PBL_STATUS_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_MBA_COMMAND_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_MBA_STATUS_REG));
+	printf("WIFI PROBE: [%s]         META=0x%08x START=0x%08x LEN=0x%08x VER=0x%08x DBG=0x%08x\n",
+	    tag,
+	    *(volatile uint32_t *)(rmb_va + RMB_PMI_META_DATA_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_PMI_CODE_START_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_PMI_CODE_LENGTH_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_PROTOCOL_VERSION_REG),
+	    *(volatile uint32_t *)(rmb_va + RMB_MBA_DEBUG_INFO_REG));
+}
+
+static int
+probe_rmb_wait_status(const char *phase, uint32_t want_status, uint32_t timeout_ms, uint32_t *out_status)
+{
+	uint32_t iters = timeout_ms / 5u;
+	uint32_t last_st = 0xFFFFFFFFu;
+	uint32_t st = 0u;
+
+	for (uint32_t i = 0u; i <= iters; i++) {
+		st = *(volatile uint32_t *)(s_rmb_va + RMB_MBA_STATUS_REG);
+		if (st != last_st || i == 0u || i == iters || st == want_status || (int32_t)st < 0) {
+			printf("WIFI PROBE: [5A]   t=%4u ms | %s MBA_STATUS=0x%08x\n",
+			    i * 5u, phase, st);
+			last_st = st;
+		}
+		if (st == want_status || (int32_t)st < 0) {
+			break;
+		}
+		if (i < iters) {
+			delay(5000);
+		}
+	}
+
+	if (out_status) {
+		*out_status = st;
+	}
+	return (st == want_status) ? 0 : -1;
+}
+
+static bool     s_mpss_boot_ok = false;
+static uint32_t s_smem_p07_pa = 0u;
+static uint32_t s_smem_p07_sz = 0u;
+static uint32_t s_smem_p07_cacheline = 32u;
+static uint32_t s_smem_comm_pa = 0u;
+static uint32_t s_smem_comm_sz = 0u;
+static uint32_t s_smem_comm_cacheline = 32u;
+
+static void
+probe_stage5a_smem_modem_audit(void)
+{
+	printf("WIFI PROBE: [5A.3] Inspecting SMEM APPS:Modem (0:1) partition for SMP2P & GLINK...\n");
+
+	s_smem_p07_pa = 0u;
+	s_smem_p07_sz = 0u;
+	s_smem_p07_cacheline = 32u;
+	s_smem_comm_pa = 0u;
+	s_smem_comm_sz = 0u;
+	s_smem_comm_cacheline = 32u;
+
+	vm_offset_t toc = ml_io_map(POPLAR_SMEM_TOC_PA, 0x1000u);
+	if (!toc) {
+		printf("WIFI PROBE: [5A.3] ERROR: failed to map SMEM TOC @ 0x%08x\n", POPLAR_SMEM_TOC_PA);
+		return;
+	}
+
+	uint32_t magic = probe_rd32(toc, 0u);
+	uint32_t num_entries = probe_rd32(toc, 8u);
+	uint32_t max_entries = probe_rd32(toc, 12u);
+	if (magic != 0x434f5424u) {
+		printf("WIFI PROBE: [5A.3] ERROR: invalid TOC magic 0x%08x\n", magic);
+		return;
+	}
+	if (max_entries > 0u && num_entries > max_entries) {
+		num_entries = max_entries;
+	}
+	if (num_entries > 32u) {
+		num_entries = 32u;
+	}
+
+	uint32_t part_idx = 0xFFFFFFFFu;
+	uint32_t part_off = 0u, part_sz = 0u, part_cl = 32u;
+	uint16_t part_h0 = 0u, part_h1 = 0u;
+	for (uint32_t i = 0u; i < num_entries; i++) {
+		uint32_t e_off = 32u + i * 48u;
+		uint32_t off   = probe_rd32(toc, e_off);
+		uint32_t sz    = probe_rd32(toc, e_off + 4u);
+		uint32_t hosts = probe_rd32(toc, e_off + 12u);
+		uint32_t cl    = probe_rd32(toc, e_off + 16u);
+		uint16_t h0 = (uint16_t)hosts;
+		uint16_t h1 = (uint16_t)(hosts >> 16);
+		printf("WIFI PROBE: [5A.3] SMEM TOC[%02u]: off=0x%05x sz=%uKB hosts=%u:%u (0x%04x:0x%04x) cl=%u\n",
+		    i, off, sz / 1024u, h0, h1, h0, h1, cl);
+		if (((h0 == 0u && h1 == 1u) || (h0 == 1u && h1 == 0u)) &&
+		    sz > 0u && sz <= 0x200000u && off <= 0x200000u - sz && part_idx == 0xFFFFFFFFu) {
+			part_idx = i;
+			part_off = off;
+			part_sz  = sz;
+			part_cl  = (cl > 0u) ? cl : 32u;
+			part_h0  = h0;
+			part_h1  = h1;
+		}
+		if (off == 0x1ff000u) {
+			/* TOC self-entry */
+			printf("WIFI PROBE: [5A.3]   TOC[%02u] is SMEM TOC self-entry ($TOC @ 0x%08x)\n",
+			    i, POPLAR_SMEM_BASE_PA + off);
+		} else if (off == 0u && h0 == 0xFFFFu && h1 == 0xFFFFu) {
+			/* Legacy Global SMEM heap */
+			printf("WIFI PROBE: [5A.3]   TOC[%02u] is Global SMEM heap (PA=0x%08x sz=%uKB)\n",
+			    i, POPLAR_SMEM_BASE_PA + off, sz / 1024u);
+		} else if (h0 == 0xFFFEu && h1 == 0xFFFEu &&
+		    sz > 0u && sz <= 0x200000u && off <= 0x200000u - sz && s_smem_comm_pa == 0u) {
+			/* True Qualcomm Common Partition (#define SMEM_COMM_HOST 0xFFFE) */
+			s_smem_comm_pa = POPLAR_SMEM_BASE_PA + off;
+			s_smem_comm_sz = sz;
+			s_smem_comm_cacheline = (cl > 0u) ? cl : 32u;
+			printf("WIFI PROBE: [5A.3]   -> Found SMEM Common Partition TOC[%02u] PA=0x%08x sz=%uKB cl=%u\n",
+			    i, s_smem_comm_pa, sz / 1024u, s_smem_comm_cacheline);
+		}
+	}
+
+	if (part_idx == 0xFFFFFFFFu) {
+		printf("WIFI PROBE: [5A.3] ERROR: APPS:Modem (0:1) partition not found in SMEM TOC.\n");
+		return;
+	}
+
+	uint32_t part_pa = POPLAR_SMEM_BASE_PA + part_off;
+	s_smem_p07_pa = part_pa;
+	s_smem_p07_sz = part_sz;
+	s_smem_p07_cacheline = part_cl;
+	uint32_t map_len = (part_sz < 0x20000u) ? part_sz : 0x20000u;
+	printf("WIFI PROBE: [5A.3] Found p[%02u] off=0x%05x PA=0x%08x sz=%uKB hosts=%u:%u cl=%u (mapping %uKB Device-nGnRnE)\n",
+	    part_idx, part_off, part_pa, part_sz / 1024u, part_h0, part_h1, part_cl, map_len / 1024u);
+
+	vm_offset_t part_va = ml_io_map(part_pa, map_len);
+	if (!part_va) {
+		printf("WIFI PROBE: [5A.3] ERROR: failed to map SMEM p[%02u] @ 0x%08x\n", part_idx, part_pa);
+		return;
+	}
+
+	uint32_t pmagic = probe_rd32(part_va, 0x00u);
+	if (pmagic != SMEM_PART_MAGIC) {
+		printf("WIFI PROBE: [5A.3] ERROR: p[%02u] magic=0x%08x (expected '$PRT')\n", part_idx, pmagic);
+		return;
+	}
+
+	uint32_t free_uncached = probe_rd32(part_va, 0x0cu);
+	uint32_t free_cached   = probe_rd32(part_va, 0x10u);
+	for (uint32_t i = 0u; i < 400u; i++) {
+		free_uncached = probe_rd32(part_va, 0x0cu);
+		free_cached   = probe_rd32(part_va, 0x10u);
+		if (free_uncached > 0x20u) {
+			break;
+		}
+		delay(5000);
+	}
+	if (free_uncached > 0x20u) {
+		delay(400000); /* 400 ms settle window for initial SMP2P & GLINK channel creation */
+		free_uncached = probe_rd32(part_va, 0x0cu);
+		free_cached   = probe_rd32(part_va, 0x10u);
+	}
+
+	printf("WIFI PROBE: [5A.3] p[%02u] Heap after wait: free_uncached=0x%x free_cached=0x%x\n",
+	    part_idx, free_uncached, free_cached);
+
+	uint32_t limit = (free_uncached < map_len) ? free_uncached : map_len;
+	uint32_t off = 0x20u;
+	uint32_t items = 0u;
+
+	while (off + 16u <= limit && items < 32u) {
+		uint32_t w0      = probe_rd32(part_va, off);
+		uint16_t canary  = (uint16_t)w0;
+		uint16_t item_id = (uint16_t)(w0 >> 16);
+		uint32_t item_sz = probe_rd32(part_va, off + 4u);
+		uint32_t w2      = probe_rd32(part_va, off + 8u);
+		uint16_t pad_dat = (uint16_t)w2;
+		uint16_t pad_hdr = (uint16_t)(w2 >> 16);
+
+		if (canary != SMEM_PRIVATE_CANARY) {
+			break;
+		}
+		uint32_t hdr_and_pad = 16u + (uint32_t)pad_hdr;
+		if (hdr_and_pad > map_len - off || item_sz > map_len - off - hdr_and_pad) {
+			break;
+		}
+		uint32_t payload_off = off + hdr_and_pad;
+		uint32_t usable_sz   = ((uint32_t)pad_dat < item_sz) ? (item_sz - (uint32_t)pad_dat) : item_sz;
+		uint32_t total_entry = hdr_and_pad + item_sz;
+
+		printf("WIFI PROBE: [5A.3]   item[%u] @ +0x%04x: id=%u sz=%u (usable=%u)\n",
+		    items, off, item_id, item_sz, usable_sz);
+
+		if (usable_sz >= 20u && probe_rd32(part_va, payload_off) == 0x504d5324u) { /* "$SMP" */
+			uint32_t pids = probe_rd32(part_va, payload_off + 8u);
+			uint32_t cnts = probe_rd32(part_va, payload_off + 12u);
+			uint16_t loc_pid = (uint16_t)pids;
+			uint16_t rem_pid = (uint16_t)(pids >> 16);
+			uint16_t valid_e = (uint16_t)(cnts >> 16);
+			uint32_t max_fit = (usable_sz - 20u) / 20u;
+			if (valid_e > 16u) {
+				valid_e = 16u;
+			}
+			if (valid_e > max_fit) {
+				valid_e = (uint16_t)max_fit;
+			}
+			printf("WIFI PROBE: [5A.3]     SMP2P: local_pid=%u rem_pid=%u valid_entries=%u\n",
+			    loc_pid, rem_pid, valid_e);
+			for (uint32_t e = 0u; e < valid_e; e++) {
+				uint32_t eoff = payload_off + 20u + e * 20u;
+				char ename[17];
+				for (uint32_t k = 0u; k < 4u; k++) {
+					uint32_t cw = probe_rd32(part_va, eoff + k * 4u);
+					ename[k * 4u + 0u] = (char)(cw & 0xffu);
+					ename[k * 4u + 1u] = (char)((cw >> 8) & 0xffu);
+					ename[k * 4u + 2u] = (char)((cw >> 16) & 0xffu);
+					ename[k * 4u + 3u] = (char)((cw >> 24) & 0xffu);
+				}
+				ename[16] = '\0';
+				for (uint32_t c = 0u; c < 16u && ename[c] != '\0'; c++) {
+					if ((unsigned char)ename[c] < 32u || (unsigned char)ename[c] > 126u) {
+						ename[c] = '?';
+					}
+				}
+				uint32_t bits = probe_rd32(part_va, eoff + 16u);
+				printf("WIFI PROBE: [5A.3]       entry[%u] '%s' bits=0x%08x\n", e, ename, bits);
+			}
+		} else if (item_id == 478u && item_sz >= 16u) {
+			uint32_t w_rx_tail = probe_rd32(part_va, payload_off + 0u);
+			uint32_t w_rx_head = probe_rd32(part_va, payload_off + 4u);
+			uint32_t w_tx_tail = probe_rd32(part_va, payload_off + 8u);
+			uint32_t w_tx_head = probe_rd32(part_va, payload_off + 12u);
+			printf("WIFI PROBE: [5A.3]     GLINK_XPRT_DESC(478): rx_tail=%u rx_head=%u tx_tail=%u tx_head=%u\n",
+			    w_rx_tail, w_rx_head, w_tx_tail, w_tx_head);
+		} else if ((item_id == 479u || item_id == 480u) && item_sz >= 4u) {
+			uint32_t dump_bytes = (item_sz < 64u) ? item_sz : 64u;
+			uint32_t nwords = dump_bytes / 4u;
+			printf("WIFI PROBE: [5A.3]     GLINK_FIFO(%u) first %u bytes:\n", item_id, nwords * 4u);
+			for (uint32_t w = 0u; w < nwords; w += 4u) {
+				uint32_t x0 = probe_rd32(part_va, payload_off + (w + 0u) * 4u);
+				uint32_t x1 = (w + 1u < nwords) ? probe_rd32(part_va, payload_off + (w + 1u) * 4u) : 0u;
+				uint32_t x2 = (w + 2u < nwords) ? probe_rd32(part_va, payload_off + (w + 2u) * 4u) : 0u;
+				uint32_t x3 = (w + 3u < nwords) ? probe_rd32(part_va, payload_off + (w + 3u) * 4u) : 0u;
+				printf("WIFI PROBE: [5A.3]       [+0x%02x] %08x %08x %08x %08x\n",
+				    w * 4u, x0, x1, x2, x3);
+			}
+		}
+
+		if (total_entry == 0u || total_entry > map_len - off || off + total_entry <= off) {
+			break;
+		}
+		off += total_entry;
+		items++;
+	}
+
+	if (items == 0u) {
+		printf("WIFI PROBE: [5A.3]   No private items present in p[%02u] uncached heap.\n", part_idx);
+	}
+}
+
+static void
+probe_stage5a_mpss_boot(void)
+{
+	int wlan_stage5a_mpss = 0;
+	(void)PE_parse_boot_argn("wlan_stage5a_mpss", &wlan_stage5a_mpss,
+	    sizeof(wlan_stage5a_mpss));
+
+	s_mpss_boot_ok = false;
+	printf("\nWIFI PROBE: [5A] === STAGE 5A: FULL MPSS SELF-AUTH ELF LOAD & SMEM 0:1 AUDIT ===\n");
+
+	if (wlan_stage5a_mpss <= 0) {
+		printf("WIFI PROBE: [5A] Gate: wlan_stage5a_mpss=0 (dormant default).\n");
+		printf("WIFI PROBE: [5A] MPSS ELF load skipped. To activate, set wlan_stage5a_mpss=1.\n\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [5A] Gate: wlan_stage5a_mpss=1 ACTIVE.\n");
+
+	if (!s_mba_boot_ok || s_mba_va == 0 || s_rmb_va == 0 || !s_fat16_valid ||
+	    !s_fw_mdt.found || s_fw_mdt.size < sizeof(struct sweet_elf32_ehdr) ||
+	    s_fw_mdt.size > sizeof(s_mdt_buf)) {
+		printf("WIFI PROBE: [5A] ABORT: Preconditions unmet (mba_ok=%d mba_va=%p rmb_va=%p fat16=%d mdt_found=%d mdt_sz=%u).\n\n",
+		    s_mba_boot_ok ? 1 : 0, (void *)s_mba_va, (void *)s_rmb_va,
+		    s_fat16_valid ? 1 : 0, s_fw_mdt.found ? 1 : 0, s_fw_mdt.size);
+		return;
+	}
+
+	/* Step 5A.1: Read, validate, stage (0x94200000), and authenticate modem.mdt */
+	memset(s_mdt_buf, 0, sizeof(s_mdt_buf));
+	int err = sweet_modem_fat16_read(s_fw_mdt.start_clus, s_fw_mdt.size, s_mdt_buf);
+	if (err != 0) {
+		printf("WIFI PROBE: [5A.1] ERROR: failed reading modem.mdt from FAT16 (err=%d)\n\n", err);
+		return;
+	}
+
+	const struct sweet_elf32_ehdr *eh = (const struct sweet_elf32_ehdr *)(const void *)s_mdt_buf;
+	if (sizeof(*eh) != 52u ||
+	    eh->e_ident[0] != 0x7fu || eh->e_ident[1] != 'E' ||
+	    eh->e_ident[2] != 'L'  || eh->e_ident[3] != 'F' ||
+	    eh->e_ident[4] != 1u   || eh->e_phentsize != 32u ||
+	    eh->e_phnum == 0u || eh->e_phnum > 30u || (eh->e_phoff & 3u) != 0u ||
+	    (uint64_t)eh->e_phoff + (uint64_t)eh->e_phnum * 32ULL > s_fw_mdt.size) {
+		printf("WIFI PROBE: [5A.1] ERROR: invalid modem.mdt ELF32 header (phoff=%u phentsz=%u phnum=%u)\n\n",
+		    eh->e_phoff, eh->e_phentsize, eh->e_phnum);
+		return;
+	}
+
+	uint64_t mdt_assign_sz = ((uint64_t)s_fw_mdt.size + 0xFFFULL) & ~0xFFFULL;
+	if (mdt_assign_sz > sizeof(s_mdt_buf)) {
+		printf("WIFI PROBE: [5A.1] ERROR: aligned mdt size 0x%llx exceeds buffer.\n\n",
+		    (unsigned long long)mdt_assign_sz);
+		return;
+	}
+
+	vm_offset_t mdt_va = s_mba_va + 0x100000ULL; /* PA = 0x94200000 */
+	const uint32_t *src_words = (const uint32_t *)(const void *)s_mdt_buf;
+	volatile uint32_t *dst_words = (volatile uint32_t *)mdt_va;
+	for (uint64_t w = 0u; w < (mdt_assign_sz / 4u); w++) {
+		dst_words[w] = src_words[w];
+	}
+	sweet_dcache_clean_poc(mdt_va, (size_t)mdt_assign_sz);
+
+	printf("WIFI PROBE: [5A.1] Staging modem.mdt (%u B -> aligned 0x%llx) @ 0x%08llx; assigning HLOS -> MSS_MSA...\n",
+	    s_fw_mdt.size, (unsigned long long)mdt_assign_sz, (unsigned long long)PIL_MDT_PHYS_BASE);
+	if (sweet_scm_assign_mem(PIL_MDT_PHYS_BASE, mdt_assign_sz,
+	        QCOM_SCM_VMID_HLOS, QCOM_SCM_VMID_MSS_MSA, QCOM_SCM_PERM_RW) != 0) {
+		printf("WIFI PROBE: [5A.1] ERROR: MP_ASSIGN for modem.mdt failed.\n\n");
+		return;
+	}
+
+	*(volatile uint32_t *)(s_rmb_va + RMB_PMI_CODE_LENGTH_REG) = 0u;
+	__asm__ volatile("dmb sy" ::: "memory");
+	*(volatile uint32_t *)(s_rmb_va + RMB_PMI_META_DATA_REG) = (uint32_t)PIL_MDT_PHYS_BASE;
+	__asm__ volatile("dmb sy" ::: "memory");
+	*(volatile uint32_t *)(s_rmb_va + RMB_MBA_COMMAND_REG) = CMD_META_DATA_READY;
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	uint32_t mdt_st = 0u;
+	int mdt_wait_rc = probe_rmb_wait_status("5A.1", STATUS_META_DATA_AUTH_SUCCESS, 10000u, &mdt_st);
+
+	/* Reclaim 0x94200000 back to HLOS regardless of outcome (pil-msa.c:761) */
+	(void)sweet_scm_assign_mem(PIL_MDT_PHYS_BASE, mdt_assign_sz,
+	    QCOM_SCM_VMID_MSS_MSA, QCOM_SCM_VMID_HLOS, QCOM_SCM_PERM_RWX);
+
+	if (mdt_wait_rc != 0) {
+		printf("WIFI PROBE: [5A.1] ERROR: modem.mdt auth failed (status=0x%08x (%d)).\n",
+		    mdt_st, (int32_t)mdt_st);
+		probe_dump_rmb_regs("5A", s_rmb_va);
+		printf("\n");
+		return;
+	}
+	printf("WIFI PROBE: [5A.1] *** MODEM.MDT METADATA AUTH SUCCESS (STATUS=0x%08x) ***\n", mdt_st);
+
+	/* Step 5A.2: Validate PT_LOAD layout and stream modem.b02..b28 into 0x8cc00000..0x93c00000 */
+	const struct sweet_elf32_phdr *phdrs =
+	    (const struct sweet_elf32_phdr *)(const void *)(s_mdt_buf + eh->e_phoff);
+	uint32_t min_paddr = 0xFFFFFFFFu;
+	uint32_t max_paddr = 0u;
+	uint32_t total_memsz = 0u;
+	uint32_t total_filesz = 0u;
+	unsigned load_seg_cnt = 0u, file_seg_cnt = 0u, bss_seg_cnt = 0u;
+	unsigned last_file_idx = 0u;
+
+	for (uint16_t i = 0u; i < eh->e_phnum; i++) {
+		const struct sweet_elf32_phdr *ph = &phdrs[i];
+		if (ph->p_type != 1u || ph->p_memsz == 0u || (ph->p_flags & 0x07000000u) == 0x02000000u) {
+			continue;
+		}
+		if (ph->p_filesz > ph->p_memsz ||
+		    ph->p_paddr < PIL_MPSS_PHYS_BASE ||
+		    (uint64_t)ph->p_paddr + ph->p_memsz > PIL_MPSS_PHYS_BASE + PIL_MPSS_SIZE) {
+			printf("WIFI PROBE: [5A.2] ERROR: phdr[%u] out of carveout (pa=0x%08x filesz=0x%x memsz=0x%x)\n\n",
+			    i, ph->p_paddr, ph->p_filesz, ph->p_memsz);
+			return;
+		}
+		if (ph->p_filesz > 0u) {
+			if (i >= 30u || !s_fw_modem_seg[i].found || s_fw_modem_seg[i].size < ph->p_filesz) {
+				printf("WIFI PROBE: [5A.2] ERROR: missing/short segment modem.b%02u (found=%d disk=%u need=%u)\n\n",
+				    i, (i < 30u && s_fw_modem_seg[i].found) ? 1 : 0,
+				    (i < 30u) ? s_fw_modem_seg[i].size : 0u, ph->p_filesz);
+				return;
+			}
+			file_seg_cnt++;
+			last_file_idx = i;
+		} else {
+			bss_seg_cnt++;
+		}
+		if (ph->p_paddr < min_paddr) {
+			min_paddr = ph->p_paddr;
+		}
+		if (ph->p_paddr + ph->p_memsz > max_paddr) {
+			max_paddr = ph->p_paddr + ph->p_memsz;
+		}
+		total_memsz  += ph->p_memsz;
+		total_filesz += ph->p_filesz;
+		load_seg_cnt++;
+	}
+
+	if (load_seg_cnt == 0u || min_paddr >= max_paddr || total_memsz == 0u) {
+		printf("WIFI PROBE: [5A.2] ERROR: empty PT_LOAD summary.\n\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [5A.2] PT_LOAD=%u [files=%u, pure_bss=%u] span=0x%08x..0x%08x total_memsz=0x%08x (%u B) total_filesz=0x%08x\n",
+	    load_seg_cnt, file_seg_cnt, bss_seg_cnt, min_paddr, max_paddr, total_memsz, total_memsz, total_filesz);
+
+	vm_offset_t mpss_va = ml_io_map_unmappable(PIL_MPSS_PHYS_BASE, PIL_MPSS_SIZE, SWEET_VM_WIMG_WCOMB);
+	if (!mpss_va) {
+		printf("WIFI PROBE: [5A.2] ERROR: ml_io_map_unmappable(0x%llx, 0x%llx, WCOMB) returned NULL.\n\n",
+		    (unsigned long long)PIL_MPSS_PHYS_BASE, (unsigned long long)PIL_MPSS_SIZE);
+		return;
+	}
+
+	printf("WIFI PROBE: [5A.2] Mapped 112 MiB MPSS carveout via WCOMB (zeroing without dc zva)...\n");
+	sweet_io_zero((void *)mpss_va, (size_t)PIL_MPSS_SIZE);
+
+	printf("WIFI PROBE: [5A.2] Streaming %u file-backed PT_LOAD segments into 0x8cc00000..0x93c00000...\n", file_seg_cnt);
+	bool first_logged = false;
+	for (uint16_t i = 0u; i < eh->e_phnum; i++) {
+		const struct sweet_elf32_phdr *ph = &phdrs[i];
+		if (ph->p_type != 1u || ph->p_memsz == 0u ||
+		    (ph->p_flags & 0x07000000u) == 0x02000000u || ph->p_filesz == 0u) {
+			continue;
+		}
+		uint64_t rel_off = (uint64_t)ph->p_paddr - PIL_MPSS_PHYS_BASE;
+		void *seg_dst = (void *)(mpss_va + (vm_offset_t)rel_off);
+		err = sweet_modem_fat16_read(s_fw_modem_seg[i].start_clus, ph->p_filesz, seg_dst);
+		if (err != 0) {
+			printf("WIFI PROBE: [5A.2] ERROR: modem.b%02u FAT16 read failed (err=%d, pa=0x%08x sz=%u)\n",
+			    i, err, ph->p_paddr, ph->p_filesz);
+			ml_io_unmap(mpss_va, PIL_MPSS_SIZE);
+			return;
+		}
+		if (!first_logged || i == last_file_idx || ph->p_filesz >= 0x100000u) {
+			first_logged = true;
+			printf("WIFI PROBE: [5A.2]   loaded modem.b%02u -> 0x%08x (%u B, memsz=0x%x)\n",
+			    i, ph->p_paddr, ph->p_filesz, ph->p_memsz);
+		}
+	}
+
+	sweet_dcache_clean_poc(mpss_va, (size_t)PIL_MPSS_SIZE);
+	ml_io_unmap(mpss_va, PIL_MPSS_SIZE);
+	mpss_va = 0;
+	printf("WIFI PROBE: [5A.2] D-cache cleaned to PoC and 112 MiB HLOS mapping removed; assigning HLOS -> MSS_MSA...\n");
+
+	if (sweet_scm_assign_mem(PIL_MPSS_PHYS_BASE, PIL_MPSS_SIZE,
+	        QCOM_SCM_VMID_HLOS, QCOM_SCM_VMID_MSS_MSA, QCOM_SCM_PERM_RW) != 0) {
+		printf("WIFI PROBE: [5A.2] ERROR: MP_ASSIGN for 112 MiB MPSS region failed.\n\n");
+		return;
+	}
+
+	/* Trigger full MPSS segment authentication & Hexagon MPSS boot (pil-msa.c:807-812) */
+	*(volatile uint32_t *)(s_rmb_va + RMB_PMI_CODE_START_REG) = min_paddr;
+	__asm__ volatile("dmb sy" ::: "memory");
+	*(volatile uint32_t *)(s_rmb_va + RMB_MBA_COMMAND_REG) = CMD_LOAD_READY;
+	__asm__ volatile("dmb sy" ::: "memory");
+	*(volatile uint32_t *)(s_rmb_va + RMB_PMI_CODE_LENGTH_REG) = total_memsz;
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	uint32_t mpss_st = 0u;
+	int mpss_wait_rc = probe_rmb_wait_status("5A.2", STATUS_AUTH_COMPLETE, 10000u, &mpss_st);
+	if (mpss_wait_rc != 0) {
+		printf("WIFI PROBE: [5A.2] ERROR: MPSS image auth failed (status=0x%08x (%d)).\n",
+		    mpss_st, (int32_t)mpss_st);
+		probe_dump_rmb_regs("5A", s_rmb_va);
+		printf("\n");
+		return;
+	}
+
+	printf("WIFI PROBE: [5A.2] *** FULL MPSS AUTH COMPLETE & BOOTED (STATUS=0x%08x) ***\n", mpss_st);
+	probe_dump_rmb_regs("5A", s_rmb_va);
+
+	/* Reclaim MBA+DP 1 MiB carveout (0x94100000) back to HLOS for Stage 5B wlan_msa (pil-msa.c:848) */
+	printf("WIFI PROBE: [5A.2] Reclaiming MBA+DP (0x94100000, 1 MiB) MSS_MSA -> HLOS...\n");
+	int reclaim_rc = sweet_scm_assign_mem(PIL_MBA_PHYS_BASE, PIL_MBA_DP_SIZE,
+	    QCOM_SCM_VMID_MSS_MSA, QCOM_SCM_VMID_HLOS, QCOM_SCM_PERM_RWX);
+	s_mpss_boot_ok = (reclaim_rc == 0);
+
