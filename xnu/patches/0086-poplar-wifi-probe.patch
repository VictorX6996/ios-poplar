+#define QCOM_SMD_RPM_LDOA           0x616f646cu   /* "ldoa" in little-endian */
+#define QCOM_SMD_RPM_CLK_BUF_A      0x616b6c63u   /* "clka" in little-endian */
+#define RPM_KEY_SWEN                0x6e657773u   /* "swen" in little-endian */
