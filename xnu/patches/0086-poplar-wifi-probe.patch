+static inline uint16_t
+s5b_rd_le16(const uint8_t *p)
+{
+	return (uint16_t)((uint16_t)p[0] | ((uint16_t)p[1] << 8));
+}
+
+static inline uint32_t
+s5b_rd_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	       ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static inline uint64_t
+s5b_rd_le64(const uint8_t *p)
+{
+	return (uint64_t)s5b_rd_le32(p) | ((uint64_t)s5b_rd_le32(p + 4) << 32);
+}
+
+static inline uint16_t
+s5b_rd_be16(const uint8_t *p)
+{
+	return (uint16_t)(((uint16_t)p[0] << 8) | (uint16_t)p[1]);
+}
+
+static inline void
+s5b_wr_le16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)(v & 0xffu);
+	p[1] = (uint8_t)((v >> 8) & 0xffu);
+}
+
+static inline void
+s5b_wr_le32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v & 0xffu);
+	p[1] = (uint8_t)((v >> 8) & 0xffu);
+	p[2] = (uint8_t)((v >> 16) & 0xffu);
+	p[3] = (uint8_t)((v >> 24) & 0xffu);
+}
+
+static inline void
+s5b_wr_le64(uint8_t *p, uint64_t v)
+{
+	s5b_wr_le32(p, (uint32_t)(v & 0xffffffffULL));
+	s5b_wr_le32(p + 4, (uint32_t)(v >> 32));
+}
+
+static inline void
+s5b_wr_be16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)((v >> 8) & 0xffu);
+	p[1] = (uint8_t)(v & 0xffu);
+}
+
+static bool
+s5b_str_eq_ci(const char *a, const char *b)
+{
+	while (*a != '\0' && *b != '\0') {
+		if (sweet_ascii_toupper(*a) != sweet_ascii_toupper(*b)) {
+			return false;
+		}
+		a++;
+		b++;
+	}
+	return (*a == '\0' && *b == '\0');
+}
+
+static bool
+s5b_str_contains(const char *hay, const char *needle)
+{
+	unsigned nlen = sweet_str_len(needle);
+	if (nlen == 0u) {
+		return true;
+	}
+	for (unsigned i = 0u; hay[i] != '\0'; i++) {
+		unsigned j = 0u;
+		while (j < nlen && hay[i + j] == needle[j]) {
+			j++;
+		}
+		if (j == nlen) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static uint32_t
+s5b_parse_dec(const char *s, bool *ok)
+{
+	uint64_t val = 0u;
+	if (!s || s[0] == '\0') {
+		*ok = false;
+		return 0u;
+	}
+	for (unsigned i = 0u; s[i] != '\0'; i++) {
+		if (s[i] < '0' || s[i] > '9') {
+			*ok = false;
+			return 0u;
+		}
+		val = val * 10u + (uint64_t)(s[i] - '0');
+		if (val > 0xffffffffULL) {
+			*ok = false;
+			return 0xffffffffu;
+		}
+	}
+	*ok = true;
+	return (uint32_t)val;
+}
+
+static unsigned
+s5b_fmt_u32_dec(uint32_t v, char *out, unsigned cap)
+{
+	char tmp[16];
+	unsigned n = 0u;
+	if (v == 0u) {
+		tmp[n++] = '0';
+	} else {
+		while (v > 0u && n < sizeof(tmp)) {
+			tmp[n++] = (char)('0' + (v % 10u));
+			v /= 10u;
+		}
+	}
+	unsigned len = 0u;
+	while (n > 0u && len + 1u < cap) {
+		out[len++] = tmp[--n];
+	}
+	if (cap > 0u) {
+		out[len] = '\0';
+	}
+	return len;
+}
+
+static uint32_t
+s5b_part_rd32(uint32_t part_off)
+{
+	if (s5b.part_va == 0u || s_smem_p07_sz < 4u || part_off > s_smem_p07_sz - 4u) {
+		return 0u;
+	}
+	return probe_rd32(s5b.part_va, part_off);
+}
+
+static void
+s5b_part_wr32(uint32_t part_off, uint32_t val)
+{
+	if (s5b.part_va == 0u || s_smem_p07_sz < 4u || part_off > s_smem_p07_sz - 4u) {
+		return;
+	}
+	probe_wr32(s5b.part_va, part_off, val);
+}
+
+static bool
+s5b_smem_lock(void)
+{
+	if (!s5b.hwlock_va) {
+		return false;
+	}
+	for (unsigned i = 0u; i < 2000u; i++) {
+		probe_wr32(s5b.hwlock_va, 0u, 1u);
+		if (probe_rd32(s5b.hwlock_va, 0u) == 1u) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+static void
+s5b_smem_unlock(void)
+{
+	if (!s5b.hwlock_va) {
+		return;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	probe_wr32(s5b.hwlock_va, 0u, 0u);
+}
+
+static bool
+s5b_smem_get_item(uint16_t item, uint32_t *out_off, uint32_t *out_sz)
+{
+	if (s5b.part_va == 0u || s_smem_p07_sz < 0x40u) {
+		return false;
+	}
+
+	uint32_t free_unc = s5b_part_rd32(0x0cu);
+	uint32_t off = 0x20u;
+	while (off + 16u <= free_unc && off <= s_smem_p07_sz - 16u) {
+		uint32_t w0 = s5b_part_rd32(off);
+		if ((uint16_t)w0 != SMEM_PRIVATE_CANARY) {
+			break;
+		}
+		uint16_t it   = (uint16_t)(w0 >> 16);
+		uint32_t sz   = s5b_part_rd32(off + 4u);
+		uint32_t w2   = s5b_part_rd32(off + 8u);
+		uint16_t pdat = (uint16_t)w2;
+		uint16_t phdr = (uint16_t)(w2 >> 16);
+		if ((uint32_t)phdr > s_smem_p07_sz - (off + 16u) ||
+		    sz > s_smem_p07_sz - (off + 16u + (uint32_t)phdr)) {
+			break;
+		}
+		uint32_t poff = off + 16u + (uint32_t)phdr;
+		if (it == item) {
+			if (out_off) *out_off = poff;
+			if (out_sz)  *out_sz  = (pdat < sz) ? (sz - pdat) : sz;
+			return true;
+		}
+		off = poff + sz;
+	}
+
+	uint32_t free_cac = s5b_part_rd32(0x10u);
+	uint32_t cl = (s_smem_p07_cacheline >= 16u) ? s_smem_p07_cacheline : 32u;
+	uint32_t hdr_stride = (16u + cl - 1u) & ~(cl - 1u);
+	if (s_smem_p07_sz < hdr_stride) {
+		return false;
+	}
+	uint32_t ce = s_smem_p07_sz - hdr_stride;
+	while (ce > free_cac && ce + hdr_stride <= s_smem_p07_sz) {
+		uint32_t w0 = s5b_part_rd32(ce);
+		if ((uint16_t)w0 != SMEM_PRIVATE_CANARY) {
+			break;
+		}
+		uint16_t it   = (uint16_t)(w0 >> 16);
+		uint32_t sz   = s5b_part_rd32(ce + 4u);
+		uint16_t pdat = (uint16_t)s5b_part_rd32(ce + 8u);
+		if (sz > ce) {
+			break;
+		}
+		uint32_t doff = ce - sz;
+		if (it == item) {
+			if (out_off) *out_off = doff;
+			if (out_sz)  *out_sz  = (pdat < sz) ? (sz - pdat) : sz;
+			return true;
+		}
+		if (doff < hdr_stride) {
+			break;
+		}
+		ce = doff - hdr_stride;
+	}
+	return false;
+}
+
+static bool
+s5b_smem_alloc_unc(uint16_t item, uint32_t payload_sz, uint32_t *out_off)
+{
+	if (s5b_smem_get_item(item, out_off, NULL)) {
+		return true;
+	}
+	if (!s5b_smem_lock()) {
+		return false;
+	}
+	uint32_t free_unc = s5b_part_rd32(0x0cu);
+	uint32_t free_cac = s5b_part_rd32(0x10u);
+	uint32_t asize = (payload_sz + 7u) & ~7u;
+	uint32_t pdat  = asize - payload_sz;
+	if (free_unc > free_cac || asize > free_cac - free_unc || 16u > free_cac - free_unc - asize) {
+		s5b_smem_unlock();
+		return false;
+	}
+	uint32_t e = free_unc;
+	s5b_part_wr32(e + 0u,  (uint32_t)SMEM_PRIVATE_CANARY | ((uint32_t)item << 16));
+	s5b_part_wr32(e + 4u,  asize);
+	s5b_part_wr32(e + 8u,  pdat);
+	s5b_part_wr32(e + 12u, 0u);
+	uint32_t p = e + 16u;
+	for (uint32_t k = 0u; k < asize; k += 4u) {
+		s5b_part_wr32(p + k, 0u);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	s5b_part_wr32(0x0cu, p + asize);
+	s5b_smem_unlock();
+	if (out_off) {
+		*out_off = p;
+	}
+	return true;
+}
+
+static bool
+s5b_smem_alloc_cac(uint16_t item, uint32_t payload_sz, uint32_t *out_off, uint32_t *out_sz)
+{
+	if (s5b_smem_get_item(item, out_off, out_sz)) {
+		return true;
+	}
+	if (!s5b_smem_lock()) {
+		return false;
+	}
+	uint32_t free_unc = s5b_part_rd32(0x0cu);
+	uint32_t free_cac = s5b_part_rd32(0x10u);
+	uint32_t cl = (s_smem_p07_cacheline >= 16u) ? s_smem_p07_cacheline : 32u;
+	uint32_t hdr_stride = (16u + cl - 1u) & ~(cl - 1u);
+	uint32_t asize = (payload_sz + cl - 1u) & ~(cl - 1u);
+	uint32_t pdat  = asize - payload_sz;
+	if (free_cac < hdr_stride + asize || free_cac - hdr_stride - asize <= free_unc + 0x200u) {
+		s5b_smem_unlock();
+		return false;
+	}
+	uint32_t new_hdr  = free_cac - hdr_stride;
+	uint32_t new_data = new_hdr - asize;
+	for (uint32_t k = 0u; k < asize; k += 4u) {
+		s5b_part_wr32(new_data + k, 0u);
+	}
+	uint32_t pad_hdr = hdr_stride - 16u;
+	s5b_part_wr32(new_hdr + 0u,  (uint32_t)SMEM_PRIVATE_CANARY | ((uint32_t)item << 16));
+	s5b_part_wr32(new_hdr + 4u,  asize);
+	s5b_part_wr32(new_hdr + 8u,  pdat | (pad_hdr << 16));
+	s5b_part_wr32(new_hdr + 12u, 0u);
+	__asm__ volatile("dsb sy" ::: "memory");
+	s5b_part_wr32(0x10u, new_data);
+	s5b_smem_unlock();
+	if (out_off) *out_off = new_data;
+	if (out_sz)  *out_sz  = payload_sz;
+	return true;
+}
+
+static void
+s5b_part_wr_ascii4(uint32_t part_off, const char *s, unsigned nbytes)
+{
+	bool ended = false;
+	for (unsigned k = 0u; k < nbytes; k += 4u) {
+		uint32_t w = 0u;
+		for (unsigned b = 0u; b < 4u && (k + b) < nbytes; b++) {
+			if (!ended) {
+				uint8_t ch = (uint8_t)s[k + b];
+				w |= ((uint32_t)ch << (b * 8u));
+				if (ch == '\0') {
+					ended = true;
+				}
+			}
+		}
+		s5b_part_wr32(part_off + k, w);
+	}
+}
